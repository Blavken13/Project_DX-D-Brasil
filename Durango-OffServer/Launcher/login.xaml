<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lost Horizon"
        Width="1280" Height="760" MinWidth="800" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="#080C09" Foreground="#F5F2E8" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#172119"/><Setter Property="Background" Value="#DFC28B"/>
      <Setter Property="BorderBrush" Value="#EFDAAD"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.85"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F5F2E8"/><Setter Property="Background" Value="#B0050B08"/>
      <Setter Property="BorderBrush" Value="#4ABCCAAF"/><Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="9,6"/><Setter Property="CaretBrush" Value="#DFC28B"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Foreground" Value="#F5F2E8"/><Setter Property="Background" Value="#B0050B08"/>
      <Setter Property="BorderBrush" Value="#4ABCCAAF"/><Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="9,6"/><Setter Property="CaretBrush" Value="#DFC28B"/>
    </Style>
  </Window.Resources>
  <Grid>
    <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill" IsMuted="True"/>
    <Border Background="#45050C09" IsHitTestVisible="False"/>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,28">
        <Image x:Name="Logo" Width="310" Height="122" Stretch="Uniform" Margin="0,0,0,16">
          <Image.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.9"/></Image.Effect>
        </Image>
        <Border Background="#C2000000" BorderBrush="#52DFC28B" BorderThickness="1" CornerRadius="7" Padding="26,22,26,18">
          <StackPanel>
            <TextBlock x:Name="Heading" Text="Entrar" FontSize="20" TextAlignment="Center"/>
            <TextBlock x:Name="Description" Text="Bem-vindo ao alfa de Lost Horizon." Foreground="#B2B8AD"
                       FontSize="12" TextAlignment="Center" Margin="0,7,0,18"/>
            <StackPanel x:Name="ServerPanel" Visibility="Collapsed" Margin="0,0,0,12">
              <TextBlock Text="Servidor" Foreground="#D3D7CE" FontSize="11" Margin="0,0,0,5"/>
              <ComboBox x:Name="Server" Height="32" Foreground="#172119"/>
            </StackPanel>
            <StackPanel x:Name="Form">
              <TextBlock Text="Usuário" Foreground="#D3D7CE" FontSize="11" Margin="0,0,0,5"/>
              <TextBox x:Name="Username" MaxLength="32" AutomationProperties.Name="Usuário"/>
              <TextBlock Text="Senha" Foreground="#D3D7CE" FontSize="11" Margin="0,12,0,5"/>
              <PasswordBox x:Name="Password" MaxLength="128" AutomationProperties.Name="Senha"/>
              <StackPanel x:Name="ConfirmationPanel" Visibility="Collapsed">
                <TextBlock Text="Confirmar senha" Foreground="#D3D7CE" FontSize="11" Margin="0,12,0,5"/>
                <PasswordBox x:Name="Confirmation" MaxLength="128" AutomationProperties.Name="Confirmar senha"/>
              </StackPanel>
              <Button x:Name="Submit" Content="ENTRAR" FontWeight="Bold" Margin="0,17,0,0" IsDefault="True"/>
              <Button x:Name="Switch" Content="Criar uma conta" Foreground="#DFC28B" Background="Transparent" BorderThickness="0"
                      FontSize="12" Padding="0,3" Margin="0,13,0,0"/>
            </StackPanel>
            <StackPanel x:Name="Account" Visibility="Collapsed">
              <TextBlock Text="Conectado como" Foreground="#B2B8AD" FontSize="12" TextAlignment="Center"/>
              <TextBlock x:Name="AccountName" FontSize="19" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <Button x:Name="Continue" Content="CONTINUAR" FontWeight="Bold" Margin="0,17,0,0"/>
              <Button x:Name="SignOut" Content="Trocar de conta" Foreground="#DFC28B" Background="Transparent" BorderThickness="0"
                      FontSize="12" Padding="0,3" Margin="0,13,0,0"/>
            </StackPanel>
            <ProgressBar x:Name="Progress" Height="3" Foreground="#DFC28B" Background="#18FFFFFF"
                         IsIndeterminate="True" Visibility="Collapsed" Margin="0,13,0,0"/>
            <TextBlock x:Name="Notice" Foreground="#F1C39C" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,11,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
              <Ellipse x:Name="StatusDot" Fill="#A6AA94" Width="5" Height="5" Margin="0,0,7,0"/>
              <TextBlock x:Name="Status" Text="Conectando ao servidor…" Foreground="#A5AF9F" FontSize="10"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock Text="Lost Horizon · Alfa" Foreground="#A0AA96" FontSize="10" TextAlignment="Center" Margin="0,16,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
