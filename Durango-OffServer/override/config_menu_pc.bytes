{
	"default": {
		"locale": {
			"Type": "Locale"
		},
		"voice_locale": {
			"Type": "Locale"
		},
		"sfx_volume": {
			"Type": "Slider",
			"Default": 1,
			"Threshold": 0.1,
			"Range": [ 0, 1 ]
		},
		"ambience_volume": {
			"Type": "Slider",
			"Default": 1,
			"Threshold": 0.1,
			"Range": [ 0, 1 ]
		},
		"bgm_volume": {
			"Type": "Slider",
			"Default": 1,
			"Threshold": 0.1,
			"Range": [ 0, 1 ]
		},
		"midi_volume": {
			"Type": "Slider",
			"Default": 1,
			"Threshold": 0.1,
			"Range": [ 0, 1 ]
		},
		"mouse_reversed": {
			"Type": "CheckBox",
			"Default": false,
			"HideOnPrologue": true
		},
		"terms": {
			"Type": "ButtonBox"
		},
		"category_chat": {
			"Type": "Category",
			"HideOnPrologue": true,
			"HideOnOffline": true
		},
		"chat_grid_buttons": {
			"Type": "Grid",
			"HideOnPrologue": true,
			"HideOnOffline": true,
			"Number": 2
		},
		"permit_conversation": {
			"Type": "CheckBox",
			"HideOnPrologue": true,
			"HideOnOffline": true,
			"GridNumber": 2
		},
		"show_draw_line": {
			"Type": "CheckBox",
			"Default": true,
			"HideOnPrologue": true,
			"HideOnOffline": true,
			"GridNumber": 2
		},
		"show_chat_bubble": {
			"Type": "CheckBox",
			"Default": true,
			"HideOnPrologue": true,
			"HideOnOffline": true,
			"GridNumber": 2
		}
	},
	"screen": {
		"screen_mode": {
			"Type": "Toggle",
			"Options": [ "fullscreen", "window" ],
			"Default": "fullscreen"
		},
		"resolution_pc": {
			"Type": "Dropdown",
			"ButtonClickClose": true,
			"Custom": true
		},
		"v_sync": {
			"Type": "CheckBox",
			"Default": false
		},
		"max_frame_rate": {
			"Type": "Slider",
			"Default": 60,
			"Threshold": 1,
			"Range": [ 30, 144 ],
			"ShowText" : true 
		},
		"anti_aliasing": {
			"Type": "Dropdown",
			"Options": [ "0", "2", "4", "8" ],
			"Default": "0",
			"ButtonClickClose": true
		},
		"ui_size": {
			"Type": "Dropdown",
			"Options": [ "1280", "1420", "1600" ],
			"Default": "1280"
		},
		"shadow": {
			"Type": "Toggle",
			"Options": [ "low", "high" ],
			"Default": "high",
			"HideOnPrologue": true
		},
		"capture_filter": {
			"Type": "Switch",
			"Default": true,
			"HideOnPrologue": true
		},
		"hide_debug_ui": {
			"Type": "Switch",
			"DebugBuild": true
		},
		"category_post_processing": {
			"Type": "Category",
			"HideOnPrologue": true
		},
		"post_processing_grid_buttons": {
			"Type": "Grid",
			"HideOnPrologue": true,
			"Number": 1
		},
		"vignette": {
			"Type": "CheckBox",
			"Default": true,
			"HideOnPrologue": true,
			"GridNumber": 1
		},
		"visual_effect": {
			"Type": "CheckBox",
			"Default": true,
			"HideOnPrologue": true,
			"GridNumber": 1
		}
	},
	"account": {
