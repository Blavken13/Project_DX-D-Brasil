msgstr "ชุดคนงานยาง (อุปกรณ์ตกแต่ง)"

msgid "고무 장갑"
msgstr "ถุงมือยาง"

msgid "고무 장화"
msgstr "รองเท้าบูทยาง"

msgid "고무나무"
msgstr "ต้นยาง"

msgid "고무나무 군락"
msgstr "ดงต้นยาง"

