msgstr "{player_name} ปรับแต่งช่อง {slot_id} ของ {artifact_name}({artifact_entity_id}) {material_slots} ด้วยวัตถุดิบบน {tile} ของ {entity_region_name}"

msgid "{player_name} 님이 {entity_region_name} 섬 {tile}에서 {band_count} 명과 함께 {own_sheet_count} 개의 비공유 악보와 {shared_sheet_count} 개의 공유 악보로 음색 각각 {timbres} 로 합주."
msgstr "{player_name} ร่วมแสดงในวงดนตรีบน {tile} ของเกาะ {entity_region_name} ในวงดนตรี {band_count} คน โดยใช้หน้า {own_sheet_count} {own_sheet_count:p:|} ของแผ่นโน้ตเพลงของพวกเขา และหน้า {shared_sheet_count} {shared_sheet_count:p:|} ของแผ่นโน้ตเพลงที่แชร์แล้วในการแสดงขับร้อง {timbres}"

msgid "{player_name} 님이 {entity_region_name} 섬 {tile}에서 {crafted_items:를} 제작. 적용 레시피: {recipe_id}, 재료: {material_slots}, 제작 결과: {result} 제작대: {workbench_entity_name}제작랜덤보너스: {bonus_prototypes}"
msgstr "{player_name} ที่สร้าง {crafted_items:를} บน {tile} ของเกาะ {entity_region_name} สูตรที่ใช้: {recipe_id} วัตถุดิบ: {material_slots} ผลการสร้าง: {result} โต๊ะทำงาน: {workbench_entity_name} โบนัสการสร้างแบบสุ่ม: {bonus_prototypes}"

