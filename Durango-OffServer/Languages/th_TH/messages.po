msgstr "ขายไอเทมที่คุณลงรายการไว้ในตลาดแล้ว: {items}"

msgid "장터에는 불안정 아이템을 등록할 수 없습니다."
msgstr "ไอเทมที่ไม่เสถียรไม่สามารถตั้งขายเพื่อขายที่ตลาดได้"

msgid "장터에는 한번에 최대 {max}개의 아이템을 등록할 수 있습니다."
msgstr "คุณสามารถตั้งขายได้สูงสุด {max} ไอเทม{max:p:|} ต่อครั้งที่ตลาด"

msgid "장터에서 검색"
msgstr " ค้นหาที่ตลาด"

msgid "장터에서 팔리는 품목은 여러 분류로 나뉘어 있습니다."
msgstr "ไอเทมที่ขายในตลาดแบ่งออกเป็นหลายหมวดหมู่"

msgid "장터에서 팔리지 않은 물건은\n만료된 물품에서 찾을 수 있습니다."
msgstr "สามารถหาไอเทมที่ไม่มีขายในตลาด\nได้ในส่วนไอเทมที่หมดอายุ"

msgid "잦은 움직임을 통해 지속적으로 공격을 할 수 있도록 전투의 기회를 잡아보세요."
msgstr "สร้างความได้เปรียบในการต่อสู้ด้วยการเคลื่อนที่ไปเรื่อย ๆ เพื่อทำการโจมตีอย่างต่อเนื่อง"

msgid "재가동"
msgstr "บูทเครื่องใหม่"

msgid "재가동 버튼으로도 해결이 안 되는 걸 보면 기기 이상은 아닌가 봐요. "
msgstr "อืมม... รีบูตก็ไม่ช่วยอะไร ฉันไม่คิดว่าปัญหาอยู่ที่อุปกรณ์"

msgid "재구매"
msgstr "ซื้อใหม่อีกครั้ง"

msgid "재난 상황에 쓰는 생존식량. \"어느 회사에서 만든 제품이지?\""
msgstr "อาหารสำหรับเวลาเกิดภัยพิบัติ \"อาหารจำเป็นในยามยาก\""

msgid "재료"
msgstr "วัตถุดิบ"

msgid "재료 가공"
msgstr "แปรรูปวัตถุดิบ"

msgid "재료 가공 100회 하세요"
msgstr "แปรรูปวัตถุดิบ 100 ครั้ง"

msgid "재료 가공 10회 하세요"
msgstr "แปรรูปวัตถุดิบ 10 ครั้ง"

msgid "재료 가공 15회 하세요"
msgstr "แปรรูปวัตถุดิบ 15 ครั้ง"

msgid "재료 가공 30회 하세요"
msgstr "แปรรูปวัตถุดิบ 30 ครั้ง"

msgid "재료 가공 55회 하세요"
msgstr "แปรรูปวัตถุดิบ 55 ครั้ง"

msgid "재료 가공 5회 하세요"
msgstr "แปรรูปวัตถุดิบ 5 ครั้ง"

msgid "재료 가공을 100번 진행하면, 보상으로 피로 회복제를 얻을 수 있습니다."
msgstr "คุณจะได้รับยาบำรุงความเหนื่อยล้าเป็นรางวัลหากคุณแปรรูปวัตถุดิบ 100 ครั้ง"

msgid "재료 가공하기"
msgstr "แปรรูปวัตถุดิบ"

msgid "재료 넣기"
msgstr "ใส่วัตถุดิบ"

msgid "재료 다듬기"
msgstr "ตัดแต่งวัสดุ"

msgid "재료 다듬기를 4번 하세요."
msgstr "ตัดแต่งวัสดุ 4 ครั้ง"

msgid "재료 레벨"
msgstr "เลเวลวัตถุดิบ"

msgid "재료 복합가공"
msgstr "แปรรูปวัตถุดิบการสร้างบ้าน"

msgid "재료 속성 레벨 증가"
msgstr "เลเวลคุณสมบัติของวัสดุเพิ่มขึ้น"

msgid "재료 압축가공"
msgstr "แปรรูปวัตถุดิบด้วยการบีบอัด"

msgid "재료 이름"
msgstr "ชื่อวัตถุดิบ"

msgid "재료 정밀가공"
msgstr "แปรรูปวัตถุดิบ\nอย่างแม่นยำ"

msgid "재료 제작"
msgstr "สร้างวัตถุดิบ"

msgid "재료 족보를 모두 모아 엮은 완성품. 품에 착용할 수 있다."
msgstr "สายเลือดที่สมบูรณ์เกิดจากการรวมสายเลือดอื่นทั้งหมดเข้าด้วยกัน สามารถสวมใส่เป็นอุปกรณ์เสริมได้"

msgid "재료 좀 더 갖다 줄래요?"
msgstr "คุณช่วยไปนำวัตถุดิบมาเพิ่มอีกได้ไหม?"

msgid "재료 파편가공"
msgstr "แปรรูปเศษวัตถุดิบ"

msgid "재료 표면가공"
msgstr "แปรรูปพื้นผิว\nวัตถุดิบ"

msgid "재료가 부족합니다."
msgstr "วัตถุดิบไม่เพียงพอ"

msgid "재료가 선택되지 않았습니다."
msgstr "ไม่ได้เลือกวัตถุดิบ"

msgid "재료가 희귀할수록,\n결과물이 희귀한 효과를 발합니다."
msgstr "ยิ่งคุณใช้วัสดุที่หายากเท่าไร \nจะยิ่งได้รับเอฟเฟกต์ที่หายากยิ่งขึ้นเท่านั้น"

msgid "재료는 이 정도면 충분혀. 만드는데 <em>시간</em>은 좀 들 것이여."
msgstr "อืมม... ยอดเยี่ยม นั่นน่าจะเป็นวัตถุดิบที่แม่นยำพอนะ ตอนนี้สิ่งที่เราต้องการก็คือ<em>เวลา</em>ที่เพียงพอจะให้เราประกอบพวกมันเข้าด้วยกันได้"

msgid "재료로 사용해 건축물 제작 시, 호박 줄무늬 패턴이 등장한다. 할로윈 이벤트 기간 동안 구입할 수 있다. \"악령은 패턴 속에 출몰한다.\""
msgstr "ใช้เป็นวัสดุเพื่อสร้างลวดลายฟักทองลายทาง สามารถซื้อได้ระหว่างกิจกรรมฮาโลวีน \"หากมองใกล้พอ คุณอาจมองเห็นวิญญาณชั่วร้ายได้แวบหนึ่ง\""

msgid "재료로 사용해 건축물 제작 시, 호박 패턴이 등장한다. 할로윈 이벤트 기간 동안 구입할 수 있다. \"인간은 두 색의 줄로 많은 민족과 스포츠팀, 생각을 표현할 수 있다\""
msgstr "ใช้เป็นวัสดุเพื่อสร้างลวดลายฟักทอง สามารถซื้อได้ระหว่างกิจกรรมฮาโลวีน \"ใจหนึ่งฉันก็หวังว่ามันจะมีรสชาติเหมือนพายฟักทอง แต่ฉันคิดผิด\""

msgid "재료를 10번 가공하세요."
msgstr "แปรรูปวัสดุ 10 ครั้ง"

msgid "재료를 꼬치에 끼워 불에 굽는다."
msgstr "นำส่วนผสมเสียบไม้และย่างบนเปลวไฟ"

msgid "재료를 꽂아 구운 꼬치구이. \"별다른 조리도구가 없을 때 편하다.\""
msgstr "แท่งสำหรับเสียบอาหาร \"สะดวกใช้งานเมื่อคุณขาดแคลนเครื่องมือการทำอาหาร\""

msgid "재료를 넣어 사우나를 건설할 수 있다. 부지를 선정한 개척자만 건설할 수 있다."
msgstr "สร้างซาวน่าโดยใช้วัตถุดิบต่าง ๆ ผู้บุกเบิกที่ได้รับมอบหมายงานในสถานที่ก่อสร้างเท่านั้นที่สามารถก่อสร้างตามแบบแปลนนี้ได้"

msgid "재료를 넣으시겠습니까?"
msgstr "เพิ่มวัสดุนี้หรือไม่"

msgid "재료를 다듬을 수 있습니다. 다듬은 재료는 무기, 의상, 건축물 제작에 쓰입니다."
msgstr "วัสดุตัดแต่ง ใช้เพื่อทำอาวุธ เสื้อผ้า และสิ่งปลูกสร้าง"

msgid "재료를 달였다. 걸쭉하니 소화가 잘 될 것 같다."
msgstr "ต้มส่วนผสมให้เป็นน้ำข้น มันจะย่อยได้ง่ายขึ้น"

msgid "재료를 더 가볍고 단단하게 가공한다."
msgstr "แปรรูปหนังเพื่อทำให้หลังเบาขึ้นและทนทานขึ้น"

msgid "재료를 말렸다. 오래 보관할 수 있을 것 같다."
msgstr "ทิ้งวัตถุดิบไว้ให้แห้ง เท่านี้ก็เก็บไว้ได้นานขึ้นแล้วละ"

msgid "재료를 모르겠다면 재료넣기에서\n구체적인 종류를 확인할 수도 있습니다."
msgstr "ตรวจสอบวัตถุดิบที่คุณไม่แน่ใจ\nเพื่อเรียนรู้เพิ่มเติมเกี่ยวกับวิธีใช้งาน"

msgid "재료를 쓰기 좋게 다듬는다."
msgstr "ตัดแต่งวัตถุดิบเพื่อทำให้นำมาใช้ได้ง่ายขึ้น"

msgid "재료를 압축하여 내구성을 높인다."
msgstr "เพิ่มค่าทนทานด้วยการบีบอัดวัตถุดิบ"

msgid "재료를 우려낸 드립 커피."
msgstr "กาแฟกลั่นที่ทำจากการชงส่วนผสมต่างๆ"

msgid "재료를 정밀하게 가공한다."
msgstr "แปรรูปวัตถุดิบด้วยความแม่นยำ"

msgid "재료를 훈제하여 풍미가 살아나면서도 보관이 쉬워졌다."
msgstr "การรมควันช่วยรักษารสชาติของอาหารและทำให้คงอยู่ได้นานขึ้น"

msgid "재료만 들고 오세요"
msgstr "นำวัสดุของคุณมาเอง"

msgid "재료에 날카로운 파편을 박아 위협적으로 가공한다."
msgstr "เสริมเศษวัสดุแหลมคมเพื่อทำให้ไอเทมดูน่ากลัวยิ่งขึ้น"

msgid "재료에 따라 건축물의 외형이 변경됩니다. 가죽 지붕, 돌 벽,\n나무 바닥 등 나만의 건축물을 만들어 보세요."
msgstr "หน้าตาของงานก่อสร้างเปลี่ยนแปลงไปตามวัสดุที่ใช้ (หลังคาหนัง, กำแพงหิน, พื้นไม้ ฯลฯ) ลองสร้างงานก่อสร้างตามแบบของคุณเอง"

msgid "재료에 따라 달라지는 건축 외형"
msgstr "การก่อสร้างสะท้อนถึงวัสดุที่ใช้"

msgid "재료에서 기름을 짜냈다."
msgstr "สกัดน้ำมันจากวัตถุดิบ"

msgid "재료와 도구만 갖추면 건설할 수 있는 도면. 거래가 가능하다."
msgstr "แบบแปลนที่สามารถสร้างได้ด้วยวัตถุดิบและเครื่องมือต่าง ๆ ที่จำเป็น ซื้อขายได้"

msgid "재료와 도구만 갖추면 건설할 수 있는 도면. 부지를 선정한 개척자만 건설할 수 있다."
msgstr "คุณสามารถเขียนแผนผังได้ด้วยการใช้อุปกรณ์และเครื่องมือที่เหมาะสม\" แต่เฉพาะผู้บุกเบิกที่เลือกสถานที่ดังกล่าวเท่านั้นจึงจะสามารถเขียนแผนผังได้"

msgid "재료의 가공방법에 따라 결과물의 속성이 달라집니다.\n금속 탈황처리를 할 경우 내구도가, 금속 탄소처리를 할 경우 공격력이 증가합니다."
msgstr "ผลลัพธ์ของคุณสมบัติเปลี่ยนแปลงไปตามการแปรรูปวัตถุดิบ\nเมื่อกำจัดก๊าซซัลเฟอร์ไดออกไซด์ออกจากโลหะ ค่าทนทานจะเพิ่มสูงขึ้น การโจมตีจะเพิ่มขึ้นถ้าเพิ่มสารคาร์บอน"

msgid "재료의 일부를 건설 부지에 넣었습니다."
msgstr "คุณได้เพิ่มวัตถุดิบบางอย่างในไซต์การก่อสร้าง"

msgid "재료의 표면을 다듬는다."
msgstr "แปรรูปพื้นผิวของวัตถุดิบ"

msgid "재무"
msgstr "การเงิน"

msgid "재미있는 친구구나. 위원회란 걸 알고도 그렇게 말했단 거니?"
msgstr "น่าสนใจ.. ฮิปโปรู้ไหมว่าเราทำงานให้ใคร?"

msgid "재발급하기"
msgstr "ออกใหม่"

msgid "재배로 얻은 수박. \"여름은 둥글다\""
msgstr "แตงโมต้องผ่านการเพาะปลูก “มันไม่ใช่ฤดูร้อนหากไม่มีแตงโม\""

msgid "재배로 얻은 통나무. \"나무들이 보기엔 토르소가 따로 없다.\""
msgstr "ท่อนซุงที่ตัดจากต้นไม้ที่เพาะปลูก \"ถ้านี่คือลำต้นของต้นไม้ แล้วหัวอยู่ที่ไหนล่ะ\""

msgid "재배엔 쓸 수 없는 식량용 감자. \"콜럼버스가 이것만 들고 가진 않았을 거다.\""
msgstr "มันฝรั่งชนิดนี้ไม่สามารถนำไปปลูกได้ \"ขาดแค่สเต็กอีกอย่างก็ครบเลย\""

msgid "재배엔 쓸 수 없는 식량용 밀. \"누구나 완벽할 수는 없다.\""
msgstr "ข้าวสาลีชนิดนี้ใช้เพาะปลูกไม่ได้ \"ข้าวสาลีที่ปลูกไม่ได้ก็เหมือนไม่ใช่ข้าวสาลี\""

msgid "재배엔 쓸 수 없는 식량용 바나나. \"탄수화물은 훗날 역사가 평가할 것이다.\""
msgstr "กล้วยที่กินได้ ไม่เหมาะสำหรับเพาะปลูก \"อาหารที่กินด้วยมือแบบดั้งเดิม\""

msgid "재배엔 쓸 수 없는 식량용 보리. \"풍부한 영양은 방귀라는 비용을 치른다.\""
msgstr "บาร์เลย์ที่กินได้แต่เก็บเกี่ยวไม่ได้ \"ผลข้างเคียงของอาหารที่มีโภชนาการสูงคืออาการท้องอืด\""

msgid "재배엔 쓸 수 없는 식량용 보리쌀. \"풍부한 영양은 방귀라는 비용을 치른다.\""
msgstr "เมล็ดข้าวบาร์เลย์ที่กินได้แต่ไม่สามารถเก็บเกี่ยวได้ “ผลข้างเคียงของอาหารที่มีโภชนาการสูงคืออาการท้องอืด”"

msgid "재배엔 쓸 수 없는 식량용 쌀. \"볍씨에서 껍질을 벗겨냈다.\""
msgstr "ข้าวชนิดนี้กินได้แต่นำไปปลูกไม่ได้ \"ปอกเปลือกแล้วจะเจอของดี\""

msgid "재배엔 쓸 수 없는 식량용 양파 구근. \"눈물은 멈추지 않는다.\""
msgstr "หัวหอมที่กินได้ ไม่เหมาะสำหรับเพาะปลูก \"มาพร้อมกับอาการแสบตา\""

msgid "재배엔 쓸 수 없는 식량용 옥수수. \"의학적인 어려움은 여전히 많다.\""
msgstr "ใช้ในการเพาะปลูกไม่ได้ \"บางครั้งคุณก็ไม่สามารถเก็บเกี่ยวผลที่สิ่งคุณหว่านไปได้\""

msgid "재배엔 쓸 수 없는 식량용 콩. \"영양이 잘 여물었다.\""
msgstr "ถั่วพวกนี้กินได้แต่นำไปปลูกไม่ได้ \"อัดแน่นไปด้วยสารอาหาร\""

msgid "재배엔 쓸 수 없는 식량용 토마토. \"먹는 게 남는 거니까.\""
