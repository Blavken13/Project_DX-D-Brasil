msgid "농사를 지을 수 있는 작은 회색 밭."
msgstr "ทุ่งนาสีเทาขนาดเล็กสำหรับเพาะปลูก"

msgid "농사를 지을 수 있는 큰 회색 밭."
msgstr "ทุ่งนาผืนสีเทาใหญ่สำหรับเพาะปลูก"

msgid "농사스킬 숙련도 100% 이벤트"
msgstr "เลเวลสกิลการเพาะปลูก + อีเวนต์ 100%"

msgid "농사스킬 숙련도 200% 이벤트"
msgstr "เลเวลสกิลการเพาะปลูก + อีเวนต์ 200%"

msgid "농사스킬 숙련도 300% 이벤트"
msgstr "เลเวลสกิลการเพาะปลูก + อีเวนต์ 300%"

