msgid "{player_name} 님이 {entity_region_name} 섬 {tile}에서 {artifact_name}({artifact_entity_id}) 건설"
msgstr "[การก่อสร้าง] {player_name} สร้าง {artifact_name} ({artifact_entity_id}) ที่ {tile} ของเกาะ {entity_region_name}"

msgid "{player_name} 님이 {entity_region_name} 섬 {tile}에서 {artifact_name}({artifact_entity_id}) 건설 재료로 {material_slots} 추가함"
msgstr "{player_name} ได้เพิ่ม {material_slots} โดยใช้ {artifact_name} ({artifact_entity_id}) เป็นวัสดุก่อสร้างที่ {tile} ของเกาะ {entity_region_name}"

