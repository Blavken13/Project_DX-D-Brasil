msgid "{item} 향육포"
msgstr "{item}แดดเดียวปรุงรส"

msgid "{item}: 가구 제작맛"
msgstr "{item}: อรรถรสของการประดิษฐ์เครื่องเรือน"

msgid "{item}: 건설맛"
msgstr "{item}: อรรถรสของการก่อสร้าง"

msgid "{item}: 공예맛"
msgstr "{item}: อรรถรสของหัตถกรรม"

msgid "{item}: 무기 제작맛"
msgstr "{item}: อรรถรสของการประดิษฐ์อาวุธ"

msgid "{item}: 옷 제작맛"
msgstr "{item}: อรรถรสของการตัดเย็บ"

msgid "{item}: 요리 제작맛"
msgstr "{item}: อรรถรสของการทำอาหาร"

