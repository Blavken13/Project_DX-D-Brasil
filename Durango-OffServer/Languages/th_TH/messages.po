msgstr "ไม่มีบันทึกของการสำรวจนี้"

msgid "해당 목표와 너무 멀리 떨어져 있습니다."
msgstr "ไกลจากเป้าหมายเกินไป"

msgid "해당 보상을 더 이상 받을 수 없습니다."
msgstr "คุณไม่สามารถรับรางวัลนี้ได้อีกต่อไป"

msgid "해당 부족 소속이 아닙니다."
msgstr "ไม่ใช่สมาชิกแคลนนี้"

msgid "해당 부족에 가입 신청을 하지 않은 상태입니다."
msgstr "คุณยังไม่ได้ขอเข้าร่วมแคลนนี้"

msgid "해당 부족을 찾을 수 없습니다."
msgstr "ไม่พบแคลน"

msgid "해당 부족의 정보가 없습니다."
msgstr "ไม่มีข้อมูลแคลน"

msgid "해당 상품이 존재하지 않습니다."
msgstr "ไม่มีสินค้านี้อยู่"

msgid "해당 슬롯의 사용 기간을 30일 추가합니다."
msgstr "ขยายระยะเวลาของช่องออกไป 30 วัน"

msgid "해당 슬롯이 가득 차 있습니다."
msgstr "ช่องนี้เต็มแล้ว"

msgid "해당 시스템 점검중으로 이용할 수 없습니다."
msgstr "ใช้ไม่ได้ ระบบอยู่ในระหว่างการบำรุงรักษา"

msgid "해당 시스템은 점검 중이며 이용이 불가능합니다."
msgstr "ขณะนี้ระบบอยู่ในระหว่างการปิดปรับปรุง"

msgid "해당 아이템은 <em>전체 내구도가 {0} 미만</em>으로 떨어져,\n더 이상 수리할 수 없습니다."
msgstr "ไม่สามารถซ่อมไอเทมได้ \n<em>ค่าทนทานรวมทั้งหมดต่ำกว่า {0}</em>"

msgid "해당 아이템이 가방에 없습니다."
msgstr "ไอเทมนี้ไม่ได้อยู่ในกระเป๋าของคุณ"

msgid "해당 연구는 이미 연구 중입니다."
msgstr "การวิจัยอยู่ระหว่างดำเนินการแล้ว"

msgid "해당 이용권은 <em>상점</em> 메뉴 내 <em>특송 화물</em> 카테고리의 <em>이용권 보기</em> 항목을 통해 확인할 수 있습니다."
msgstr "หากต้องการตรวจสอบคูปองที่เกี่ยวข้อง โปรดเลือก<em>ดูคูปอง</em> ที่อยู่ใต้<em>สินค้าด่วน</em> จาก<em>เมนูร้านค้า</em>"

