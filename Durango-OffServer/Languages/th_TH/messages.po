msgid "돌격"
msgstr "จู่โจม"

msgid "돌격전차 하드로사우루스"
msgstr "ฮาโดรจอมบดขยี้ปล่องภูเขาไฟ"

msgid "돌격태세"
msgstr "ท่าจู่โจม"

msgid "돌격태세 효과"
msgstr "ท่าจู่โจม"

msgid "돌곡괭이"
msgstr "อีเต้อหิน"

msgid "돌곡괭이 구해다줘"
msgstr "ขุดเพื่ออนาคต"

msgid "돌곡괭이를 만들 수 있습니다. 광물 채광에 쓰입니다."
msgstr "ทำอีเต้อหิน ใช้เพื่อขุดแร่ธาตุ"

msgid "돌괭이"
msgstr "จอบหิน"

msgid "돌괭이를 만들 수 있습니다. 작은 밭을 일구는 데 쓰입니다."
msgstr "ทำจอบหิน ใช้เพื่อเตรียมที่ดินขนาดเล็ก"

msgid "돌기둥"
msgstr "เสาหิน"

msgid "돌기둥 구해주지?"
msgstr "เสาหลักของสังคม"

msgid "돌기둥 제작하기"
msgstr "การแกะแกนหิน"

msgid "돌길"
msgstr "ถนนหิน"

msgid "돌길을 2번 건설하세요."
msgstr "สร้างถนนหิน 2 ครั้ง"

msgid "돌날"
msgstr "ใบมีดหิน"

msgid "돌날 양손검"
msgstr "ดาบหินสองมือ"

msgid "돌날 양손도끼"
msgstr "ขวานหินสองมือ"

msgid "돌날과 뼈날은 무기, 도구 제작에,\n금속날은 가공 계열에 있습니다."
msgstr "ใบมีดกระดูกและหินอยู่ที่ด้านล่างของการสร้างอาวุธและเครื่องมือ\nในขณะที่ใบมีดโลหะอยู่ในหมวดหมู่การแปรรูป"

msgid "돌날로 <link>가시덩굴</link> 베어 없애기"
msgstr "ใช้ใบมีดหินเพื่อตัด<link>พุ่มไม้หนามแหลมออกไปให้พ้นทาง</link>"

msgid "돌날보다 공격력이 높은 뼈날을 만들 수 있습니다."
msgstr "ทำใบมีดกระดูกที่มีพลังโจมตีมากกว่าใบมีดหิน"

msgid "돌날은 돌멩이를 쪼개 만들기에\n돌멩이만 있으면 됩니다."
msgstr "สิ่งเดียวที่คุณต้องการ คือก้อนกรวดที่ีคุณสามารถ\nลับให้คมเป็นใบมีดหินได้"

msgid "돌날을 도끼날로 쓰면\n더 이상 해당 돌날은 돌날로 쓸 수 없습니다."
msgstr "คุณจะไม่สามารถใช้ใบมีดหินได้อีก\nเมื่อแปลงมันเป็นหัวขวาน"

msgid "돌날이나 급조한 한손칼이\n적절한 수준입니다."
msgstr "สามารถใช้ใบมีดหินและมีดมือเดียวประดิษฐ์เองได้"

msgid "돌다리"
msgstr "สะพานหิน"

msgid "돌담이라도 쌓고 싶은데, 당신한테 그 일 해달라고 시간 뺏긴 그래서요. <em>{item_0}</em>라도 구해주셨으면 좋겠네요. 바람을 막고 안 막고가 차이가 커요."
msgstr "ฉันต้องการสร้างกำแพงหิน ถึงอย่างนั้นก็ไม่จำเป็นต้องออกแรงด้วยตัวเองมากเกินไป คุณช่วยไปเอา <em>{item_0}</em> มาให้ฉันได้หรือไม่? กำแพงทุกกำแพงต้องเริ่มต้นที่ไหนสักที่"

msgid "돌덩어리"
msgstr "ก้อนหิน"

msgid "돌도끼"
msgstr "ขวานหิน"

msgid "돌도끼날"
msgstr "หัวขวานหิน"

msgid "돌도끼날보다 공격력이 높은 뼈도끼날을 만들 수 있습니다."
msgstr "ทำหัวขวานกระดูกที่มีพลังโจมตีมากกว่าหัวขวานหิน"

msgid "돌로 만든 경첩. \"문이 닫힌다고 문 밖의 세상이 사라지진 않는다.\""
msgstr "บานพับที่สร้างจากหิน \"แม้อยู่ด้านหลังประตูที่ปิดสนิท แต่โลกภายนอกก็ไม่ได้หายไปไหน\""

msgid "돌로 만든 곡괭이. 채광 작업에 쓴다. \"돌에는 돌.\""
msgstr "อีเต้อที่ทำจากหิน ใช้สำหรับขุดแร่ \"หินบางชนิดก็แข็งกว่าหินชนิดอื่น\""

msgid "돌로 만든 곡괭이. 채광에 쓴다."
msgstr "อีเต้อที่ทำจากหิน ใช้สำหรับขุดแร่"

msgid "돌로 만든 괭이. 농사에 쓴다."
msgstr "จอบที่ทำจากหิน ใช้สำหรับเพาะปลูก"

msgid "돌로 만든 괭이. 농사에 쓴다. \"흙에서 자란 돌로 흙을 버무린다.\""
msgstr "จอบที่ทำจากหิน ใช้สำหรับเพาะปลูก \"ถือกำเนิดจากดินเพื่อช่วยจัดสภาพดิน\""

msgid "돌로 만든 급조날."
msgstr "ใบมีดประดิษฐ์เองที่ทำจากหิน"

msgid "돌로 만든 급조날. \"모든 게 다시 시작이다.\""
msgstr "ใบมีดประดิษฐ์เองที่ทำจากหิน \"ที่นี่ เราเริ่มต้นทุกอย่างจากศูนย์\""

msgid "돌로 만든 도끼. \"숲을 없애다 보면 숲을 좋아하게 된다.\""
msgstr "ขวานที่ทำจากหิน \"บางครั้งคุณก็ตกหลุมรักป่าไม้ที่คุณทำลายอย่างช่วยไม่ได้\""

msgid "돌로 만든 도끼. 제작법의 수준과 맞지 않는 도끼날을 사용하여 엉성하게 조립되었다."
msgstr "ขวานที่ทำจากหิน ใบมีดขวานไร้ประสิทธิภาพถูกนำมาใช้เป็นวัตถุดิบสำหรับไอเทมนี้ ทำให้มีคุณภาพไม่ค่อยดี"

msgid "돌로 만든 도끼날. 한손 도끼 조립에 쓴다."
msgstr "หัวขวานที่ทำจากหิน ใช้สำหรับประกอบเป็นขวานมือเดียว"

msgid "돌로 만든 도끼날. 한손도끼 조립에 쓴다. \"1억 번 두드려 안 넘어가는 나무 없다.\""
msgstr "หัวขวานที่ทำจากหิน ใช้สำหรับสร้างขวานมือเดียว \"เพียงเหวี่ยงเล็กน้อยก็ล้มต้นโอ๊คใหญ่ได้\""

msgid "돌로 만든 망치. \"만들고 고칠 게 참 많다.\""
msgstr "ค้อนที่ทำจากหิน \"หยุดนะ ได้เวลาลง... ได้เวลาต้องหลีกเลี่ยงการละเมิดลิขสิทธิ์อย่างระมัดระวังแล้วละ\""

msgid "돌로 만든 망치. 제작법의 수준과 맞지 않는 망치머리를 사용하여 엉성하게 조립되었다."
msgstr "ค้อนที่ทำจากหิน หัวค้อนไร้ประสิทธิภาพถูกนำมาใช้เป็นวัตถุดิบสำหรับไอเทมนี้ ทำให้มีคุณภาพไม่ค่อยดี"

msgid "돌로 만든 망치머리. 한손망치 조립에 쓴다."
msgstr "หัวค้อนที่ทำจากหิน ใช้สำหรับประกอบเป็นค้อนมือเดียว"

msgid "돌로 만든 망치머리. 한손망치 조립에 쓴다. \"세상에 도움이 되기를.\""
msgstr "หัวค้อนที่ทำจากหิน ใช้สำหรับสร้างค้อนมือเดียว \"ใช้การเล็งแค่ส่วนเดียว 10 ส่วนที่เหลือคือแรงล้วนๆ\""

msgid "돌로 만든 못. \"누군가의 가슴에 박지는 말자.\""
msgstr "ตะปูที่ทำจากหิน \"พวกเขาขอให้ฉันทำอะไรสักอย่างเพื่อทำให้แผ่นไม้ติดกัน ตอกตะปูสิ\""

msgid "돌로 만든 바닥."
msgstr "พื้นที่สร้างจากหิน"

msgid "돌로 만든 바닥. 조립식 건축물인 벽집을 건축할 때 재료로 사용된다. \"침대와 겨울만 해결하면 완벽하다.\""
msgstr "พื้นที่สร้างจากหิน ใช้เป็นวัสดุสำหรับบ้านและค่ายทหาร ซึ่งกำลังก่อสร้างเป็นบางส่วน \"ทางเลือกที่ดีหากคุณวางแผนที่จะอยู่บนที่นอนตลอดหน้าหนาว\""

msgid "돌로 만든 벽."
msgstr "กำแพงที่สร้างจากหิน"

msgid "돌로 만든 벽. 조립식 건축물인 벽집을 건축할 때 재료로 사용된다. \"성긴 틈 사이로 오래 된 노래가 분다.\""
msgstr "กำแพงที่สร้างจากหิน ใช้เป็นวัสดุสำหรับบ้านและค่ายทหาร ซึ่งกำลังก่อสร้างเป็นบางส่วน \"เสียงเพลงโบราณแว่วออกมาระหว่างรอยแตก\""

msgid "돌로 만든 양손 도끼. \"벌목꾼들의 민요가 음악 교과서에 수록될 즈음에야 나무의 개체 수는 늘 것이다.\""
msgstr "ขวานสองมือที่ทำจากหิน \"แยกต้นไม้กับป่าไม้ไม่ออกงั้นเหรอ เดี๋ยวจัดให้...\""

msgid "돌로 만든 양손 도끼. 제작법의 수준과 맞지 않는 도끼날을 사용하여 엉성하게 조립되었다."
msgstr "ขวานสองมือที่ทำจากหิน ใบมีดขวานไร้ประสิทธิภาพถูกนำมาใช้เป็นวัตถุดิบสำหรับไอเทมนี้ ทำให้มีคุณภาพไม่ค่อยดี"

msgid "돌로 만든 양손 망치. \"세상은 나아간다.\""
msgstr "ค้อนสองมือที่ทำจากหิน \"สำหรับปูทาง\""

msgid "돌로 만든 양손 망치. 제작법의 수준과 맞지 않는 양손 망치머리를 사용하여 엉성하게 조립되었다."
msgstr "ค้อนสองมือที่ทำจากหิน หัวค้อนไร้ประสิทธิภาพถูกนำมาใช้เป็นวัตถุดิบสำหรับไอเทมนี้ ทำให้มีคุณภาพไม่ค่อยดี"

msgid "돌로 만든 양손 칼. 제작법의 수준과 맞지 않는 칼날을 사용하여 엉성하게 조립되었다."
msgstr "มีดสองมือที่ทำจากหิน ใบมีดไร้ประสิทธิภาพถูกนำมาใช้เป็นวัตถุดิบสำหรับไอเทมนี้ ทำให้มีคุณภาพไม่ค่อยดี"

msgid "돌로 만든 작업용 날."
msgstr "ใบมีดงานที่ทำจากหิน"

msgid "돌로 만든 작업용 날. \"모든 게 다시 시작이다.\""
msgstr "ใบมีดที่ทำจากหิน ใช้สำหรับทำสิ่งต่างๆ \"ที่นี่ เราเริ่มต้นทุกอย่างจากศูนย์\""

msgid "돌로 만든 창. \"길 가다 잃어 버려도 유물로 발견될 거다.\""
msgstr "หอกที่ทำจากหิน \"ถ้าพวกมนุษย์ถ้ำใช้ประโยชน์จากมันได้ คุณก็ทำได้เช่นกัน\""

msgid "돌로 만든 창날. 창 재료로 쓴다. \"훗날의 아이들이 우리 시대를 구석기 시대라 부르지 않았으면 좋겠다.\""
msgstr "หัวหอกที่ทำจากหิน ใช้เป็นวัตถุดิบสำหรับสร้างหอก \"ฉันหวังว่าคนรุ่นหลังจะไม่เรียกช่วงเวลาตอนนี้ว่าเป็นยุคหินหรอกนะ\""

msgid "돌로 만든 창날. 창 조립에 쓴다."
msgstr "หัวหอกที่ทำจากหิน ใช้เพื่อประกอบหอก"

msgid "돌로 만든 칼. \"선사 시대에 온 걸 환영한다.\""
msgstr "มีดที่ทำจากหิน \"ยินดีต้อนรับสู่ช่วงเวลายุคก่อนประวัติศาสตร์\""

msgid "돌로 만든 칼. 제작법의 수준과 맞지 않는 칼날을 사용하여 엉성하게 조립되었다."
msgstr "มีดที่ทำจากหิน ใบมีดไร้ประสิทธิภาพถูกนำมาใช้เป็นวัตถุดิบสำหรับไอเทมนี้ ทำให้มีคุณภาพไม่ค่อยดี"

msgid "돌로 만든 칼날. 한손칼 조립에 쓴다."
msgstr "ใบมีดที่ทำจากหิน ใช้สำหรับประกอบเป็นมีดมือเดียว"

msgid "돌로 만든 칼날. 한손칼 조립에 쓴다. \"칼을 처음 만든 사람은 칼에 반대했을까?\""
msgstr "ใบมีดหินสำหรับสร้างมีดมือเดียว \"เราอาจไม่มีทางรู้ได้ว่าใบมีดแรกประดิษฐ์ขึ้นเพื่อใช้ออกหาอาหารหรือเพื่อต่อสู้\""

msgid "돌로 만든 큰 급조날."
msgstr "ใบมีดประดิษฐ์เองขนาดใหญ่ที่ทำจากหิน"

msgid "돌로 만든 큰 급조날. \"아마 최초는 돌날이 작다고 클레임을 건 사람들 때문이었을 거다.\""
msgstr "ใบมีดประดิษฐ์เองขนาดใหญ่ที่ทำจากหิน \"ใครบางคนแค่ต้องมีสิ่งที่ใหญ่กว่า...\""

msgid "돌로 만든 큰 도끼날. 양손 도끼 조립에 쓴다."
msgstr "หัวขวานขนาดใหญ่ที่ทำจากหิน ใช้สำหรับประกอบเป็นขวานสองมือ"

msgid "돌로 만든 큰 도끼날. 양손도끼 조립에 쓴다. \"돌덩이가 굴러 떨어지는 날 60년대는 시작됐다.\""
msgstr "หัวขวานขนาดใหญ่ที่ทำจากหิน ใช้สำหรับสร้างขวานสองมือ \"ถ้าเล่นมุก 'ร็อคแอนด์โรล' อีกรอบเดียว ฉันสับหัวนายหลุดจากบ่าแน่ๆ\""

msgid "돌로 만든 큰 망치머리. 양손망치 조립에 쓴다."
msgstr "หัวค้อนที่ทำจากหิน ใช้สำหรับประกอบเป็นค้อนสองมือ"

msgid "돌로 만든 큰 망치머리. 양손망치 조립에 쓴다. \"뭐든 잘 때려 넣을 것 같다.\""
msgstr "หัวค้อนใหญ่ที่ทำจากหิน ใช้สำหรับสร้างค้อนสองมือ \"เหมาะสำหรับใช้เล่นเกมตีไดโนเสาร์\""

msgid "돌로 만든 큰 칼날. 양손칼 조립에 쓴다."
msgstr "ใบมีดขนาดใหญ่ที่ทำจากหิน ใช้สำหรับประกอบเป็นมีดสองมือ"

msgid "돌로 만든 큰 칼날. 양손칼 조립에 쓴다. \"빛이 나는 돌을 별이라 한다.\""
msgstr "ใบมีดขนาดใหญ่ที่ทำจากหิน ใช้สำหรับสร้างมีดสองมือ \"ด้ามไม้ หิน และอื่นๆ\""

msgid "돌로 만든 톱."
msgstr "เลื่อยที่ทำจากหิน"

msgid "돌로 만든 톱. 가공 작업에 쓴다. \"톱니가 거칠지만 켜는 데 나쁘지 않다.\""
msgstr "เลื่อยที่ทำจากหิน ใช้เพื่อแปรรูปวัตถุดิบ \"อาจจะหยาบไปหน่อยรอบคมเลื่อย แต่สามารถใช้งานได้ดี\""

msgid "돌로 만든 톱날. 톱 조립에 쓴다."
msgstr "ใบมีดที่ทำจากหิน ใช้เพื่อประกอบเลื่อย"

msgid "돌로 만든 톱날. 톱재료로 쓴다. \"켜고 켜라.\""
msgstr "ใบมีดเลื่อยที่ทำจากหิน ใช้สำหรับสร้างเลื่อย \"ไม่ต้องใช้แบตเตอรี่\""

msgid "돌로 만든 한손검"
msgstr "ดาบหินมือเดียว"

msgid "돌론"
msgstr "โดลอน"

msgid "돌리기"
msgstr "หมุน"

msgid "돌망치"
msgstr "ค้อนหิน"

msgid "돌망치머리"
msgstr "หัวค้อนหิน"

msgid "돌망치머리보다 공격력이 높은 뼈망치머리를 만들 수 있습니다."
msgstr "ทำหัวค้อนกระดูกที่มีพลังโจมตีมากกว่าหัวค้อนหิน"

msgid "돌머리 대형망치"
msgstr "ค้อนหินยักษ์"

msgid "돌머리 망치"
msgstr "ค้อนหิน"

msgid "돌멩이"
msgstr "กรวด"

msgid "돌멩이 구해주세요"
msgstr "มือใครยาว สาวได้สาวเอา"

msgid "돌멩이 채집하기"
msgstr "รวบรวมก้อนกรวด"

msgid "돌멩이 판재"
msgstr "ไม้กระดานกรวด"

msgid "돌멩이, 바위"
msgstr "กรวด หินก้อนใหญ่"

msgid "돌멩이나 바위를 지지하고 있던 돌부리. 평범하게 돌로 사용할 수 있다."
msgstr "หินขรุขระที่ครั้งหนึ่งเคยช่วยพยุงก้อนหินและหินก้อนใหญ่ ๆ ไว้ สามารถใช้เป็นหินทั่วไปได้"

msgid "돌멩이를 300번 채집하세요."
msgstr "รวบรวมรวบรวมก้อนกรวด 300 ก้อน"

msgid "돌멩이를 30번 채집하세요."
msgstr "รวบรวมรวบรวมก้อนกรวด 30 ก้อน"

msgid "돌멩이를 90번 채집하세요."
msgstr "รวบรวมรวบรวมก้อนกรวด 90 ก้อน"

msgid "돌멩이를 돌날로 새로 만들어\n도끼날의 재료로 씁니다."
msgstr "สร้างใบมีดหินเล่มใหม่จากก้อนกรวด\nเพื่อใช้สร้างขวาน"

msgid "돌멩이를 레벨별로 가져보자"
msgstr "รับก้อนกรวดทุกครั้งที่คุณเพิ่มเลเวล"

msgid "돌멩이를 이용해 돌날을 만들 수 있습니다. 자연물을 채집하거나 제작에 쓰입니다."
msgstr "ทำใบมีดหินจากก้อนกรวด ใช้เพื่อเก็บทรัพยากรธรรมชาติและทำการประดิษฐ์"

msgid "돌멩이를 채집할 수 있습니다. 돌멩이로 돌날 등 도구를 만들 수 있습니다."
msgstr "เก็บก้อนกรวด ใช้ทำเครื่องมือ เช่น ใบมีดหิน"

msgid "돌못"
msgstr "ตะปูหิน"

msgid "돌무늬"
msgstr "ลายหิน"

msgid "돌부리"
msgstr "หินขรุขระ"

msgid "돌아가면 모두에게 사과해야겠지?"
msgstr "ฉันควรขอโทษทุกคนหรือเปล่าเมื่อกลับไป?"

msgid "돌아오면 다시 무덤으로 보내고 싶을걸? 허허."
msgstr "ฉันพนันว่าถ้าเป็นแบบนั้นนะ คุณคงจะรีบส่งเขากลับลงหลุมไปเลยล่ะ ฮ่าๆ"

msgid "돌아오면 분명한 의도를 파악해야 해. 그 계집은 어릴 때부터 거짓말을 잘 했어."
msgstr "เราต้องหาเจตนาที่แท้จริงของเธอเมื่อเธอกลับมา มันคงไม่ง่าย เพราะเธอโกหกได้ยอดเยี่ยมตั้งแต่ตอนที่เป็นเด็กแล้ว..."

msgid "돌아온 개척자"
msgstr "ผู้บุกเบิกใจป้ำ"

msgid "돌을 다듬어 만든 판재. "
msgstr "แผ่นหินที่ทำจากการแกะสลักหิน"

msgid "돌을 다듬은 판재. \"돌도 참 다루기 나름이다.\""
msgstr "ทำจากหินตัดแต่ง “การทำงานกับหินเป็นสิ่งที่เพลิดเพลินใจได้อย่างแท้จริง และคุณเกิดมาเพื่อสิ่งนี้”"

msgid "돌을 쌓아서 등대를 만든다"
msgstr "กองหินที่ใช้สร้างประภาคาร"

msgid "돌을 잘 다듬은 판재. 안락도를 추가로 올릴 수 있다."
msgstr "ทำจากหินที่ตัดแต่งมาอย่างดี"

msgid "돌을 조립한 도끼. \"나무는 저항하지 않는다.\""
msgstr "ขวานที่ทำจากหิน \"ค้อนชนะกระดาษ ใช่ไหม\""

msgid "돌을 조립한 망치. \"망치가 망치는 게 뭐가 있을까?\""
msgstr "ค้อนที่ทำจากหิน \"ฉันวางหินลงบนแท่งได้ ฉันไร้เทียมทานแล้ว\""

msgid "돌을 조립한 양손 도끼. \"나무가 아무 말 않는 게, 도끼에 동의하는 건 아니다.\""
msgstr "ขวานสองมือที่ทำจากหิน \"ต้นไม้ทำอะไรไม่ได้เลยนอกจากยอมรับชะตากรรมของมันเท่านั้น\""

msgid "돌을 조립한 양손 망치. \"운석이 내리치듯이.\""
msgstr "ค้อนสองมือที่ทำจากหิน \"การเหวี่ยงค้อนแต่ละครั้งแรงเหมือนอุกกาบาตถล่ม\""

msgid "돌을 조립한 양손 칼. \"채집에만 쓸 일은 없겠지.\""
