msgid "야생 피망 종자를 채집할 수 있습니다. 해당 종자를 심고 기르는 스킬은 농사 계열에서 배울 수 있습니다."
msgstr "เก็บเมล็ดพริกหวานป่า เรียนรู้วิธีปลูกพืชพันธุ์นี้ได้จากหมวดหมู่สกิลการเพาะปลูก"

msgid "야생_양파"
msgstr "หัวหอม_ป่า"

msgid "야생사탕수수"
msgstr "อ้อยป่า"

msgid "야생시대의 끝이 도래했다."
msgstr "กำจัดความดุร้ายออกจากสัตว์ป่า"

msgid "야생에 적응했다."
msgstr "ในที่รกร้างว่างเปล่า"

msgid "야생에서 <em>종자</em>를 채집하는 스킬들도 농사법 스킬에 포함됩니다."
msgstr "สกิลที่จำเป็นในการรวบรวม<em>เมล็ด</em>จากในป่าก็รวมอยู่ในชุดสกิลการฝึกเพาะปลูกด้วยเช่นกัน"

msgid "야생에서 기름기는 귀하다."
msgstr "แหล่งน้ำมันจากผลไม้เปลือกแข็ง"

msgid "야생에서 얻은 버섯. \"배가 고프면 독버섯인지 알 바 아니다.\""
msgstr "เห็ดที่ขึ้นตามธรรมชาติ \"มันมีพิษหรือเปล่าเนี่ย ฉันรู้อย่างน้อยวิธีหนึ่งที่จะหาคำตอบ...\""

msgid "야생에서도 음식은 맛있고 재료가 좋을수록 좋습니다."
msgstr "คุณควรจะมีอาหารและวัตถุดิบติดตัว โดยเฉพาะเมื่ออยู่ในป่า"

msgid "야생에선 마초적이고 가부장적인 사회가 나타날 거라 생각했다.\n하지만 원시적이지만 다양한 가치가 공존하고 있다.\n단순히 환경이나 기술 수준만이 우리를 결정하는 것은 아니었다."
msgstr "ฉันเชื่อว่าสังคมที่ผู้ชายเป็นใหญ่ไม่จำเป็นต้องเป็นวิถีธรรมชาติเสมอไป\nแม้เราจะถูกบีบให้กลับมาอยู่ในสภาพแวดล้อมดึกดำบรรพ์ แต่เราได้พิสูจน์แล้วว่าคุณค่าที่แตกต่างกันสามารถดำรงอยู่ร่วมกันได้\nเราจะไม่ยอมถอยหลังเข้าคลองด้วยเรื่องแค่นี้หรอก"

msgid "야생에선 못 사시겠네."
msgstr "ดื่มหนักขนาดนี้จะเข้าป่าไหวได้ไง..."

msgid "야생의 단풍나무"
msgstr "ต้นเมเปิ้ลป่า"

msgid "야생의 땅 저멀리 달에서 온 달토끼 패키지!!"
msgstr "แพ็กเกจกระต่ายดวงจันทร์ที่เดินทางมาแสนไกลจากดินแดนรกร้าง!"

msgid "야생의 먹거리는 위험하지만, 요리는 위험을 없애고 반가움으로 맛을 낸다."
msgstr "การกินอาหารป่าอาจอันตรายได้เท่ากับล่าหามา แต่การปรุงจะช่วยให้อาหารป่านั้นทั้งอร่อยและปลอดภัย"

msgid "야생의 벽집"
msgstr "บ้านป่า"

msgid "야생의 벽집 {size_x}x{size_y}"
msgstr "บ้านป่า {size_x}x{size_y}"

msgid "야생의 사랑초를 15회 채집하세요."
msgstr "เก็บรวบรวมออกซาลิซป่า 15 ครั้ง"

msgid "야생의 사랑초를 300회 채집하세요."
msgstr "เก็บรวบรวมออกซาลิซป่า 300 ครั้ง"

msgid "야생의 사랑초를 90회 채집하세요."
msgstr "เก็บรวบรวมออกซาลิซป่า 90 ครั้ง"

msgid "야생의 은행나무"
msgstr "ต้นแปะก๊วยป่า"

msgid "야생장미"
msgstr "กุหลาบป่า"

msgid "야생장미 꽃"
msgstr "กุหลาบป่า"

msgid "야생장미 나뭇가지 채집하기"
msgstr "เก็บกิ่งกุหลาบป่า"

msgid "야운데"
msgstr "ยาอุนเด"

msgid "야자나무에 게가 살 거예요"
msgstr "ปูมื้อค่ำ"

msgid "야자나무에 사는 게. \"어떤 시대엔 별미지만, 어떤 시대엔 주식이다.\""
msgstr "ปูที่อาศัยอยู่บนต้นปาล์ม \"นำมาเป็นวัตถุดิบหลักในการทำอาหารอันเลิศรส\""

msgid "야자수"
msgstr "ต้นปาล์ม"

msgid "야자수 통나무"
msgstr "ท่อนไม้ต้นปาล์ม"

msgid "야자수_여름이벤트"
msgstr "ต้นปาล์ม_กิจกรรมฤดูร้อน"

msgid "야자수에서 <em>{item_0}</em>을 구할 수 있을 거예요. 쓸모가 많을 테니까 구해주셨으면 해요. 그곳에서 오는 무전들 듣고 있으면, 무법섬 얘기는 정말 지겨울 정도로 많이 듣네요."
msgstr "คุณสามารถเก็บ <em>{item_0}</em> ได้จากต้นปาล์ม ของพวกนี้มีประโยชน์ในหลาย ๆ ด้าน คุณช่วยไปหามาให้หน่อยได้ไหม? ตอนที่ฉันนั่งลงที่นี่แล้วฟังเสียงสัญญาณที่ส่งมาจากสถานที่อันห่างไกล... ฉันหวังจริง ๆ ว่าฉันจะไม่ได้ยินอะไรเลยที่เกี่ยวข้องกับเกาะแดนเถื่อน "

msgid "야즈드"
msgstr "ยาซด์"

msgid "야채"
msgstr "ผัก"

msgid "야채 국물"
msgstr "ซุปผัก"

msgid "야채 볶음면"
msgstr "บะหมี่ผัดผัก"

msgid "야채 샌드위치"
msgstr "แซนด์วิชผัก"

msgid "야채 소스"
msgstr "ซอสผัก"

msgid "야채 소스로 만든 양념을 얹은 치킨. \"내가 먹을 수 없다면 혁명이 아니다.\""
msgstr "ไก่ปรุงรสด้วยซอสผัก \"คุณพูดว่า ‘มันมีรสชาติเหมือนไก่’ ราวกับว่าไก่เป็นสิ่งไม่ดี\""

msgid "야채 소스에 볶아 고명을 얹은 면. \"누군가 건강 문제를 얘기해서 만들어졌다.\""
msgstr "เส้นบะหมี่ผัดซอสผักพร้อมเครื่องเคียงโรยหน้า \"ผักบางชนิดทำให้อาหารดูสุขภาพดีใช่ไหม\""

msgid "야채 소스에 볶은 면. \"불맛만큼 확고한 맛도 없을 거다.\""
msgstr "ทำจากเส้นบะหมี่ผัดกับซอสผัก \"พูดจริง ๆ นะ ใครบ้างที่ไม่ชอบเส้นบะหมี่\""

msgid "야채 육수"
msgstr "น้ำซุปผัก"

msgid "야채 주스"
msgstr "น้ำผัก"

msgid "야채 피자"
msgstr "พิซซ่าผัก"

msgid "야채 피자 (조각)"
msgstr "พิซซ่าผัก (ชิ้น)"

msgid "야채 피자의 조각. \"시로 쓰면 밀밭 위로 젖소가 거닐고 여러 풀잎이 피었다.\""
msgstr "พิซซ่าแบ่งชิ้นโรยหน้าด้วยผัก \"ทำไมถึงต้องเหลือแต่หน้านี้เป็นชิ้นสุดท้ายทุกทีเลยน่ะ\""

msgid "야채, 과일"
msgstr "ผัก, ผลไม้"

msgid "야채로 만든 주스. \"들판이 목구멍으로 흐른다.\""
msgstr "น้ำที่ทำจากผัก \"เหมือนมีสวนผักในคอหอยของคุณ\""

msgid "야채로 우린 국물. \"강물에 야채를 던지는 것보단 진하다.\""
msgstr "ทำโดยการเคี่ยวผักต่างๆ \"อย่างน้อยก็อร่อยกว่าน้ำในลำธารแน่ๆ ล่ะ\""

msgid "야채를 넣은 샌드위치. \"의사가 추천할 것 같다.\""
msgstr "แซนด์วิชไส้ผัก \"หมอโรคหัวใจของคุณจะขอบคุณ ถ้าเธออยู่ที่นี่ละก็นะ\""

msgid "야채를 얹은"
msgstr "ราดหน้าผัก"

msgid "야채를 얹은 볶음면. \"아무리 힘들더라도 입의 즐거움을 포기하지 말자.\""
msgstr "บะหมี่ผัดกับผัก \"อาหารจานนี้จะทำให้คุณเชื่อว่าการเป็นมังสวิรัตินั้นไม่ได้แย่มาก\""

msgid "야채를 채운 빵. \"늘 이런 정원을 갖고 싶었어.\""
msgstr "ขนมปังที่ยัดไส้ผัก \"สิ่งนี้ถือเป็นสลัดใช่ไหม\""

msgid "야채빵"
msgstr "ขนมปังยัดไส้ผัก"

msgid "야채와 과일을 버무린 샐러드."
msgstr "สลัดผักและผลไม้"

msgid "야콥스타드"
msgstr "เจคอบสตัด"

msgid "약"
msgstr "ยา"

msgid "약 먹이기"
msgstr "ให้ยา"

msgid "약 작업대를 만들 수 있습니다. 약 제조대에서는 약을 제조할 수 있습니다."
msgstr "สร้างโต๊ะปรุงยา ใช้เพื่อปรุงยาที่ห้องทดลองยา"

msgid "약 정보"
msgstr "ข้อมูลยา"

msgid "약 제조"
msgstr "ยา"

msgid "약 제조대"
msgstr "ห้องทดลองทางการแพทย์"

msgid "약 제조대 Ⅱ"
msgstr "ห้องทดลองทางการแพทย์ 2"

msgid "약간 걸리는 게 있는데. <em>그 건</em>은 내가 알아볼게."
msgstr "พูดตามตรง ฉันก็เป็นห่วงอยู่เหมือนกัน ยังบอกไม่ได้ว่าทำไม แต่... ปล่อยให้ฉันจัดการเรื่อง<em>ปัญหานั้น</em>เองเถอะ"

msgid "약간 비린 맛이 올라오는 느낌이다."
msgstr "รสชาติเหมือนปลานิดหน่อย"

msgid "약간 신 맛이 난다."
msgstr "เปรี้ยวไปหน่อยสำหรับฉัน"

msgid "약간 실수해서 채집물에 손상이 생겼습니다."
msgstr "คุณได้พลาดเล็กน้อย ส่งผลให้วัสดุเสียหายนิดหน่อย"

msgid "약간 쌉싸래한 맛이 난다."
msgstr "ออกจะขมหน่อยๆ"

msgid "약간 짭짤하다."
msgstr "เค็มไปหน่อย"

msgid "약간의 고기 맛이 느껴지는 듯하다."
msgstr "ฉันว่ามันเข้าข่ายเป็นเนื้อสัตว์ได้นะ"

msgid "약간의 고소함이 느껴진다."
msgstr "รสอร่อย"

msgid "약과 독은 정도의 차이라던데, 택배상자에서 꺼내서 읽어 본 식물도감은 듀랑고랑 잘 안 맞더군요. <em>{item_0}</em>를 약용으로 쓸 수 있는데 구해다 줄래요? 해안가에 있는 <em>{item_1}</em>나 내륙의 <em>{item_2}</em>이 좋겠네요."
msgstr "เขาว่ากันว่ายารักษาโรคกับยาพิษนั้นต่างกันแค่เส้นยาแดงผ่าแปด เรามีตำราพฤกษศาสตร์ที่บอกความแตกต่างได้ ถึงแม้จะไม่มีข้อมูลพรรณพืชทุกชนิดของ Durango ก็ตาม คุณช่วยรวบรวม <em>{item_0}</em> มาให้ฉันหน่อยได้ไหม สามารถนำมาใช้เป็นยารักษาโรคได้ <em>{item_1}</em> บนชายหาดหรือ <em>{item_2}</em> ที่อยู่ห่างจากชายฝั่งน่าจะไม่เป็นไร"

msgid "약국"
msgstr "ร้านขายยา"

msgid "약물"
msgstr "ยา"

msgid "약속하지. 적어도 나랑 내 친구들은 징병관 노릇은 하지 않을 거야."
msgstr "ฟังนะ ฉันให้สัญญา ฉันและคนอื่น ๆ จะไม่สรรหาคนใหม่มาเพิ่มอีกแล้ว"

msgid "약으로 쓰는 알보팔. \"작은 고통은 큰 고통을 피하는 대가이다.\""
msgstr "ยาสำหรับอาการบาดเจ็บ \"ไม่เจ็บตัวก็ไม่ต้องใช้ยานี้ เมื่อไม่เจ็บก็ไม่ต้องจำ\""

msgid "약으로 쓰는 일반 환약. \"고통과 두려움은 같이 찾아온다.\""
msgstr "เม็ดยา \"ความเจ็บปวดและความกลัวเป็นของคู่กัน้\""

msgid "약으로 쓰는 진통제. \"고통과 두려움은 같이 찾아온다.\""
msgstr "ยาแก้ปวดที่ใช้เป็นยา \"ความเจ็บปวดและความกลัวเป็นของคู่กัน\""

msgid "약으로 쓰는 허브차. \"작은 고통은 큰 고통을 피하는 대가이다.\""
msgstr "ชาสมุนไพรใช้เป็นยา \"หวานเป็นลม ขมเป็นยา\""

msgid "약은 여러 종류가 있습니다. 전투에 참여하는 <em>동물</em>을 회복하는 약, 중독을 해독하는 약 등 다양합니다."
msgstr "มียาหลายชนิดเพื่อรองรับจุดประสงค์การใช้งานที่หลากหลาย บางชนิดใช้รักษา<em>สัตว์</em>ที่ได้รับบาดเจ็บจากการต่อสู้ ในขณะที่บางแบบอาจช่วยขจัดการติดยา"

msgid "약을 전문적으로 보관할 수 있는 상자. <em>약</em> 속성을 지닌 아이템을 보관하면 해당 아이템의 <em>내구도가 천천히 감소</em>한다."
msgstr "กล่องเก็บยา ไอเทมที่มีคุณสมบัติ<em>ยา</em><em>จะลดการเสื่อมสภาพของค่าทนทานลงได้</em> เมื่อจัดเก็บไว้ภายใน"

msgid "약재"
msgstr "วัตถุดิบปรุงยา"

msgid "약재 부탁해요"
msgstr "สุขภาพดี"

msgid "약재가 부족하네요. 그 섬에 일어난 워프가 보통 크기는 아니었나봐요. 제가 못 간 게 정말 죄송스러워요. 약재를 현지에서 직접 구해야 해요. <em>{item_0}</em>이 있으면 문제 해결에 도움이 될 거예요."
msgstr "ดูเหมือนว่าวาร์ปบนเกาะนั้นมีขนาดใหญ่กว่าปกติ และตอนนี้เราขาดแคลนยา ฉันอยากไปด้วยตัวเองนะ... โอเค ฉันคร่ำครวญมากพอแล้ว คุณต้องรวบรวมยามายังสถานที่ เริ่มต้นโดยการเก็บ <em>{item_0}</em> แต่ต้องทำให้ทื่อก่อน"

msgid "약재로 쓸 뿌리가"
msgstr "รากสมุนไพรรักษาโรค"

msgid "약재로 쓸 수 있게 <em>{item_0}</em>을 구해둬야겠어요. 무전 들으니 그 섬 캠프에 재고가 별로 없는 것 같아서요. 툰드라에서 꽃 구하는 게 쉬운 일은 아니겠지만, 찾아보면 <em>{item_1}</em>라도 은근히 있을 거예요. 당신이 어려운 일을 잘 해주니까 나도 점점 염치가 없어지나봐요. 미안해요."
msgstr "ฉันควรจะมี <em>{item_0}</em> ในมือเพื่อใช้ทำยา ฉันได้ยินจากการส่งสัญญาณว่าที่ค่ายเริ่มที่จะทำงานลดลง ไม่ใช่เรื่องง่ายที่จะค้นพบดอกไม้ในเขตหนาว แต่ก็ไม่ใช่ว่าจะเป็นไปไม่ได้ ดูอย่างใกล้ชิดและคุณควรจะพบกับ <em>{item_1}</em> ขอโทษที่รบกวนคุณ แต่คุณทำให้งานที่ยากที่สุดดูง่ายเสมอมา"

msgid "약재를 모아주세요"
