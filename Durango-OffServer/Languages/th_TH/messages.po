msgid "{category}-{id} 연구"
msgstr "{category}-วิจัย {id}"

msgid "{clan_name} 부족의 문양이 변경됨. 변경한 플레이어: {player}"
msgstr "เปลี่ยนการออกแบบแคลน {clan_name} แล้ว เปลี่ยนโดย: {player}"

msgid "{clan_name} 부족이 {target_clan_name} 부족과의 동맹을 파기. 동맹 파기 플레이어: {player_name}, 상호 동의: {agreed}"
msgstr "แคลน {clan_name} ยกเลิกการเป็นพันธมิตรของตัวเองกับแคลน {target_clan_name} แล้ว ยกเลิกโดย: {player_name} ข้อตกลงร่วมกัน: {agreed}"

msgid "{clan_name} 부족이 {target_clan_name} 부족에게 동맹 제안. 동맹 제안 플레이어: {player_name}"
msgstr "แคลน {clan_name} ส่งคำขอเป็นพันธมิตรไปที่แคลน {target_clan_name} แล้ว ส่งคำขอโดย: {player_name}"

msgid "{clan_name} 부족이 {target_clan_name} 부족에게 동맹 파기를 제안. 파기 제안 플레이어: {player_name}"
msgstr "แคลน {clan_name} ส่งคำขอยกเลิกความสัมพันธ์กับแคลน {target_clan_name} แล้ว ส่งคำขอโดย: {player_name}"

msgid "{clan_name} 부족이 {target_clan_name} 부족의 동맹 제안을 수락. 제안 수락 플레이어: {player_name}"
msgstr "แคลน {clan_name} ยอมรับคำขอเป็นพันธมิตรของแคลน {target_clan_name} แล้ว ยอมรับโดย: {player_name}"

msgid "{clan_name}({clan_id}) 부족 레벨 {clan_level} 달성. 멤버: {member_infos}"
msgstr "แคลน {clan_name} ({clan_id}) ได้เพิ่มเป็นเลเวล {clan_level} สมาชิก: {member_infos}"

msgid "{clan_name}({clan_id}) 부족에서 {player_name} 님이 등급을 변경. 변경 전: ({before_roles}), 변경 후: ({new_roles})"
msgstr "{player_name} จากแคลน {clan_name} ({clan_id}) มีการเปลี่ยนแปลงอันดับ อันดับก่อนหน้า: ({before_roles}) อันดับใหม่: ({new_roles})"

msgid "{clan_name}({clan_id}) 부족에서 {setter_name} 님이 {player_name} 님의 등급을 {prev_role} 에서 {role}으로 변경"
msgstr "{setter_name} จากแคลน {clan_name} ({clan_id}) เปลี่ยนอันดับของ {player_name} จาก {prev_role} เป็น {role}"

msgid "{clan_name}({clan_id}) 부족이 {entity_region_name} 섬 {tile}에 위치한 {entity_name} 점령 시도. 점령 시도자: {player_name}"
msgstr "แคลน {clan_name} ({clan_id}) พยายามยึด {entity_name} บน {tile} ของเกาะ {entity_region_name} ดำเนินการโดย: {player_name}"

msgid "{clan_name}({clan_id}) 부족이 {entity_region_name} 섬 {tile}에 위치한 {entity_name} 점령. 방어 부족: {prev_occupied_name}, 방어 기간: {prev_defense_counts} 회차, 점령 시도자: {player_name}"
msgstr "แคลน {clan_name} ({clan_id}) ได้ยึด {entity_name} ใน {tile} ของเกาะ {entity_region_name} แคลนที่ป้องกัน: {prev_occupied_name} ระยะเวลาการป้องกัน: {prev_defense_counts} เทิร์น ดำเนินการโดย: {player_name}"

