msgstr "เซจ"

msgid "생 간"
msgstr "ตับดิบ"

msgid "생 간 10회 도축하기"
msgstr "แล่ตับดิบ 10 ครั้ง"

msgid "생 간 1회 도축하기"
msgstr "แล่ตับดิบ 1 ครั้ง"

