msgid "내가 하는 일 알잖아요. 외부에서 활동하는 사람들과 연락하고 일 기획해요. 활동은 시위 같은 거고요."
msgstr "คุณอาจอยากรู้ว่าฉันทำอะไร ง่ายๆ เลย ฉันติดต่อกับสมาชิกของเรานอกองค์กรและประสานงานกิจกรรมต่างๆ กิจกรรมส่วนใหญ่ก็อย่างเช่น การประท้วง"

msgid "내가 하는 일이 뭔지 알아? 그 뭐 같은 워프에 휘말려 온 사람들 잡아다가 무법섬에다가 파는 거야. 너나 내가 여기 처음 왔을 때처럼 넋이 빠져서, 전화기만 붙잡고 있는 사람들 말이야. 뭐 그 사람들 애기들 같지. 착한 사람도 있을 거고, 나쁜 사람도 있을 거고. 여러 사람 있을 거야."
msgstr "คุณรู้ไหมว่าจริง ๆ แล้วฉันทำอะไร ไม่ใช่การทำฟาร์มหรอก ฉันจับตัวผู้คนจากวาร์ปที่เข้ามาเกยตื้นที่เกาะ แล้วขายให้กองทัพต่าง ๆ บนเกาะแดนเถื่อน ใช่แล้ว ฉันจับคนที่เป็นเหมือนกับฉัน คนที่สับสน โดดเดี่ยว หวาดกลัว... อย่างเช่นเด็ก ๆ จะดีหรือเลว... มันก็ไม่ต่างกัน"

msgid "내가 한 행동은 절대로 옹호받을 수도 없고, 용서받을 수도 없는 일이다. 난 회사를 떠나겠다."
msgstr "กระทำของฉันไม่สามารถแก้ต่างหรือให้อภัยได้... ซึ่งฉันก็เข้าใจดี ดังนั้น ฉันขอลาออกจากคอมปะนีโดยให้มีผลในทันที"

msgid "내가 확실하게 항의해주마. 그러지 못 하도록 말이야."
msgstr "ฉันจะหยุดพวกนั้นเอง พวกเขาจะมาทำแบบนั้นไม่ได้อีกแล้ว"

msgid "내가 회사 사람들이 어떤 합의 때문에 이렇게 행동하는 건지 다 알 순 없지만 말이야."
msgstr "ฉันไม่รู้ทำไมพวกคุณทุกคนแสดงท่าทีแบบนี้..."

msgid "내구가 강한 건물"
msgstr "สิ่งปลูกสร้างที่มีระดับค่าทนทานสูง"

msgid "내구가 강함"
msgstr "ระดับค่าทนทานสูง"

msgid "내구가 약한 건물"
msgstr "สิ่งปลูกสร้างที่มีระดับค่าทนทานต่ำ"

msgid "내구가 약함"
msgstr "ระดับค่าทนทานต่ำ"

msgid "내구도"
msgstr "ค่าทนทาน"

msgid "내구도 0이 되면 사라집니다."
msgstr "โดยจะหายไปเมื่อความทนทานเหลือ 0"

msgid "내구도 {durability}"
msgstr "ความทนทาน {durability}"

msgid "내구도 감소"
msgstr "ดีบัฟค่าทนทาน"

msgid "내구도 감소 완화 정도"
msgstr "ระดับของการลดค่าทนทาน"

msgid "내구도 수정"
msgstr "แก้ไขความทนทาน"

msgid "내구도 안내"
msgstr "คำแนะนำเรื่องความทนทาน"

msgid "내구도 정렬"
msgstr "เรียงตามค่าทนทาน"

msgid "내구도 증가"
msgstr "บัฟค่าทนทาน"

msgid "내구도 테스트 (30초)"
msgstr "การทดสอบค่าทนทาน (30 วินาที)"

msgid "내구도 테스트 (60초)"
msgstr "การทดสอบค่าทนทาน (60 วินาที)"

msgid "내구도가 0이 되어 사용할 수 없습니다. 대부분의 아이템은 수리키트나 워프젬으로 <em>수리</em>하면 다시 사용할 수 있습니다."
msgstr "ความทนทานเป็น 0 ไม่สามารถใช้งานได้ คุณสามารถ<em>ซ่อมแซม</em>ไอเท็มส่วนใหญ่ได้โดยใช้ชุดซ่อมหรือเพชรวาร์ป"

msgid "내구도가 0이 된 장비는 수리키트를 사용해서 수리할 수 있습니다.\n단, 수리 시 최대 내구도가 감소됩니다."
msgstr "สามารถซ่อมอุปกรณ์ที่ไม่เหลือค่าทนทานได้โดยใช้เครื่องมือซ่อม \nอย่างไรก็ตาม การซ่อมจะลดค่าทนทานสูงสุดของมัน"

msgid "내구도가 1보다 적게 남은 건축물은 포장할 수 없습니다."
msgstr "ไม่สามารถบรรจุสิ่งก่อสร้างที่มีความทนทานน้อยกว่า 1 ได้"

msgid "내구도가 {0:P0} 미만인 아이템은 등록할 수 없습니다"
msgstr "ไม่สามารถตั้งขายไอเทมเมื่อค่าทนทานต่ำกว่า {0:P0}"

msgid "내구도가 {lower_bound:p0} 미만인 아이템은 장터에 등록할 수 없습니다."
msgstr "ไอเทมที่มีค่าทนทาน {lower_bound:p0} หรือต่ำกว่า ไม่สามารถตั้งขายเพื่อขายที่ตลาดได้"

msgid "내구도가 감소합니다."
msgstr "ลดความทนทาน"

msgid "내구도가 높아 작업에 사용하기에 좋은 작업칼. \"양심은 옳고 그름이 아닌 자신을 향한 존중이다.\""
msgstr "มีดทำงานแข็งแรงที่เหมาะกับงานฝีมือ “เคารพคนตายด้วยการมอบงานให้ทำ\""

msgid "내구도가 높아 흙을 푸는데 좋은 삽. \"굴착기의 원형은 여기서 나왔다.\""
msgstr "พลั่วที่แข็งแรงใช้สำหรับการพรวนดิน “เครื่องมือขุดดั้งเดิม\""

msgid "내구도가 높은 도끼. \"나무 입장에선 사람을 베는 게 더 좋을 지도 모른다.\""
msgstr "ขวานแข็งแรง \"ถ้าถึงตาพวกต้นไม้นั่นได้ทีบ้าง พวกเราเองก็คงโดนตัดจนเหี้ยน\""

msgid "내구도가 다 된 건축물은 까만색으로 표시되며 이용할 수 없습니다.\n수리하거나 새로 지어주세요."
msgstr "สิ่งก่อสร้างที่ไม่มีค่าทนทานถูกทำสัญลักษณ์เป็นสีดำและไม่สามารถใช้ได้ \nซ่อมแซมหรือสร้างอันใหม่"

msgid "내구도가 다 된 아이템은 전송할 수 없습니다."
msgstr "ไม่สามารถโอนไอเทมที่ไม่มีค่าทนทานได้"

msgid "내구도가 다 된 아이템입니다."
msgstr "ค่าทนทานไอเทมหมดแล้ว"

msgid "내구도가 더 낮아야 수리할 수 있습니다."
msgstr "ค่าทนทานของไอเทมต้องลดลงต่ำกว่านี้จึงจะซ่อมได้"

msgid "내구도가 비율로 감소합니다."
msgstr "ลดความทนทานตามเปอร์เซ็นต์ที่กำหนดไว้"

msgid "내구도가 비율로 증가합니다."
msgstr "เพิ่มความทนทานตามเปอร์เซ็นต์ที่กำหนดไว้"

msgid "내구도가 있는 건축물은 사용/착용 여부와 상관없이 시간이 지나면 내구도가 줄어듭니다."
msgstr "ค่าทนทานของอาคารที่มีค่าทนทานจะลดลงเมื่อเวลาผ่านไป ไม่ว่าจะมีการใช้งาน/เรียกใช้หรือไม่ก็ตาม"

msgid "내구도가 있는 아이템은 사용/착용 여부와 상관없이 시간이 지나면 내구도가 줄어듭니다."
msgstr "ค่าทนทานของไอเทมที่มีค่าทนทานจะลดลงเมื่อเวลาผ่านไป ไม่ว่าจะมีการใช้งาน/เรียกใช้หรือไม่ก็ตาม"

msgid "내구도가 있는 아이템은 사용/착용 여부와 상관없이 시간이 지나면 내구도가 줄어듭니다.  캐릭터 착용 레벨에 따라 아이템 능력치가 적용됩니다."
msgstr "ค่าทนทานของไอเทมที่มีค่าทนทานจะลดลงเมื่อเวลาผ่านไป ไม่ว่าจะมีการใช้งาน/เรียกใช้หรือไม่ก็ตาม นำสถิติไอเทมมาใช้ตามเลเวลการเรียกใช้ของตัวละคร"

msgid "내구도가 있는 아이템은 사용/착용 여부와 상관없이 시간이 지나면 내구도가 줄어듭니다. 캐릭터 착용 레벨에 따라 아이템 능력치가 적용됩니다."
msgstr "ค่าทนทานของไอเทมที่มีค่าทนทานจะลดลงเมื่อเวลาผ่านไป ไม่ว่าจะมีการใช้งาน/เรียกใช้หรือไม่ก็ตาม สถิติที่ของไอเทมจะนำมาใช้ตามเลเวลของตัวละครที่สวมใส่ไอเทมดังกล่าว"

msgid "내구도가 증가합니다."
msgstr "เพิ่มความทนทาน"

msgid "내구도와 수리"
msgstr "ค่าทนทานและการซ่อม"

msgid "내리기"
msgstr "ลง"

msgid "내릴 수 없는 곳입니다."
msgstr "คุณไม่สามารถลงจอดที่นี่ได้"

msgid "내부 기록"
msgstr "บันทึกภายใน"

msgid "내부 꾸미기"
msgstr "ตกแต่งภายใน"

msgid "내부 분위기가 정말 이상해요. 얼마 전까지 리우 선생을 그렇게 다들 비판하고 그랬는데 지금은 딴판입니다."
msgstr "บรรยากาศแบบนี้มันแปลกมาก... ก่อนหน้านี้ทุกคนต่างโทษหลิว แต่ตอนนี้ทุกอย่างเปลี่ยนไปหมด"

msgid "내부 요원이 아니라면 상당한 희생을 감당해야 할 겁니다. 일용직들은 버티지 못 할 거예요."
msgstr "แน่นอนว่ามันต้องเสียสละครั้งใหญ่กันหน่อย พวกเราข้างล่างไม่น่าจะรับมือไหว"

msgid "내부 테스트용 상태효과"
msgstr "เอฟเฟกต์สถานะสำหรับการทดสอบภายใน"

msgid "내부를 수리했으니 여기 넣어두면 <em>전달</em>이 될거에요."
msgstr "โอเค เราควรลงมือกันได้เลย! แก้ไขด้านในแล้วก็พร้อมสำหรับการ<em>จัดส่ง</em>แล้ว!"

msgid "내부에서 건수만 생기면 곧 활성화되겠군. 그 둘이 조직 장악력이 있는 편인가?"
msgstr "ฉันพนันว่าพวกนั้นจะต้องลงมือแน่ถ้ามีโอกาส พวกนั้นมีอำนาจแค่ไหนในองค์กรนะ?"

msgid "내슈빌"
msgstr "แนชวิลล์"

msgid "내심 땅에 고인 항공유에 공룡이 발을 담그는 순간\n타임 패러독스로 워프가 발생할 거라고 기대했지만 아니더군요.\n– 신비주의 성향 워프 추적자"
msgstr "ฉันหวังว่าความผิดปกติของเวลาอาจทำให้วาร์ปเปิดออกในตอนที่ฉันเห็นรอยเท้าของทีเร็กซ์ในหลุมเชื้อเพลิงอากาศยาน\nแต่ฉันคิดว่ามันไม่ได้เป็นไปแบบนั้น\n– ผู้ไล่ตามวาร์ปที่ไม่ได้รับการยอมรับ"

msgid "내역"
msgstr "ประวัติ"

msgid "내용"
msgstr "เนื้อหา"

msgid "내용 확인"
msgstr "ยอมรับ"

msgid "내용물"
msgstr "ไส้อาหาร"

msgid "내용물 가져오기"
msgstr "นำสิ่งของที่จัดเก็บออกมา"

msgid "내용물 꺼내기"
msgstr "ลบเนื้อหา"

msgid "내용물 보기"
msgstr "ดู"

msgid "내용물 확인"
msgstr "ตรวจสอบรางวัล"

msgid "내용물을 넣은 빵"
msgstr "ขนมปังยัดไส้"

msgid "내용물을 넣은 빵 제작법으로 10번 제작하세요."
msgstr "สร้างโดยใช้รูปแบบขนมปังยัดไส้ 10 ครั้ง"

msgid "내용물을 넣은 빵. 재료에 따라 효과가 달라진다."
msgstr "ขนมปังยัดไส้ต่าง ๆ ผลที่ได้จะแตกต่างกันไปตามส่วนผสม"

msgid "내용물을 넣은 빵을 만들 수 있습니다. 먹으면 의지가 올라갑니다. 내용물을 넣어 추가 효과를 낼 수 있습니다."
msgstr "ทำขนมปังยัดไส้ กินเพื่อเพิ่มความมุ่งมั่น ใส่ไส้เพื่อเพิ่มเอฟเฟ็กต์"

msgid "내용물이 있는 건축물 입니다."
msgstr "สิ่งก่อสร้างนี้จัดเก็บสิ่งของบางอย่างไว้"

msgid "내용은 관심 없어. 돈 받을 데 몇 군데 떼주면, 바로 연결해줄게."
msgstr "ฉันไม่สนหรอกว่ามันเรื่องอะไร ตราบใดที่คุณแบ่งเงินบางส่วนไว้ เดี๋ยวฉันจัดการให้เอง"

msgid "내용은 여전히 1865년에 사라진 거랑 별 차이는 없어."
msgstr "ถ้าเขาทำแบบนี้ต่อไป เราได้เป็นต้นเหตุของสงครามกลางเมืองแน่"

msgid "내용을 접수하지 못했습니다. 통신 상태를 확인해 주세요."
msgstr "ไม่สามารถรับรายงานได้ โปรดตรวจสอบการเชื่อมต่อของคุณ"

msgid "내장"
msgstr "ไส้"

msgid "내장을 꺼내오렴"
msgstr "ความรู้สึกข้างใน"

msgid "내장을 채집할 수 있습니다. 내장은 고기로 먹을 수도 있고, 소시지 재료로 쓰거나 육식 동물의 사료로 쓸 수 있습니다."
msgstr "เก็บลำไส้ จะใช้กินแทนเนื้อ หรือใช้เป็นวัตถุดิบทำไส้กรอกและอาหารสัตว์กินเนื้อได้"

msgid "내집 마련의 시작 1"
msgstr "บ้านในฝันแห่ง Durango 1"

msgid "내집 마련의 시작 2"
msgstr "บ้านในฝันแห่ง Durango 2"

msgid "내집 마련의 시작 3"
msgstr "บ้านในฝันแห่ง Durango 3"

msgid "내집 마련의 시작 4"
msgstr "บ้านในฝันแห่ง Durango 4"

msgid "내집 마련의 시작 5"
msgstr "บ้านในฝันแห่ง Durango 5"

msgid "내출혈"
msgstr "อาการเลือดตกใน"

msgid "내출혈 예방"
msgstr "ป้องกันอาการเลือดตกใน"

msgid "내출혈 예방 재료"
msgstr "วัตถุดิบป้องกันอาการเลือดตกใน"

msgid "내출혈 예방약"
msgstr "ยาป้องกันอาการเลือดตกใน"

msgid "내출혈 치료"
msgstr "รักษาอาการเลือดตกใน"

msgid "내출혈이 회복되었다."
msgstr "ช่วยฟื้นฟูอาการเลือดตกใน"

msgid "내키진 않지만 그 소위 <em>{item_0}</em>에 맞춰줘야 할 때도 있습니다. 그 섬에 <em>{item_1}</em>가 채집해도 환경에 해가 안 될 거란 게 무영향 운동가들의 생각이고요. 포럼엔 제가 동의하지 않더라도 이뤄지는 일이 있습니다."
msgstr "เราไม่ต้องการทำเช่นนั้น แต่มีบางครั้งที่เราต้องปรับตัวให้เข้ากับ <em>{item_0}</em> ตามที่คนอื่นเรียกกัน นักกิจกรรมที่ไม่สร้างผลกระทบเชื่อว่าการรวบรวม <em>{item_1}</em> จากเกาะจะไม่มีผลเชิงลบต่อสิ่งแวดล้อม บางครั้งเราต้องตัดสินใจอย่างยากลำบากถึงแม้ที่ประชุมยังไม่ได้ข้อสรุป"

msgid "냄비"
msgstr "หม้อ"

msgid "냄비가 필요해요"
msgstr "อาหารว่างที่บ้าน"

msgid "냄새 제거"
msgstr "กำจัดกลิ่น"

msgid "냉장고"
msgstr "ตู้เย็น"

msgid "냉정한 용암 파괴자 I"
msgstr "นักทำลายล้างลาวาที่แสนใจเย็น 1"

msgid "냉정한 용암 파괴자 II"
msgstr "นักทำลายล้างลาวาที่แสนใจเย็น 2"

msgid "냉정한 용암 파괴자 III"
msgstr "นักทำลายล้างลาวาที่แสนใจเย็น 3"

msgid "냉정한 용암 파괴자 IV"
msgstr "นักทำลายล้างลาวาที่แสนใจเย็น 4"

msgid "냉정한 용암 파괴자 V"
msgstr "นักทำลายล้างลาวาที่แสนใจเย็น 5"

msgid "냉탕에 몸을 담그면 화산의 열기에 대한 저항이 증가합니다. 해당 효과는 1시간 동안 지속되며, 3시간마다 이용할 수 있습니다."
msgstr "แช่ตัวในสระน้ำเย็นนี้เพื่อเพิ่มความต้านทานกระแสความร้อนของคุณต่อความร้อนจากภูเขาไฟ เอฟเฟกต์จะคงอยู่ได้นาน 1 ชั่วโมง และสามารถใช้งานได้ทุกๆ 3 ชั่วโมง"

msgid "냉탕의 효과로 화산의 열기를 더 잘 견딜 수 있다."
msgstr "ผ่อนคลายในสระน้ำเพื่อคลายความร้อนจากภูเขาไฟ"

msgid "냐짱"
msgstr "นาตรัง"

msgid "너 내 동료가 되라."
msgstr "มาร่วมทีมกันเถอะ!"

msgid "너 때문에 삶이란 게 더 이상하고 신비로워 보인다."
msgstr "เราคิดว่านี่เป็นวิธีเดียวที่จะจัดการที่แห่งนี้ได้... แค่ค้นหาตัวเองให้เจอ คุณเข้าใจใช่ไหม ฉันเดาว่ามีอะไรมากกว่านั้น"

msgid "너 아니더라도 날 미치게 할 인간들 많아. 입 닥치고 있어."
msgstr "มีคนทำให้ฉันประสาทเสียพออยู่แล้ว"

msgid "너 은근히 사람 괴롭히는 걸 즐기는구나. 토끼발도 알고 있었어?"
msgstr "คุณมีความสามารถพิเศษในการสร้างความน่ารำคาญใช่ไหม เคย์ ตีนกระต่าย ฉันคงต้องพูดแล้วล่ะว่า คุณเป็นคนที่อดทนมากกว่าที่ฉันคิดไว้"

msgid "너 이 돌멩이를 사라 (테스트)"
msgstr "ก้อนกรวดในความคิดของคุณ (ทดสอบ)"

msgid "너 자신이 백날 떳떳하다고 생각해도 그 생각을 남에게 효과적으로 전하지 않으면 의미가 없어."
msgstr "คุณอาจเชื่อว่าตัวเองเป็นคนดีมีเกียรติ แต่มันจะไม่มีความหมายเลยถ้าคนอื่นๆ ไม่คิดแบบนั้น"

msgid "너나 나나 발 묶여 있잖아. 지금 확인하러 갈 수 있는 사람이……"
msgstr "ฉันไม่สามารถทำอะไรได้เลย คนเดียวเท่านั้นที่สามารถไปได้คือ..."

msgid "너는 그저 아무 것도 모르고 기차를 탔다가, 스쿱에 휘말려 이곳에 왔을 뿐이야."
msgstr "รถไฟที่คุณนั่งมาโดน \"ช้อน\"ไว้โดยไม่ตั้งใจจนมาถึงที่นี่"

msgid "너는 말은 없지만, 할 일은 다 하더구나."
msgstr "คุณไม่พูดมาก แต่คุณทำทุกอย่างที่ต้องทำ"

msgid "너는 부족의 살림을 담당하는 인간인데 어떻게 그럴 수가 있냐? 실망했다. 부족장이 그렇게 말했지. 얼굴 낯짝이 대기권보다 두터웠어. 어떤 인공위성도 나사 조각 하나 안 남길 기세였지. 내가 그 동안 모은 서류를 보여주니까 술만 더 마셨지."
msgstr "“คุณทำอย่างนั้นได้ยังไง คุณควรคำนึงถึงความเป็นอยู่ที่ดีของแคลนก่อนเป็นอันดับแรก! ฉันผิดหวังจริง ๆ...” นี่คือสิ่งที่เสนาธิการพูด โดยไม่มีวี่แววของความละอายใจเลย เฮ้... ฉันพนันเลยว่าคุณสามารถจับเขามาเปลือยกายแสดงต่อหน้าผู้ชมโดยผูกเชือกร้อยรอบคอของเขา โดยที่เขาจะไม่พยายามปิดบังร่างกายตัวเองเลย! ฉันเอาเอกสารทั้งหมดเกี่ยวกับเรื่องนี้ที่เก็บรวบรวมมาให้เขาดู... ทุกสิ่งที่เขาทำได้ก็คือนั่งอยู่ตรงนั้นและดื่มเหล้า"

msgid "너는 사실 아무 것도 아니야. X는 알아."
msgstr "คุณไม่รู้อะไรเลยเอ๊กซ์ รู้ทุกอย่าง"

msgid "너는 잘 해주었다. K 역시 네가 아니었다면 아무 것도 하지 못 했을 것이니 사실 더 큰 공로는 너에게 있다."
msgstr "อา เด็กน้อยเอย... เธอทำได้ดีมาก รู้ไหมว่า ถ้าไม่มีเธอ เราคงช่วยอะไร เคย์ ไม่ได้ อันที่จริงแล้ว ผู้คนใน Durango ทุกคนเป็นหนี้เธอนะ"

msgid "너는 지구인으로 죽을 거니? 아니면 여기 사람으로 죽을 거니?"
msgstr "ถ้าคุณตาย คุณจะตายในฐานะคนพลัดถิ่นฐานจากโลก? หรือในฐานะคนที่เกิดและเติบโตที่นี่จริงๆ "

msgid "너도 누군가처럼 여러 개의 조국을 갖고 있는 거란다."
msgstr "คนๆ หนึ่งต้องรับคำสั่งจากคนมากมาย"

msgid "너도 늘 생각하거라. 네가 왜 그 낯선 불안정섬에서 헛고생을 하고 있는지."
msgstr "คุณควรคิดให้ดี และคิดให้ไกลด้วย... ว่าทำไมคุณถึงต้องดิ้นรนไม่มีที่สิ้นสุดบนเกาะไม่เสถียร"

msgid "너도 지구에서 왔지. K. 아무튼 말싸움 할 기운은 없다."
msgstr "คุณก็มาจากโลกเหมือนกันเคย์ ตัวคุณน่ะ ช่างเถอะ ฉันไม่มีแรงจะเถียงกับคุณแล้ว"

msgid "너를 보고싶어서 조각 해 보았다."
msgstr "ฉันในแบบตัวเล็ก ๆ"

msgid "너무 가까워서 발사할 수 없습니다."
msgstr "รัศมีการยิงใกล้เกินไป"

msgid "너무 가까워지지 않도록 대치하면서 정확한 사격을 한다."
msgstr "ยิงกระสุนที่มีความรุนแรงสูงจากระยะปลอดภัย"

msgid "너무 가까이 있다가 소용돌이에 휩쓸려버렸지."
msgstr "ก็อย่างที่บอก ฉันอยู่ใกล้เกินไป จนเกือบถูกน้ำวนที่เกิดขึ้นตามมาพัดพาไปด้วย"

msgid "너무 더워서 걷는 것만으로 지친다. 몸을 씻거나 물을 마시면 좀 나아질 것 같다."
msgstr "การเดินท่ามกลางความร้อนจัดจะทำให้คุณเหนื่อยได้อย่างรวดเร็ว ดื่มน้ำและใช้น้ำอาบชะโลมร่างกายเพื่อทำให้เย็น"

msgid "너무 많은 메시지를 보내 잠시 입력이 제한됩니다."
msgstr "คุณถูกจำกัดการสนทนาเพราะส่งข้อความมากเกินไป"

msgid "너무 많이 부탁해서 민망할 정도네요. 다른 개척자들도 당신처럼 기본이 된 사람들이면 좋을 텐데, 그렇지가 않으니 누군가는 이 엉망진창에서 쓸 만한 걸 끌어올려야죠. <em>{item_0}</em>으로 쓸 수 있는 걸 구해주세요. 책에서 보니까 <em>{item_1}</em>이 좋던데 그건 좀 무리겠죠?"
msgstr "ฉันขอความช่วยเหลือจากคุณบ่อยมากจนฉันเริ่มรู้สึกอายแล้ว คงจะดีถ้าผู้บุกเบิกคนอื่นเก่งได้ครึ่งหนึ่งของคุณ แต่มันก็แค่ความฝัน ได้โปรด รวบรวมสิ่งของที่สามารถใช้สำหรับ <em>{item_0}</em> ตามตำรา <em>{item_1}</em> เป็นสิ่งที่ยอดเยี่ยม คงไม่ขอมากเกินไปใช่ไหม"

msgid "너무 매워서 눈물이 찔끔 난다."
msgstr "ความเผ็ดกำลังทำให้ฉันน้ำตาไหล"

msgid "너무 매워서 혀가 아프다."
msgstr "เผ็ดมาก! ปาก...แสบร้อน...!"

msgid "너무 멀어서 발사할 수 없습니다."
msgstr "รัศมีการยิงไกลเกินไป"

msgid "너무 문어발식으로 나서는 건 아닌가, 가끔 생각을 정리하고 싶을 때가 있다. 당신아. <em>{item_0}</em> 구해오라니. 당신 같은 고급 두뇌가 할 일은 아니지만, 시대가 워낙에 시대잖아."
msgstr "มีช่วงเวลาที่ฉันคิดว่าพวกเขาแค่พยายามทำให้เรายุ่งเข้าไว้ ฉันหมายถึง พวกเขาให้เราไปเอา <em>{item_0}</em> มาตอนนี้ บางคนที่ฉลาดเหมือนคุณต้องมีอะไรทำที่ดีกว่านี้ แต่ดูไม่เหมือนว่าเราพูดเรื่องนี้กันบ่อย ๆ"

msgid "너무 미안하고 염치가 없네요. 내가 모아둔 회사 물건이라도 주고 싶네요."
msgstr "ถ้าฉันสามารถสั่งการได้ ฉันจะมอบทุกสิ่งทุกอย่างที่คอมปะนีเป็นเจ้าของเพื่อตอบแทนให้กับคุณ แต่ฉันมอบให้คุณได้เพียงคำขอบคุณเท่านั้น"

msgid "너무 시어서 어질어질하다."
msgstr "รสชาติเปรี้ยวน่าเวียนหัว"

msgid "너무 시어서 이가 시리다."
msgstr "เปรี้ยวมาก มันทำให้ฟันฉันเจ็บ"

msgid "너무 써서 먹은 걸 토하고 싶다."
msgstr "ขมมาก ฉันจะอ้วก..."

msgid "너무 어렵게 생각할 건 없수. 21세기 지구 사람이나 듀랑고 사람이나 로마 제국의 시민은 아니여."
msgstr "...อย่าคิดมากไปเลยเรื่องนี้ ทั้งชาวโลกในศตวรรษที่ 21 และชาว Durango สมัยใหม่ต่างไม่เคยอาศัยอยู่ในจักรวรรดิโรมัน สิ่งที่เราคาดเดาได้ก็คงพอๆ กับที่พวกเขาคาดเดาได้นั่นแหละ"

msgid "너무 익숙해진 건 아닐까"
msgstr "มากเท่าที่ต้องการ"

msgid "너무 짠 나머지 입안이 얼얼하다."
msgstr "เค็มเกินไป ปากฉันรู้สึกประหลาด"

msgid "너무 쫄진 말고. 너와 같은 방식으로 살진 않으니까 말이야."
msgstr "แต่คุณอย่ากังวลไปเลย ฉันจะไม่เสียเวลาทั้งชีวิตจมอยู่กับความโกรธแค้นโง่ๆ อย่างที่คุณทำ"

msgid "너무 추워서 덜덜 떨린다. 불을 쬐거나 따뜻한 옷을 입으면 좀 나아질 것 같다."
msgstr "คุณรู้สึกหนาวเย็นถึงกระดูก ทำร่างกายให้อบอุ่นหน้ากองไฟหรือสวมเสื้อผ้าที่อบอุ่นขึ้น"

msgid "너무 흥분한 것 같은데 다음에 다시 얘기하자. 이 채널에서 얘기하면 될까?"
msgstr "คุณอย่าเพิ่งพูดตอนนี้เลย คุณต้องพักผ่อน ไว้ค่อยคุยกันทีหลังตกลงไหม? คุณจะติดต่อผ่านคลื่นนี้ใช่หรือเปล่า?"

msgid "너비"
msgstr "ความกว้าง"

msgid "너야말로 아직도 카우르를 사령관이라 부르잖아."
msgstr "แต่คุณก็ยังเรียกคาอูรูว่าหัวหน้า"

msgid "너의 감상은 너의 머리로만 생각하거라. 너희가 <em>파악한 정보</em>부터 보고하거라."
msgstr "พักเรื่องความรู้สึกของเธอไว้ก่อน ในเวลาเช่นนี้ ความรู้สึกเป็นเพียงตัวสร้างปัญหา เล่า<em>สิ่งที่เธอได้รู้มา</em>ให้ฉันฟังหน่อย"

msgid "너의 충성이 갈림길에 서 있구나. 얘야."
msgstr "คุณมาถึงทางแยกแล้ว จะภักดีกับฝ่ายไหนล่ะ?"

msgid "너의 힘을 보여주렴"
msgstr "ทดสอบพละกำลังของคุณ"

msgid "너클"
msgstr "สนับมือ"

msgid "너희 마음에 약간 의구심이 생겼을진 몰라도, 너흰 임무에 집중하고 있어."
msgstr "ฉันรู้ว่าคุณสงสัย แต่สนแค่งานของตัวเองก็พอ"

msgid "너희 모두 X에게 할 말이 많다는 걸 안단다. 하지만 감상을 말할 시간은 없으니 X부터 얘기하마."
msgstr "ฉันรู้ว่าคุณทุกคนมีสิ่งที่ต้องการพูดกับฉันมากมาย แต่ในเมื่อเราไม่มีเวลาเหลือเฟือ ฉันขอพูดก่อนก็แล้วกัน"

msgid "너희가 그 사실을 몇 가지 암호와 힌트로, 알아낸 건 참 잘 했단다."
msgstr "เด็กน้อย พวกเธอคาดเดาความเป็นจริงจากอักษรลับที่กระจัดกระจายอยู่และจากคำใบ้ที่แทบไร้ประโยชน์ได้เก่งมาก"

msgid "너희가 하는 일이 불만을 뿜는 거 말고 뭐가 있어? 오래 전에 결정한 일인데, 아직까지 그 얘기라니 전두엽 절제라도 당했냐?"
msgstr "คุณทำอย่างอื่นได้อีกหรือเปล่านอกจากบ่น เรื่องนี้ตัดสินใจมานานแล้ว จนป่านนี้คุณยังไม่เลิกนึกถึงมันอีก... คุณถูกแองคิโลซอรัสทำร้ายเข้าที่หัวหรือยังไง?"

msgid "너희는 궁금해하겠지. X가 <em>어떤 이유</em>로 너희에게 정보를 넘겼는지 말이야."
msgstr "ฉันมั่นใจว่าพวกคุณทุกคนอยากรู้... <em>ทำไม</em>เอ็กซ์จึงมอบกุญแจสู่ความจริงให้กับคุณมาจนถึงตอนนี้"

msgid "너희는 일종의 <em>비상구</em>란다. 외부로 정보를 보낼 수 있는 <em>지하통로</em> 같은 거지."
msgstr "...เว้นแต่ผู้นำคนนั้นไม่มีกลยุทธ์ใน<em>การออก</em>นะ <em>เส้นทางลับ</em>ในการส่งข่าวกรองออกสู่โลกภายนอก หรือที่เรียกสั้น ๆ ว่าคนอย่างพวกเธอ เด็ก ๆ ไงล่ะ"

msgid "너희들은 겉에 너무 익숙해서 속이 쏟아지면 정신을 못 차리지. 늘 겉이 다가 아니고, 속에 무엇이 있을지를 생각해야 한단다. <em>{item_0}</em>로 교훈을 얻어보자꾸나. 그 아이의 속에 무엇이 들어있는지 <em>{item_1}</em>을 들추어보자꾸나."
msgstr "ผู้คนส่วนใหญ่คุ้นเคยกับสิ่งที่อยู่บนพื้นผิวซึ่งทำให้ตื่นเต้นกับสิ่งที่อยู่เบื้องล่าง รูปลักษณ์ที่เห็นไม่ใช่ทุกสิ่ง คุณก็รู้ คุณต้องขุดลึกลงไปเพื่อเรียนรู้คุณค่าที่แท้จริงของบางสิ่ง เอา <em>{item_0}</em> ไปเป็นตัวอย่าง...และไปเอา <em>{item_1}</em> ของมันมาให้ฉัน"

msgid "너희들이 무슨 짓을 하건 부인할 수 있어야 한단다. 베드로가 그걸 참 잘 했지."
msgstr "ในสายงานของเรา สกิลการหลอกลวงคือกุญแจสำคัญ เปโดรเก่งเรื่องนั้นมาก"

msgid "너희의 말이 노망난 것처럼 들리게 해야 한단다. 진실을 바라보려면 눈을 감아야 해. 눈은 뇌가 보고 싶은 대로 보려고 하니까 말이야."
msgstr "การจะให้คนอื่นเชื่อคำพูดของคุณ ตัวคุณเองก็ต้องเชื่อด้วย ยังไงความจริงก็ถูกเขียนใหม่เรื่อยๆ อยู่แล้ว"

msgid "너희의 요구사항은 잘 얘기했단다."
msgstr "ฉันบอกพวกเขาแล้วว่าคุณต้องการอะไร"

msgid "너희의 충성심은 잘 안다. 하지만 너희 단계에선 고려할 수 없는 문제가 있다. 일일이 설명할 수 없단 건 알지?"
msgstr "ฉันรู้ว่าคุณภักดีแค่ไหน แต่เรื่องนี้มันเกินทักษะของคุณ คุณก็รู้ใช่ไหม?"

msgid "넌 XX 특별한 아이야. 우리 모두에게 말이야. 우리가 한 모든 일이 역할극이라고 해도 말이야."
msgstr "แต่คุณเป็นที่รักของพวกเราทุกคน เราไม่เคยทำเป็นแสดงหรือเล่นตามบทเลยนะ ถ้าเป็นเรื่องความรักและความห่วงใยในตัวคุณ"

msgid "넌 금고란다."
msgstr "คุณคือตู้เซฟ"

msgid "넌 네 <em>역할</em>을 잘 해왔다. 133. 여러 루트로 <em>정보를 흘려 보내는 일</em>이지."
msgstr "คุณทำ<em>หน้าที่</em>ของคุณได้เป็นอย่างดี 133 ไม่มีเจ้าหน้าที่คนใดของเราสามารถ<em>เผยแพร่ข้อมูล</em> ได้หลายช่องทางเท่ากับคุณ ไชโย"

msgid "넌 누구지?"
msgstr "คุณเป็นใคร"

msgid "넌 보상을 위해, <em>노왁, 리우, K</em> 누구건 접촉했지. 그게 <em>X</em>가 널 <em>메신저</em>로 선택한 이유란다."
msgstr "<em>โนวัค</em> <em>หลิว</em>...<em>เคย์</em> คุณจะเข้าร่วมกับองค์กรไหนก็ได้หากมีค่าตอบแทนที่คุ้มค่า ซึ่งเป็นเหตุผลที่ชัดเจนว่าทำไม<em>เอ็กซ์</em>จึงเลือกคุณเป็น<em>ผู้ส่งข่าว</em>ของเธอ"

msgid "넌 사과하고 싶지 않잖아. 타협하고 싶은 거지."
msgstr "คุณไม่ได้อยากขอโทษหรอก อยากต่อรองมากกว่า"

msgid "넌 이 무전에 끼어들면 안 돼. 누가 듣기라도 하면,"
msgstr "คุณไม่ใช่ส่วนหนึ่งของการส่งสัญญาณนี้ ถ้ามีบางคนมาได้ยินเข้า"

msgid "넌 정말로 정말로 감정적인 문제가 있다. 무전기는 그만 잡고 머리나 식혀라."
msgstr "ฉันคิดว่าคุณใช้อารมณ์มากเกินไป คุณน่าจะปิดวิทยุแล้วพักหายใจก่อนนะ"

msgid "넌 회사를 배신할 거다."
msgstr "ฉันรู้ว่าคุณกำลังจะทรยศคอมปะนี"

msgid "널 키워준 사람들 앞에서 할 말은 아니지."
msgstr "...เธอรู้ไหมว่าไม่ควรจะพูดอะไรแบบนั้นกับคนที่เลี้ยงเธอมา"

msgid "넓은 {item}"
msgstr "{item}แบบกว้าง"

msgid "넓은 가죽"
msgstr "หนังหยาบ"

msgid "넓은 나무 화단"
msgstr "กระถางไม้ดอกใหญ่"

msgid "넓은 바위 화단"
msgstr "กระถางดอกไม้หินใหญ่"

msgid "넓은 밭"
msgstr "ที่นาผืนใหญ่"

msgid "넓은 밭 건설하기"
msgstr "การสร้างทุ่งนาขนาดใหญ่"

msgid "넓은 뿔 화단"
msgstr "กระถางดอกไม้เขาใหญ่"

msgid "넓은 사각 물뿜이"
msgstr "เครื่องฉีดน้ำสี่เหลี่ยมแบบฉีดไกล"

msgid "넓은 사각 물뿜이 도면"
msgstr "แบบแปลนเครื่องฉีดน้ำสี่เหลี่ยมที่ฉีดเป็นวงกว้าง"

msgid "넓은 사각 물뿜이를 건설할 수 있는 도면."
msgstr "แบบแปลนสำหรับใช้สร้างเครื่องฉีดน้ำสี่เหลี่ยมที่ฉีดเป็นวงกว้าง"

msgid "넓은 세계에 나와 자유의 몸이 되었다."
msgstr "ออกเดินทางท่องโลกอย่างอิสระ"

msgid "넓은 천"
msgstr "ผ้าหยาบ"

msgid "넓은 천 모양"
msgstr "รูปทรงผ้ากว้าง"

msgid "넓은 털가죽"
msgstr "หนังหยาบติดขน"

msgid "넓은 톱니 모양의"
msgstr "รูปทรงฟันปลากว้าง"

msgid "넓은 판재"
msgstr "แผ่นกว้าง"

msgid "넓음"
msgstr "ขนาดความใหญ่"

msgid "넓이"
msgstr "พื้นที่"

msgid "넓적 상자"
msgstr "กล่องขนาดใหญ่"

msgid "넓적 상자 도면"
msgstr "แผนผังกล่องกว้าง"

msgid "넓적 상자를 건설하세요."
msgstr "สร้างกล่องขนาดกว้าง"

msgid "넓적 상자를 만들 수 있습니다. 넓적 상자엔 큰 상자보다 물건을 더 많이 보관할 수 있습니다."
msgstr "สร้างกล่องแบบกว้าง ใช้เก็บไอเทมได้มากกว่ากล่องขนาดใหญ่"

msgid "넓적 잎상자"
msgstr "กล่องใบไม้แบบกว้าง"

msgid "넓적잎"
msgstr "ใบแบนขนาดใหญ่"

msgid "넓직한 데다가 터를 잡고 있어. 자네 연구는 잘 되어 가는 겨?"
msgstr "ฉันกำลังทำเรื่องขอเป็นเจ้าของพื้นที่แปลงใหญ่ผืนนี้ อ้อ..งานวิจัยของคุณไปได้สวยหรือเปล่า?"

