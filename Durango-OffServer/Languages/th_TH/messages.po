msgstr "วัน"

msgid "낮까지 {0} 남음"
msgstr "{0}จนกว่าจะถึงเวลากลางวัน"

msgid "낮은 광택"
msgstr "ความมันวาวต่ำ"

msgid "낮은 마찰력"
msgstr "ความเสียดทานต่ำ"

msgid "낮은 밀도"
msgstr "ความหนาแน่นต่ำ"

msgid "낮은 사다리"
msgstr "บันไดพับ"

msgid "낮은 생울타리"
msgstr "พุ่มไม้เตี้ย"

