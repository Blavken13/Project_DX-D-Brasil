msgstr "สร้างเครื่องมือการทำอาหาร"

msgid "요리 레벨 10을 달성하고 재스민 생선 구이를 제작하세요."
msgstr "เพิ่มเลเวลการทำอาหารให้ถึงเลเวล 10 แล้วปรุงปลาย่างดอกแจสมิน"

msgid "요리 레벨 10을 달성하고 재스민 차를 제작하세요."
msgstr "เพิ่มเลเวลการทำอาหารให้ถึงเลเวล 10 แล้วปรุงชาแจสมิน"

msgid "요리 레벨 16을 달성하고 상큼 모히또를 제작하세요."
msgstr "เพิ่มเลเวลการทำอาหารเป็นเลเวล 16 แล้วทำโมฮิโต้แสนสดชื่น"

msgid "요리 레벨 16을 달성하고 워프 칵테일을 제작하세요."
msgstr "เพิ่มเลเวลการทำอาหารให้เป็นเลเวล 16 แล้วทำค็อกเทลวาร์ป"

msgid "요리 마스터"
msgstr "ปรมาจารย์การทำอาหาร"

msgid "요리 모자"
msgstr "หมวกทำอาหาร"

msgid "요리 모자 패키지"
msgstr "แพกเกจเชฟ"

msgid "요리 모자. \"네가 만든 꼬치구이가 덜 익어서 아직도 안전가옥을 뛰어다니잖아!\""
msgstr "หมวกทำอาหาร \"เนื้อเสียบไม้ของคุณยังดิบอยู่จนสามารถวิ่งไปรอบ ๆ ที่ซ่อนตัวของคุณได้เลยล่ะ!\""

msgid "요리 보관함"
msgstr "ที่เก็บอาหาร"

msgid "요리 복구율"
msgstr "อัตราการฟื้นฟูการทำอาหาร"

msgid "요리 섭취 시 포만감 시간 감소"
msgstr "ลดระยะเวลาการอิ่มท้องเมื่อกินอาหารที่ปรุงสุกแล้ว"

msgid "요리 숙련도를 올리는 방법"
msgstr "วิธีเพิ่มเลเวลของสกิลการทำอาหารของคุณ"

msgid "요리 스킬 계열 레벨업"
msgstr "เลเวลอัพการทำอาหาร"

msgid "요리 스킬을 Lv.10으로 성장시키세요."
msgstr "เลเวลสกิลการทำอาหารถึงเลเวล 10"

msgid "요리 스킬을 Lv.20으로 성장시키세요."
msgstr "เลเวลสกิลการทำอาหารถึงเลเวล 20"

msgid "요리 스킬을 Lv.30으로 성장시키세요."
msgstr "เลเวลสกิลการทำอาหารถึงเลเวล 30"

msgid "요리 스킬을 Lv.40으로 성장시키세요."
msgstr "เลเวลสกิลการทำอาหารถึงเลเวล 40"

msgid "요리 스킬을 Lv.50으로 성장시키세요."
msgstr "เลเวลสกิลการทำอาหารถึงเลเวล 50"

msgid "요리 스킬을 Lv.60으로 성장시키세요."
msgstr "เลเวลสกิลการทำอาหารถึงเลเวล 60"

msgid "요리 연구"
msgstr "วิจัยการทำอาหาร"

msgid "요리 연구 Lv.1"
msgstr "วิจัยทำอาหาร เลเวล 1"

msgid "요리 연구 Lv.2"
msgstr "วิจัยพลังงาน เลเวล 2"

msgid "요리 연구 Lv.3"
msgstr "วิจัยทำอาหาร เลเวล 3"

msgid "요리 연구 Lv.4"
msgstr "วิจัยทำอาหาร เลเวล 4"

msgid "요리 연습"
msgstr "พื้นฐานการทำอาหาร"

msgid "요리 연습 I"
msgstr "พื้นฐานการทำอาหาร I"

msgid "요리 연습 II"
msgstr "พื้นฐานการทำอาหาร II"

msgid "요리 연습 III"
msgstr "พื้นฐานการทำอาหาร III"

msgid "요리 연습 IV"
msgstr "พื้นฐานการทำอาหาร IV"

msgid "요리 연습 V"
msgstr "พื้นฐานการทำอาหาร V"

msgid "요리 응용"
msgstr "อาหารประจำภูมิภาค"

msgid "요리 응용하기"
msgstr "สร้างอาหาร"

msgid "요리 이름표"
msgstr "ป้ายชื่อเชฟ"

msgid "요리 이름표. \"누구든 미식가가 되고 싶다면 이 이름을 외워라.\""
msgstr "ป้ายชื่อที่เชฟสวมใส่ “คุณต้องการทานอาหารใช่มั้ย แค่จำชื่อฉันไว้ก็พอ”"

msgid "요리 작업에 좋은 부엌 작업복."
msgstr "ของจำเป็นเมื่อต้องทำอาหารในครัว"

msgid "요리 작업에 좋은 우뚝이 주방복."
msgstr "ชุดที่คุณสามารถสวมใส่ได้ในขณะทำอาหาร"

msgid "요리 전문가 Ⅰ"
msgstr "ผู้เชี่ยวชาญด้านการทำอาหาร I"

msgid "요리 전문가 Ⅱ"
msgstr "ผู้เชี่ยวชาญการทำอาหาร II"

msgid "요리 전문가 Ⅲ"
msgstr "ผู้เชี่ยวชาญด้านการทำอาหาร III"

msgid "요리 제작"
msgstr "ทำอาหาร"

msgid "요리 조리대"
msgstr "เคาน์เตอร์\nทำอาหาร"

msgid "요리 준비하기"
msgstr "การเตรียมครัว"

msgid "요리 중에 도둑이 결혼반지를 훔쳐 달아났다. 쫓아 기차까지 왔다. 분노를 가라 앉힌 뒤, 기차를 뒤질 것이다. 누군진 모르지만 찾아낼 것이다."
msgstr "โจรขโมยแหวนแต่งงานฉันไปตอนกำลังซื้อของ ฉันวิ่งตามมันมาจนถึงรถไฟขบวนนี้ พอสงบใจได้บ้างแล้ว ฉันจะค้นดูขบวนรถทุกตู้ ฉันไม่รู้ว่าแกเป็นใคร แต่ฉันจะตามหาแก..."

msgid "요리농사 개조 Ⅰ"
msgstr "ปรับแต่งทำอาหารและเพาะปลูก I"

msgid "요리는 개척자의 활동 시간을 고정하고 시간을 논리적으로 쓰게 한다."
msgstr "วางแผนทำอาหารของคุณอย่างสม่ำเสมอช่วยให้คุณสามารถใช้เวลาได้อย่างคุ้มค่ามากที่สุด"

msgid "요리도구 제작"
msgstr "เครื่องมือการทำอาหาร"

msgid "요리도구는 <em>무기/도구 제작<em> 계열에서, 건축물은 <em>건설</em> 계열에서 스킬을 배울 수 있습니다."
msgstr "เรียนรู้วิธีการสร้างเครื่องมือทำอาหารของคุณจากหมวดหมู่สกิล <em>การสร้างอาวุธ/เครื่องมือ<em>และสร้างอุปกรณ์ที่จำเป็นต่าง ๆ (เตาอบ เป็นต้น) โดยศึกษาจากหมวดหมู่สกิล<em>การก่อสร้าง</em>"

msgid "요리를 100번 진행하면, 보상으로 고기빵을 얻을 수 있습니다."
msgstr "คุณจะได้รับขนมปังเนื้อเป็นรางวัลหากคุณทำอาหาร 100 ครั้ง"

msgid "요리를 100번 하세요."
msgstr "ทำอาหาร 100 ครั้ง"

msgid "요리를 10번 하세요."
msgstr "ทำอาหาร 10 ครั้ง"

msgid "요리를 15번 하세요."
msgstr "ทำอาหาร 15 ครั้ง"

msgid "요리를 200번 하세요."
msgstr "ทำอาหาร 200 ครั้ง"

msgid "요리를 20번 하세요."
msgstr "ทำอาหาร 20 ครั้ง"

msgid "요리를 250번 하세요."
msgstr "ทำอาหาร 250 ครั้ง"

msgid "요리를 25번 하세요."
msgstr "ทำอาหาร 25 ครั้ง"

msgid "요리를 35번 하세요."
msgstr "ทำอาหาร 35 ครั้ง"

msgid "요리를 50번 하세요."
