msgid "제가 들은 게 정확히 어디서 나온 건진 몰라요. 무전에서 위치를 말 안 하니까요."
msgstr "ฉันไม่แน่ใจว่าสัญญาณนั้นส่งมาจากที่ไหน พวกเขาไม่ยอมเปิดเผยตำแหน่งที่ตั้ง"

msgid "제가 모신 분입니다. 매케인 선생님과는 업무 때문에 연락한 것이지 외부 활동가 문제와는 무관한 분입니다."
msgstr "อ่า.. แต่ฉันทำงานกับคนๆ นี้มาก่อนนะ โดยปกติแล้วเขาติดต่อกับแม็คเคนแค่เฉพาะเรื่องงานเท่านั้น ไม่มีอะไรเกี่ยวข้องกับปัญหานักเคลื่อนไหวภายนอกเลย"

msgid "제가 무전을 한 것은 비밀로 부탁드립니다. 선생님."
msgstr "ได้โปรด อย่าบอกใครว่าฉันติดต่อคุณ"

msgid "제가 선생님께 무전을 보낸 게, 참 잘 한 것 같습니다."
msgstr "การได้ติดต่อกับคุณถือเป็นหนึ่งในความสำเร็จที่ฉันภาคภูมิใจ"

msgid "제가 손을 쓰지 않았는데 적색 섬의 머리가 잘렸습니다. 자체적으로 일어난 일인지, 아니면 배후가 있는지 조사 중입니다. 혹시 배후를 알고 계신다면 정보 공유 하시는 게 낫지 않겠습니까?"
msgstr "ลบข้อความก่อนหน้านี้ทิ้งให้หมด หัวหน้าเกาะสีแดงเดือดจริงจังอย่างเป็นทางการแล้ว แต่คนของเราไม่ได้เป็นคนทำ ฉันกำลังตรวจสอบอยู่ว่านี่เป็นแค่ความบังเอิญหรือไม่ คุณรู้อะไรเกี่ยวกับเรื่องนี้หรือเปล่าผู้บัญชาการ?"

msgid "제가 수학이나 영어를 가르쳐 달라고 할 때 도와주는 어른은 잘 없었어요. 학업을 떠난지 오래 돼서 잘 모르겠다고 하더라고요. 부족장이 다른 부족에서 수학 교사를 불렀는데 참여가 저조해서 폐강되고 다들 덫이나 만들러 나갔죠. 그래도 저는 2차함수 정도는 풀 수 있어요."
msgstr "ตอนที่ฉันต้องการเรียนคณิตศาสตร์และภาษาอังกฤษ ไม่มีใครคอยช่วยเหลือฉันเลย พวกคนที่โตแล้วบอกว่าพวกเขาเรียนจบมานานแล้ว และจำไม่ได้แล้วว่าจะสอนอะไร มีอยู่ครั้งหนึ่งเสนาธิการพาครูวิชาคณิตศาสตร์มาจากแคลนอื่นเพื่อสอนเรา แต่ชั้นเรียนต้องถูกยกเลิกไปเพราะไม่มีใครมาเรียน ฉันต้องกลับไปสร้างกับดักทั้งวันเลย แต่ท้ายที่สุด ฉันก็ยังคิดว่าฉันเก่งวิชาพีชคณิตพอตัวนะ"

msgid "제가 알리겠어요. 앙코라도 다른 사람들과 함께 <em>개인섬</em>으로 먼저 가세요."
msgstr "ฉันจะส่งคำพูดออกไป แองคอร่า คุณนำหน้าไปที่<em>เกาะเทม</em>ของคุณพร้อมกับคนอื่น ๆ ก่อนนะ"

msgid "제가 얼마전에 생판 알지도 못 하는 사람들한테 얻어 맞은 적이 있습니다."
msgstr "ฉันโดนใครก็ไม่รู้เตะตูดมาเมื่อเร็วๆ นี้ เลิกขำก่อนได้ไหม?"

msgid "제가 업무 흐름을 뭔가 위반한 것처럼 말씀하시는데,"
msgstr "ฉันทำผิดกฎอะไรรึเปล่า?"

msgid "제가 연구용으로 갖고 있는 독도 있긴 합니다. 하지만 출처가 너무 명확한 게 문제죠."
msgstr "ฉันรวบรวมพิษเพื่อวัตถุประสงค์ในการวิจัย แต่สิ่งนี้เชื่อมโยงกับฉันอย่างชัดเจนจนน่าขนลุก"

msgid "제가 워프 조난자 구조하는 거 알죠? 혹시…… 그 일 같이 해 볼 생각은 없나요?"
msgstr "คุณรู้ใช่ไหมว่าฉันช่วยเหลือผู้รอดชีวิตจากวาร์ป แล้ว...คุณสนใจที่จะทำงานกับฉันไหม"

msgid "제가 조난자를 구조하러 다닐 때도 다들 그랬어요. <em>보통 사람들을 살려봤자 소용 없다고</em>."
msgstr "มีอีกหลายคนที่คิดแบบนี้เหมือนกัน ฉันได้ยินบ่อย ๆ ตอนที่ฉันช่วยเหลือผู้รอดชีวิต... <em>‘อย่าเสียเวลาให้ความช่วยเหลือคนธรรมดา</em>’"

msgid "제가 진행합니까?"
msgstr "คุณจะให้ฉันจัดการเหรอ?"

msgid "제가 해양구조대에 전화했습니다. 모두 안심하세요!"
msgstr "ไม่ต้องห่วงนะ ฉันส่งข้อความหายามชายฝั่งแล้ว"

msgid "제거"
msgstr "ทำลาย"

msgid "제과/제빵"
msgstr "การอบ / นม"

msgid "제과/제빵 만들기"
msgstr "สร้างอาหารอบ"

msgid "제네바"
msgstr "เจนีวา"

msgid "제노바"
msgstr "เจโนวา"

msgid "제련, 피할 수 없는 쓰임새"
msgstr "การขัดเกลาเป็นเรื่องที่หลีกเลี่ยงไม่ได้"

msgid "제련된 금속"
msgstr "โลหะที่หลอมแล้ว"

msgid "제련으로 구리를 얻는 광석. \"청동과 황동은 구리에 신세를 졌다.\""
msgstr "หาทองแดงได้จากการสกัดแร่นี้ \"ทองสำริดและทองเหลืองล้วนเป็นหนี้บุญคุณทองแดง\""

msgid "제련으로 금을 얻는 광석."
msgstr "แร่ที่สกัดเป็นทองได้"

msgid "제련으로 납을 얻는 광석. \"납은 단맛이 나지만 먹으면 안 된다.\""
msgstr "แร่ที่มีส่วนประกอบของตะกั่ว \"ฉันได้ยินมาว่าตะกั่วมีรสหวาน แต่ฉันก็ยังได้ยินมาอีกว่ามันไม่คุ้มเลยที่จะลองด้วยตัวเอง\""

msgid "제련으로 아연을 얻는 광석. \"황동을 만드는 데 필요하다.\""
msgstr "หาสังกะสีได้จากการสกัดแร่นี้ \"วัตถุดิบที่จำเป็นต่อการผลิตทองเหลือง\""

msgid "제련으로 은을 얻는 광석."
msgstr "แร่ที่สกัดเป็นเงินได้"

msgid "제련으로 주석을 얻는 광석. \"청동을 만드는 데 필요하다.\""
msgstr "หาดีบุกได้จากการสกัดแร่นี้ \"วัตถุดิบที่จำเป็นต่อการผลิตทองสำริด\""

msgid "제련으로 철을 얻는 광석. \"문명은 누군가 왜 그리 땔감을 낭비하냐며 욕을 먹었을 때 시작됐다.\""
msgstr "หาเหล็กได้จากการสกัดแร่นี้ \"อารยธรรมเริ่มต้นขึ้นเป็นครั้งแรกเมื่อมีใครบางคนถูกด่าเพราะพยายามเอาไม้ฟืนไปจุดไฟหลอมหิน\""

msgid "제련을 해보자"
msgstr "เขาผู้ที่ได้กลิ่น..."

msgid "제련한 금속. \"주괴가 있다는 건, 어딘가 그만한 문명이 있단 뜻이다.\""
msgstr "โลหะที่หลอมแล้ว \"โลหะเป็นรากฐานของอารยธรรมอันยิ่งใหญ่ทั้งมวล\""

msgid "제보를 줄 테니까, 네가 적당히 출처를 꾸며서 K와 샤를리즈에게 전해주거라."
msgstr "ฉันมีบางเรื่องที่ต้องบอกคุณ ถึงแม้คุณจะบอกต่อเรื่องนี้ให้เคย์รู้และคนงี่เง่าที่ยิ้มแย้มคนนั้น ก็แล้วแต่คุณ"

msgid "제보자. 나도 제보를 했지. 동료의 사생활을 유포한 혐의로 윤리위에 너를 제보했어."
msgstr "ฉันรายงานคุณด้วย คณะกรรมการจริยธรรมต้องได้ฟังเรื่องที่คุณกุข่าวลือเกี่ยวกับเพื่อนสมาชิกสภา"

msgid "제보자에게 불이익을 줬다는 게 사실이야?"
msgstr "จริงไหมที่คุณไล่แหล่งข่าวออก?"

msgid "제보해 주셔서 감사합니다."
msgstr "ขอบคุณสำหรับการส่งของคุณ"

msgid "제보해 주셔서 감사합니다.\n서버 상황 제보 외 문의(결제, 플레이 등)는 게임 내 고객센터 1:1 문의를 통해 접수해 주세요."
msgstr "ขอบคุณสำหรับการส่งรายงานของคุณ\nสำหรับคำถามอื่น ๆ ที่ไม่เกี่ยวข้องกับสถานะของเซิร์ฟเวอร์ (การเรียกเก็บเงิน การเล่นเกม เป็นต้น) โปรดติดต่อเราในเกมโดยไปที่ฝ่ายบริการลูกค้า > ถาม 1:1"

msgid "제브라를 길들이거라"
msgstr "ฝึกให้เชื่องได้"

msgid "제브라의 꽃. \"식물의 이름을 여기서 배운 게 많다.\""
msgstr "ดอกของต้นม้าลาย \"Durango จะทำให้เราทุกคนกลายเป็นนักพฤกษศาสตร์\""

msgid "제브라케라톱스"
msgstr "ซีบราเซอราทอปส์"

msgid "제브라케라톱스 가죽"
msgstr "หนังซีบราเซอราทอปส์"

msgid "제브라케라톱스 갈비뼈"
msgstr "ซี่โครงซีบราเซอราทอปส์"

msgid "제브라케라톱스 고기"
msgstr "เนื้อซีบราเซอราทอปส์"

msgid "제브라케라톱스 머리뼈"
msgstr "กะโหลกซีบราเซอราทอปส์"

msgid "제브라케라톱스 몰이란다"
msgstr "ทางม้าลายสำหรับซีบร้าเซราท็อป"

msgid "제브라케라톱스 사냥하기"
msgstr "ล่าซีบร้าเซราท็อป"

msgid "제브라케라톱스 자료 건입니다."
msgstr "ซีบร้าเซราท็อปอยู่ในใจ"

msgid "제브라케라톱스 큰 다리뼈"
msgstr "กระดูกขาซีบราเซอราทอปส์ขนาดใหญ่"

msgid "제브라케라톱스 포획"
msgstr "จับซีบราเซอราทอปส์"

msgid "제브라케라톱스 표본이 필요합니다"
msgstr "รอยเท้าของซีบร้าเซราท็อป"

msgid "제브라케라톱스를 포획하세요."
msgstr "จับซีบราเซอราทอปส์หนึ่งตัว"

msgid "제비꽃"
msgstr "ไวโอเล็ต"

msgid "제빵"
msgstr "อบ"

msgid "제빵 마스터"
msgstr "ปรมาจารย์การอบขนม"

msgid "제빵/제과 만들기"
msgstr "สร้างอาหารอบ"

msgid "제빵기능사 1급"
msgstr "บลิสส์อบใหม่"

msgid "제빵기능사 1급 과목을 완료하세요"
msgstr "สำเร็จหลักสูตรความสำราญใจในการอบขนม"

msgid "제빵기능사 1급 과정을 완료하였다."
msgstr "อบบลิสส์สดใหม่สำเร็จแล้ว"

msgid "제빵기능사 2급"
msgstr "พื้นฐานการอบสดใหม่"

msgid "제빵기능사 2급 과정을 완료하였다."
msgstr "พื้นฐานการอบสดใหม่สำเร็จแล้ว"

msgid "제빵은 곡물을 원래의 형태를 잃게 하고, 가루내어 더 높은 수준의 효율을 뽑을 수 있게 유도하는 요리법입니다. 요리 계열에서 <em>스킬</em>을 배울 수 있습니다."
msgstr "อบไม่เพียงแค่เปลี่ยนแป้งให้เป็นสิ่งอัศจรรย์เท่านั้น แต่ยังช่วยให้คุณดึงสารอาหารออกมาจากธัญพืชทั่วไปได้มากขึ้น คุณสามารถดู<em>สกิล</em>นี้ได้ในหมวดหมู่สกิลทำอาหาร"

msgid "제슈프"
msgstr "เซอร์ซูฟ"

msgid "제시. 내 애들도 도시섬에 있어. 전쟁은 절대 안정해역까지 안 퍼져."
msgstr "เจสซี่.. ลูกๆ ฉันก็อยู่บนเกาะอารยธรรมเหมือนกัน เชื่อฉันเถอะ ไม่มีทางที่สงครามจะมาถึงทะเลเสถียรได้หรอก"

msgid "제시. 너한테 공유할 게 있으면 알아서 공유할 거야."
msgstr "เจสซี่ถ้ามีข่าวใหม่ ฉันก็บอกคุณไปแล้ว"

msgid "제시. 대외로 나가는 건 다 내 업무야. 나랑 친하다고 네 월권까지 참진 않아."
msgstr "เจสซี่ ทุกอย่างที่ออกสู่สาธารณะอยู่ในความดูแลของฉัน ฉันจะไม่ยอมปล่อยให้คุณขัดคำสั่งแค่เพราะเราสนิทกันหรอกนะ"

msgid "제시. 좀 쉬어. 애랑 놀아준지 얼마나 됐어? 머리 복잡할 땐 무전기 끄는 게 나아."
msgstr "เจสซี่ใจเย็น คุณไม่ได้เล่นกับลูกมานานแค่ไหนแล้วเนี่ย? เวลายุ่งๆ น่ะ ปิดวิทยุสื่อสารก่อนดีกว่า"

msgid "제안"
msgstr "เสนอ"

msgid "제안됨"
msgstr "ที่เสนอ"

msgid "제우스"
msgstr "ซูส"

msgid "제임스타운"
msgstr "เจมส์ทาวน์"

msgid "제자리에서 즉시 부활 (<em>1일 5회</em>)"
msgstr "การคืนชีพทันที (<em>5 ครั้งต่อวัน</em>)"

msgid "제자리에서 즉시 부활합니다."
msgstr "คืนชีพที่ตำแหน่งปัจจุบันของคุณได้ในทันที"

msgid "제작"
msgstr "สร้าง"

msgid "제작 가능한 아이템"
msgstr "สร้างเป็น..."

msgid "제작 결과가 두렵다면 예상 결과를 확인해보세요. \n 대성공률도 확인할 수 있습니다."
msgstr "ตรวจสอบผลลัพธ์ที่คาดหวัง หากคุณรู้สึกไม่มั่นใจเกี่ยวกับการสร้างของคุณ\nคุณสามารถดูอัตราความสำเร็จแบบไร้ที่ติได้"

msgid "제작 과정에서 도구라고 명시된 것은 제작 후에\n재료처럼 사라지지 않고 대신 내구도가 감소합니다."
msgstr "ไอเทมที่ใช้เป็นเครื่องมือในกระบวนการประดิษฐ์ \nจะไม่หายไปเหมือนวัตถุดิบ แต่จะสูญเสียค่าทนทาน"

msgid "제작 능력"
msgstr "ทักษะในการสร้าง"

msgid "제작 능력 감소"
msgstr "ดีบัฟทักษะในการสร้าง"

msgid "제작 능력 증가"
msgstr "บัฟทักษะในการสร้าง"

msgid "제작 능력을 올리기 위해서는"
msgstr "เพื่อเพิ่มทักษะในการสร้างของคุณ"

msgid "제작 대성공 확률"
