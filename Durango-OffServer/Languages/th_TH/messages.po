msgid "글쎄, 당신이 워낙 속인 게 많아서 <em>신뢰</em>가 안 가는데."
msgstr "คุณไม่ได้ทำอะไรเลยนอกจากโกหกเราตลอดเวลา แล้วทำไมตอนนี้เราถึงต้อง<em>เชื่อ</em>คุณล่ะ"

msgid "글쎄, 요시포비치님. 가상의 적을 두는 게 정책 수립에서 도움은 되겠지만 말이야."
msgstr "บางทีคุณอาจพูดถูก โจซิโพวิค บางทีการมีศัตรูที่ทำให้เราร่วมใจกันสู้อาจช่วยสร้างความสงบเรียบร้อยก็ได้"

msgid "글쎄. 대부분은 그렇지만 소수 성공한 모델이 나오면 금세 번지게 되어 있어."
msgstr "ก็จริง แต่แนวคิดที่ดีกว่าก็จะเติบโตขึ้นในที่สุด ถ้าถึงตอนนั้นแล้ว มันก็จะแพร่ออกไปอย่างรวดเร็ว"

msgid "글쎄. 애들이 독립하겠대?"
msgstr "เด็กๆ เรียนรู้ที่จะหาเลี้ยงตัวเองเหรอ?"

msgid "글쎄. 자기들 <em>안싸움</em>에서 밀려서 외부에 <em>보험</em> 만드는 걸지도."
msgstr "ก็นะ... บางทีเธออาจจะเสียเขตอิทธิพลของตัวเองจาก<em>การต่อสู้ภายใน</em> บางทีเอกสารนั้นก็เป็นเพียงแบบฟอร์มหนึ่งของ...<em>การรับประกัน</em>"

msgid "글쎄. 진짜 막 공룡 봐서 후들후들 떨리는데."
msgstr "จะว่าไป ตอนที่ฉันเห็นไดโนเสาร์ตัวแรก ฉันค่อนข้างตกใจสุดขีดเลยเชียวละ"

msgid "글쎄다. 사령관님. 오늘은 말씀이 없으시군요. 듣고 있지 않습니까?"
msgstr "ไม่มีทางหัวหน้า... วันนี้คุณดูเงียบๆ นะ ฟังอยู่หรือเปล่า?"

msgid "글쎄요. 이상 현상을 일으킬 정도의 워프 에너지는 없었어요. 계속해서 동물 쪽도 살펴봐 주시겠어요?"
msgstr "ไม่รู้สิ... มีพลังงานวาร์ปไม่เพียงพอที่จะก่อให้เกิดความผิดปกติ คุณช่วยตรวจสอบพวกสัตว์ต่อได้ไหม?"

msgid "글쎄요? 애초에 처음부터 그 운동이 환경 무영향이라 할 수가 있었나요?"
msgstr "ไม่รู้สิ... หรืออาจเป็นตัวโครงการเองที่มีปัญหาตั้งแต่ต้นและไม่สามารถตามมาตรฐานของเราได้?"

msgid "글은 많은 걸 생각할 수 있게 하는데 영상은 사람을 멍청하게 한다고 그랬지."
msgstr "เขาบอกว่าถ้อยคำที่เขียนออกมาสร้างแรงบันดาลใจให้กับความคิดและจินตนาการ แต่พวกวิดีโอก่อให้เกิดความขี้เกียจและไม่ใส่ใจ"

msgid "글자를 알려줬더니 벌써 절반은 질리려 하더라고. 허허."
msgstr "เราเรียนตัวอักษรไปบางตัว แต่เด็กๆ ส่วนใหญ่ก็ดูจะเบื่อๆ ไปบ้างซะแล้ว ฮ่าๆ"

msgid "긁힘"
msgstr "ขูดขีด"

msgid "금"
msgstr "ทอง"

msgid "금 광석"
msgstr "แร่ทอง"

msgid "금 광석을 채집할 수 있습니다. 금은 제련해서 액세서리의 재료 등으로 씁니다."
msgstr "เก็บแร่ทองคำ สามารถนำไปถลุงแล้วใช้เป็นวัสดุอุปกรณ์เสริมได้"

msgid "금고에 관한 입소문이 도는 편인데 특별히 규모가 크지는 않아 대응은 하지 않고 있습니다."
msgstr "มีข่าวลือไปทั่วเรื่องตู้เซฟ แต่ยังไม่จำเป็นต้องทำอะไรในตอนนี้ ข่าวยังไม่ไปไกลนัก"

msgid "금고에 쓰일법한 회전식 손잡이."
msgstr "มือหมุนที่ดูเหมือนว่าจะทำขึ้นมาเพื่อล็อกอะไรสักอย่าง"

msgid "금고의 가장 큰 덕목은 안정성이야. 죽지 말거라."
msgstr "ตู้เซฟคงไม่มีประโยชน์ถ้ามันแตก พูดอีกอย่างก็คือ พยายามอย่าตาย"

msgid "금공 I"
msgstr "ทำงานโลหะ I"

msgid "금공 II"
msgstr "ทำงานโลหะ II"

msgid "금공 III"
msgstr "ทำงานโลหะ III"

msgid "금공 IV"
msgstr "ทำงานโลหะ IV"

msgid "금관 섹션"
msgstr "เครื่องเป่าทองเหลือง"

msgid "금광"
msgstr "เหมืองทอง"

msgid "금광석"
msgstr "แร่ทอง"

msgid "금망치"
msgstr "ค้อนทอง"

msgid "금속"
msgstr "โลหะ"

msgid "금속 가공"
msgstr "แปรรูปโลหะ"

msgid "금속 가공 능력"
msgstr "ทักษะแปรรูปโลหะ"

msgid "금속 가공 능력 증가"
msgstr "บัฟทักษะแปรรูปโลหะ"

msgid "금속 가공 능력 증가 이벤트"
msgstr "กิจกรรมบัฟทักษะแปรรูปโลหะ"

msgid "금속 가공 능력이 증가한다."
msgstr "เพิ่มทักษะในการวิจัยการแปรรูปโลหะ"

msgid "금속 가공 능력이 증가합니다."
msgstr "เพิ่มความสามารถในการแปรรูปโลหะ"

msgid "금속 가공 복구율"
msgstr "อัตราการฟื้นฟูการแปรรูปโลหะ"

msgid "금속 가공 연구"
msgstr "วิจัยการแปรรูปโลหะ"

msgid "금속 가공 연구 Lv.1 "
msgstr "วิจัยแปรรูปโลหะ เลเวล 1"

msgid "금속 가공 연구 Lv.2"
msgstr "วิจัยแปรรูปโลหะ เลเวล 2"

msgid "금속 가공 연구 Lv.3"
msgstr "วิจัยแปรรูปโลหะ เลเวล 3"

msgid "금속 가공 연구 Lv.4"
msgstr "วิจัยแปรรูปโลหะ เลเวล 4"

msgid "금속 가공과 재봉 작업에 좋은 우아한 작업복."
msgstr "เสื้อผ้าทำงานที่ประณีต ผลิตเพื่อสวมใส่ขณะที่แปรรูปโลหะหรือเย็บผ้า"

msgid "금속 경첩"
msgstr "บานพับโลหะ"

msgid "금속 경첩을 만들 수 있습니다. 금속 경첩은 여닫이가 필요한 건축물의 재료로 쓰입니다."
msgstr "ทำบานพับโลหะ ใช้เป็นวัสดุสำหรับสิ่งก่อสร้างที่เปิดปิดได้"

msgid "금속 광산"
msgstr "เหมืองโลหะ"

msgid "금속 기둥"
msgstr "เสาโลหะ"

msgid "금속 기둥을 다듬은 판재. \"없는 공장장이 품질을 칭찬할 것 같다.\""
msgstr "ทำจากเสาโลหะ \"อย่าหลบอยู่ใต้สิ่งนี้เมื่อมันถล่มลงมาเชียว\""

msgid "금속 너클"
msgstr "สนับมือโลหะ"

msgid "금속 덩어리로 만든 못."
msgstr "ตะปูที่ทำจากก้อนโลหะ"

msgid "금속 덩어리로 만든 판재."
msgstr "แผ่นกระดานที่ทำจากก้อนโลหะ"

msgid "금속 덩어리를 기둥 모양으로 깎는 법을 배웁니다. 금속 기둥은 다양한 가구나 건축물의 재료로 쓰입니다."
msgstr "เรียนรู้วิธีการแกะสลักแท่งโลหะให้กลายเป็นเสา ใช้เพื่อเป็นวัสดุสำหรับการสร้างเครื่องเรือนและสิ่งปลูกสร้างหลายอย่าง"

msgid "금속 덩어리를 깎아 만든 기둥."
msgstr "เสาที่ทำจากการแกะสลักก้อนโลหะ"

msgid "금속 덩어리를 깎아 만든 기둥. \"왠지 이번엔 산업 혁명까지 그리 오래 안 걸릴 것도 같다.\""
msgstr "ทำจากก้อนโลหะ \"เรากำลังอยู่ในช่วงปฏิวัติอุตสาหกรรมใหม่\""

msgid "금속 막대"
msgstr "แท่งโลหะ"

msgid "금속 막대를 3개 제작하세요."
msgstr "สร้างแท่งโลหะ 3 อัน"

msgid "금속 못"
msgstr "ตะปูโลหะ"

msgid "금속 못을 4개 제작하세요."
msgstr "สร้างตะปูโลหะ 4 ตัว"

msgid "금속 석쇠"
msgstr "ตะแกรงเหล็ก"

msgid "금속 석쇠를 만들 수 있습니다. 금속 석쇠는 석쇠구이, 양념석쇠구이를 할 때 씁니다."
msgstr "ทำตะแกรงเหล็ก ใช้เพื่อทำอาหารย่างและอาหารย่างแบบปรุงรส"

msgid "금속 속성의 아이템을 채집할 때 대성공 확률이 증가합니다."
msgstr "เพิ่มอัตราการเก็บแบบไร้ที่ติของไอเทมที่มีคุณสมบัติโลหะ"

msgid "금속 양동이"
msgstr "ถังโลหะ"

msgid "금속 얼음진흙 탄소처리"
msgstr "เปลี่ยนโลหะโคลนแช่แข็งเป็นคาร์บอน"

msgid "금속 열처리"
msgstr "หลอมโลหะ"

msgid "금속 용암처리"
msgstr "โลหะที่แปรรูปด้วยลาวา"

msgid "금속 재료 작업을 연습해 관련 작업 성공률을 높입니다."
msgstr "ฝึกทำงานกับวัตถุดิบประเภทโลหะเพื่อเพิ่มอัตราความสำเร็จของการทำงานที่เกี่ยวข้อง"

msgid "금속 채광 I"
msgstr "ขุดโลหะ I"

msgid "금속 채광 II"
msgstr "ขุดโลหะ II"

msgid "금속 채광 III"
msgstr "ขุดโลหะ III"

msgid "금속 채광 IV"
msgstr "ขุดโลหะ IV"

msgid "금속 탄소처리"
msgstr "แปรสภาพคาร์บอนในโลหะ"

msgid "금속 탄소처리 Ⅱ"
msgstr "แปรสภาพคาร์บอนในโลหะ 2"

msgid "금속 탈황처리"
msgstr "แยกสารประกอบซัลเฟอร์ในโลหะ"

msgid "금속 판재"
msgstr "แผ่นโลหะ"

msgid "금속 합치기"
msgstr "หลอมโลหะ"

msgid "금속가공 패키지"
msgstr "แพ็กเกจการทำเครื่องใช้โลหะ"

msgid "금속각도끼"
msgstr "ขวานโลหะแบบเข้ามุม"

msgid "금속각도끼 Ⅱ"
msgstr "ขวานโลหะแบบเข้ามุม 2"

msgid "금속각도끼날"
msgstr "หัวขวานตัดเข้าเหลี่ยมโลหะ"

msgid "금속각도끼날 Ⅱ"
msgstr "หัวขวานโลหะเหลี่ยม 2"

msgid "금속각진도끼날"
msgstr "หัวขวานตัดเข้าเหลี่ยมโลหะ"

msgid "금속각진칼날"
msgstr "ใบมีดตัดเข้าเหลี่ยมโลหะ"

msgid "금속경첩"
msgstr "บานพับโลหะ"

msgid "금속곡괭이"
msgstr "อีเต้อโลหะ"

msgid "금속곡괭이날"
msgstr "หัวอีเต้อโลหะ"

msgid "금속곡괭이와 금속곡괭이날을 만들 수 있습니다. Lv.55이상 광물 채광에 쓰입니다."
msgstr "ทำอีเต้อโลหะและหัวอีเต้อโลหะ ใช้เพื่อขุดแร่ธาตุ (เลเวล 55 ขึ้นไป)"

msgid "금속괭이"
msgstr "จอบโลหะ"

msgid "금속괭이날"
msgstr "ใบมีดจอบโลหะ"

msgid "금속괭이와 금속괭이날을 만들 수 있습니다. 밭을 일구는 데 쓰입니다."
msgstr "ทำจอบโลหะและใบจอบโลหะ ใช้เพื่อเตรียมที่ดิน"

msgid "금속기둥"
msgstr "เสาโลหะ"

msgid "금속날"
msgstr "ใบมีดโลหะ"

msgid "금속덩어리"
msgstr "ก้อนโลหะ"

msgid "금속도끼"
msgstr "ขวานโลหะ"

msgid "금속도끼날"
msgstr "หัวขวานสงครามโลหะ"

msgid "금속도끼날보다 공격력이 높은 뼈톱도끼날을 만들 수 있습니다."
msgstr "ทำหัวขวานเลื่อยกระดูกที่มีพลังโจมตีมากกว่าหัวขวานสงครามโลหะ"

msgid "금속등자"
msgstr "โกลนโลหะ"

msgid "금속류"
msgstr "โลหะ"

msgid "금속막대"
msgstr "แท่งโลหะ"

msgid "금속막대 Ⅱ"
msgstr "แท่งโลหะ 2"

msgid "금속망치"
msgstr "ค้อนโลหะ"

msgid "금속망치머리"
msgstr "หัวค้อนโลหะ"

msgid "금속망치머리보다 공격력이 높은 대갈부수개망치머리을 만들 수 있습니다."
msgstr "ทำหัวค้อนป่นกะโหลกที่มีพลังโจมตีมากกว่าหัวค้อนโลหะ"

msgid "금속못"
msgstr "ตะปูโลหะ"

msgid "금속못 x 30"
msgstr "ตะปูโลหะ x30"

msgid "금속못 Ⅱ"
msgstr "ตะปูโลหะ 2"

msgid "금속바늘"
msgstr "เข็มโลหะ"

msgid "금속부속품"
msgstr "เครื่องประดับโลหะ"

msgid "금속부속품 x 10"
msgstr "เครื่องประดับโลหะ x10"

msgid "금속부속품 Ⅱ"
msgstr "เครื่องประดับโลหะ 2"

msgid "금속부속품을 만들 수 있습니다. 금속부속품은 고급 금속 무기와 의상 제작에 쓰입니다."
msgstr "ทำอุปกรณ์โลหะ ใช้เพื่อการทำอาวุธและเสื้อผ้าโลหะขั้นสูง"

msgid "금속삽"
msgstr "พลั่วโลหะ"

msgid "금속삽과 금속삽날을 만들 수 있습니다. Lv.55이상 진흙을 채집할 때 쓰입니다."
msgstr "ทำพลั่วโลหะและใบพลั่วโลหะ ใช้เพื่อเก็บโคลน (เลเวล 55 ขึ้นไป)"

msgid "금속삽날"
msgstr "ใบมีดพลั่วโลหะ"

msgid "금속석쇠"
msgstr "ตะแกรงเหล็ก"

msgid "금속소모품"
msgstr "วัตถุดิบโลหะที่ใช้แล้วหมด"

msgid "금속에 반복적으로 열을 가해 순도를 높이는 법을 배웁니다. 금속의 <em>가벼움</em>과 <em>치밀한 구조</em> 속성이 올라갑니다."
msgstr "เพิ่มความบริสุทธิ์ด้วยการนำโลหะไปหลอมซ้ำ ๆ เพิ่มคุณสมบัติ<em>น้ำหนักเบา</em>และ<em>โครงสร้างกะทัดรัด</em>ของโลหะ"

msgid "금속에 조개껍질을 넣고 가열해 황을 제거하는 법을 배웁니다. 금속의 <em>높은 밀도</em>속성이 올라갑니다."
msgstr "แยกกำมะถันด้วยการเพิ่มความร้อนลงในส่วนผสมของโลหะและเปลือกหอยตลับ เพิ่มคุณสมบัติ<em>ความหนาแน่นสูง</em>ของโลหะ"

msgid "금속에 탄소함유량을 낮춰 순도를 높이는 법을 배웁니다. 금속의 <em>낮은 밀도</em>와 <em>단단함</em> 속성이 올라갑니다."
msgstr "เพิ่มความบริสุทธิ์ด้วยการลดปริมาณคาร์บอนในโลหะ เพิ่มคุณสมบัติ<em>ความหนาแน่นต่ำ</em>และ<em>ความแน่น</em>ของโลหะ"

msgid "금속연결뭉치"
msgstr "ข้อต่อโลหะ"

msgid "금속연결뭉치 x 20"
msgstr "ข้อต่อโลหะ x20"

msgid "금속연결뭉치를 만들 수 있습니다. 금속연결뭉치는 무기와 의상 제작에 쓰입니다."
msgstr "ทำโซ่โลหะ ใช้เพื่อการทำอาวุธและเสื้อผ้า"

msgid "금속으로 된 표지판 날. \"이곳의 사람들처럼 자신이 있을 맥락을 잃어 버렸다.\""
msgstr "โลหะจากป้ายข้างทาง \"ถ้าไม่มีสิ่งนี้ ผู้คนคงหลงทางแน่...\""

msgid "금속으로 만든 각도끼. \"도끼의 진짜 용도는 아무도 모른다.\""
msgstr "ขวานแบบเข้ามุมที่ทำจากโลหะ \"โค่นได้แม้ศัตรูที่สูงที่สุดของคุณ ไม่ว่าจะเป็นต้นไม้หรืออย่างอื่นก็ตาม\""

msgid "금속으로 만든 각도끼날. 한손도끼 조립에 쓴다. \"도끼는 오래 전부터 무기였다.\""
msgstr "หัวขวานแบบเข้ามุมที่ทำจากโลหะ ใช้สำหรับสร้างขวานมือเดียว \"ขวานโบราณนั้นอันตรายไม่น้อยไปกว่าขวานสมัยใหม่\""

msgid "금속으로 만든 거인면도칼. \"적도 당신처럼 두려울 것이다.\""
msgstr "มีดโกนขนาดใหญ่ที่ทำจากโลหะ \"เอาด้านบนออกไปนิดหน่อยเท่านั้น\""

msgid "금속으로 만든 거인면도칼날. 한손칼 조립에 쓴다. \"전시는 사람들이 평화에 지쳤을 때를 말한다.\""
msgstr "ใบมีดโกนขนาดใหญ่ที่ทำจากโลหะ ใช้สำหรับสร้างมีดมือเดียว \"บางคนยอมตายในการต่อสู้มากกว่าตายเพราะความเบื่อหน่าย\""

msgid "금속으로 만든 경첩. \"문을 닫는 게 옹졸해 보인다면 문턱을 높이는 것도 한 방법이다.\""
msgstr "บานพับที่สร้างจากโลหะ \"ถ้าคุณไม่ชอบการปิดประตู คุณก็สามารถสร้างบ้านต้นไม้ได้ทุกเมื่อ\""

msgid "금속으로 만든 곡괭이. 채광 작업에 쓴다. \"단단한 암석에도 쉽게 상하지 않는다.\""
msgstr "อีเต้อที่ทำจากโลหะ ใช้สำหรับขุดแร่ \"ฉันได้ยินมาว่าพวกเขากำลังทำอีเต้อจากเพชรอยู่ละ\""

msgid "금속으로 만든 곡괭이. 채광에 쓴다."
msgstr "อีเต้อที่ทำจากโลหะ ใช้สำหรับขุดแร่"

msgid "금속으로 만든 곡괭이날. 곡괭이 재료로 쓴다. \"금속이 금속을 부르는 순환이 완성되었다.\""
msgstr "หัวอีเต้อที่ทำจากโลหะ ใช้สำหรับสร้างอีเต้อ \"โลหะหนักหลอมรวมกับหินแข็ง\""

msgid "금속으로 만든 곡괭이날. 곡괭이 조립에 쓴다."
msgstr "หัวอีเต้อที่ทำจากโลหะ ใช้เพื่อสร้างอีเต้อ"

msgid "금속으로 만든 괭이. 농사에 쓴다."
msgstr "จอบที่ทำจากโลหะ ใช้สำหรับเพาะปลูก"

msgid "금속으로 만든 괭이. 농사에 쓴다. \"흙은 금속을 감추고, 금속은 흙을 헤집는다.\""
msgstr "จอบที่ทำจากโลหะ ใช้สำหรับเพาะปลูก \"ดินกลบโลหะ และโลหะเปิดดิน"

msgid "금속으로 만든 괭이날. 괭이 재료로 쓴다. \"쇠가 땅을 헤집어 놓네.\""
msgstr "ใบมีดที่ทำจากโลหะ ใช้สำหรับสร้างจอบ \"ไร่นาไม่มีทางรู้ว่าอะไรที่ขุดเจาะมัน\""

msgid "금속으로 만든 괭이날. 괭이 조립에 쓴다."
msgstr "ใบจอบที่ทำจากโลหะ ใช้เพื่อสร้างจอบ"

msgid "금속으로 만든 급조날."
msgstr "ใบมีดประดิษฐ์เองที่ทำจากโลหะ"

msgid "금속으로 만든 급조날. \"별 것 아닌 것 같지만 적어도 몇 만 년은 절약했다.\""
msgstr "ใบมีดประดิษฐ์เองที่ทำจากโลหะ \"อาณาจักรอันนองเลือดมากมายสร้างขึ้นด้วยเครื่องมืออันเรียบง่ายนี้\""

msgid "금속으로 만든 도끼. \"나무 입장에선 사람을 베는 게 더 좋을 지도 모른다.\""
msgstr "ขวานที่ทำจากโลหะ \"ถ้าถึงตาพวกต้นไม้นั่นได้ทีบ้าง พวกเราเองก็คงโดนตัดจนเหี้ยน\""

msgid "금속으로 만든 도끼. 제작법의 수준과 맞지 않는 도끼날을 사용하여 엉성하게 조립되었다."
msgstr "ขวานที่ทำจากโลหะ ใบมีดขวานไร้ประสิทธิภาพถูกนำมาใช้เป็นวัตถุดิบสำหรับไอเทมนี้ ทำให้มีคุณภาพไม่ค่อยดี"

msgid "금속으로 만든 도끼날. 한손 도끼 조립에 쓴다."
msgstr "หัวขวานที่ทำจากโลหะ ใช้สำหรับประกอบเป็นขวานมือเดียว"

msgid "금속으로 만든 도끼날. 한손도끼 조립에 쓴다. \"금속은 직설적이다.\""
msgstr "หัวขวานที่ทำจากโลหะ ใช้สำหรับสร้างขวานมือเดียว \"โลหะคือทางออกเพียงหนทางเดียวจากยุคมืดครั้งใหม่นี้\""

msgid "금속으로 만든 막대."
msgstr "แท่งที่ทำจากโลหะ"

msgid "금속으로 만든 막대. \"언젠가 주문량이 밀릴 것이다.\""
msgstr "แท่งที่ทำจากโลหะ \"ฉันสงสัยจังว่าสิ่งนี้ตกลงมาจากต้นไม้ประเภทไหนกัน...\""

msgid "금속으로 만든 망치. \"두드려라. 열릴 것이다.\""
msgstr "ค้อนที่ทำจากโลหะ \"อย่ากลัว ไม่มีอะไรสามารถหยุดยั้งคุณได้แล้วตอนนี้\""

msgid "금속으로 만든 망치. 제작법의 수준과 맞지 않는 망치머리를 사용하여 엉성하게 조립되었다."
msgstr "ค้อนที่ทำจากโลหะ หัวค้อนไร้ประสิทธิภาพถูกนำมาใช้เป็นวัตถุดิบสำหรับไอเทมนี้ ทำให้มีคุณภาพไม่ค่อยดี"

msgid "금속으로 만든 망치머리. 한손망치 조립에 쓴다."
msgstr "หัวค้อนที่ทำจากโลหะ ใช้สำหรับประกอบเป็นค้อนมือเดียว"

msgid "금속으로 만든 망치머리. 한손망치 조립에 쓴다. \"철물점이 문명의 정수란 걸 알게 되었다.\""
msgstr "หัวค้อนที่ทำจากโลหะ ใช้สำหรับสร้างค้อนมือเดียว \"ร้านขายวัสดุภัณฑ์ที่ดีตั้งอยู่ที่ศูนย์กลางของอารยธรรมยิ่งใหญ่\""

msgid "금속으로 만든 못. \"못 한 개가 이리 귀한 것이었다.\""
msgstr "ตะปูที่ทำจากโลหะ \"ชอบอันนี้เหรอ รอให้เห็นรุ่นที่ยาวเก้านิ้วก่อนเถอะ\""

msgid "금속으로 만든 바늘."
msgstr "เข็มที่ทำจากโลหะ"

msgid "금속으로 만든 바늘. 의류 제작에 쓴다. \"작은 금속이 첨예하다.\""
msgstr "เข็มที่ทำจากโลหะ ใช้สำหรับการเย็บชุด \"เข็มแบบคลาสสิก ตอนนี้ ถ้าเพียงแต่ปลอกนิ้วทะลุผ่านวาร์ปมาได้ละก็...\""

msgid "금속으로 만든 벽."
msgstr "กำแพงที่สร้างจากโลหะ"

msgid "금속으로 만든 벽. 조립식 건축물인 벽집을 건축할 때 재료로 사용된다. \"방 안에 누워있으면 통조림 고기가 된 기분이다.\""
msgstr "ผนังที่ทำจากเหล็กใช้เป็นวัสดุสำหรับบ้านและค่ายทหาร ซึ่งเป็นอาคารที่แบ่งออกเป็นส่วน ๆ  \"เอนกายลงและสัมผัสกับชีวิตของปลาซาร์ดีนบรรจุกระป๋อง\""

msgid "금속으로 만든 삽."
msgstr "พลั่วที่ทำจากโลหะ"

msgid "금속으로 만든 삽. 흙을 푸는 데 쓴다. \"굴착기의 원형은 여기서 나왔다.\""
msgstr "พลั่วที่ทำจากโลหะ ใช้สำหรับพรวนดิน \"เครื่องมือขุดเจาะแบบดั้งเดิม\""

msgid "금속으로 만든 삽날. 삽 재료로 쓴다. \"흐르는 물에 삽날을 씻어라.\""
msgstr "ใบมีดพลั่วที่ทำจากโลหะ ใช้สำหรับสร้างพลั่ว \"ทุกๆ การตักดินหนึ่งครั้งเข้าใกล้การกลบฝังอดีตหนึ่งก้าว\""

msgid "금속으로 만든 삽날. 삽 조립에 쓴다."
msgstr "ใบมีดพลั่วที่ทำจากโลหะ ใช้เพื่อประกอบพลั่ว"

msgid "금속으로 만든 석궁 등자. 석궁 조립에 쓴다."
msgstr "โกลนที่ทำจากโลหะ ใช้เพื่อประกอบหน้าไม้"

msgid "금속으로 만든 석궁. 제작법의 수준과 맞지 않는 재료를 사용하여 엉성하게 조립되었다."
msgstr "หน้าไม้ที่ทำจากโลหะ วัตถุดิบไร้ประสิทธิภาพถูกนำมาใช้กับไอเทมนี้ ทำให้มีคุณภาพไม่ค่อยดี"

msgid "금속으로 만든 양동이. 물 또는 용암을 뜰 수 있다."
msgstr "ถังที่ทำจากโลหะ ใช้เพื่อใส่น้ำหรือลาวา"

msgid "금속으로 만든 양동이. 물 또는 용암을 뜰 수 있다. \"손에 넣을 수 없었던 모든 걸 이젠 놓치지 않는다.\""
msgstr "ถังที่ทำจากโลหะ ใช้เพื่อใส่น้ำหรือลาวา “ในที่สุด ก็มีภาชนะที่สามารถบรรจุสิ่งของต่าง ๆ ที่ก่อนหน้านี้เราคิดว่าไม่มีทางขนย้ายไปไหนมาไหนได้!\""

msgid "금속으로 만든 양손 각도끼. \"인간끼리 서로 싫어함은 자연의 개체 수 조절이다.\""
msgstr "ขวานสองมือแบบเข้ามุมที่ทำจากโลหะ \"ควบคุมทั้งจำนวนต้นไม้และมนุษย์ในการเหวี่ยงขวานเพียงครั้งเดียว หรือหลายครั้งในบางกรณี\""

msgid "금속으로 만든 양손 거인면도칼. \"칼춤을 추자.\""
msgstr "ใบมีดโกนสองมือขนาดใหญ่ที่ทำจากโลหะ \"พร้อมโกนหนวดแล้วรึยัง\""

msgid "금속으로 만든 양손 도끼. \"생태계는 다시 주도권을 뺏기고 있다.\""
msgstr "ขวานสองมือที่ทำจากโลหะ \"เมื่อต้องลุกขึ้นต่อสู้กับเผ่าพันธุ์มนุษย์ ธรรมชาติจะเหลือทางสู้ได้อย่างไร\""

msgid "금속으로 만든 양손 도끼. 제작법의 수준과 맞지 않는 도끼날을 사용하여 엉성하게 조립되었다."
msgstr "ขวานสองมือที่ทำจากโลหะ ใบมีดขวานไร้ประสิทธิภาพถูกนำมาใช้เป็นวัตถุดิบสำหรับไอเทมนี้ ทำให้มีคุณภาพไม่ค่อยดี"

msgid "금속으로 만든 양손 망치. \"세상은 망치가 모루를 두들길 때 굴러 간다.\""
msgstr "ค้อนสองมือที่ทำจากโลหะ \"การเหวี่ยงค้อนแต่ละครั้ง คือพัฒนาการก้าวใหม่ของมวลมนุษย์\""

msgid "금속으로 만든 양손 망치. 제작법의 수준과 맞지 않는 양손 망치머리를 사용하여 엉성하게 조립되었다."
msgstr "ค้อนสองมือที่ทำจากโลหะ หัวค้อนสองมือไร้ประสิทธิภาพถูกนำมาใช้เป็นวัตถุดิบสำหรับไอเทมนี้ ทำให้มีคุณภาพไม่ค่อยดี"

msgid "금속으로 만든 양손 칼. \"1 더하기 1은 2가 아니다.\""
msgstr "มีดสองมือที่ทำจากโลหะ \"นี่แหละ ที่เรียกว่ามีด\""

msgid "금속으로 만든 양손 칼. 제작법의 수준과 맞지 않는 칼날을 사용하여 엉성하게 조립되었다."
msgstr "มีดสองมือที่ทำจากโลหะ ใบมีดไร้ประสิทธิภาพถูกนำมาใช้เป็นวัตถุดิบสำหรับไอเทมนี้ ทำให้มีคุณภาพไม่ค่อยดี"

msgid "금속으로 만든 엉성한 쇠창문."
msgstr "หน้าต่างคุณภาพต่ำที่ทำจากเหล็ก"

msgid "금속으로 만든 인식표. \"시간이 많이 지나 쓸모가 없어서 버리게 되길 소망한다.\""
msgstr "ป้ายชื่อระบุตัวตนที่ทำจากโลหะ \"ฉันหวังว่าจะไม่มีใครต้องใช้มันในวันหนึ่งนะ\""

msgid "금속으로 만든 인식표. 나의 이름이 적혀있다. \"시간이 많이 지나 쓸모가 없어서 버리게 되길 소망한다.\""
msgstr "ป้ายชื่อระบุตัวตนที่ทำจากโลหะ มีชื่อของฉันเขียนอยู่บนนั้น \"ฉันหวังว่าจะไม่มีใครต้องใช้มันในวันหนึ่งนะ\""

msgid "금속으로 만든 작살. 낚시에 쓴다. \"중금속 때문에 죽게 된다는 점은 같다.\""
msgstr "ฉมวกที่ทำจากโลหะ ใช้สำหรับจับปลา \"โลหะมีน้ำหนัก... ช่างป่าเถื่อน\""

msgid "금속으로 만든 작살. 물고기를 잡을 때 쓴다."
msgstr "ฉมวกที่ทำจากโลหะ ใช้สำหรับจับปลา"

msgid "금속으로 만든 창. \"금속은 살아 있지도 죽지도 않는다.\""
msgstr "หอกที่ทำจากโลหะ \"การใช้หอกยังคงไม่สูญพันธุ์ที่ Durango\""

msgid "금속으로 만든 창. 제작법의 수준과 맞지 않는 재료를 사용하여 엉성하게 제작되었다."
msgstr "หอกที่ทำจากโลหะ วัตถุดิบไร้ประสิทธิภาพถูกนำมาใช้กับไอเทมนี้ ทำให้มีคุณภาพไม่ค่อยดี"

msgid "금속으로 만든 창날. 창 재료로 쓴다. \"역사 교과서의 연표를 헷갈리게 할 것이다.\""
msgstr "หัวหอกที่ทำจากโลหะ ใช้สำหรับสร้างหอก \"คำว่า 'หัวหอก' ต้องมีที่มาจากที่ไหนสักแห่งสินะ\""

msgid "금속으로 만든 창날. 창 조립에 쓴다."
msgstr "หัวหอกที่ทำจากโลหะ ใช้เพื่อประกอบหอก"

msgid "금속으로 만든 칼. \"적의 칼날을 두려워하지 마라.\""
msgstr "มีดที่ทำจากโลหะ \"จงอย่าเกรงกลัวมีด แต่ทำความเข้าใจมัน\""

msgid "금속으로 만든 칼. 제작법의 수준과 맞지 않는 칼날을 사용하여 엉성하게 조립되었다."
msgstr "มีดที่ทำจากโลหะ ใบมีดไร้ประสิทธิภาพถูกนำมาใช้เป็นวัตถุดิบสำหรับไอเทมนี้ ทำให้มีคุณภาพไม่ค่อยดี"

msgid "금속으로 만든 칼날. 한손칼 조립에 쓴다."
msgstr "ใบมีดที่ทำจากโลหะ ใช้สำหรับประกอบเป็นมีดมือเดียว"

msgid "금속으로 만든 칼날. 한손칼 조립에 쓴다. \"인간은 서로를 죽이는 방법을 계속 연구했다.\""
msgstr "ใบมีดที่ทำจากโลหะ ใช้สำหรับสร้างมีดมือเดียว \"ไม่มีอะไรจะกระตุ้นความเป็นอัจฉริยะในมวลมนุษย์ได้เท่าสงคราม\""

msgid "금속으로 만든 큰 각도끼날. 양손도끼 조립에 쓴다. \"나무들은 쓰러지든 서 있든 늘 말이 없다.\""
msgstr "หัวขวานแบบเข้ามุมขนาดใหญ่ที่ทำจากโลหะ ใช้สำหรับสร้างขวานสองมือ \"โอ้ ดูความน่ากลัวที่ต้นไม้พวกนี้ต้องเผชิญสิ...\""

msgid "금속으로 만든 큰 거인면도칼날. 양손칼 조립에 쓴다. \"펜은 칼보다 강하다. 펜잡이들이 칼도 들고 있으니까.\""
msgstr "ใบมีดโกนขนาดใหญ่ยักษ์ที่ทำจากโลหะ ใช้สำหรับสร้างมีดสองมือ \"ถ้าการกระทำสำคัญกว่าคำพูด งั้นทำไมปากกาถึงมีอำนาจมากกว่าดาบล่ะ\""

msgid "금속으로 만든 큰 급조날."
msgstr "ใบมีดประดิษฐ์เองขนาดใหญ่ที่ทำจากโลหะ"

msgid "금속으로 만든 큰 급조날. \"석기와 철기의 등장 시점이 전보다 많이 좁혀졌다.\""
msgstr "ใบมีดประดิษฐ์เองขนาดใหญ่ที่ทำจากโลหะ \"แรกเริ่มก็เป็นเครื่องมือหิน แล้วตอนนี้ก็เป็นโลหะ! อีกไม่นานก็คงเช็คอีเมลได้แล้วล่ะ!\""

msgid "금속으로 만든 큰 도끼날. 양손 도끼 조립에 쓴다."
msgstr "หัวขวานขนาดใหญ่ที่ทำจากโลหะ ใช้สำหรับประกอบเป็นขวานสองมือ"

msgid "금속으로 만든 큰 도끼날. 양손도끼 조립에 쓴다. \"도끼의 이빨이 단단하게 여물었다.\""
msgstr "หัวขวานขนาดใหญ่ที่ทำจากโลหะ ใช้สำหรับสร้างขวานสองมือ \"หนักกว่าหัวกะโหลกของทีเร็กซ์ มากด้วยแรงบดขยี้ที่เกือบจะทัดเทียมกัน\""

msgid "금속으로 만든 큰 망치머리. 양손망치 조립에 쓴다."
msgstr "หัวค้อนที่ทำจากโลหะ ใช้สำหรับประกอบเป็นค้อนสองมือ"

msgid "금속으로 만든 큰 망치머리. 양손망치 조립에 쓴다. \"해머 갖고 와.\""
msgstr "หัวค้อนใหญ่ที่ทำจากโลหะ ใช้สำหรับสร้างค้อนสองมือ \"ห่างจากค้อนคัดค้านในตำนานอยู่เพียงก้าวเดียว\""

msgid "금속으로 만든 큰 칼날. 양손칼 조립에 쓴다."
msgstr "ใบมีดขนาดใหญ่ที่ทำจากโลหะ ใช้สำหรับประกอบเป็นมีดสองมือ"

msgid "금속으로 만든 큰 칼날. 양손칼 조립에 쓴다. \"도덕이란 특정한 강박이 있는 사람이 힘을 가진 상태를 말한다.\""
msgstr "ใบมีดขนาดใหญ่ที่ทำจากโลหะ ใช้สำหรับสร้างมีดสองมือ \"ถ้าคุณสามารถหาเหตุผลให้สงครามได้ ยังมีสิ่งอื่นอีกหรือที่คุณหาเหตุผลไม่ได้\""

msgid "금속으로 만든 톱."
msgstr "เลื่อยที่ทำจากโลหะ"

msgid "금속으로 만든 톱. 가공 작업에 쓴다. \"좋은 도구를 갖는 것 만으로도 기분 전환이 될 때가 있다.\""
msgstr "เลื่อยที่ทำจากโลหะ ใช้เพื่อดำเนินงาน \"ตัดวัสดุส่วนใหญ่เหมือนมีดตัดเนย\""

msgid "금속으로 만든 톱날. 톱 재료로 쓴다. \"그곳으로 다시 돌아갈 수 있다면 목수 일을 해보고 싶다.\""
msgstr "ใบมีดเลื่อยที่ทำจากโลหะ ใช้สำหรับสร้างเลื่อย \"ถ้าฉันสามารถกลับไปยังโลกได้ ฉันคงได้เป็นช่างไม้มืออาชีพ\""

msgid "금속으로 만든 톱날. 톱 조립에 쓴다."
msgstr "ใบมีดที่ทำจากโลหะ ใช้เพื่อประกอบเลื่อย"

msgid "금속으로 만든 활. 제작법의 수준과 맞지 않는 재료를 사용하여 엉성하게 조립되었다."
msgstr "ธนูที่ทำจากโลหะ วัตถุดิบไร้ประสิทธิภาพถูกนำมาใช้กับไอเทมนี้ ทำให้มีคุณภาพไม่ค่อยดี"

msgid "금속으로 못, 바늘, 막대, 날, 큰 날 등의 소모품을 만들 수 있습니다. 금속 소모품은 무기, 의상, 건축물 제작에 쓰입니다."
msgstr "ทำวัตถุดิบโลหะที่ใช้แล้วหมดไป เช่น ตะปู เข็ม ใบมีด และใบมีดขนาดใหญ่ ใช้เพื่อทำอาวุธ เสื้อผ้า และสิ่งปลูกสร้าง"

msgid "금속으로 양동이를 만들 수 있습니다. 물 또는 용암을 뜰 수 있습니다."
msgstr "ทำถังจากโลหะ ใช้เพื่อใส่น้ำหรือลาวา"

msgid "금속을 5번 채집하세요."
msgstr "รวบรวมเหล็ก 5 ครั้ง"

msgid "금속을 덧대어 만든 쇠 창문."
msgstr "หน้าต่างเหล็กที่ทำจากโลหะต่อเป็นชั้น"

msgid "금속을 반복 가열해 순도를 높인다."
msgstr "เพิ่มความบริสุทธิ์ด้วยการนำโลหะไปหลอมซ้ำๆ"

msgid "금속을 얼음진흙과 가열해 다른 성질로 탄소함유량을 낮춘다."
msgstr "เพิ่มความบริสุทธิ์และลดปริมาณคาร์บอนด้วยการเพิ่มความร้อนให้โลหะด้วยโคลนแช่แข็ง"

msgid "금속을 용암에 넣어 더욱 치밀한 구조를 만든다."
msgstr "แปรรูปโลหะโดยใช้ลาวาเพื่อโครงสร้างที่กะทัดรัดมากขึ้น"

msgid "금속을 정련한 덩어리. \"열기를 뚫고 순수함만이 남았다.\""
msgstr "ก้อนโลหะที่ขัดเงา \"ประกายมันวาวนั้นไม่ใช่ทองไปเสียหมด แต่บางอย่างก็ยังคงมีค่าค่อนข้างมาก\""

msgid "금속을 조개껍질과 가열해 부식 원인인 황을 제거해 순도를 높인다."
msgstr "เพิ่มความบริสุทธิ์ด้วยการเพิ่มความร้อนให้โลหะและเปลือกหอยตลับเพื่อแยกซัลเฟอร์ที่มีฤทธิ์กัดกร่อนออก"

msgid "금속을 조립한 도끼. \"베고 또 베리라.\""
msgstr "ขวานที่ทำจากโลหะ \"ฉับ ฉับ\""

msgid "금속을 조립한 망치. \"긍정적인 것만 만들 수 있으면 좋겠다.\""
msgstr "ค้อนที่ทำจากโลหะ \"ขอแค่มีค้อนดีๆ สักอันกับตะปูมากพอ ไม่ว่าอะไรฉันก็ซ่อมได้หมด\""

msgid "금속을 조립한 양손 도끼. \"거목이 쓰러져야 다른 식물에 기회가 생긴다.\""
msgstr "ขวานสองมือที่ทำจากโลหะ \"เมื่อต้นไม้ใหญ่ล้ม พืชที่อยู่ด้านใต้ก็จะได้รับแสงอาทิตย์\""

msgid "금속을 조립한 양손 망치. \"문명의 요람에선 금속이 운다.\""
msgstr "ค้อนสองมือที่ทำจากโลหะ \"พวกเราร่วมกันโครงสร้างรากฐานอารยธรรมด้วยค้อนแบบเดียวกันนี่แหละ\""

msgid "금속을 조립한 양손 칼. \"새로운 시대는 계속 문을 두드린다.\""
msgstr "มีดสองมือที่ทำจากโลหะ \"ก้าวเข้าสู่ยุคใหม่ ตัดทีละครั้ง\""

msgid "금속을 조립한 칼. \"조립이란 단어는 참 스펙트럼이 넓다.\""
msgstr "มีดที่ทำจากโลหะ \"เทคโนโลยีล้ำยุคของชาว Durango\""

msgid "금속을 진흙과 가열해 단단하고 무겁게 만든다."
msgstr "เพิ่มน้ำหนักและความทนทานโดยการทำความร้อนโลหะด้วยโคลน"

msgid "금속을 진흙과 가열해 탄소함유량을 낮춰 순도를 높인다."
msgstr "เพิ่มความบริสุทธิ์และลดปริมาณคาร์บอนด้วยการเพิ่มความร้อนให้โลหะด้วยโคลน"

msgid "금속을 합쳐 금속 덩어리를 얻는다."
msgstr "หลอมโลหะเพื่อสร้างก้อนโลหะขนาดใหญ่"

msgid "금속작살"
msgstr "ฉมวกโลหะ"

msgid "금속작살을 만들 수 있습니다. Lv.55이상 물고기를 잡는 데 쓰입니다."
msgstr "ทำฉมวกโลหะ ใช้เพื่อจับปลา (เลเวล 55 ขึ้นไป)"

msgid "금속절구"
msgstr "ครกโลหะ"

msgid "금속절구를 만들 수 있습니다. 재료를 갈거나 빻고 으깰 수 있습니다. 고급 약 등을 만들려면 금속절구가 필요합니다."
msgstr "ทำครกโลหะ ใช้เพื่อผสม บด หรือป่นส่วนผสม จำเป็นต้องใช้สำหรับการทำยาที่มีคุณภาพและอื่น ๆ"

msgid "금속조각"
msgstr "ชิ้นส่วนโลหะ"

msgid "금속주괴"
msgstr "ก้อนโลหะ"

msgid "금속창"
msgstr "หอกโลหะ"

msgid "금속창날"
msgstr "หัวหอกโลหะ"

msgid "금속창날보다 공격력이 높은 뼈송이창날를 만들 수 있습니다."
msgstr "ทำหัวหอกเศษกระดูกที่มีพลังโจมตีมากกว่าหัวหอกโลหะ"

msgid "금속칼"
msgstr "มีดโลหะ"

msgid "금속칼날"
msgstr "ใบมีดโลหะ"

msgid "금속칼날보다 공격력이 높은 뼈솟칼날을 만들 수 있습니다."
msgstr "ทำใบมีดเขี้ยวกระดูกที่มีพลังโจมตีมากกว่าใบมีดโลหะ"

msgid "금속톱"
msgstr "เลื่อยโลหะ"

msgid "금속톱과 금속톱날을 만들 수 있습니다. Lv.55이상 나무 채집과 재료 가공에 쓰입니다."
msgstr "สร้างเลื่อยโลหะและใบเลื่อยโลหะ ใช้เพื่อเก็บไม้ (เลเวล 55 ขึ้นไป) และแปรรูปวัสดุ"

msgid "금속톱날"
msgstr "ใบมีดเลื่อยโลหะ"

msgid "금속파이프"
msgstr "ท่อโลหะ"

msgid "금속판"
msgstr "แผงโลหะ"

msgid "금속판재"
msgstr "แผ่นโลหะ"

msgid "금속판재 지붕"
msgstr "หลังคาแผ่นโลหะ"

msgid "금속판재로 만든 지붕."
msgstr "หลังคาที่สร้างจากแผ่นโลหะ"

msgid "금속판재로 만든 지붕. 조립식 건축물인 막사와 벽집을 건축할 때 재료로 사용된다. \"여기에 올려지기까지 많은 갈등이 있었다.\""
msgstr "หลังคาที่ทำจากแผ่นโลหะ ใช้เป็นวัสดุสำหรับบ้านและค่ายทหาร ซึ่งกำลังก่อสร้างเป็นบางส่วน \"จะต้องทำบางอย่างเพื่อวางสิ่งนี้ไว้ที่ด้านบนของบ้าน\""

msgid "금액 설정"
msgstr "การตั้งค่าราคา"

msgid "금으로 도금한 망치. \"이런 게 만들어진다는 건 수요가 있단 뜻이겠지.\""
msgstr "ค้อนที่เคลือบด้วยทอง \"แค่เพราะว่าบางอย่างมีประโยชน์ ไม่ได้หมายความว่ามันจะยอดเยี่ยมไปพร้อมๆ กันด้วยไม่ได้\""

msgid "금은 녹이 잘 슬지 않고 쓸모가 많아서 돈 역할을 했어."
msgstr "ทองถูกเลือกเป็นสิ่งแลกเปลี่ยนเงินตราบนโลกได้ไม่ยากด้วยความที่มันหายาก ทนต่อสนิม และมีประโยชน์สารพัด"

msgid "금지"
msgstr "ถูกจำกัด"

msgid "급소찌르기"
msgstr "แทงข้างหลัง"

msgid "급소찌르기 I"
msgstr "แทงข้างหลัง I"

msgid "급소찌르기 II"
msgstr "แทงข้างหลัง II "

msgid "급소찌르기 III"
msgstr "แทงข้างหลัง III"

msgid "급소찌르기 IV"
msgstr "แทงข้างหลัง IV"

msgid "급소찌르기: 관통 I"
msgstr "แทงข้างหลัง: เจาะเกราะ I"

msgid "급소찌르기: 관통 II"
msgstr "แทงข้างหลัง: เจาะเกราะ II"

msgid "급소찌르기: 관통 III"
msgstr "แทงข้างหลัง: เจาะเกราะ III"

msgid "급소찌르기가 상대의 방어를 관통할 확률을 높입니다."
msgstr "เพิ่มอัตราการเจาะทะลวงของการแทงข้างหลัง"

msgid "급소찌르기의 피해량을 늘립니다."
msgstr "เพิ่มความเสียหายในการแทงข้างหลัง"

msgid "급수 시설에 물이 충전되지 않았습니다."
