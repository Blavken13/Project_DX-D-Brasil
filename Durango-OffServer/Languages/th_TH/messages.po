msgid "광석_열대전초기지_에메랄드"
msgstr "แร่_หน้าด่านเขตร้อน_มรกต"

msgid "광석_열대전초기지_은"
msgstr "แร่_หน้าด่านเขตร้อน_เงิน"

msgid "광석_열대전초기지_철"
msgstr "แร่_หน้าด่านเขตร้อน_เหล็ก"

msgid "광석_온대_구리"
