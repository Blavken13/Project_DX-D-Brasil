msgid "강_강 속_중간바위A_경계쪽"
msgstr "Sungai_Di Dalam Sungai_Batu A Ukuran Sedang_Sisi Perbatasan"

msgid "강_강 속_중간바위A_경계쪽_늪"
msgstr "Sungai_Di Dalam Sungai_Batu A Ukuran Sedang_Sisi Perbatasan_Rawa"

