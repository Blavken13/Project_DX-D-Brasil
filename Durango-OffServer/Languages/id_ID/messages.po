msgid "전천후 막사"
msgstr "Barak untuk Semua Cuaca"

msgid "전체"
msgstr "Semua"

msgid "전체 4x3, 실내 3x3"
msgstr "Total 4x3, Interior 3x3"

msgid "전체 검색"
msgstr "Cari Semua"

msgid "전체 대기자 목록 보기"
msgstr "Lihat Daftar Tunggu Penuh"

msgid "전체 목록"
msgstr "Daftar Lengkap"

msgid "전체 보상 목록"
msgstr "Daftar Hadiah Lengkap"

msgid "전체 상품"
msgstr "Semua Produk"

msgid "전체 선택"
msgstr "Pilih Semua"

msgid "전체 시즌"
msgstr "Semua Musim"

msgid "전체 요청 내역"
msgstr "Riwayat Permintaan Penuh"

msgid "전체 요청내역 보기"
