msgstr "{hour}j {min}m {sec}d"

msgid "{hour}시간 {sec}초"
msgstr "{hour}j {sec}d"

msgid "{id} 작물에 대한 정보가 없습니다."
msgstr "Tidak ada informasi mengenai hasil panen {id}."

msgid "{id}: 유효하지 않은 이용권입니다."
msgstr "{id}: Voucer tidak valid."

msgid "{invitee} 님을 초대했습니다."
msgstr "{invitee} telah diundang."

msgid "{invitee} 님이 파티 초대를 거절했습니다."
msgstr "{invitee} menolak undangan regu."

msgid "{item:을} 건조한 것. \"시간은 수명과 물기를 가져간다.\""
msgstr "{item} dikeringkan. \"Seandainya ada pelembap yang terlempar ke dalam Warp...\""

msgid "{item:을} 구웠는데 설익었다. \"땅에다 심으면 자라겠군.\""
msgstr "{item} belum matang. \"Ini jauh dari matang, sekalian saja kamu tanam lagi.\""

msgid "{item:을} 구웠는데 설익었다. \"한 번 더 구웠으면 좋겠다.\""
msgstr "{item} belum matang. \"Masukkan saja ke microw—oh...\""

msgid "{item:을} 국 끓인 것. \"속이 따뜻해질 거야.\""
msgstr "Sup {item}. \"Persis seperti masakan ibu.\""

msgid "{item:을} 금속 석쇠에 구운 것. \"자랑할 데가 없다는 게 아쉽다.\""
msgstr "{item} dibakar di atas panggangan logam. \"Seandainya ini bisa dibagikan di media sosial...\""

msgid "{item:을} 금속 석쇠에 구운 것. 탔다. \"안타까워라.\""
msgstr "{item} dibakar di atas panggangan logam. Makanan ini gosong. \"Tragedi besar di zaman kita.\""

msgid "{item:을} 길들였다. 귀속할 수 있다."
msgstr "{item} telah dijinakkan. Sekarang kamu bisa membentuk ikatan dengannya."

msgid "{item:을} 다듬은 것. \"자신을 버리지 마라. 견디면 시간이 다듬어준다.\""
msgstr "Item yang digunakan untuk memangkas {item}. \"Sedikit kelebihan di pinggirnya.\""

msgid "{item:을} 다지고 뭉친 환약. \"고급 환약은 건강 보험 비급여 대상이다.\""
msgstr "Pil yang dibuat dengan menggiling dan memeras {item}. \"Pil berkualitas tidak ditanggung oleh asuransi.\""

msgid "{item:을} 다지고 뭉친 환약. \"누구나 아픈 날이 있다.\""
msgstr "Pil yang dibuat dengan menggiling dan memeras {item}. \"Satu pil sehari memastikan dokter dapat banyak uang!\""

msgid "{item:을} 다지고 뭉친 환약. \"죽음을 피할 순 없지만 늦출 순 있다.\""
msgstr "Pil yang dibuat dengan menggiling dan memeras {item}. \"Kematian tidak bisa dicegah...tapi bisa dibuat bingung.\""

msgid "{item:을} 덜 말린 것. \"시간이 충분하지 않을 때도 있다.\""
msgstr "{item} dikeringkan sebagian. \"Ada beberapa hal yang memerlukan lebih banyak waktu.\""

msgid "{item:을} 돌판에 구운 것. \"죽기 전에 다시 먹고 싶을 것 같다.\""
msgstr "{item} dibakar di atas piring batu. \"Semoga aku bisa makan ini setidaknya satu kali lagi sebelum aku mati.\""

msgid "{item:을} 돌판에 구운 것. 탔다. \"너무 신중했던 것 같다.\""
msgstr "{item} dibakar di atas piring batu. Makanan ini gosong. \"Kesabaran: tidak selalu berarti kebajikan.\""

msgid "{item:을} 로스트한 것. \"인생에 더 나은 게 있나?\""
msgstr "{item} dipanggang. \"Coba jawab: Apa yang lebih bagus dari ini?\""

msgid "{item:을} 로스트한 것. 탔다. \"되돌리고 싶은 순간이 있다.\""
msgstr "{item} dipanggang. Makanan ini gosong. \"Seandainya aku bisa memutar balik waktu... Seandainya aku bisa menemukan cara...\""

msgid "{item:을} 말린 것. \"냉장고 이전의 조상들은 고생했구나.\""
msgstr "{item} dikeringkan. \"Siapa yang butuh kulkas?\""

msgid "{item:을} 말린 것. \"물기 없는 과일도 별미다.\""
msgstr "{item} dikeringkan. \"Tanpa kelembapan, penuh cita rasa.\""

msgid "{item:을} 무두질한 것. \"쓸모가 있으려면 꽤 많은 시도가 필요하다.\""
msgstr "{item} yang disamak. \"Hanya waktu yang akan menunjukkan maksudnya.\""

msgid "{item:을} 묶어 이은 끈. \"길이가 등차수열이면, 쓸모는 등비수열이다.\""
msgstr "{item} yang terhubung dengan sebuah tali. \"Satu-satunya hal yang lebih baik dari tali adalah tali yang lebih panjang.\""

msgid "{item:을} 볶은 것. \"불맛이 배이면 다 그럴싸하다.\""
msgstr "{item} oseng. \"Hampir semua hal bisa diselesaikan dengan api, terkadang kamu perlu sedikit kreatif.\""

msgid "{item:을} 삶은 것. \"삶은 그대로도 아름다운 것.\""
msgstr "{item} yang direbus dengan api kecil. \"Hidup itu indah walaupun terkadang membosankan.\""

msgid "{item:을} 양념 발라 금속 석쇠에 구운 것. \"이걸 만든 것만으로도 인간은 살 가치가 있다.\""
msgstr "{item} dibumbui dan dibakar di atas panggangan logam. \"Kenyataan bahwa orang bisa memasak hidangan seperti ini merupakan alasan yang cukup untuk menyelamatkan kemanusiaan.\""

msgid "{item:을} 양념 발라 금속 석쇠에 구운 것. 탔다. \"욕심을 부렸나보다.\""
msgstr "{item} dibumbui dan dibakar di atas panggangan logam. Makanan ini gosong. \"Gosong tapi keren.\""

msgid "{item:을} 양념 발라 돌판에 구운 것. \"돌판구이가 맛있단 느낌만은 영원할 것 같다.\""
msgstr "{item} dibumbui dan dibakar di atas piring batu. \"Rasanya seperti Pesta Tahun Baru!\""

msgid "{item:을} 양념 발라 돌판에 구운 것. 탔다. \"타임머신이 필요해.\""
msgstr "{item} dibumbui dan dibakar di atas piring batu. Makanan ini gosong. \"Seandainya aku punya mesin waktu...\""

msgid "{item:을} 양념 발라 로스트한 것. \"어디서나 일용할 양식을.\""
msgstr "{item} dibumbui dan dipanggang. \"Berikan roti harian kami untuk hari ini.\""

msgid "{item:을} 양념 발라 로스트한 것. 탔다. \"자신을 과신했던 것 같다.\""
msgstr "{item} dibumbui dan dipanggang. Makanan ini gosong. \"Aku lebih suka 'amat sangat matang', terima kasih.\""

msgid "{item:을} 연장한 막대. \"연장 근무보단 연장한 막대가 행복하리라.\""
msgstr "Stik yang diperpanjang dari {item}. \"Jauh lebih baik daripada perpanjangan jam kerja.\""

msgid "{item:을} 염장한 것. \"내일 먹을 게 있다는 게 기쁘다.\""
msgstr "{item} diawetkan dengan garam. \"Kenapa harus makan sekarang kalau bisa disimpan untuk besok?\""

msgid "{item:을} 염장한 것. 향을 넣었다. \"먹고 마시고 개척하라.\""
msgstr "{item} diberi rasa dan diawetkan dengan garam. \"Makan, minum, dan jadilah perintis!\""

msgid "{item:을} 오랜 시간 구워 육즙이 살아있다."
msgstr "{item} masih segar berair berkat proses memasak lama."

msgid "{item:을} 우린 차. \"새로운 다도를 세울 때가 왔다.\""
msgstr "Teh rendaman {item}. \"Sudah saatnya kita membuat upacara minum teh yang baru.\""

msgid "{item:을} 잘 구웠다. \"이런 걸 보니 살아 있는 것 같다.\""
msgstr "{item} dimasak hingga matang. \"Kita hidup di masa yang menakjubkan.\""

msgid "{item:을} 잘 구웠다. \"잘 먹고 치과의사를 찾아야겠다.\""
msgstr "{item} dimasak hingga matang. \"Yang penting makan dulu, dokter gigi urusan nanti! Atau, tahu sendiri lah, kapan-kapan.\""

msgid "{item:을} 제대로 통조림한 것. \"이곳에 회사 하나 차리고 싶다.\""
msgstr "{item} dikalengkan dengan benar. \"Bukankah mengejutkan bagaimana makanan murah bisa menjadi hidangan istimewa?\""

msgid "{item:을} 찐 것. \"증기로 푹 익혔다.\""
msgstr "{item} dikukus. \"Bukan dalam artian makan ini marah.\""

msgid "{item:을} 태웠다. \"불조절이 쉬운 건 아니다.\""
msgstr "{item} dimasak sampai gosong. \"Main api membuatmu mendapatkan hidangan di bawah standar.\""

msgid "{item:을} 통조림한 것. \"많은 기술을 복기해본다.\""
msgstr "{item} dikalengkan. \"Beberapa keterampilan dasar sudah jadi seni yang hilang.\""

msgid "{item:을} 튀긴 것. \"행복은 기름의 손을 잡고 온다.\""
msgstr "{item} goreng. \"Semua terasa lebih lezat jika digoreng.\""

msgid "{item:을} 향을 넣어 말린 것. \"마른 것이시여 만수무강하소서.\""
msgstr "{item} dikeringkan dengan tambahan rasa. \"Semoga bertahan selamanya.\""

msgid "{item:을} 향을 넣어 말린 것. \"생존이 해결되면 다음 문제는 취향이다.\""
msgstr "{item} dikeringkan dengan tambahan rasa. \"Kita bisa mulai memikirkan kesukaan setelah menemukan cara untuk bertahan hidup.\""

msgid "{item:을} 훈제한 것. \"여기서 여러 요리법을 겪어 본다.\""
msgstr "{item} diasapi. \"Siapa yang mengira kalau kita bisa memasak satu hidangan dengan begitu banyak cara?\""

msgid "{item:을} 훈제한 것. 향을 넣었다. \"지쳤다면 앉아서 식감을 즐겨보자.\""
msgstr "{item} diasapi dengan tambahan rasa. \"Duduk, santai, dan nikmatilah. Kamu layak mendapatkannya.\""

