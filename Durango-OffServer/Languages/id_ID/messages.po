msgstr "{item} beraroma daun"

msgid "나뭇잎, 이끼"
msgstr "Dedaunan, Lumut"

msgid "나뭇잎과 들꽃으로 만든 길. 이동속도가 빨라진다."
msgstr "Jalan terbuat dari daun dan bunga liar. Meningkatkan Kecepatan Gerakan."

msgid "나뭇잎길"
msgstr "Jalan Daun"

msgid "나뭇잎옷"
msgstr "Pakaian dari Daun"

msgid "나뭇잎옷 <link>장착</link>하기"
msgstr "<link>Pakai</link> Pakaian dari Daun"

