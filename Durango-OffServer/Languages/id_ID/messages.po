msgid "강_돌_대형_common_l01"
msgstr "Sungai_Batu_Ukuran Besar_umum_l01"

msgid "강_돌_대형_snowfileds_l01"
msgstr "Sungai_Batu_Ukuran Besar_hamparan salju_l01"

msgid "강_돌_대형_tropical_l01"
msgstr "Sungai_Batu_Ukuran Besar_tropis_l01"

msgid "강_돌_대형_tundra_l01"
msgstr "Sungai_Batu_Ukuran Besar_tundra_l01"

msgid "강_돌_중형_common_m01"
msgstr "Sungai_Batu_Ukuran Sedang_umum_m01"

msgid "강_돌_중형_snowfields_m01"
msgstr "Sungai_Batu_Ukuran Sedang_hamparan salju_m01"

