msgstr "Sungai_Di Dalam Sungai_Batu B Ukuran Sedang_Terkunci"

msgid "강_강 속_중간바위B_잠김_늪"
msgstr "Sungai_Di Dalam Sungai_Batu B Ukuran Sedang_Terkunci_Rawa"

msgid "강_강 속_중간바위B_잠김_푸른열대"
