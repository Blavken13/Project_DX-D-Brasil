msgid "<em>15레벨 불안정섬</em>에서 제브라케라톱스를 포획할 수 있습니다."
msgstr "Kamu dapat menemukan dan menangkap Zebraceratops di <em>level 15 Unstable Island</em>."

msgid "<em>1600개</em>의 용량을 지닌 개인 창고입니다. 200개씩 8개의 공간으로 나뉘며, 각 공간에 이름을 부여할 수 있습니다."
msgstr "Gudang pribadi ini memiliki kapasitas sebesar <em>1.600</em>! Ini dibagi menjadi 8 tab unik, masing-masing dengan 200 ruang."

msgid "<em>30레벨 성장 패키지</em>를 할인된 가격에 구매하세요."
msgstr "Pembelian <em>Paket Ascension Level 30</em> dengan harga diskon."

msgid "<em>30일 동안</em> 난수 조각을 드립니다."
msgstr "Memberikan Cuplikan Kode selama <em>30 hari</em>."

msgid "<em>30일 동안</em> 매일 프리미엄 바우처를 충전해 드립니다."
msgstr "Voucer premium diisi ulang setiap hari untuk <em>30 hari</em>."

msgid "<em>30일간</em> 전체 스킬 계열 <em>54레벨</em>까지 적용"
msgstr "Berlaku untuk semua kategori kemampuan hingga <em>level 54</em> untuk hingga <em>30 hari</em>."

msgid "<em>45레벨</em> 이상의 불안정섬은 <em>도시섬</em>에서도 갈 수 있습니다."
msgstr "Kamu bisa pergi ke Unstable Island yang berada di <em>level 45</em> atau lebih tinggi dari <em>Civilized Island</em>."

msgid "<em>5층</em>은 <em>숲</em>이에요. <em>숲</em>이 <em>5층</em>이에요."
msgstr "<em>Lantai 5</em> adalah <em>Hutan</em>. <em>Hutan</em> adalah <em>Lantai 5</em>."

msgid "<em>5층</em>은 듀랑고 곳곳에 영향을 미치고 있고요. 여기 있는 우리를 빼면요."
msgstr "Pengaruh <em>Lantai 5</em> menyebar ke seluruh Durango... Kecuali orang-orang yang berkumpul di sini hari ini."

msgid "<em>5층</em>은 우리가 워프에 휘말리도록 <em>유도</em>했어요. 회사와 위원회는 듀랑고에 파견된 <em>5층의 요원들</em>이고요."
msgstr "Tapi <em>Lantai 5</em> tahu. Mereka <em>memasukkan kita</em> ke dalam Warp. The Company, Komite... Mereka BERDUA adalah <em>agen dari Lantai 5</em>."

msgid "<em>5층</em>은 전부 알고 있었어요. 소름도 돋고 화도 나네요."
msgstr "<em>Lantai 5</em> tahu setiap hal kecil tentangnya. Membacanya membuatku merinding... dan membuatku sangat marah."

msgid "<em>5층</em>이란 곳에서 지구에서 <em>언제, 어디서 워프가 일어날지 알고 있었어</em>."
msgstr "Sesuatu yang disebut <em>Lantai 5 tahu kapan dan di mana Warp akan terjadi</em> di Bumi."

msgid "<em>60레벨 성장 패키지</em>를 할인된 가격에 구매하세요."
msgstr "Pembelian <em>Paket Ascension Level 60</em> dengan harga diskon."

msgid "<em>6군도 첫번째 섬</em>섬을 탐색하여 <em>크레이터</em>를 발견하세요."
msgstr "Cari <em>Kawah</em> di <em>pulau pertama pada kepulauan 6</em>."

msgid "<em>7일간</em> 개인섬의 개척도 성장을 더욱 빠르게!"
msgstr "Tingkatkan laju kenaikan level perintis Tamed Island selama <em>7 hari</em>!"

msgid "<em>7일간</em> 개척 포인트 400% 보너스 구간 추가"
msgstr "Menambahkan 400% zona bonus Poin Perintis selama <em>7 hari</em>."

msgid "<em><help>{0}</help> 원하는 외형</em>이 나오려면?"
msgstr "<help>{0}</help> Bagaimana caranya mendapatkan <em>desain yang diinginkan</em>?"

msgid "<em>BPM</em>을 입력하여 곡의 빠르기를 조절할 수 있습니다."
msgstr "Gunakan <em>BPM</em> untuk menyesuaikan kecepatan lagu."

msgid "<em>D2E</em>가 발견된다면 듀랑고를 발칵 뒤집을 중대한 사건이지 않겠나? "
msgstr "Penemuan <em>D2E</em> akan memembalik Durango!"

msgid "<em>D2E</em>라고 들어봤나? 지구로 통하는 입구을 가라키는 코드네임이라고 하던디."
msgstr "Pernahkah kamu mendengar istilah <em>D2E</em>? Itu nama kode yang diberikan pada pintu masuk yang mengarah ke Bumi."

msgid "<em>K</em>. 내 아이들한테 선물을 보냈더군. 정성은 꽤 있어."
msgstr "...Aku tahu kau memberi hadiah untuk anak-anakku, <em>K</em>. Aku menghargai sikap itu, bahkan terkejut dengan kebaikanmu."

msgid "<em>K</em>. 우리 지금 좀 혼란스러운데, 어떻게 된 건지 설명해줄래?"
msgstr "Tenanglah, <em>K</em>. Kami di sini untukmu, kami hanya... agak bingung. Apa yang terjadi? Apa yang kau temukan?"

msgid "<em>K</em>. 있잖아. <em>회사</em>에서<em> K</em>를 또 찾는 것 같아."
msgstr "Aku benci menjadi pembawa berita buruk, <em>K</em>... Tapi sepertinya <em>The Company</em> sedang mencarimu lagi. "

msgid "<em>K</em>를 잘 알고 있지 않습니까? 그분과 <em>접촉</em>이 좀 필요할듯 합니다."
msgstr "Kamu dekat dengan <em>K</em>, kan? Kebetulan kami ingin <em>menghubunginya</em>."

msgid "<em>K를 터치</em>하여 대화하세요."
msgstr "<em>Ketuk K</em> untuk bicara."

msgid "<em>K에게 분명히 전하거라</em>."
msgstr "<em>Jadi, lakukanlah apa yang selalu kau lakukan, 'Ancora'—teruskan setiap kata kepada K</em>."

msgid "<em>LJ</em>. 그 아인 참 예뻤어. 우리 개척자는 모두 꼭 <em>복수</em>해야 해."
msgstr "Maafkan aku, <em>LJ</em>... Dia cantik, dan dia pantas mendapatkan yang lebih baik. <em>Mereka akan membayar</em> apa yang telah mereka lakukan. Itu adalah tugas kita sebagai perintis."

msgid "<em>T스톤</em>이 워프를 유도한단 <em>증거</em>가 나오기 전까진,  제가 어릴 적엔 그냥 <em>돌덩어리</em>에 불과했죠."
msgstr "Sebelum seseorang <em>membuktikan</em> bahwa <em>Batu-T</em> menginduksi Warp, orang berpikir Warp hanyalah sekumpulan <em>batu tak berguna</em>."

msgid "<em>X 전용 무전기</em>를 사용하세요."
msgstr "Gunakan <em>Walkie-Talkie Jalur-X</em>."

msgid "<em>X</em> 본인이 <em>흔들리고 있을 가능성</em>도 있겠죠.  위원회 내부에 <em>균열</em>이 있을 수도 있다고 제가,"
msgstr "Ada juga kemungkinan bahwa <em>X</em> mulai meragukan misinya. Kalau ada semacam <em>keretakan</em> di dalam Komite, mungkin kita bisa—"

msgid "<em>X</em>가 <em>왜</em> 그 문서를 남겨 놓았을까?"
msgstr "Yang masih belum aku mengerti adalah <em>mengapa</em> <em>X</em> meninggalkan dokumen itu?"

msgid "<em>X</em>가 접근하고 있으니 가능한 빨리 <em>실험의 일정</em>을 당겨야 한다. 이런 내용이 있네요."
msgstr "Ia berkata mereka menemukan bahwa <em>X</em> mengetahuinya, jadi mereka mempercepat <em>jadwal eksperimen</em> semaksimal mungkin."

msgid "<em>X</em>께 들었습니다. 그분께선 모든 걸 알고 계시죠."
msgstr "<em>X</em> memberitahuku segalanya."

msgid "<em>X</em>는 수상한 인물이고, 우리와 맞지 않지만,  우리에게 정보를 넘긴 건 사실이고, <em>이런 배경</em> 때문 같아요."
msgstr "Meskipun aku biasanya tidak pernah mempercayai <em>X</em>, dia memang memberikan intel yang kita butuhkan. Dengan apa yang kita <em>tahu sekarang</em>, itu semakin masuk akal."

msgid "<em>X</em>는 흔들리고 있어요. 위원회 내부엔 실제로 <em>균열</em>이 생기고 있네요."
msgstr "Jadi <em>X</em> benar-benar kehilangan kekuasaannya... ADA <em>keretakan</em> yang terbentuk dalam Komite."

msgid "<em>X</em>도 <em>실험</em>이 진행 중인 건 알고 있을 거야. 워낙에 <em>정보력</em>으로 인정을 받았던 인간이니까."
msgstr "<em>X</em> pasti tahu sudah sejauh mana <em>eksperimennya</em>. Lagi pula, dia selalu sangat mahir <em>mengumpulkan intel</em>."

msgid "<em>X</em>랑 어떻게 연락이 된 건지 신기하네."
msgstr "Tentang bagaimana ia berhubungan dengan <em>X</em>, aku tidak tahu..."

msgid "<em>X</em>와 <em>위원회</em>의 이익이 같지 않을 수도 있겠죠. 아무튼 그래서 <em>위원회의 시선</em>을 어떻게 끌죠?"
msgstr "Aku cuma bilang, <em>X</em> dan <em>Komite</em> mungkin tidak memiliki tujuan yang sama... Tapi kita sudah keluar jalur. Bagaimana kita bisa menarik <em>perhatian Komite</em>?"

msgid "<em>X</em>와 연락을 취해보고, 이 <em>암호</em>를 <em>해독</em>해보는 게 좋겠어요."
msgstr "Ayo <em>dekode</em> <em>kriptogram</em> ini. Kurasa sudah saatnya juga kita menghubungi <em>X</em>."

msgid "<em>X와만 무전할 수 있는 무전기</em>도 함께 보낼거란다. 도청 당하지 않으니 챙기거라."
msgstr "Aku juga mengirim <em>walkie-talkie dengan jalur pribadi dan eksklusif denganku</em>. Tidak bisa disadap, tidak terlacak...dan tidak tergantikan. Jangan sampai kau kehilangannya."

