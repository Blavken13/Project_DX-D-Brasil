msgstr "Buat salad. Makan untuk meningkatkan Ketangkasan."

msgid "샐비어"
msgstr "Sage"

msgid "생 간"
msgstr "Hati Mentah"

msgid "생 간 10회 도축하기"
msgstr "Potong 10 hati mentah."

