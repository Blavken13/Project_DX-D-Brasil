msgid "공격 액션 성공하기"
msgstr "Serang raptornya"

msgid "공격 액션 재사용 대기시간"
msgstr "Pengurangan Pendinginan Aksi Serangan"

msgid "공격 액션을 사용할 때, 공격 관련 숙련도가 증가합니다."
msgstr "Tingkatkan level keterampilan terkait menyerang dengan menggunakan aksi serangan."

msgid "공격 연구"
msgstr "Riset tentang Serangan"

msgid "공격 주기"
msgstr "Siklus Serangan"

msgid "공격 쿨타임"
msgstr "Pendinginan Serangan"

msgid "공격 피해"
msgstr "Kerusakan Serangan"

msgid "공격!"
msgstr "Serang!"

msgid "공격, 방어, 회복 등 종합적인 전투 능력이 향상됩니다."
msgstr "Tingkatkan serangan, pertahanan, pemulihan, dan kemampuan terkait pertempuran lainnya."

msgid "공격력"
msgstr "Serangan"

msgid "공격력 감소"
msgstr "Debuff serangan"

msgid "공격력 연구"
msgstr "Riset Serangan"

msgid "공격력 연구 Lv.1"
msgstr "Riset Serangan Lv. 1"

msgid "공격력 연구 Lv.2"
msgstr "Riset Serangan Lv. 2"

