msgid "화물 워프홀 빠른 전송"
msgstr "Pengiriman Cepat Courier Warp Hole"

msgid "화물 워프홀 이용자들로부터 징수한 이용요금입니다. 이 금액은 부족 자금으로 자동 이체됩니다."
msgstr "Tarif dikumpulkan dari pengguna Lubang Dimensi Kurir. Jumlah ini akan secara otomatis ditransfer ke dana klan."

msgid "화물 워프홀 전송"
msgstr "Pengiriman Courier Warp Hole"

msgctxt "크럼"
msgid "화물 워프홀 전송"
msgstr "Pengiriman Lubang Dimensi Kurir"

