msgid "노왁"
msgstr "Novak"

msgid "노왁, 당신은 말은 많지만, 그중에 <em>쓸모</em>가 있을 만한 건 하나도 없군요."
msgstr "Novak malang yang teperdaya... Kau bicara terus, tapi tak banyak yang <em>dikatakan</em>."

msgid "노왁과 전쟁"
msgstr "Novak dan Perang"

msgid "노왁과 하우아타의 잡담1"
msgstr "Obrolan Novak dan Hauata 1"

msgid "노왁과 하우아타의 잡담2"
