msgid "금속 탄소처리 Ⅱ"
msgstr "Mengurangi Tingkat Karbon pada Logam II"

msgid "금속 탈황처리"
msgstr "Menghilangkan Sulfur dari Logam"

msgid "금속 판재"
msgstr "Papan Logam"

msgid "금속 합치기"
msgstr "Menggabungkan Logam"

msgid "금속가공 패키지"
msgstr "Paket Pengolahan Logam"

msgid "금속각도끼"
msgstr "Kapak Logam Bersiku"

msgid "금속각도끼 Ⅱ"
msgstr "Kapak Logam Bersiku II"

msgid "금속각도끼날"
msgstr "Kepala Kapak Logam Bersiku"

msgid "금속각도끼날 Ⅱ"
msgstr "Kepala Kapak Logam Bersiku II"

msgid "금속각진도끼날"
msgstr "Kepala Kapak Logam Bersiku"

msgid "금속각진칼날"
msgstr "Mata Pisau Logam Melengkung"

msgid "금속경첩"
msgstr "Engsel Logam"

msgid "금속곡괭이"
msgstr "Beliung Logam"

msgid "금속곡괭이날"
msgstr "Kepala Beliung Logam"

msgid "금속곡괭이와 금속곡괭이날을 만들 수 있습니다. Lv.55이상 광물 채광에 쓰입니다."
msgstr "Buat beliung dari logam dan kepala beliung dari logam. Gunakan untuk menambah mineral (Lv. 55 ke atas)."

msgid "금속괭이"
msgstr "Cangkul Logam"

msgid "금속괭이날"
msgstr "Pisau Cangkul Logam"

msgid "금속괭이와 금속괭이날을 만들 수 있습니다. 밭을 일구는 데 쓰입니다."
msgstr "Buat cangkul dari logam dan mata cangkul dari logam. Gunakan untuk menggarap lahan."

msgid "금속기둥"
msgstr "Pilar Logam"

msgid "금속날"
msgstr "Mata Pisau Logam"

msgid "금속덩어리"
msgstr "Bongkahan Logam"

msgid "금속도끼"
msgstr "Kapak Logam"

msgid "금속도끼날"
msgstr "Kepala Kapak Perang Logam"

msgid "금속도끼날보다 공격력이 높은 뼈톱도끼날을 만들 수 있습니다."
msgstr "Buat kepala kapak gergaji dari tulang, yang memiliki Serangan lebih tinggi daripada kepala kapak perang dari logam."

msgid "금속등자"
msgstr "Pengaduk Logam"

msgid "금속류"
msgstr "Logam"

msgid "금속막대"
msgstr "Tongkat Logam"

