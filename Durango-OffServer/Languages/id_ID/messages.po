msgid "보석을 10회 거친 연마 하세요."
msgstr "Poles kasar sebuah permata 10 kali."

msgid "보석을 10회 미세 연마 하세요."
msgstr "Poles halus sebuah permata 10 kali."

msgid "보석을 10회 추출하세요."
msgstr "Ekstrak sebuah permata 10 kali."

msgid "보석을 1회 거친 연마 하세요."
msgstr "Poles kasar sebuah permata 1 kali."

msgid "보석을 1회 미세 연마 하세요."
msgstr "Poles halus sebuah permata 1 kali."

msgid "보석을 1회 추출하세요."
