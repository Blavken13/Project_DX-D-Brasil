msgstr "Penambangan"

msgid "채광 I"
msgstr "Penambangan I"

msgid "채광 II"
msgstr "Penambangan II"

msgid "채광 III"
msgstr "Penambangan III"

msgid "채광 IV"
msgstr "Penambangan IV"

msgid "채광 V"
msgstr "Penambangan V"

msgid "채광 능력"
msgstr "Kemampuan Pertambangan"

msgid "채광 능력 증가"
msgstr "Buff Kemampuan Penambangan"

