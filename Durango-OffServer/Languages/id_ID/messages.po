msgid "부족원 최대 51명, 영토 개수 최대 60개"
msgstr "Maks. 51 anggota klan. Maks. 60 Wilayah Klan."

msgid "부족원 최대 52명, 영토 개수 최대 63개"
msgstr "Maks. 52 anggota klan. Maks. 63 Wilayah Klan."

msgid "부족원 최대 53명, 영토 개수 최대 66개"
