msgid "큰 모리체야자나무 나뭇잎"
msgstr "Daun Pohon Palem Moriche Lebar"

msgid "큰 물고기"
msgstr "Ikan Besar"

msgid "큰 바나나나무 나뭇잎"
msgstr "Daun Pohon Pisang Besar"

msgid "큰 바위"
