msgstr "{item_name} yang dikembangkan di {entity_name} pada {tile} di pulau {entity_region_name}, yang ditanam oleh {farmer_name} ({result})."

msgid "{entity_region_name} 섬 {tile} {entity_name}에 건축물 스탯 변화. 안락도: {comfort}, 항균력: {antibacterial}, 복잡도: {complexity}"
msgstr "{entity_name} pada {tile} dari statistik bangunan pulau {entity_region_name} telah berubah. Kenyamanan: {comfort}. Antibiotik: {antibacterial}. Kompleksitas: {complexity}."

msgid "{entity_region_name} 섬 {tile} {entity_name}에 분위기 효과 {mood_id} 변화. 레벨: {level}"
msgstr "{entity_name} pada {tile} dari efek nuansa pulau {entity_region_name} berubah ke {mood_id}. Level: {level}."

msgid "{entity_region_name} 섬 {tile} {entity_name}에 세트 효과 {set_id} 변화. 구성: {slots}"
msgstr "{entity_name} pada {tile} dari efek set pulau {entity_region_name} berubah ke {set_id}. Konten: {slots}."

msgid "{entity_region_name} 섬 {tile} 위치에서 {victim_entity_name} 에게 데미지를 줌. 데미지: {damage_value}, 피해자의 이전 체력: {before_hp}, 피해자의 이후 체력: {after_hp}, 가해자: {killer_entity_name}"
msgstr "Kerusakan diberikan di {victim_entity_name} pada {tile} pulau {entity_region_name}. Kerusakan: {damage_value}. HP korban sebelum: {before_hp}. HP korban sesudah: {after_hp}. Penyerang: {killer_entity_name}."

msgid "{entity_region_name} 섬 {tile} 위치의 레벨{level} {entity_name} 노후 되어 섬 정화로 자연 철거됨. 보관중인 아이템: {inventory_items}"
msgstr "Level {level} {entity_name} pada {tile} di pulau {entity_region_name} telah memburuk di luar perbaikan, jadi ini dihancurkan secara alami saat pulau dipulihkan. Item tersimpan: {inventory_items}."

msgid "{entity_region_name} 섬 {tile} 의 {entity_name} 세션({session_id}) 에서 {phase} 페이즈 시작"
msgstr "Fase {phase} dimulai dalam sesi {entity_name} ({session_id}) pada {tile} di Pulau {entity_region_name}."

msgid "{entity_region_name} 섬 {tile} 의 {entity_name} 세션({session_id}) 에서 {phase} 페이즈 의 - {wave} 웨이브 클리어"
msgstr "Gelombang {wave} pada fase {phase} di sesi {entity_name} ({session_id}) dihapus pada {tile} di Pulau {entity_region_name}."

msgid "{entity_region_name} 섬 {tile} 의 {entity_name} 세션({session_id}) 에서 {phase} 페이즈 클리어"
msgstr "Fase {phase} dihapusi dalam sesi {entity_name} ({session_id}) pada {tile} di Pulau {entity_region_name}."

msgid "{entity_region_name} 섬 {tile} 의 {entity_name} 세션({session_id}) 종료 ({phase} 페이즈 클리어)"
msgstr "Sesi {entity_name} ({session_id}) berakhir pada {tile} di Pulau {entity_region_name}. (Fase {phase} dihapus)"

msgid "{entity_region_name} 섬 {tile}에서 {entity_name} 인벤토리의 {from_section} 섹션 내에 {item_name} 제거. 사유: {item_popped_reason}"
msgstr "Di {tile} Pulau {entity_region_name}, {item_name} dihapus dari bagian {from_section} inventaris {entity_name}. Alasan: {item_popped_reason}."

msgid "{entity_region_name} 섬 {tile}에서 {entity_name} 인벤토리의 {into_section} 섹션에 {item_name} 추가, 잠금설정: {is_locked}, 사유: {item_added_reason}"
msgstr "Di {tile} Pulau {entity_region_name}, {item_name} ditambahkan ke bagian {into_section} inventaris {entity_name}. Status Kunci: {is_locked}, Alasan: {item_added_reason}."

msgid "{entity_region_name} 섬 {tile}에서 {entity_name} 인벤토리의 {item_name} 만료됨"
msgstr "{item_name} di inventaris {entity_name} sudah kedaluwarsa pada {tile} di pulau {entity_region_name}."

msgid "{faction:과} {level} 이상이어야 합니다."
msgstr "Harus level {level} atau lebih tinggi dengan {faction}."

msgid "{faction}에 요청한 {name}의 지원 결과를 확인하세요."
msgstr "Silakan periksa {faction} untuk dukungan dari {name} yang kamu minta."

msgid "{faction}에 지원 요청이 가능합니다."
msgstr "Kamu bisa meminta dukungan dari {faction}."

msgid "{first_owner_name}의 사과"
msgstr "Apel milik {first_owner_name}"

msgid "{from_region_role}-{from_region_name:이}({from_region_id}) {to_region_role}-{to_region_name:과}({to_region_id}) 연결"
msgstr "{from_region_role}-{from_region_name} ({from_region_id}) terhubung ke {to_region_role}-{to_region_name} ({to_region_id})."

msgid "{helper} 님이 {player} 님을 구조했습니다. 건강이 더 많이 회복됩니다."
msgstr "{player} telah diselamatkan oleh {helper}. Kesehatan tambahan telah dipulihkan."

