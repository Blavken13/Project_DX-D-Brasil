msgid "무기/도구제작 스킬을 Lv.60으로 성장시키세요."
msgstr "Capai level keterampilan produksi senjata/alat 60."

msgid "무기/도구제작스킬 숙련도 100% 이벤트"
msgstr "Level Keterampilan Produksi Senjata/Peralatan +100% Acara"

msgid "무기/도구제작스킬 숙련도 200% 이벤트"
msgstr "Level Keterampilan Produksi Senjata/Peralatan +200% Acara"

