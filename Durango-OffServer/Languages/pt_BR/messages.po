msgid "초대형 이정표"
msgstr "Placa de Direção Gigante"

msgid "초대형표지판"
msgstr "Placa Gigante"

msgid "초록 광택"
msgstr "Brilho Verde"

msgid "초록 미니 콤피 빈백"
msgstr "Minibolsa de Feijões do Compsognato Verde"

msgid "초록 빛깔의 보석 에메랄드. \"밤마다 지붕 위에서 빛나던 고양이의 눈.\""
msgstr "Pedra preciosa verde. “Como os olhos cintilantes de um predador perseguindo a luz da fogueira.”"

msgid "초록수영장"
