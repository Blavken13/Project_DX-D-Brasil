msgstr "<alert_icon> Você pode declarar um Domínio de Ilha Civilizada separadamente de um Domínio de Ilha Domada."

msgid "<cashshop_mileage>{amount:n0}</cashshop_mileage>{amount:-이} 부족합니다."
msgstr "<cashshop_mileage>{amount:n0}</cashshop_mileage> insuficiente."

msgid "<coin>{amount:n0}</coin>{amount:-이} 부족합니다."
msgstr "São necessários(as) mais <coin>{amount:n0}</coin>."

msgid "<em>'하데스, 숲, 해'</em> 이런 암호들요. 그래요. <em>회사의 진짜 목적</em>은 여기 숨겨져 있어요."
msgstr "Palavras-chave como <em>Hades, Floresta, Sol</em>... Estão todas neles.<em>O verdadeiro objetivo da Companhia</em>, escondido bem debaixo do nariz."

msgid "<em>'해님', '숲', '물', '깔때기'</em>… 암호가 회사랑 겹치네요."
msgstr "<em>Sol, Floresta, Água e Funil</em>... São as mesmas palavras-chave que a Companhia usa."

msgid "<em>15레벨 불안정섬</em>에서 제브라케라톱스를 포획할 수 있습니다."
msgstr "Você pode encontrar e capturar um Zebraceratops em uma <em>Ilha Instável de nível 15</em>."

msgid "<em>1600개</em>의 용량을 지닌 개인 창고입니다. 200개씩 8개의 공간으로 나뉘며, 각 공간에 이름을 부여할 수 있습니다."
msgstr "Esse armazém privado tem uma capacidade de <em>1.600</em>! Ele é dividido em 8 guias únicas, cada uma com 200 espaços."

msgid "<em>30레벨 성장 패키지</em>를 할인된 가격에 구매하세요."
msgstr "Compre o <em>Pacote de Progressão de Nível 30</em> com desconto."

msgid "<em>30일 동안</em> 난수 조각을 드립니다."
msgstr "Concede Fragmentos de Código por <em>30 dias</em>."

msgid "<em>30일 동안</em> 매일 프리미엄 바우처를 충전해 드립니다."
msgstr "Cupons de recarga diária premium por <em>30 dias</em>."

msgid "<em>30일간</em> 전체 스킬 계열 <em>54레벨</em>까지 적용"
msgstr "Aplica-se a todas as categorias de habilidade até o <em>nível 54</em> por até <em>30 dias</em>."

msgid "<em>45레벨</em> 이상의 불안정섬은 <em>도시섬</em>에서도 갈 수 있습니다."
msgstr "Você pode viajar para Ilhas Instáveis que estejam no <em>nível 45</em> ou superior a partir de uma <em>Ilha Civilizada</em>."

msgid "<em>5층</em>은 <em>숲</em>이에요. <em>숲</em>이 <em>5층</em>이에요."
msgstr "O <em>5º Andar</em> é a <em>Floresta</em>. A <em>Floresta</em> é o <em>5º Andar</em>."

msgid "<em>5층</em>은 듀랑고 곳곳에 영향을 미치고 있고요. 여기 있는 우리를 빼면요."
msgstr "A influência do <em>5º Andar</em> abrange todas as partes de Durango... A única exceção pode ser as pessoas reunidas aqui hoje."

msgid "<em>5층</em>은 우리가 워프에 휘말리도록 <em>유도</em>했어요. 회사와 위원회는 듀랑고에 파견된 <em>5층의 요원들</em>이고요."
msgstr "Mas o <em>5º Andar</em> sabia. Ele praticamente nos <em>jogou</em> no Portal. A Companhia, o Comitê... AMBOS são <em>agentes do 5º Andar</em>."

msgid "<em>5층</em>은 전부 알고 있었어요. 소름도 돋고 화도 나네요."
msgstr "O <em>5º Andar</em> sabia cada detalhe sobre ela. Só de ler fiquei com calafrios... e me deixou nervosa pra caramba."

msgid "<em>5층</em>이란 곳에서 지구에서 <em>언제, 어디서 워프가 일어날지 알고 있었어</em>."
msgstr "Alguma coisa chamada de <em>o 5º Andar sabia quando e onde os Portais ocorreriam</em> na Terra."

msgid "<em>60레벨 성장 패키지</em>를 할인된 가격에 구매하세요."
msgstr "Compre o <em>Pacote de Progressão de Nível 60</em> com desconto."

msgid "<em>6군도 첫번째 섬</em>섬을 탐색하여 <em>크레이터</em>를 발견하세요."
msgstr "Busque a <em>Cratera</em> na <em>primeira ilha do arquipélago 6</em>."

msgid "<em>7일간</em> 개인섬의 개척도 성장을 더욱 빠르게!"
msgstr "Aumente por <em>7 dias</em> a taxa com que o nível de pioneiro de sua Ilha Domada aumenta!"

msgid "<em>7일간</em> 개척 포인트 400% 보너스 구간 추가"
msgstr "Adiciona uma zona com um bônus de 400% de Pontos de Pioneiro por <em>7 dias</em>."

msgid "<em><help>{0}</help> 원하는 외형</em>이 나오려면?"
msgstr "<help>{0}</help> Como conseguir o <em>design desejado</em>?"

msgid "<em>BPM</em>을 입력하여 곡의 빠르기를 조절할 수 있습니다."
msgstr "Use as <em>BPM</em> para ajustar a velocidade da canção."

msgid "<em>D2E</em>가 발견된다면 듀랑고를 발칵 뒤집을 중대한 사건이지 않겠나? "
msgstr "A descoberta de um <em>DPT</em> viraria Durando de ponta cabeça!"

msgid "<em>D2E</em>라고 들어봤나? 지구로 통하는 입구을 가라키는 코드네임이라고 하던디."
