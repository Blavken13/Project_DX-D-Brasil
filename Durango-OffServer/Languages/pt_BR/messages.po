msgid "진흙 구할 수 있지?"
msgstr "Aterre as Mãos"

msgid "진흙 샘플이 필요합니다"
msgstr "Ponha a Mão na Massa"

msgid "진흙 채집 능력"
msgstr "Habilidade de Coletar Lama"

msgid "진흙 채집하기"
msgstr "Coletando Lama"

msgid "진흙구덩이"
msgstr "Poço de Lama"

msgid "진흙구덩이_tar_1x1"
msgstr "Poço de lama com alcatrão"

msgid "진흙을 100번 채집하세요."
