msgid "아이템 추가버튼을 눌러야 반영됩니다."
msgstr "Toque no botão Adicionar Item para implementar."

msgid "아이템 형식이 잘못되었습니다."
msgstr "Formato inválido do item."

msgid "아이템 회수"
msgstr "Coletar Item"

msgid "아이템 획득"
msgstr "Itens Adquiridos"

msgid "아이템과 건축물은 내구도가 있습니다."
msgstr "Itens e construções possuem Durabilidade limitada."

msgid "아이템과 레시피의 속성을 확인하세요.\n나뭇가지, 갈비뼈, 다리뼈 모두 막대 속성을 가지고 있습니다."
msgstr "Verifique a receita e atributos do item.\nGalhos, costelas e ossos de perna, todos têm o atributo bastão."

msgid "아이템마다 가공할 수 있는 횟수가 있습니다."
msgstr "Há um limite para quantas vezes você pode processar um item."

msgid "아이템을 가방에 확보합니다."
msgstr "Ponha o item a salvo na sua mochila."

msgid "아이템을 구매했습니다."
msgstr "Você comprou o item."

msgid "아이템을 꺼낼 수 있는 대상이 아닙니다."
msgstr "O item não pode ser recuperado."

msgid "아이템을 드래그해서 건물에 설치할 수 있습니다."
msgstr "Arraste itens para adicioná-los à construção."

msgid "아이템을 몇 번 더 가공할 수 있는지 표시합니다. 가공할 때마다 1씩 줄어들며, 가공 가능 횟수가 0일 때는 아이템을 더 이상 가공할 수 없습니다."
msgstr "Mostra quantas vezes um item pode ser processado. Cada vez que é processado diminui 1. Não será mais possível processar um item quando seu número chegar a 0."

msgid "아이템을 버리시겠습니까?"
msgstr "Descartar Item?"

msgid "아이템을 버릴 때는 신중해야 합니다.\n버린 아이템은 일정 시간이 지나면 사라집니다."
msgstr "Pense bem antes de descartar algum item.\nItens descartados irão desaparecer."

msgid "아이템을 버릴 장소를 선택하세요."
msgstr "Selecione um local para descartar esse item."

msgid "아이템을 선택하세요."
msgstr "Selecione um item."

msgid "아이템을 정말 버리시겠습니까?"
msgstr "Tem certeza de que deseja descartar esse item?"

msgid "아이템을 찾을 수 없습니다."
msgstr "Não é possível achar o item."

msgid "아이템을 통해 <em>과일샌드</em> 제작법을 배우고, <em>도시섬 부엌</em> 설치를 위해 <em>도시섬에 입장</em>하세요."
msgstr "Aprenda a fazer um <em>sanduíche de frutas</em> e <em>entre em uma Ilha Civilizada</em> para instalar uma <em>Cozinha de Ilha Civilizada</em>."

msgid "아이템을 통해 <em>도시 장인 양손 도끼</em> 제작법을 배우고 제작하세요. 제작 시 <em>무작위의 추가 공격력</em>을 획득합니다."
msgstr "Aprenda a fazer e produzir um <em>Machado de Duas Mãos Civilizado</em>. Cada machado ganha um <em>aumento de Ataque aleatório</em>."

msgid "아이템을 통해 <em>도시 장인 장창</em> 제작법을 배우고 제작하세요. 제작 시 <em>무작위의 추가 공격력</em>을 획득합니다."
msgstr "Aprenda a fazer e produzir uma <em>Lança Civilizada</em>. Cada lança ganha um <em>aumento de Ataque aleatório</em>."

msgid "아이템을 통해 <em>도시 장인 활</em> 제작법을 배우고 제작하세요. 제작 시 <em>무작위의 추가 공격력</em>을 획득합니다."
msgstr "Aprenda a fazer e produzir um <em>Arco Civilizado</em>. Cada arco ganha um <em>aumento de Ataque aleatório</em>."

msgid "아이템의 <em>속성</em>은 <em>가방</em>이나 <em>제작/건설</em> 과정에서 확인 가능합니다."
msgstr "Você pode ver os <em>atributos</em> de um item na <em>mochila</em> ou quando estiver <em>criando</em>."

msgid "아이템이 <em>가열됨</em> 속성을 갖도록 하는 <em>제작법</em>은 무엇입니까?"
msgstr "É assim que eu <em>crio</em> um item usando o atributo <em>Aquecido</em>?"

msgid "아이템이 존재하지 않습니다."
msgstr "Esse item não existe."

msgid "아이템이 지급되었습니다."
msgstr "O Item foi entregue."

msgid "아이템이 찜 목록에 등록되었습니다. \n 내 장터 > 찜 목록에서 확인 가능합니다"
msgstr "O item foi adicionado à sua Lista de Desejos.\nEle pode ser encontrado em Mercado > Lista de Desejos"

msgid "아이템이 회수되었습니다."
msgstr "O item foi coletado."

