msgid "<alert_icon/> 속성을 확정하기 전까지는 계속해서 속성을 변경할 수 있습니다."
msgstr "<alert_icon/> Atributos podem ser alterados até que você os confirme."

msgid "<alert_icon/> 속성을 확정하지 않으면 다음 속성을 얻을 수 없습니다."
msgstr "<alert_icon/> Você precisa confirmar os atributos anteriores para receber o próximo."

msgid "<alert_icon/> 오늘 무료로 습득 취소 가능한 횟수를 모두 사용했습니다."
