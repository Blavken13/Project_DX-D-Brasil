msgid "금속 탈황처리"
msgstr "Metal Dessulfurizado"

msgid "금속 판재"
msgstr "Tábua de Metal"

msgid "금속 합치기"
msgstr "Metal Combinado"

msgid "금속가공 패키지"
msgstr "Pacote de Metalurgia"

msgid "금속각도끼"
msgstr "Machado Angular de Metal"

msgid "금속각도끼 Ⅱ"
msgstr "Machado Angular de Metal II"

msgid "금속각도끼날"
msgstr "Cabeça de Machado Angular de Metal"

msgid "금속각도끼날 Ⅱ"
msgstr "Cabeça de Machado Angular de Metal II"

msgid "금속각진도끼날"
msgstr "Cabeça de Machado Angular de Metal"

msgid "금속각진칼날"
msgstr "Lâmina Angular de Faca de Metal"

msgid "금속경첩"
msgstr "Dobradiça de Metal"

msgid "금속곡괭이"
msgstr "Picareta de Metal"

msgid "금속곡괭이날"
msgstr "Cabeça de Picareta de Metal"

msgid "금속곡괭이와 금속곡괭이날을 만들 수 있습니다. Lv.55이상 광물 채광에 쓰입니다."
msgstr "Faz uma Picareta de Metal e uma Cabeça de Picareta de Metal. Use-as para extrair minerais. (Nv. 55 ou superior)."

msgid "금속괭이"
msgstr "Enxada de Metal"

msgid "금속괭이날"
msgstr "Lâmina de Enxada de Metal"

msgid "금속괭이와 금속괭이날을 만들 수 있습니다. 밭을 일구는 데 쓰입니다."
msgstr "Faz uma Enxada de Metal e uma Lâmina de Enxada de Metal. Use-as para Cultivar o Campo."

msgid "금속기둥"
msgstr "Pilar de Metal"

msgid "금속날"
msgstr "Lâmina de Metal"

msgid "금속덩어리"
msgstr "Fragmento de Metal"

msgid "금속도끼"
msgstr "Machado de Metal"

msgid "금속도끼날"
msgstr "Cabeça de Machado de Guerra de Metal"

msgid "금속도끼날보다 공격력이 높은 뼈톱도끼날을 만들 수 있습니다."
msgstr "Faz uma cabeça de machado de serra de osso que tem ataque superior ao de uma cabeça de machado de guerra de metal."

msgid "금속등자"
msgstr "Estribo de Metal"

msgid "금속류"
msgstr "Metais"

msgid "금속막대"
msgstr "Bastão de Metal"

msgid "금속막대 Ⅱ"
msgstr "Bastão de Metal II"

msgid "금속망치"
msgstr "Martelo de Metal"

msgid "금속망치머리"
msgstr "Cabeça de Martelo de Metal"

msgid "금속망치머리보다 공격력이 높은 대갈부수개망치머리을 만들 수 있습니다."
msgstr "Faz uma cabeça de martelo racha cuca com ataque superior ao de uma cabeça de martelo de metal."

msgid "금속못"
msgstr "Prego de Metal"

msgid "금속못 x 30"
msgstr "Prego de Metal x30"

msgid "금속못 Ⅱ"
msgstr "Prego de Metal II"

msgid "금속바늘"
msgstr "Agulha de Metal"

msgid "금속부속품"
msgstr "Acessórios de Metal"

msgid "금속부속품 x 10"
msgstr "Acessórios de Metal x10"

msgid "금속부속품 Ⅱ"
msgstr "Acessórios de Metal II"

msgid "금속부속품을 만들 수 있습니다. 금속부속품은 고급 금속 무기와 의상 제작에 쓰입니다."
msgstr "Faz Acessórios de Metal. Use-os para fazer armas e roupas avançadas."

msgid "금속삽"
msgstr "Pá de Metal"

msgid "금속삽과 금속삽날을 만들 수 있습니다. Lv.55이상 진흙을 채집할 때 쓰입니다."
msgstr "Faz uma pá de metal e uma lâmina de pá de metal. Use-as para coletar lama (Nv. 55 ou superior)."

msgid "금속삽날"
msgstr "Lâmina de Pá de Metal"

msgid "금속석쇠"
msgstr "Grelha de Metal"

msgid "금속소모품"
msgstr "Consumíveis de Metal"

msgid "금속에 반복적으로 열을 가해 순도를 높이는 법을 배웁니다. 금속의 <em>가벼움</em>과 <em>치밀한 구조</em> 속성이 올라갑니다."
msgstr "Aumenta a pureza aplicando calor repetidas vezes ao metal. Aumenta os atributos de <em>Leveza</em> e <em>Estrutura Compacta</em> do metal."

msgid "금속에 조개껍질을 넣고 가열해 황을 제거하는 법을 배웁니다. 금속의 <em>높은 밀도</em>속성이 올라갑니다."
msgstr "Remove enxofre ao aquecer uma mistura de metal e conchas de moluscos. Aumenta o atributo de <em>Alta Densidade</em> do metal."

msgid "금속에 탄소함유량을 낮춰 순도를 높이는 법을 배웁니다. 금속의 <em>낮은 밀도</em>와 <em>단단함</em> 속성이 올라갑니다."
msgstr "Aumenta a pureza diminuindo o conteúdo de carbono do metal. Aumenta os atributos de <em>Baixa Densidade</em> e <em>Firmeza</em> do metal."

msgid "금속연결뭉치"
msgstr "Argolas de Metal"

msgid "금속연결뭉치 x 20"
msgstr "Argolas de Metal x20"

msgid "금속연결뭉치를 만들 수 있습니다. 금속연결뭉치는 무기와 의상 제작에 쓰입니다."
msgstr "Faz Argolas de Metal. Use-as para fazer armas e roupas."

msgid "금속으로 된 표지판 날. \"이곳의 사람들처럼 자신이 있을 맥락을 잃어 버렸다.\""
msgstr "Metal de uma placa de trânsito. “Sem isso, as pessoas ficariam perdidas...”"

msgid "금속으로 만든 각도끼. \"도끼의 진짜 용도는 아무도 모른다.\""
msgstr "Machado angular feito de metal. “Derrube seus inimigos mais altos, árvores ou alguma outra coisa.”"

msgid "금속으로 만든 각도끼날. 한손도끼 조립에 쓴다. \"도끼는 오래 전부터 무기였다.\""
msgstr "Cabeça de machado angular feita de metal. Usado para criar machados de uma mão. “Um machado primitivo não é menos mortal do que um moderno.”"

msgid "금속으로 만든 거인면도칼. \"적도 당신처럼 두려울 것이다.\""
msgstr "Navalha gigante feita de metal. “Um pouco mais curta em cima.”"

msgid "금속으로 만든 거인면도칼날. 한손칼 조립에 쓴다. \"전시는 사람들이 평화에 지쳤을 때를 말한다.\""
msgstr "Lâmina de navalha gigante feia de metal. Usada para criar facas de uma mão. Alguns preferem morrer em batalha a morrer de tédio.”"

msgid "금속으로 만든 경첩. \"문을 닫는 게 옹졸해 보인다면 문턱을 높이는 것도 한 방법이다.\""
msgstr "Dobradiça feita de metal. “Se fechar portas não é o seu barato, você pode construir uma casa na árvore.”"

msgid "금속으로 만든 곡괭이. 채광 작업에 쓴다. \"단단한 암석에도 쉽게 상하지 않는다.\""
msgstr "Picareta feita de metal. Usada para minerar. “Ouvi dizer que estão fazendo uma de diamante.”"

msgid "금속으로 만든 곡괭이. 채광에 쓴다."
msgstr "Picareta feita de metal. Usada para minerar."

msgid "금속으로 만든 곡괭이날. 곡괭이 재료로 쓴다. \"금속이 금속을 부르는 순환이 완성되었다.\""
msgstr "Cabeça de picareta feita de metal. Usado para criar picaretas. “O metal pesado encontra o rock tradicional.”"

msgid "금속으로 만든 곡괭이날. 곡괭이 조립에 쓴다."
msgstr "Cabeça de picareta feita de metal. Usada para montar uma picareta."

msgid "금속으로 만든 괭이. 농사에 쓴다."
msgstr "Enxada feita de metal. Usada para cultivar."

msgid "금속으로 만든 괭이. 농사에 쓴다. \"흙은 금속을 감추고, 금속은 흙을 헤집는다.\""
msgstr "Enxada feita de metal. Usada para cultivar. “A terra enterra o metal, e o metal descobre a terra.”"

msgid "금속으로 만든 괭이날. 괭이 재료로 쓴다. \"쇠가 땅을 헤집어 놓네.\""
msgstr "Lâmina feita de metal. Usada para criar enxadas. “Os campos não vão saber o que os acertou.”"

msgid "금속으로 만든 괭이날. 괭이 조립에 쓴다."
msgstr "Lâmina de enxada feita de metal. Usada para montar uma enxada."

msgid "금속으로 만든 급조날."
msgstr "Lâmina improvisada feita de metal."

msgid "금속으로 만든 급조날. \"별 것 아닌 것 같지만 적어도 몇 만 년은 절약했다.\""
msgstr "Lâmina improvisada feita de metal. \"Tantos impérios sangrentos foram construídos com essa ferramenta tão humilde.\""

msgid "금속으로 만든 도끼. \"나무 입장에선 사람을 베는 게 더 좋을 지도 모른다.\""
msgstr "Machado feito de metal. “Se dependesse das árvores, nós é que seríamos cortados.”"

msgid "금속으로 만든 도끼. 제작법의 수준과 맞지 않는 도끼날을 사용하여 엉성하게 조립되었다."
msgstr "Machado feito de metal. Uma lâmina de machado inferior foi usada como material para esse item, o que resultou em uma qualidade medíocre."

msgid "금속으로 만든 도끼날. 한손 도끼 조립에 쓴다."
msgstr "Cabeça de machado feita de metal. Usada para montar um machado de uma mão."

msgid "금속으로 만든 도끼날. 한손도끼 조립에 쓴다. \"금속은 직설적이다.\""
msgstr "Cabeça de machado feita de metal. Usado para criar machados de uma mão. “O metal é o único caminho para fora dessa nova era das trevas.”"

msgid "금속으로 만든 막대."
msgstr "Bastão feito de metal."

msgid "금속으로 만든 막대. \"언젠가 주문량이 밀릴 것이다.\""
msgstr "Bastão feito de metal. “Eu imagino de que tipo de árvore essa coisa caiu...”"

msgid "금속으로 만든 망치. \"두드려라. 열릴 것이다.\""
msgstr "Martelo feito de metal. “Não tenha medo. Nada pode te deter agora.”"

msgid "금속으로 만든 망치. 제작법의 수준과 맞지 않는 망치머리를 사용하여 엉성하게 조립되었다."
msgstr "Martelo feito de metal. Uma cabeça de martelo inferior foi usada como material para esse item, o que resultou em uma qualidade medíocre."

msgid "금속으로 만든 망치머리. 한손망치 조립에 쓴다."
msgstr "Cabeça de martelo feita de metal. Usada para montar um martelo de uma mão."

msgid "금속으로 만든 망치머리. 한손망치 조립에 쓴다. \"철물점이 문명의 정수란 걸 알게 되었다.\""
msgstr "Cabeça de martelo feito de metal. Usada para criar martelos de uma mão. “Uma boa loja de ferragens é o centro de toda grande civilização.”"

msgid "금속으로 만든 못. \"못 한 개가 이리 귀한 것이었다.\""
msgstr "Prego feito de metal. “Se você gosta desse, espero pelo modelo mais avançado.”"

msgid "금속으로 만든 바늘."
msgstr "Agulha feita de metal."

msgid "금속으로 만든 바늘. 의류 제작에 쓴다. \"작은 금속이 첨예하다.\""
msgstr "Agulha feita de metal. Usada para costurar trajes. “A agulha clássica. Ah, se alguns dedais chegassem pelo portal...”"

msgid "금속으로 만든 벽."
msgstr "Parede feita de metal."

msgid "금속으로 만든 벽. 조립식 건축물인 벽집을 건축할 때 재료로 사용된다. \"방 안에 누워있으면 통조림 고기가 된 기분이다.\""
msgstr "Uma parede feita de aço. Usada como material para casas e abrigos que fizerem parte de construções pré-fabricadas. \"Entre e deite-se para ter a experiência de vida de uma sardinha enlatada.\""

msgid "금속으로 만든 삽."
msgstr "Pá feita de metal."

msgid "금속으로 만든 삽. 흙을 푸는 데 쓴다. \"굴착기의 원형은 여기서 나왔다.\""
msgstr "Pá feita de metal. Usada para descompactar o solo. “A escavadora original.”"

msgid "금속으로 만든 삽날. 삽 재료로 쓴다. \"흐르는 물에 삽날을 씻어라.\""
msgstr "Lâmina de pá feita de metal. Usada para criar pás. “Cada porção de terra é um passo mais perto para apagar o passado.”"

msgid "금속으로 만든 삽날. 삽 조립에 쓴다."
msgstr "Lâmina de pá feita de metal. Usada para montar uma pá."

msgid "금속으로 만든 석궁 등자. 석궁 조립에 쓴다."
msgstr "Estribo básico feito de metal. Usado para montar uma besta."

msgid "금속으로 만든 석궁. 제작법의 수준과 맞지 않는 재료를 사용하여 엉성하게 조립되었다."
msgstr "Besta feita de metal. Materiais de qualidade inferior foram usados nesse item, o que resultou em uma qualidade medíocre."

msgid "금속으로 만든 양동이. 물 또는 용암을 뜰 수 있다."
msgstr "Balde de metal. Use para carregar água ou lava."

msgid "금속으로 만든 양동이. 물 또는 용암을 뜰 수 있다. \"손에 넣을 수 없었던 모든 걸 이젠 놓치지 않는다.\""
msgstr "Balde feito de metal. Usado para carregar água ou lava. “Finalmente, um recipiente para coisas que antes se acreditava serem impossíveis de carregar!”"

msgid "금속으로 만든 양손 각도끼. \"인간끼리 서로 싫어함은 자연의 개체 수 조절이다.\""
msgstr "Machado angular de duas mãos feito de metal. “Controla a população de árvores e humanos com um único golpe. Ou muitos, em alguns casos.”"

msgid "금속으로 만든 양손 거인면도칼. \"칼춤을 추자.\""
msgstr "Navalha gigante de duas mãos feita metal. “Pronto para se barbear?”"

msgid "금속으로 만든 양손 도끼. \"생태계는 다시 주도권을 뺏기고 있다.\""
msgstr "Machado de duas mãos feito de metal. “A natureza não tem a menor chance contra a raça humana.”"

msgid "금속으로 만든 양손 도끼. 제작법의 수준과 맞지 않는 도끼날을 사용하여 엉성하게 조립되었다."
msgstr "Machado de duas mãos feito de metal. Uma lâmina de machado inferior foi usada como material para esse item, o que resultou em uma qualidade medíocre."

msgid "금속으로 만든 양손 망치. \"세상은 망치가 모루를 두들길 때 굴러 간다.\""
msgstr "Martelo de duas mãos feito de metal. “Cada martelada é um passo à frente para a humanidade.”"

msgid "금속으로 만든 양손 망치. 제작법의 수준과 맞지 않는 양손 망치머리를 사용하여 엉성하게 조립되었다."
msgstr "Martelo de duas mãos feito de metal. Uma cabeça de martelo de duas mãos inferior foi usada como material para esse item, o que resultou em uma qualidade medíocre."

msgid "금속으로 만든 양손 칼. \"1 더하기 1은 2가 아니다.\""
msgstr "Faca de duas mãos feita de metal. “ISSO é que é faca.”"

msgid "금속으로 만든 양손 칼. 제작법의 수준과 맞지 않는 칼날을 사용하여 엉성하게 조립되었다."
msgstr "Faca de duas mãos feita de metal. Uma lâmina de faca inferior foi usada como material para esse item, o que resultou em uma qualidade medíocre."

msgid "금속으로 만든 엉성한 쇠창문."
msgstr "Janela falsa feita de aço."

msgid "금속으로 만든 인식표. \"시간이 많이 지나 쓸모가 없어서 버리게 되길 소망한다.\""
msgstr "Uma chapa de identificação feita de metal. “O tipo de coisa que você espera nunca precisar.”"

msgid "금속으로 만든 인식표. 나의 이름이 적혀있다. \"시간이 많이 지나 쓸모가 없어서 버리게 되길 소망한다.\""
msgstr "Uma chapa de identificação feita de metal. O meu nome está escrito nela. “O tipo de coisa que você espera nunca precisar.”"

msgid "금속으로 만든 작살. 낚시에 쓴다. \"중금속 때문에 죽게 된다는 점은 같다.\""
msgstr "Arpão feito de metal. Usado para pescar. “Metal pesado... Brutal.”"

msgid "금속으로 만든 작살. 물고기를 잡을 때 쓴다."
msgstr "Arpão feito de metal. Usado para pescar."

msgid "금속으로 만든 창. \"금속은 살아 있지도 죽지도 않는다.\""
msgstr "Lança feita de metal. “Revestir a ponta das armas ainda é popular em Durango, apenas um pouco mais voltado para a produção de lanças.”"

msgid "금속으로 만든 창. 제작법의 수준과 맞지 않는 재료를 사용하여 엉성하게 제작되었다."
msgstr "Lança feita de metal. Materiais de qualidade inferior foram usados nesse item, o que resultou em uma qualidade medíocre."

msgid "금속으로 만든 창날. 창 재료로 쓴다. \"역사 교과서의 연표를 헷갈리게 할 것이다.\""
msgstr "Ponta de lança feita de metal. Usado para criar lanças. “O termo ‘ponta de lança’ tinha que vir de algum lugar.”"

msgid "금속으로 만든 창날. 창 조립에 쓴다."
msgstr "Ponta de lança feita de metal. Usada para montar uma lança."

msgid "금속으로 만든 칼. \"적의 칼날을 두려워하지 마라.\""
msgstr "Faca feita de metal. “Não tema a faca. Compreenda-a.”"

msgid "금속으로 만든 칼. 제작법의 수준과 맞지 않는 칼날을 사용하여 엉성하게 조립되었다."
msgstr "Faca feita de metal. Uma lâmina de faca inferior foi usada como material para esse item, o que resultou em uma qualidade medíocre."

msgid "금속으로 만든 칼날. 한손칼 조립에 쓴다."
msgstr "Lâmina de faca feita de metal. Usada para montar uma faca de uma mão."

msgid "금속으로 만든 칼날. 한손칼 조립에 쓴다. \"인간은 서로를 죽이는 방법을 계속 연구했다.\""
msgstr "Lâmina feita de metal. Usada para criar facas de uma mão. “Nada destaca mais a raça humana do que a guerra.”"

msgid "금속으로 만든 큰 각도끼날. 양손도끼 조립에 쓴다. \"나무들은 쓰러지든 서 있든 늘 말이 없다.\""
msgstr "Cabeça de machado angular feita de metal. Usado para criar machados de duas mãos. “Oh, os horrores que essas árvores já presenciaram...”"

msgid "금속으로 만든 큰 거인면도칼날. 양손칼 조립에 쓴다. \"펜은 칼보다 강하다. 펜잡이들이 칼도 들고 있으니까.\""
msgstr "Lâmina grande de navalha gigante feita de metal. Usada para criar facas de duas mãos. “Se as ações falam mais alto do que as palavras, como a pena pode ser mais poderosa que a espada?”"

msgid "금속으로 만든 큰 급조날."
msgstr "Lâmina grande improvisada feita de metal."

msgid "금속으로 만든 큰 급조날. \"석기와 철기의 등장 시점이 전보다 많이 좁혀졌다.\""
msgstr "Lâmina grande improvisada feita de metal. \"Primeiro, ferramentas de pedra, agora de metal! Não vai demorar muito para termos e-mail!\""

msgid "금속으로 만든 큰 도끼날. 양손 도끼 조립에 쓴다."
msgstr "Cabeça de machado grande feita de metal. Usada para montar um machado de duas mãos."

msgid "금속으로 만든 큰 도끼날. 양손도끼 조립에 쓴다. \"도끼의 이빨이 단단하게 여물었다.\""
msgstr "Cabeça de machado grande feita de metal. Usada para criar machados de duas mãos. “Mais pesado que o crânio de um tiranossauro, e com a mesma potência para esmagar.”"

msgid "금속으로 만든 큰 망치머리. 양손망치 조립에 쓴다."
msgstr "Cabeça de martelo feita de metal. Usada para montar um martelo de duas mãos."

msgid "금속으로 만든 큰 망치머리. 양손망치 조립에 쓴다. \"해머 갖고 와.\""
msgstr "Cabeça de martelo grande feito de metal. Usado para criar martelos de duas mãos. “Um nível abaixo do lendário martelo do ‘ban’.”"

msgid "금속으로 만든 큰 칼날. 양손칼 조립에 쓴다."
msgstr "Lâmina de faca grande feita de metal. Usada para montar uma faca de duas mãos."

msgid "금속으로 만든 큰 칼날. 양손칼 조립에 쓴다. \"도덕이란 특정한 강박이 있는 사람이 힘을 가진 상태를 말한다.\""
msgstr "Grande lâmina feita de metal. Usada para criar facas de duas mãos. “Se você consegue justificar a guerra, porque não pode se justificar?\""

msgid "금속으로 만든 톱."
msgstr "Serra feita de metal."

msgid "금속으로 만든 톱. 가공 작업에 쓴다. \"좋은 도구를 갖는 것 만으로도 기분 전환이 될 때가 있다.\""
msgstr "Serra feita de metal. Usada para processar. “Corta a maioria dos materiais como manteiga.”"

msgid "금속으로 만든 톱날. 톱 재료로 쓴다. \"그곳으로 다시 돌아갈 수 있다면 목수 일을 해보고 싶다.\""
msgstr "Lâmina de serra feita de metal. Usada. “Se eu pudesse voltar à Terra, seria um carpinteiro profissional.”"

msgid "금속으로 만든 톱날. 톱 조립에 쓴다."
msgstr "Lâmina feita de metal. Usada para montar uma serra."

msgid "금속으로 만든 활. 제작법의 수준과 맞지 않는 재료를 사용하여 엉성하게 조립되었다."
msgstr "Arco feito de metal. Materiais de qualidade inferior foram usados nesse item, o que resultou em uma qualidade medíocre."

msgid "금속으로 못, 바늘, 막대, 날, 큰 날 등의 소모품을 만들 수 있습니다. 금속 소모품은 무기, 의상, 건축물 제작에 쓰입니다."
msgstr "Faz consumíveis a partir do metal, tais como pregos, agulhas, lâminas e lâminas grandes. Use-os para fazer armas, roupas e construções."

msgid "금속으로 양동이를 만들 수 있습니다. 물 또는 용암을 뜰 수 있습니다."
msgstr "Faça um balde de metal. Usado para carregar água ou lava."

msgid "금속을 5번 채집하세요."
msgstr "Colete metal 5 vezes."

msgid "금속을 덧대어 만든 쇠 창문."
msgstr "Janela de Aço feita com camadas de metal."

msgid "금속을 반복 가열해 순도를 높인다."
msgstr "Aumente a pureza ao aquecer o metal repetidamente."

msgid "금속을 얼음진흙과 가열해 다른 성질로 탄소함유량을 낮춘다."
msgstr "Aumenta a pureza e reduz o conteúdo de carbono, aquecendo o metal com lama congelada."

msgid "금속을 용암에 넣어 더욱 치밀한 구조를 만든다."
msgstr "Processe metal em lava para conseguir uma estrutura mais compacta."

msgid "금속을 정련한 덩어리. \"열기를 뚫고 순수함만이 남았다.\""
msgstr "Fragmento de metal polido. “Nem tudo que reluz é ouro. Mas algumas coisas que reluzem ainda são bem valiosas.”"

msgid "금속을 조개껍질과 가열해 부식 원인인 황을 제거해 순도를 높인다."
msgstr "Aumente a pureza ao aquecer o metal e as conchas para remover o enxofre corrosivo."

msgid "금속을 조립한 도끼. \"베고 또 베리라.\""
msgstr "Machado feito de metal. “Chop, chop!”"

msgid "금속을 조립한 망치. \"긍정적인 것만 만들 수 있으면 좋겠다.\""
msgstr "Martelo feito de metal. “Com um martelo robusto e pregos suficientes, posso consertar qualquer coisa.”"

msgid "금속을 조립한 양손 도끼. \"거목이 쓰러져야 다른 식물에 기회가 생긴다.\""
msgstr "Machado de duas mãos feito de metal. “Quando uma árvore grande cai, as plantas abaixo dela saúdam a luz do sol.\""

msgid "금속을 조립한 양손 망치. \"문명의 요람에선 금속이 운다.\""
msgstr "Martelo de duas mãos feito de metal. “Construímos juntos os primeiros andaimes da civilização com martelos como este.”"

msgid "금속을 조립한 양손 칼. \"새로운 시대는 계속 문을 두드린다.\""
msgstr "Faca de duas mãos feita de metal. “Entrando em uma nova era, com um corte por vez.”"

msgid "금속을 조립한 칼. \"조립이란 단어는 참 스펙트럼이 넓다.\""
msgstr "Faca feita de metal. “Tecnologia Durangoniana de ponta.”"

msgid "금속을 진흙과 가열해 단단하고 무겁게 만든다."
msgstr "Adiciona peso e tenacidade ao esquentar metal com lama."

msgid "금속을 진흙과 가열해 탄소함유량을 낮춰 순도를 높인다."
msgstr "Aumente a pureza e reduza o conteúdo de carbono ao aquecer o metal com barro."

msgid "금속을 합쳐 금속 덩어리를 얻는다."
msgstr "Combine metais para criar um grande fragmento."

msgid "금속작살"
msgstr "Arpão de Metal"

msgid "금속작살을 만들 수 있습니다. Lv.55이상 물고기를 잡는 데 쓰입니다."
msgstr "Faz um Arpão de Metal. Use-o para pegar peixes. (Nv. 55 ou superior)."

msgid "금속절구"
msgstr "Almofariz de Metal"

msgid "금속절구를 만들 수 있습니다. 재료를 갈거나 빻고 으깰 수 있습니다. 고급 약 등을 만들려면 금속절구가 필요합니다."
msgstr "Faça um almofariz de metal. Use-o para misturar, moer e amassar ingredientes. Necessário para fazer remédios de qualidade, etc."

msgid "금속조각"
msgstr "Pedaço de Metal"

msgid "금속주괴"
msgstr "Lingote de Metal"

msgid "금속창"
msgstr "Lança de Metal"

msgid "금속창날"
msgstr "Ponta de Lança de Metal"

msgid "금속창날보다 공격력이 높은 뼈송이창날를 만들 수 있습니다."
msgstr "Faz uma ponta de lança com tiras de osso com ataque superior ao de um ponta de lança de metal."

msgid "금속칼"
msgstr "Faca de Metal"

msgid "금속칼날"
msgstr "Lâmina de Metal"

msgid "금속칼날보다 공격력이 높은 뼈솟칼날을 만들 수 있습니다."
msgstr "Faz uma lâmina de faca de presas que tem ataque superior ao de uma lâmina de metal."

msgid "금속톱"
msgstr "Serra de Metal"

msgid "금속톱과 금속톱날을 만들 수 있습니다. Lv.55이상 나무 채집과 재료 가공에 쓰입니다."
msgstr "Faz uma Serra de Metal e uma Lâmina de Serra de Metal. Use-as para coletar madeira (Nv. 55 ou superior) e processar materiais."

msgid "금속톱날"
msgstr "Lâmina de Serra de Metal"

msgid "금속파이프"
msgstr "Tubo de Metal"

msgid "금속판"
msgstr "Placa de Metal"

msgid "금속판재"
msgstr "Tábua de Metal"

msgid "금속판재 지붕"
msgstr "Telhado de Tábuas de Metal"

msgid "금속판재로 만든 지붕."
msgstr "Telhado feito de tábuas de metal."

msgid "금속판재로 만든 지붕. 조립식 건축물인 막사와 벽집을 건축할 때 재료로 사용된다. \"여기에 올려지기까지 많은 갈등이 있었다.\""
msgstr "Telhado feito de tábuas de metal. Usado como material para casas e abrigos que fizerem parte de construções pré-fabricadas. \"Vai dar um trabalhinho colocar isso em cima de uma casa.\""

msgid "금액 설정"
msgstr "Configurações de Preço"

msgid "금으로 도금한 망치. \"이런 게 만들어진다는 건 수요가 있단 뜻이겠지.\""
msgstr "Martelo banhado a ouro. “Só porque algo é útil não significa que também não possa ser fabuloso.”"

msgid "금은 녹이 잘 슬지 않고 쓸모가 많아서 돈 역할을 했어."
msgstr "Raridade, resistência à ferrugem e versatilidade tornaram o ouro uma escolha ideal para moedas na Terra."

msgid "금지"
msgstr "Bloqueada"

msgid "급소찌르기"
msgstr "Golpe Traiçoeiro"

msgid "급소찌르기 I"
msgstr "Golpe Traiçoeiro I"

msgid "급소찌르기 II"
msgstr "Golpe Traiçoeiro II "

msgid "급소찌르기 III"
msgstr "Golpe Traiçoeiro III"

msgid "급소찌르기 IV"
msgstr "Golpe Traiçoeiro IV"

msgid "급소찌르기: 관통 I"
msgstr "Golpe Traiçoeiro: Penetração I"

msgid "급소찌르기: 관통 II"
msgstr "Golpe Traiçoeiro: Penetração II"

msgid "급소찌르기: 관통 III"
msgstr "Golpe Traiçoeiro: Penetração III"

msgid "급소찌르기가 상대의 방어를 관통할 확률을 높입니다."
msgstr "Aumenta a Taxa de Penetração do Golpe Traiçoeiro."

msgid "급소찌르기의 피해량을 늘립니다."
msgstr "Aumenta o dano do Golpe Traiçoeiro."

msgid "급수 시설에 물이 충전되지 않았습니다."
msgstr "Você deve abastecer a reserva de água primeiro."

msgid "급수량"
msgstr "Reserva de Água"

msgid "급수시설로 밭에 뿌려 작물의 수확을 더 늘리는 액체비료."
msgstr "Fertilizante líquido misturado no aqueduto para aumentar a sua colheita."

msgid "급조 {item} 통조림"
msgstr "{item} Enlatado(a) Improvisado(a)"

msgid "급조 통조림"
msgstr "Comida Enlatada Improvisada"

msgid "급조 통조림을 10번 제작하세요."
msgstr "Criar comida enlatada improvisada 10 vezes."

msgid "급조 통조림을 만들 수 있습니다. 크게 보존기간이 늘어나는 대신 음식 재료의 일부 효과가 줄어듭니다."
msgstr "Faz comida enlatada improvisada. Prolonga sua validade, mas os efeitos dos ingredientes diminuirão um pouco."

msgid "급조 환약"
msgstr "Pílula Improvisada"

msgid "급조 환약을 만들 수 있습니다. 급조 환약은 허브차보다 많은 건강을 회복시킵니다."
msgstr "Faz uma pílula improvisada. Use-a para restaurar mais Saúde do que com Chá de Ervas."

msgid "급조한 고기망치"
msgstr "Martelo de Carne Improvisado"

msgid "급조한 금속도끼"
msgstr "Machado de Metal Improvisado"

msgid "급조한 금속망치"
msgstr "Martelo de Metal Improvisado"

msgid "급조한 금속칼"
msgstr "Faca de Metal Improvisada"

msgid "급조한 나무망치"
msgstr "Martelo de Madeira Improvisado"

msgid "급조한 나무활"
msgstr "Arco de Madeira Improvisado"

msgid "급조한 나무활을 만들 수 있습니다."
msgstr "Faz um Arco de Madeira Improvisado."

msgid "급조한 돌도끼"
msgstr "Machado de Pedra Improvisado"

msgid "급조한 돌망치"
msgstr "Martelo de Pedra Improvisado"

msgid "급조한 돌칼"
msgstr "Faca de Pedra Improvisada"

msgid "급조한 뼈도끼"
msgstr "Machado de Osso Improvisado"

msgid "급조한 뼈망치"
msgstr "Martelo de Osso Improvisado"

msgid "급조한 뼈칼"
msgstr "Faca de Osso Improvisada"

msgid "급조한 양손 고기망치"
msgstr "Martelo de Carne de Duas Mãos Improvisado"

msgid "급조한 양손 금속도끼"
msgstr "Machado de Metal de Duas Mãos Improvisado"

msgid "급조한 양손 금속망치"
msgstr "Martelo de Metal de Duas Mãos Improvisado"

msgid "급조한 양손 금속칼"
msgstr "Faca de Metal de Duas Mãos Improvisada"

msgid "급조한 양손 돌도끼"
msgstr "Machado de Pedra de Duas Mãos Improvisado"

msgid "급조한 양손 돌망치"
msgstr "Martelo de Pedra de Duas Mãos Improvisado"

msgid "급조한 양손 돌칼"
msgstr "Faca de Pedra de Duas Mãos Improvisada"

msgid "급조한 양손 뼈도끼"
msgstr "Machado de Osso de Duas Mãos Improvisado"

msgid "급조한 양손 뼈망치"
msgstr "Martelo de Osso de Duas Mãos Improvisado"

msgid "급조한 양손 뼈칼"
msgstr "Faca de Osso de Duas Mãos Improvisada"

msgid "급조한 양손도끼"
msgstr "Machado Duas Mãos Improvisado"

msgid "급조한 양손망치"
msgstr "Martelo de Duas Mãos Improvisado"

msgid "급조한 양손칼"
msgstr "Faca de Duas Mãos Improvisada"

msgid "급조한 한손도끼"
msgstr "Machado de Uma Mão Improvisado"

msgid "급조한 한손망치"
msgstr "Martelo de Uma Mão Improvisado"

msgid "급조한 한손칼"
msgstr "Faca de Uma Mão Improvisada"

msgid "급하게 만들고 있는 게 있나봐. 무전으로 그쪽 지역 근처에서 <em>{item_0}</em> 부탁하는 연락이 왔거든. 베테랑 선원들은 배에 물이 들어차도 판떼기 들고 와서 못질로 막던데. 그런 멘털이 이 시대에 필요하지. 당신도 그랬으면 하고."
msgstr "Eu acabei de receber uma transmissão daquela área pedindo por <em>{item_0}s</em>. Parece que eles estão tentando construir algo. Mesmo quando se está sozinho em mar aberto, um marinheiro pode parar um vazamento com tábuas e pregos. A sua geração poderia aprender algo."

msgid "급한 불은 껐어요. 다른 개척자들도 땔감을 준비하기 위해 작업 도끼를 챙기고 있답니다."
msgstr "Nós acendemos a fogueira o quanto antes. Os outros pioneiros estão saindo com seus machados para encontrar mais lenha, então acredito que as coisas só vão melhorar."

msgid "급한대로 만든 양손도끼."
msgstr "Machado de duas mãos feito às pressas."

msgid "급한대로 만든 양손망치."
msgstr "Martelo de duas mãos feito às pressas."

msgid "급한대로 만든 양손칼."
msgstr "Faca de duas mãos feita às pressas."

msgid "급한대로 만든 한손도끼."
msgstr "Machado de uma mão feito às pressas."

msgid "급한대로 만든 한손망치."
msgstr "Martelo de uma mão feito às pressas."

msgid "급한대로 만든 한손칼."
msgstr "Faca de uma mão feita às pressas."

msgid "급한대로 만든 활."
msgstr "Arco feito às pressas."

msgid "긍정도 부정도 하지 않으마."
msgstr "Não posso confirmar nem negar isso."

msgid "긍정적으로 생각해야지."
msgstr "Tente ser mais otimista, certo?"

msgid "기가스"
msgstr "Gigantes"

msgid "기간"
msgstr "Duração"

msgid "기간 내 구매 가능 갯수 테스트"
msgstr "Teste de Limite de Compra dentro de um período especificado"

msgid "기간 연장"
msgstr "Duração Aumentada"

msgid "기간이 지난 건축법 입니다."
msgstr "Este projeto não está mais ativo."

msgid "기간이 지난 제작법 입니다."
msgstr "Esse padrão não está mais ativo."

msgid "기간제 건물은 무법섬에 건설하거나 배치할 수 없습니다."
msgstr "Construções com um limite de tempo não podem ser erguidas ou colocadas em Ilhas Selvagens."

msgid "기간제 건물은 수리할 수 없습니다."
msgstr "Itens com prazo não podem ser reparados."

msgid "기간제 단시간 패키지 (테스트)"
msgstr "Pacote de Curto Prazo Limitado (Teste)"

msgid "기간제 아이템은 수리할 수 없습니다."
msgstr "Itens com prazo não podem ser reparados."

msgid "기강으로 따지자면 둥지가 훨씬 엉망진창이란다."
msgstr "No que diz respeito à disciplina, o Ninho é uma balbúrdia."

msgid "기계 마스크"
msgstr "Máscara de Mecânico"

msgid "기계 마스크 외형장비"
msgstr "Máscara Mecânica (Decorativa)"

msgid "기계가 쓸 것 같진 않은 모자. \"일부 기계는 모욕이라 느낄 것이다.\""
msgstr "Montado de peças quebradas. “É um design muito feio que as máquinas acham ofensivo.”"

msgid "기계가 쓸 것 같진 않은 모자. 다른 옷 위에 입을 수 있다. \"일부 기계는 모욕이라 느낄 것이다.\""
msgstr "Montada com peças quebradas. Pode ser usada por cima de outras roupas. “É um design muito feio que as máquinas acham ofensivo.”"

msgid "기관포는 잡았지만, <em>사일로</em>까지 아직 저항이 거셉니다!"
msgstr "A metralhadora virou sucata, mas eles ainda estão bloqueando o caminho para o <em>silo</em> com tudo que têm!"

msgid "기기 연동에 실패했습니다. 에러코드: {0}"
msgstr "Falha ao vincular o dispositivo. Código do Erro: {0}"

msgid "기기 이상을 일으키는 무전 통신 중계소를 점검한다. "
msgstr "Inspecione a estação de retransmissão de rádio que está causando problemas com o equipamento."

msgid "기껏 갔는데 안 됐으면 시간 허탕치는 거잖아."
msgstr "Qual a utilidade de ir até aí se os dados não estiverem prontos?"

msgid "기능 활성화 보상"
msgstr "Recompensa de Ativação de Recurso"

msgid "기능성 작물"
msgstr "Planta Funcional"

msgid "기니"
msgstr "Guiné"

msgid "기다리는 동안 다이어울프를 다룬 생물학 책을 찾아봤지. 괴팍한 습성에 관한 기록은 없던데 이참에 개정할 구석이 있겠어.  "
