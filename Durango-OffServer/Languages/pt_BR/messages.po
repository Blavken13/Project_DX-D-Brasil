msgid "고무나무에서 얻은 고무액. \"생태계는 인간의 가장 큰 채권자이다.\""
msgstr "Borracha líquida de uma seringueira. “Um dia, o ecossistema será o maior credor da humanidade.”"

msgid "고무로 만든 고무 작업모. 기름 안개를 막아주고, 기름독을 효과적으로 예방해 준다. \"1.5리터들이의 주름이 사라지면 우리도 사라진다.\""
msgstr "Chapéu de trabalho feito de borracha. Protege contra a névoa de óleo e previne a toxicidade do óleo com eficiência. \"As garrafas de plástico possivelmente perdurarão muito além da humanidade.\""

msgid "고무로 만든 고무 작업복. 기름 안개를 막아주고, 기름독을 효과적으로 예방해 준다. \"연약한 육체는 진보를 향한 레버리지이다.\""
msgstr "Traje de trabalho feito de borracha. Protege contra a névoa de óleo e previne a toxicidade do óleo com eficiência. \"A busca sem fim pelo aperfeiçoamento é, no fundo, uma resposta à fragilidade humana básica.\""

msgid "고무로 만든 비어 있는 아이스박스. 음식을 보관할 수 있다. \"채워야 할 아이스박스가 있다면 인생에 뭐가 더 필요하겠는가\""
msgstr "Cooler de borracha vazio. Comida pode ser armazenada dentro dele. \"Tudo o que alguém precisa é de um cooler para manter suas comidas favoritas fresquinhas.\""

msgid "고무로 만든 작업모. <em>가혹한 기름 안개를 막고</em>, <em>위협적인 기름독을 예방</em>해 준다."
msgstr "Chapéu de trabalho feito de borracha. <em>Obstrui uma névoa de óleo nociva</em> e <em>previne a prejudicial toxicidade do óleo</em>."

msgid "고무로 만든 작업복. <em>가혹한 기름 안개를 막고</em>, <em>위협적인 기름독을 예방</em>해 준다."
msgstr "Traje de trabalho feito de borracha. <em>Obstrui uma névoa de óleo nociva</em> e <em>previne a toxicidade do óleo prejudicial</em>."

