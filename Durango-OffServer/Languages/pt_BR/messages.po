msgid "돌도끼날"
msgstr "Cabeça de Machado de Pedra"

msgid "돌도끼날보다 공격력이 높은 뼈도끼날을 만들 수 있습니다."
msgstr "Faz uma cabeça de machado de osso que tem ataque superior ao de uma cabeça de machado de pedra."

msgid "돌로 만든 경첩. \"문이 닫힌다고 문 밖의 세상이 사라지진 않는다.\""
msgstr "Dobradiça feita de pedra. “O mundo lá fora não desaparece atrás de uma porta fechada.”"

msgid "돌로 만든 곡괭이. 채광 작업에 쓴다. \"돌에는 돌.\""
msgstr "Picareta feita de pedra. Usada para minerar. “Algumas pedras são mais fortes do que outras.”"

msgid "돌로 만든 곡괭이. 채광에 쓴다."
msgstr "Picareta feita de pedra. Usada para minerar."

msgid "돌로 만든 괭이. 농사에 쓴다."
msgstr "Enxada feita de pedra. Usada para cultivar."

msgid "돌로 만든 괭이. 농사에 쓴다. \"흙에서 자란 돌로 흙을 버무린다.\""
msgstr "Enxada feita de pedra. Usada para cultivar. “Nascida da terra para ajudar a terra.”"

msgid "돌로 만든 급조날."
msgstr "Lâmina improvisada feita de pedra."

msgid "돌로 만든 급조날. \"모든 게 다시 시작이다.\""
msgstr "Lâmina feita de pedra. \"Vamos começar do início.\""

msgid "돌로 만든 도끼. \"숲을 없애다 보면 숲을 좋아하게 된다.\""
msgstr "Machado feito de pedra. “Às vezes, é impossível não se apaixonar pela floresta que você está destruindo.”"

msgid "돌로 만든 도끼. 제작법의 수준과 맞지 않는 도끼날을 사용하여 엉성하게 조립되었다."
msgstr "Machado feito de pedra. Uma lâmina de machado inferior foi usada como material para esse item, o que resultou em uma qualidade medíocre."

msgid "돌로 만든 도끼날. 한손 도끼 조립에 쓴다."
msgstr "Cabeça de machado feita de pedra. Usada para montar um machado de uma mão."

msgid "돌로 만든 도끼날. 한손도끼 조립에 쓴다. \"1억 번 두드려 안 넘어가는 나무 없다.\""
msgstr "Cabeça de machado feita de pedra. Usado para criar machados de uma mão. “Com grandes machadadas se derruba até um prédio.”"

msgid "돌로 만든 망치. \"만들고 고칠 게 참 많다.\""
msgstr "Martelo feito de pedra. “Pare, hora... do martelo e de evitar a violação de direitos autorais.”"

msgid "돌로 만든 망치. 제작법의 수준과 맞지 않는 망치머리를 사용하여 엉성하게 조립되었다."
msgstr "Martelo feito de pedra. Uma cabeça de martelo inferior foi usada como material para esse item, o que resultou em uma qualidade medíocre."

msgid "돌로 만든 망치머리. 한손망치 조립에 쓴다."
msgstr "Cabeça de martelo feita de pedra. Usada para montar um martelo de uma mão."

msgid "돌로 만든 망치머리. 한손망치 조립에 쓴다. \"세상에 도움이 되기를.\""
msgstr "Cabeça de martelo feita de pedra. Usada para criar martelos de uma mão. “Uma parte é mira, o resto é só força bruta.”"

msgid "돌로 만든 못. \"누군가의 가슴에 박지는 말자.\""
msgstr "Prego feito de pedra. “Eles me pediram para criar algo para conectar as peças de madeira. Mandei bem!”"

msgid "돌로 만든 바닥."
msgstr "Piso feito de pedra."

msgid "돌로 만든 바닥. 조립식 건축물인 벽집을 건축할 때 재료로 사용된다. \"침대와 겨울만 해결하면 완벽하다.\""
msgstr "Piso feito de pedra. Usado como material para casas e abrigos que fizerem parte de construções pré-fabricadas. \"Uma escolha excelente se você planeja ficar na cama o inverno todo.\""

msgid "돌로 만든 벽."
msgstr "Parede feita de pedra."

msgid "돌로 만든 벽. 조립식 건축물인 벽집을 건축할 때 재료로 사용된다. \"성긴 틈 사이로 오래 된 노래가 분다.\""
msgstr "Parede feita de pedra. Usada como material para casas e abrigos que fizerem parte de construções pré-fabricadas. \"Uma canção antiga sopra pelas rachaduras.\""

msgid "돌로 만든 양손 도끼. \"벌목꾼들의 민요가 음악 교과서에 수록될 즈음에야 나무의 개체 수는 늘 것이다.\""
msgstr "Machado de duas mãos feito de pedra. “Não consegue ver a floresta por causa das árvores? Eu posso resolver isso...”"

msgid "돌로 만든 양손 도끼. 제작법의 수준과 맞지 않는 도끼날을 사용하여 엉성하게 조립되었다."
msgstr "Machado de duas mãos feito de pedra. Uma lâmina de machado inferior foi usada como material para esse item, o que resultou em uma qualidade medíocre."

msgid "돌로 만든 양손 망치. \"세상은 나아간다.\""
msgstr "Martelo de duas mãos feito de pedra. “Abrindo o caminho.”"

msgid "돌로 만든 양손 망치. 제작법의 수준과 맞지 않는 양손 망치머리를 사용하여 엉성하게 조립되었다."
msgstr "Martelo de duas mãos feito de pedra. Uma cabeça de martelo de duas mãos inferior foi usada como material para esse item, o que resultou em uma qualidade medíocre."

msgid "돌로 만든 양손 칼. 제작법의 수준과 맞지 않는 칼날을 사용하여 엉성하게 조립되었다."
msgstr "Faca de duas mãos feita de pedra. Uma lâmina de faca inferior foi usada como material para esse item, o que resultou em uma qualidade medíocre."

msgid "돌로 만든 작업용 날."
msgstr "Lâmina de trabalho feita de pedra."

msgid "돌로 만든 작업용 날. \"모든 게 다시 시작이다.\""
msgstr "Lâmina feita de pedra. Usada para várias tarefas. “Vamos começar do início.”"

msgid "돌로 만든 창. \"길 가다 잃어 버려도 유물로 발견될 거다.\""
msgstr "Lança feita de pedra. “Se funcionou com os homens das cavernas, vai funcionar com você.”"

msgid "돌로 만든 창날. 창 재료로 쓴다. \"훗날의 아이들이 우리 시대를 구석기 시대라 부르지 않았으면 좋겠다.\""
msgstr "Ponta de lança feita de pedra. Usado como material para lanças. “Espero que as gerações futuras não chamem essa época de Idade da Pedra.”"

msgid "돌로 만든 창날. 창 조립에 쓴다."
msgstr "Ponta de lança feita de pedra. Usada para montar uma lança."

msgid "돌로 만든 칼. \"선사 시대에 온 걸 환영한다.\""
msgstr "Faca feita de pedra. “Bem-vindo à era pré-histórica.”"

msgid "돌로 만든 칼. 제작법의 수준과 맞지 않는 칼날을 사용하여 엉성하게 조립되었다."
msgstr "Faca feita de pedra. Uma lâmina de faca inferior foi usada como material para esse item, o que resultou em uma qualidade medíocre."

msgid "돌로 만든 칼날. 한손칼 조립에 쓴다."
msgstr "Lâmina de faca feita de pedra. Usada para montar uma faca de uma mão."

msgid "돌로 만든 칼날. 한손칼 조립에 쓴다. \"칼을 처음 만든 사람은 칼에 반대했을까?\""
msgstr "Lâmina de osso para criar facas de uma mão. “Pode ser que a gente nunca descubra se a primeira foi inventada para coletar recursos ou para a guerra.”"

msgid "돌로 만든 큰 급조날."
msgstr "Lâmina grande improvisada feita de pedra."

msgid "돌로 만든 큰 급조날. \"아마 최초는 돌날이 작다고 클레임을 건 사람들 때문이었을 거다.\""
msgstr "Lâmina grande improvisada feita de pedra. \"Alguém tinha que ter a espada maior...\""

msgid "돌로 만든 큰 도끼날. 양손 도끼 조립에 쓴다."
msgstr "Cabeça de machado grande feita de pedra. Usada para montar um machado de duas mãos."

msgid "돌로 만든 큰 도끼날. 양손도끼 조립에 쓴다. \"돌덩이가 굴러 떨어지는 날 60년대는 시작됐다.\""
msgstr "Cabeça de machado grande. Usado para criar machados de duas mãos. “Mais uma piadinha sobre machados e vou cortar a sua cabeça.”"

msgid "돌로 만든 큰 망치머리. 양손망치 조립에 쓴다."
msgstr "Cabeça de martelo feita de pedra. Usada para montar um martelo de duas mãos."

msgid "돌로 만든 큰 망치머리. 양손망치 조립에 쓴다. \"뭐든 잘 때려 넣을 것 같다.\""
msgstr "Cabeça de martelo grande feito de pedra. Usado para criar martelos de duas mãos. “Ideal para brincar de pancadas com dinossauros.”"

msgid "돌로 만든 큰 칼날. 양손칼 조립에 쓴다."
msgstr "Lâmina de faca grande feita de pedra. Usada para montar uma faca de duas mãos."

msgid "돌로 만든 큰 칼날. 양손칼 조립에 쓴다. \"빛이 나는 돌을 별이라 한다.\""
msgstr "Lâmina de faca grande feita de pedra. Usada para criar facas de duas mãos. “Pau e pedra etc.”"

msgid "돌로 만든 톱."
msgstr "Serra feita de pedra."

msgid "돌로 만든 톱. 가공 작업에 쓴다. \"톱니가 거칠지만 켜는 데 나쁘지 않다.\""
msgstr "Serra feita de pedra. Usada para processar. “Um pouco rústica, mas faz um bom trabalho.”"

msgid "돌로 만든 톱날. 톱 조립에 쓴다."
msgstr "Lâmina feita de pedra. Usada para montar uma serra."

msgid "돌로 만든 톱날. 톱재료로 쓴다. \"켜고 켜라.\""
msgstr "Lâmina de serra feita de pedra. Usada para criar serras. “Baterias não são necessárias.”"

msgid "돌로 만든 한손검"
msgstr "Espada de Pedra de Uma Mão"

msgid "돌론"
msgstr "Dolon"

msgid "돌리기"
msgstr "Girar"

msgid "돌망치"
msgstr "Martelo de Pedra"

msgid "돌망치머리"
msgstr "Cabeça de Martelo de Pedra"

msgid "돌망치머리보다 공격력이 높은 뼈망치머리를 만들 수 있습니다."
msgstr "Faz uma cabeça de martelo de osso com ataque superior ao de uma cabeça de martelo de pedra."

msgid "돌머리 대형망치"
msgstr "Martelo de Pedra Gigante"

msgid "돌머리 망치"
msgstr "Martelo de Pedra"

msgid "돌멩이"
msgstr "Seixo"

msgid "돌멩이 구해주세요"
msgstr "Mais Vale um Seixo na Mão do que Dois Voando"

msgid "돌멩이 채집하기"
msgstr "Coletando Seixos"

msgid "돌멩이 판재"
msgstr "Tábua de Seixo"

msgid "돌멩이, 바위"
msgstr "Seixo e Pedregulho"

msgid "돌멩이나 바위를 지지하고 있던 돌부리. 평범하게 돌로 사용할 수 있다."
msgstr "Pedra irregular que já apoiou uma rocha ou pedregulho. Pode ser usada como uma pedra normal."

msgid "돌멩이를 300번 채집하세요."
msgstr "Coletar 300 seixos."

msgid "돌멩이를 30번 채집하세요."
msgstr "Coletar 30 seixos."

msgid "돌멩이를 90번 채집하세요."
msgstr "Coletar 90 seixos."

msgid "돌멩이를 돌날로 새로 만들어\n도끼날의 재료로 씁니다."
msgstr "Transforme o seixo em uma nova lâmina de pedra\nque você pode usar para confeccionar um machado."

msgid "돌멩이를 레벨별로 가져보자"
msgstr "Ganhe um seixo sempre que subir de nível"

msgid "돌멩이를 이용해 돌날을 만들 수 있습니다. 자연물을 채집하거나 제작에 쓰입니다."
msgstr "Faz uma lâmina de pedra com seixos. Use para coletar recursos naturais e criar."

msgid "돌멩이를 채집할 수 있습니다. 돌멩이로 돌날 등 도구를 만들 수 있습니다."
msgstr "Coleta seixo. Usado para fazer ferramentas como lâminas de pedra."

msgid "돌못"
msgstr "Prego de Pedra"

msgid "돌무늬"
msgstr "Padrão de Pedra"

msgid "돌부리"
msgstr "Pedra Irregular"

msgid "돌아가면 모두에게 사과해야겠지?"
msgstr "Devo pedir desculpas para o pessoal quando eu voltar?"

msgid "돌아오면 다시 무덤으로 보내고 싶을걸? 허허."
msgstr "Aposto que se isso acontecesse, você não demoraria a mandá-lo de volta, haha."

msgid "돌아오면 분명한 의도를 파악해야 해. 그 계집은 어릴 때부터 거짓말을 잘 했어."
msgstr "Vamos ter que comprovar as suas reais intenções quando ela voltar. Não vai ser fácil. Ela mente muito bem desde nova."

msgid "돌아온 개척자"
msgstr "Pioneiro Pródigo"

msgid "돌을 다듬어 만든 판재. "
msgstr "Prancha esculpida em pedra."

msgid "돌을 다듬은 판재. \"돌도 참 다루기 나름이다.\""
msgstr "Feito de pedra lascada. “Trabalhar com pedra pode ser uma verdadeira ameaça. Depende de como você lida com isso.\""

msgid "돌을 쌓아서 등대를 만든다"
msgstr "Junte pedras para construir um farol."

msgid "돌을 잘 다듬은 판재. 안락도를 추가로 올릴 수 있다."
msgstr "Feito de pedra bem lascada."

msgid "돌을 조립한 도끼. \"나무는 저항하지 않는다.\""
msgstr "Machado feito de pedra. “Parece que enfim a pedra venceu o papel.”"

msgid "돌을 조립한 망치. \"망치가 망치는 게 뭐가 있을까?\""
msgstr "Martelo feito de pedra. “Eu pus a pedra no cabo. Agora, estou invencível!”"

msgid "돌을 조립한 양손 도끼. \"나무가 아무 말 않는 게, 도끼에 동의하는 건 아니다.\""
msgstr "Machado de duas mãos feito de pedra. “A árvore não pode fazer nada, a não ser aceitar o seu destino.”"

msgid "돌을 조립한 양손 망치. \"운석이 내리치듯이.\""
msgstr "Martelo de duas mãos feito de pedra. “Cada golpe causa o impacto de um meteoro.”"

msgid "돌을 조립한 양손 칼. \"채집에만 쓸 일은 없겠지.\""
msgstr "Faca de duas mãos feita de pedra. “Posso pensar em alguns usos não artesanais para essa garota malvada.”"

msgid "돌을 조립한 칼. \"궁하면 통한다.\""
msgstr "Faca feita de pedra. “A necessidade é a mãe de todas as invenções.”"

msgid "돌이 뭉친 바위 덩어리. \"락스타는 언제나 멋지다.\""
msgstr "Fragmento retirado de uma rocha maior. “Rock clássico será sempre maneiro.”"

msgid "돌이 뭉친 큰 돌멩이. \"락스타는 언제나 멋지다.\""
msgstr "Rocha grande. “Assim como a estrela do rock nasce no palco, a rocha nasce do calcário.”"

msgid "돌작업날"
msgstr "Lâmina de Trabalho de Pedra"

msgid "돌작업날, 유리조각"
msgstr "Lâmina de Trabalho de Pedra, Pedaço de Vidro"

msgid "돌작업도끼"
msgstr "Machado de Pedra"

msgid "돌작업도끼를 만들 수 있습니다. Lv.35이상 자연물을 벌목하거나 도구 제작에 쓰입니다."
msgstr "Faz um Machado de Trabalho de pedra. Use-o para pegar recursos naturais. (Nv. 35 ou superior) e criar ferramentas."

msgid "돌작업망치"
msgstr "Martelo de Pedra"

msgid "돌작업망치를 만들 수 있습니다. Lv.35이상 자연물을 캐거나 건축물 제작에 쓰입니다."
msgstr "Faz um martelo de trabalho de pedra. Use-o para coletar recursos naturais (Nv. 35 ou superior) e fazer construções."

msgid "돌작업칼"
msgstr "Faca de Pedra"

msgid "돌작업칼을 만들 수 있습니다. Lv.35이상 자연물을 채집하거나 제작에 쓰입니다."
msgstr "Faz uma faca de trabalho de pedra. Use-a para coletar recursos naturais (Nv. 35 ou superior) e criar."

msgid "돌장식 {item}"
msgstr "{item} com Pedra Decorativa"

msgid "돌절구"
msgstr "Almofariz de Pedra"

msgid "돌절구를 만들 수 있습니다. 재료를 갈거나 빻고 으깰 수 있습니다."
msgstr "Faz um almofariz de pedra. Use-o para misturar, moer e amassar ingredientes."

msgid "돌진 A"
msgstr "Ímpeto A"

msgid "돌진 B"
msgstr "Ímpeto B"

msgid "돌진 C"
msgstr "Ímpeto C"

msgid "돌진 S"
msgstr "Ímpeto S"

msgid "돌창"
msgstr "Lança de Pedra"

msgid "돌창날"
msgstr "Ponta de Lança de Pedra"

msgid "돌창날보다 공격력이 높은 뼈창날을 만들 수 있습니다."
msgstr "Faz uma ponta de lança de osso com ataque superior ao de uma ponta de lança de pedra."

msgid "돌칼"
msgstr "Faca de Pedra"

msgid "돌칼날"
msgstr "Lâmina de Faca de Pedra"

msgid "돌칼날보다 공격력이 높은 뼈칼날을 만들 수 있습니다."
msgstr "Faz uma lâmina de faca de osso, que tem maior ataque que uma lâmina de faca de pedra."

msgid "돌타일"
msgstr "Azulejo de Pedra"

msgid "돌톱"
msgstr "Serra de Pedra"

msgid "돌톱 구해다줘"
msgstr "Madeira!"

msgid "돌톱과 돌톱날을 만들 수 있습니다. 나무 채집과 재료 가공에 쓰입니다."
msgstr "Faz uma Serra de Pedra e uma Lâmina de Serra de Pedra. Use-as para coletar madeira e processar materiais."

msgid "돌톱날"
msgstr "Lâmina de Serra de Pedra"

msgid "돌판"
msgstr "Tábua de Pedra"

msgid "돌판구이"
msgstr "Churrasco na Chapa de Pedra"

msgid "돌판구이 조리법으로 10번 요리하세요."
msgstr "Grelhar 10 chapas de pedra de churrasco."

msgid "돌판구이를 할 수 있습니다. 회복되는 에너지와 능력치효과 시간이 늘어납니다."
msgstr "Faz da pedra um prato de Churrasco. Aumenta a energia recuperada e a Duração do Efeito de Condição."

msgid "돌판양념구이"
msgstr "Churrasco Temperado na Chapa de Pedra"

msgid "돌판양념구이를 할 수 있습니다. 회복되는 에너지와 능력치효과 시간이 늘어나고 향신료를 넣어 추가 효과를 낼 수 있습니다."
msgstr "Faz um Churrasco Temperado na Chapa de Pedra. Aumenta a energia recuperada e a Duração do Efeito de Condição. Adicione condimentos para efeitos extras."

msgid "돌판을 만들 수 있습니다. 돌판은 돌판구이, 돌판양념구이를 할 때 씁니다."
msgstr "Faz uma tábua de pedra. Use para fazer Churrasco na Chapa de Pedra e Churrasco Temperado na Chapa de Pedra."

msgid "돌판이 있음 좋겠네요"
msgstr "Pratos de Pedra"

msgid "돌판재"
msgstr "Tábua de Pedra"

msgid "동굴에 아직 탄약이 꽤 남아 있어. 베일리."
msgstr "Ainda tem muita munição naquela caverna, Bailey."

msgid "동남쪽의 작은 <link>호수</link> 찾기"
msgstr "Encontre o pequeno <link>lago</link> ao sudeste."

msgid "동력도 부족하고, 인력도 농사 짓는 걸 안 내켜하고 문제점은 많지. 경지 면적도 너무 좁고 말이야. 하지만 해결책은 분명히 있을 거야. 토끼발은 묵묵하게 가는 타입이니까. 그렇지? <em>{item_0}</em> 같은 걸로 농경제에 기여를 해줘."
msgstr "Nós temos poucos voluntários e obstáculos demais para tentar essa coisa de cultivo. E nem vou começar a falar sobre a ampliação dos campos nessas ilhas pequenas... Você tem alguma solução? Bem, se não tiver, traga alguns <em>{item_0}s</em>, pois eles nos ajudariam bastante em nossa causa."

msgid "동료는 프리젠테이션이 사람들이 세상을 다 안다는 착각에 빠지게 한다고 싫어했지."
msgstr "Meu colega também não gostava de apresentações. Dizia que elas ofereciam conhecimento suficiente para fazer as pessoas acharem que sabiam de tudo... Uma crença poderosa."

msgid "동료들한테 공유했는데, 사령관 출신들이 아마 선거 때문일 것 같다 추측하더군."
msgstr "Já espalhei essa informação para os nossos aliados. Tenho certeza de que os antigos comandantes suspeitam que exista alguma ligação com a eleição que está por vir."

