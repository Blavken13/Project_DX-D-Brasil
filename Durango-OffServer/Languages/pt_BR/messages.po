msgid "고급열매비료"
msgstr "Fertilizante de Qualidade de Frutas"

msgid "고급자용 포획 도구를 만들 수 있습니다. 포획 도구를 소지하고 있으면 동물을 포획할 수 있습니다."
msgstr "Faça uma ferramenta de captura avançada que pode ser usada para capturar animais."

msgid "고급형 건물 수리키트"
msgstr "Kit de Reparo de Edifícios de Qualidade"

msgid "고급형 건물 수리키트 x5"
