msgstr "{hour}h {sec}seg"

msgid "{id} 작물에 대한 정보가 없습니다."
msgstr "Não há informações sobre a plantação de {id}."

msgid "{id}: 유효하지 않은 이용권입니다."
msgstr "{id}: Cupom inválido."

msgid "{invitee} 님을 초대했습니다."
msgstr "{invitee} foi convidado."

msgid "{invitee} 님이 파티 초대를 거절했습니다."
msgstr "{invitee} recusou o convite do grupo."

msgid "{item:을} 건조한 것. \"시간은 수명과 물기를 가져간다.\""
msgstr "{item} está seco(a). “Ah, se algum hidratante caísse pelo Portal...”"

msgid "{item:을} 구웠는데 설익었다. \"땅에다 심으면 자라겠군.\""
msgstr "{item} está malpassado(a). “Tão malpassado que você talvez tenha que replantar.\""

msgid "{item:을} 구웠는데 설익었다. \"한 번 더 구웠으면 좋겠다.\""
msgstr "{item} está malpassado(a). “É só colocar no micro-ondas... não, espera...”"

msgid "{item:을} 국 끓인 것. \"속이 따뜻해질 거야.\""
msgstr "Sopa de {item}. “Igual à que a minha mãe fazia.”"

msgid "{item:을} 금속 석쇠에 구운 것. \"자랑할 데가 없다는 게 아쉽다.\""
msgstr "{item} foi grelhado(a) em uma grelha de metal. “Se pelo menos eu pudesse compartilhar isso nas redes sociais...\""

msgid "{item:을} 금속 석쇠에 구운 것. 탔다. \"안타까워라.\""
msgstr "{item} foi grelhado(a) em uma grelha de metal. Mas queimou. “Uma grande tragédia dos nosso tempos.\""

msgid "{item:을} 길들였다. 귀속할 수 있다."
msgstr "{item} foi domado. Agora você pode criar um vínculo com ele."

msgid "{item:을} 다듬은 것. \"자신을 버리지 마라. 견디면 시간이 다듬어준다.\""
msgstr "Item usado para aparar {item}. “Só mais um pouquinho nas laterais.”"

msgid "{item:을} 다지고 뭉친 환약. \"고급 환약은 건강 보험 비급여 대상이다.\""
msgstr "Pílula feita por moagem e trituração {item}. \"Pílulas de qualidade não são cobertas pelo seguro.\""

msgid "{item:을} 다지고 뭉친 환약. \"누구나 아픈 날이 있다.\""
msgstr "Pílula feita ao moer e prensar {item}. “Uma pílula todo dia mantém o médico bem remunerado!\""

msgid "{item:을} 다지고 뭉친 환약. \"죽음을 피할 순 없지만 늦출 순 있다.\""
msgstr "Pílula feita ao moer e prensar {item}. \"Death cannot be stopped...but it can be distracted.\""

msgid "{item:을} 덜 말린 것. \"시간이 충분하지 않을 때도 있다.\""
msgstr "{item} está parcialmente seco(a). “Algumas coisas precisam de mais tempo.”"

msgid "{item:을} 돌판에 구운 것. \"죽기 전에 다시 먹고 싶을 것 같다.\""
msgstr "{item} foi grelhado(a) em uma chapa de pedra. “Espero poder comer pelo menos mais um antes morrer.\""

msgid "{item:을} 돌판에 구운 것. 탔다. \"너무 신중했던 것 같다.\""
msgstr "{item} foi grelhado(a) em uma chapa de pedra. Mas queimou. “Paciência nem sempre é uma virtude.”"

msgid "{item:을} 로스트한 것. \"인생에 더 나은 게 있나?\""
msgstr "{item} foi assado(a). “Me fala: Tem coisa melhor do que isso?\""

msgid "{item:을} 로스트한 것. 탔다. \"되돌리고 싶은 순간이 있다.\""
msgstr "{item} foi assado(a). Mas queimou. “Se eu pudesse voltar no tempo... Se eu pudesse encontrar uma maneira...”"

msgid "{item:을} 말린 것. \"냉장고 이전의 조상들은 고생했구나.\""
msgstr "{item} está seco(a). “Quem precisa de frigideira?”"

msgid "{item:을} 말린 것. \"물기 없는 과일도 별미다.\""
msgstr "{item} está seco(a). “Sem nenhuma umidade, com todo o sabor.”"

msgid "{item:을} 무두질한 것. \"쓸모가 있으려면 꽤 많은 시도가 필요하다.\""
msgstr "{item} curtido(a). “Só o tempo nos mostrará o seu propósito.”"

msgid "{item:을} 묶어 이은 끈. \"길이가 등차수열이면, 쓸모는 등비수열이다.\""
msgstr "{item} conectado(a) por uma tira. “A única coisa melhor do que uma tira é uma tira mais longa.”"

msgid "{item:을} 볶은 것. \"불맛이 배이면 다 그럴싸하다.\""
msgstr "{item} Refogado(a). “A maioria das coisas podem ser resolvidas com fogo, você só precisa ser um pouco criativo às vezes.\""

msgid "{item:을} 삶은 것. \"삶은 그대로도 아름다운 것.\""
msgstr "{item} Fervilhado(a). “A vida é bela, mesmo quando está chata.\""

msgid "{item:을} 양념 발라 금속 석쇠에 구운 것. \"이걸 만든 것만으로도 인간은 살 가치가 있다.\""
msgstr "{item} foi temperado e grelhado(a) em uma grelha de metal. “O fato de as pessoas poderem criar um prato assim é motivo suficiente para salvar a humanidade.\""

msgid "{item:을} 양념 발라 금속 석쇠에 구운 것. 탔다. \"욕심을 부렸나보다.\""
msgstr "{item} foi temperado e grelhado(a) em uma grelha de metal. Mas queimou. “Uma queimadura doentia.\""

msgid "{item:을} 양념 발라 돌판에 구운 것. \"돌판구이가 맛있단 느낌만은 영원할 것 같다.\""
msgstr "{item} foi temperado(a) e grelhado(a) em uma chapa de pedra. “É como se fosse o Sete de Setembro!”"

msgid "{item:을} 양념 발라 돌판에 구운 것. 탔다. \"타임머신이 필요해.\""
msgstr "{item} foi temperado(a) e grelhado(a) em uma chapa de pedra. Mas queimou. “Se eu tivesse uma máquina do tempo...\""

msgid "{item:을} 양념 발라 로스트한 것. \"어디서나 일용할 양식을.\""
msgstr "{item} foi temperado(a) e assado(a). “O pão nosso de cada dia nos dai hoje.”"

msgid "{item:을} 양념 발라 로스트한 것. 탔다. \"자신을 과신했던 것 같다.\""
msgstr "{item} foi temperado(a) e assado(a). Mas queimou. “Preferia ouvir ‘muito bem’, obrigado.”"

msgid "{item:을} 연장한 막대. \"연장 근무보단 연장한 막대가 행복하리라.\""
msgstr "Bastão ampliado a partir de {item}. “Bem melhor do que ampliar as horas de trabalho.”"

msgid "{item:을} 염장한 것. \"내일 먹을 게 있다는 게 기쁘다.\""
msgstr "{item} foi conservado(a) com sal. “Por que comer hoje o que você pode guardar para amanhã?”"

msgid "{item:을} 염장한 것. 향을 넣었다. \"먹고 마시고 개척하라.\""
msgstr "{item} foi aromatizado(a) e conservado(a) com sal. “Coma, beba e descubra!”"

msgid "{item:을} 오랜 시간 구워 육즙이 살아있다."
msgstr "{item} ainda está suculento(a) por ter sido cozinhado lentamente."

msgid "{item:을} 우린 차. \"새로운 다도를 세울 때가 왔다.\""
msgstr "Chá de {item}. “Está na hora de pensar em uma nova cerimônia do chá.\""

msgid "{item:을} 잘 구웠다. \"이런 걸 보니 살아 있는 것 같다.\""
msgstr "{item} está bem passado(a). “Que hora boa para estar vivo.\""

msgid "{item:을} 잘 구웠다. \"잘 먹고 치과의사를 찾아야겠다.\""
msgstr "{item} está Bem Passado(a). “Primeiro a comida, depois o dentista! Ou, você sabe, nunca.\""

msgid "{item:을} 제대로 통조림한 것. \"이곳에 회사 하나 차리고 싶다.\""
msgstr "{item} foi enlatado(a) adequadamente. “E pensar que nossas comidas mais baratas se tornariam uma grande iguaria.”"

msgid "{item:을} 찐 것. \"증기로 푹 익혔다.\""
msgstr "{item} foi cozido a vapor. “E isso não quer dizer que foi lento.\""

msgid "{item:을} 태웠다. \"불조절이 쉬운 건 아니다.\""
msgstr "{item} está queimado(a). \"Play with fire and you're going to get a subpar dish.\""

msgid "{item:을} 통조림한 것. \"많은 기술을 복기해본다.\""
msgstr "{item} foi enlatado(a). “Algumas habilidades básicas se tornaram uma arte perdida.”"

msgid "{item:을} 튀긴 것. \"행복은 기름의 손을 잡고 온다.\""
msgstr "{item} Frito(a). “Tudo fica melhor frito.\""

msgid "{item:을} 향을 넣어 말린 것. \"마른 것이시여 만수무강하소서.\""
msgstr "{item} foi seco e recebeu um sabor a mais. “Que possa durar eternamente.”"

msgid "{item:을} 향을 넣어 말린 것. \"생존이 해결되면 다음 문제는 취향이다.\""
msgstr "{item} foi seco(a) com e recebeu um sabor a mais. “Vamos considerar a preferência após descobrirmos como sobreviver.”"

msgid "{item:을} 훈제한 것. \"여기서 여러 요리법을 겪어 본다.\""
msgstr "{item} está defumado(a). “Quem imaginava que você soubesse preparar uma refeição de várias maneiras.”"

msgid "{item:을} 훈제한 것. 향을 넣었다. \"지쳤다면 앉아서 식감을 즐겨보자.\""
msgstr "{item} foi defumado(a) e recebeu um sabor a mais. “Sente-se, relaxe e mande ver. Você merece.”"

