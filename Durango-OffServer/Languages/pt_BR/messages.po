msgid "{collectible}의 고기. \"단 한마리의 브라키오도 살아있지 않았다.\""
msgstr "Carne de um {collectible}. \"Até um Braquiossauro pode virar comida se você tiver a paciência de esperar.\""

msgid "{collectible}의 고기. \"이곳의 고기라는 게 다 고기서 고기지만 이 고기만큼은 좀 특별해 보인다.\""
msgstr "Carne de {collectible}. “Existe carne e existe A carne.”"

msgid "{collectible}의 골판. \"이런 걸 갖추게 된 생물학적 사연이 있을 것이다.\""
msgstr "Tábua óssea de {collectible}. “Estou a um gabinete de distância de um belo jogo de jantar.”"

msgid "{collectible}의 과육. \"사막은 죽은 곳이 아니다.\""
msgstr "{collectible} polpa. “O deserto não é totalmente infértil.”"

msgid "{collectible}의 과육. \"아삭하게 씹힌다.\""
msgstr "Polpa de {collectible}. “Uma mordida e você está fisgado!”"

msgid "{collectible}의 깃털. \"옷을 안 입는 이유가 있었다.\""
msgstr "Pena de {collectible}. “As roupas feitas com essas penas seriam equivalentes à tortura com cócegas.”"

msgid "{collectible}의 껍질. \"탄수화물을 여기에 넣고 먹었었다.\""
msgstr "Cascas de {collectible}. “As pessoas costumavam comer isso para conseguir carboidratos.”"

msgid "{collectible}의 나뭇가지. \"단단한 게 불리한 덕목은 아니다.\""
msgstr "Galho de {collectible}. “Ser rígido e inflexível tem suas vantagens.”"

msgid "{collectible}의 나뭇가지. \"유연해 쓸 구석이 많다.\""
msgstr "Galho de {collectible}. “Versatilidade conquistada pela flexibilidade.”"

msgid "{collectible}의 나뭇가지. \"팔은 나뭇가지로 확장된다.\""
msgstr "Galho de {collectible}. “Nós podemos aumentar o nosso alcance usando o membro de uma árvore.”"

msgid "{collectible}의 내장. \"고생하셨다. 이제 쉬소서.\""
msgstr "Vísceras de {collectible}. “Parece que comer isso seria redundante.”"

msgid "{collectible}의 넓은 가죽. \"겉넓이를 구하는 공식을 몸으로 익힌다.\""
msgstr "Couro largo de {collectible}. “É muito mais fácil determinar a área de superfície de alguma coisa se você remove essa superfície.”"

msgid "{collectible}의 넓은 털가죽. \"융단은 자연에서 생긴다.\""
msgstr "Pele larga de {collectible}. “Tapetes felpudos foram criados originalmente pela natureza.”"

msgid "{collectible}의 다리뼈. \"오랫동안 누군가를 지탱한 흔적에 추모를.\""
msgstr "Osso da perna de {collectible}. “Isso serviu de suporte durante uma vida toda e nunca recebeu agradecimentos. Mostre um pouco de respeito.”"

msgid "{collectible}의 다리뼈. \"잡아 먹으려 달리던 다리도 멈췄도다.\""
msgstr "Osso da perna de {collectible}. “Até mesmo as pernas do caçador mais bem-sucedido um dia param de funcionar.”"

msgid "{collectible}의 다리뼈. \"잡아 먹힐까 달리던 다리도 멈췄도다.\""
msgstr "Osso da perna de {collectible}. “Até mesmo as pernas da presa mais bem-sucedida um dia param de funcionar.”"

msgid "{collectible}의 덤불. \"해양성 기후에선 자주 볼 수 있다.\""
msgstr "Arbusto de {collectible}. “Originário de regiões litorâneas.”"

msgid "{collectible}의 덩굴. \"덩굴이 의지할 수 있는 사람이 되자.\""
msgstr "Videira de {collectible}. “Se coletarmos muitas dessas, quem sabe não podemos criar nossa própria diversão.”"

msgid "{collectible}의 등심. \"한 시절을 겪어낸 등이다.\""
msgstr "Lombo de {collectible}. “Pelo menos ainda temos alguns artigos de luxo em Durango.”"

msgid "{collectible}의 머리뼈. \"꿈과 본능, 의지가 있던 곳이 비었다.\""
msgstr "Crânio de {collectible}. “Pobre dinossauro, eu o conhecia bem.”"

msgid "{collectible}의 머리뼈. \"한 생물의 본질이 있던 자리다.\""
msgstr "O crânio de um {collectible}. “A casca que protege a essência de um ser vivo.\""

msgid "{collectible}의 뿌리. \"식물의 위대함은 뿌리에서 나온다.\""
msgstr "Raízes de {collectible}. “As maiores plantas têm as raízes mais fortes.”"

msgid "{collectible}의 뿔. \"인간에게 뿔이 있다면 악마는 뿔을 잃을 것이다.\""
msgstr "Chifre de {collectible}. “Se os humanos tivessem chifres, o diabo se livraria do dele com desgosto.”"

msgid "{collectible}의 삼겹살. \"밥벌이가 지겨워도 가끔은 할 만한 이유다.\""
msgstr "Carne do estômago de {collectible}. “Coisas assim é que fazem a sobrevivência em Durango valer a pena.”"

msgid "{collectible}의 상아. \"상아가 없는 개체들이 살아남을 것이다.\""
msgstr "Marfim de {collectible}. “Quando a ganância do homem vira a sua inimiga, o marfim gera mais riscos do que defesa.”"

msgid "{collectible}의 새순. \"날이 풀리면 새로 돋는다.\""
msgstr "Broto de {collectible}. “Eles se erguem acima da superfície para saudar o sol.”"

msgid "{collectible}의 생 간. 급박한 상황에 먹으면 생존에 큰 도움이 된다."
msgstr "Fígado cru de {collectible}. Em situações de crise, comer isso poderá aumentar drasticamente suas chances de sobrevivência."

msgid "{collectible}의 생 간. 죽은 지 얼마 되지 않은 듯 하다. 급박한 상황에 먹으면 생존에 큰 도움이 되지만, 채집 시 기름독이 옮을 수 있다."
msgstr "Fígado cru de {collectible}. Parece que ele morreu recentemente. Pode melhorar suas chances de sobrevivência em uma situação difícil, mas com o risco de sofrer Toxicidade do Óleo."

msgid "{collectible}의 싱싱한 고기. \"고기가 자라는 식물이 있으면 좋겠다.\""
msgstr "Carne fresca de um {collectible} morto(a). “Ah, se isso desse em árvore...”"

msgid "{collectible}의 안심. \"등을 지탱하던 살이 위를 지탱할 것이다.\""
msgstr "Filé de {collectible}. “Uma carne tão macia que você imagina se o animal costumava receber massagem.”"

msgid "{collectible}의 열매. \"맛의 다양성은 공존 가능하다.\""
msgstr "Fruta de uma {collectible}. “Alguns sabores coexistem em harmonia melhor do que a maioria das pessoas.”"

msgid "{collectible}의 이빨. \"뜯고 씹고 으깨기에는 좀 작다.\""
msgstr "Dente de {collectible}. “Um pouco pequeno para morder e mastigar.”"

msgid "{collectible}의 이빨. \"뜯고 씹고 으깼다.\""
msgstr "Dente de {collectible}. “Mastigando e engolindo.”"

msgid "{collectible}의 잎. \"생존의 방식은 여러 가지니 서로 존중하자.\""
msgstr "Folha de {collectible}. “Há muitas formas de sobreviver sem nos matarmos mutuamente.”"

msgid "{collectible}의 작은 골판. \"사람에게 없다고 자연에 없는 것은 아니다.\""
msgstr "Tábua óssea pequena de {collectible}. “Eu nunca imaginei que sentiria ciúmes dos ossos de outro animal.”"

msgid "{collectible}의 작은 머리뼈. \"머리의 크기가 지능의 크기는 아니다.\""
msgstr "Crânio pequeno de {collectible}. “Não julgue o cérebro pelo crânio.”"

msgid "{collectible}의 작은 뿔. \"작은 뿔은 큰 뿔을 시기하는가?\""
msgstr "Chifre pequeno de {collectible}. “Você acha que dá para sentir inveja de chifres?” "

msgid "{collectible}의 작은 잎. \"형태란 오래 쌓인 진화의 썸네일이다.\""
msgstr "Folha pequena de {collectible}. “Milhões de anos de evolução conectam essa pequena folha ao sol e à lua.”"

msgid "{collectible}의 줄기. \"섬유 비슷한 게 필요할 때 좋다.\""
msgstr "Caule de {collectible}. “Uma boa maneira de conseguir o seu suplemento de fibra.”"

msgid "{collectible}의 지방. \"죽음은 영원한 다이어트다.\""
msgstr "Gordura de {collectible}. “A morte é a dieta suprema.”"

msgid "{collectible}의 진액. \"침과 땀이 얘보다 못 할 게 뭔가?\""
msgstr "Seiva de {collectible}. “Eu ainda não consigo me livrar dessa impressão de que a árvore está querendo cuspir em nós...”"

msgid "{collectible}의 질긴 줄기. \"질기게 살아 남으면 언젠가 좋은 일이 있겠지.\""
msgstr "Caule durável de {collectible}. “Aqueles duráveis o bastante para sobreviver serão recompensados... ou colhidos.”"

msgid "{collectible}의 참 갈비뼈. \"온갖 생체 기계가 보호 아래에 있었다.\""
msgstr "Costela verdadeira de um {collectible}. \"Imagine todos os órgãos delicados que essa lasca de osso protegia.\""

msgid "{collectible}의 큰 나뭇잎. \"피고 지고 시간이 간다.\""
msgstr "Folha grande de {collectible}. “Cada folha amarelada é um lembrete que o tempo não para.”"

msgid "{collectible}의 큰 다리뼈. \"구름다리도 지탱할 다리다.\""
msgstr "Osso da perna grande de {collectible}. “Esqueça os dinossauros, essas coisas poderiam sustentar até um viaduto.”"

msgid "{collectible}의 큰 머리뼈. \"한 생물의 본질이 있던 자리다.\""
msgstr "Crânio grande de {collectible}. “Isso está me fazendo repensar aquela máxima de ‘tamanho é o que importa’...”"

msgid "{collectible}의 털가죽 조각. \"부드러움을 할부로.\""
msgstr "Pedaço de pele de {collectible}. “Esqueça tudo. Eu quero fazer carinho no bicho de onde essa pele veio.”"

msgid "{collectible}의 털가죽. \"사냥의 고됨도 부드러운 털길에 잊힌다.\""
msgstr "Pele de {collectible}. “A maciez da pele faz você esquecer os rigores da caçada.”"

msgid "{collectible}의 힘줄. \"질긴 게 많은 힘을 견딜 수 있다.\""
msgstr "Tendão de {collectible}. “Tão versátil quanto o corpo do qual ele fazia parte.”"

msgid "{commodity_name} 상품을 1시간 내에 수령하지 않으면 사라집니다."
msgstr "O produto {commodity_name} vai desaparecer se você não o resgatar em 1 hora."

msgid "{commodity_name} 상품의 수령기간이 1일 남았습니다."
msgstr "Falta 1 dia para resgatar o produto {commodity_name}."

