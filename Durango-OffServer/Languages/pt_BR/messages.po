msgstr "{player_name} transferiu {amount} ({currency}). Saldo: {balance}. Motivo: {reason}. Motivo na Linha do Tempo: {timeline_reason}."

msgid "{player_name} 님이 {amount}({currency}) 재화를 {clan_name}({clan_id}) 부족에 기부. 부족 기금: {clan_fund}"
msgstr "{player_name} doou {amount} ({currency}) para o clã {clan_name} ({clan_id}). Fundos do clã: {clan_fund}."

msgid "{player_name} 님이 {animal_type_name:을} 길들이기 시도, 지역: {region_name}({region_id})"
