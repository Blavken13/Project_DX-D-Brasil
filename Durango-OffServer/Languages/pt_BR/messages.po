msgid "전투 모자. \"희생정신 못지 않게 제복을 향한 애착이 훌륭한 군인을 만들기도 한다.\""
msgstr "Chapéu de combate. \"Um bom soldado mantém o uniforme limpo.\""

msgid "전투 몰입 A"
msgstr "Manter o Foco A"

msgid "전투 몰입 B"
msgstr "Manter o Foco B"

msgid "전투 몰입 S"
