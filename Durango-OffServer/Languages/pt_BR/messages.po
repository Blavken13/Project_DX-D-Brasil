msgid "전초기지 섬에서 부족 영토를 나타내는 깃발. 건설에 티스톤을 사용한다."
msgstr "Bandeira que indica Enclaves nas Ilhas Selvagens. Use Pedras-T para construir."

msgid "전통적으로 이어져 내려온 토테미즘."
msgstr "Totens tradicionais"

msgid "전투"
msgstr "Combate"

msgid "전투 능력"
