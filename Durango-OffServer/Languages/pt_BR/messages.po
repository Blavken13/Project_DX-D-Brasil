msgid "군락용_열대blue_헬리코니아"
msgstr "(Identificador)"

msgid "군락용_중형 똥"
msgstr "Fezes médias da colônia"

msgid "군락용_진흙구덩이_tar_1x1"
msgstr "Poço de lama com alcatrão da colônia"

