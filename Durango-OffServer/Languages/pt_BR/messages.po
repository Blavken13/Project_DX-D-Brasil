msgid "UN, 제네바 이런 얘기는 전혀 안 먹혀. 여긴 듀랑고랴."
msgstr "Coisas como a ONU e a Convenção de Genebra não significam nada para eles. Aqui é Durango, e as leis são escritas com sangue."

msgid "Use somente letras, números, ponto, hífen ou underline no nickname."
msgstr "Use somente letras, números, ponto, hífen ou sublinhado no nome de usuário."

