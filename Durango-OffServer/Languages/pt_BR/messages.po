msgid "\"15일간 유용한 혜택!\""
msgstr "“15 dias de benefícios!”"

msgid "\"30일간 유용한 혜택!\""
msgstr "“30 dias de benefícios!”"

msgid "\"7일간 유용한 혜택!\""
msgstr "“7 dias de benefícios!”"

msgid "\"7일간 유용한 혜택!\" \n가방 용량 20칸 증가, 매일 워프젬 10개 및 강력 피로회복제 3개 자동 발송"
msgstr "“7 dias de benefícios!”\nO Pacote de 7 dias amplia instantaneamente o espaço de seu inventário em 20. Além disso, receberá diariamente 10 Pedras do Portal e 3 Restauradores de Fadiga Potente."

msgid "\"K\"랑 안다."
msgstr "Conheceu K."

msgid "\"V8 엔진 소리와 구분되지 않는 그르렁거림.\""
msgstr "“Ele ronca como um motor V8.”"

msgid "\"X\"가 보시기에 아직 아는 게 없다."
msgstr "Não corresponde ao padrão de X."

msgid "\"X\"가 시키시면 한다."
msgstr "Disposto a fazer qualquer coisa que X ordene."

msgid "\"X\"에게 달관했다."
msgstr "Considerando uma abordagem filosófica no trabalho com X."

msgid "\"X\"에게 시달린지 한 세월이다."
msgstr "Vem sendo assediado por X há meses."

msgid "\"가냘픈 전광석화.\""
msgstr "“Até mesmo o menor dos relâmpagos continua sendo um relâmpago.”"

msgid "\"가성비는 고려 대상이 아니다.\""
msgstr "“Você não precisa de gás! Já carne, por outro lado...”"

msgid "\"가장 귀엽고 힘찬 발걸음.\""
msgstr "\"O passo mais bonito e mais poderoso\""

msgid "\"가장 힘찬 발걸음.\""
msgstr "“A terra irá tremer.”"

msgid "\"가족들이 첫 탈것은 검정이나 흰색 중에 고르래서 둘 다 골랐다.\""
msgstr "“Ainda bem que não tive que escolher entre o preto e o branco.”"

msgid "\"거대 인공물들의 중심부를 관통하는 야생의 맛\""
msgstr "“Um gosto silvestre que destrói os sabores artificiais!”"

msgid "\"거칠게 사는 것도 또 한 생이 아니겠는가?\""
msgstr "“A coisa mais parecida com um tanque de guerra.”"

msgid "\"걷는 곳이 훗날의 도로명주소가 된다.\""
msgstr "“Dentes longos, garras rápidas.”"

msgid "\"겉멋은 원하지 않는다. 실속을 원한다.\""
msgstr "“Eu? Eu prefiro substância em vez de estilo.”"

msgid "\"경험치 100%, 스킬 계열 숙련도 100% 증가!\" \n(캐릭터와 각 스킬 계열 60레벨까지, 기간 제한 없음)"
msgstr "\"100% de aumento no EXP e nível de categoria de habilidade!\"\n(Dura até o nível 60 para um personagem e por categoria de habilidade, sem limite de tempo.) "

msgid "\"경험치 300%, 스킬 계열 숙련도 300% 증가, 스킬 연구 시간 스킵!\" \n(캐릭터와 각 스킬 계열 50레벨까지)"
msgstr "\"300% de aumento no EXP e de categoria de habilidade? E você pode pular a pesquisa de habilidade?! Incrível!\"\n(Dura até o nível 50 por personagem e por cada categoria de habilidade) "

msgid "\"고기를 먹는 고기는, 종속영양 중에도 가장 비효율적이지만 그만큼 많은 자유를 얻는다.\""
msgstr "“Carne comendo carne pode parecer loucura, mas pelo menos os que estão no topo da cadeia alimentar estão livres para fazer sua escolha.”"

msgid "\"고단한 삶을 안고 오늘도 길을 가네.\""
msgstr "\"Em uma terra de ilhas, a mergulhadora é rainha!\""

msgid "\"군자는 뛰지 않는다.\""
msgstr "“Um cavalheiro nunca corre.”"

msgid "\"기능과 형태가 꼭 이혼한 부부처럼 사이가 나쁜 건 아니다.\""
msgstr "“Um casamento de design e funcionalidade.”"

msgid "\"기차에서 봤던 인형의 눈을 닮았다.\""
msgstr "“Acho que já vi esses botões antes...”"

msgid "\"까치의 학명은 Pica pica이다.\""
msgstr "\"O nome científico do pega-rabilo é Pica-Pica. Meio que me dá vontade de atirar uma bolinha nele para capturá-lo...\""

msgid "\"날개를 잃고 억센 다리를 얻었다.\""
msgstr "“Ele não pode voar, mas com certeza consegue correr.”"

msgid "\"내가 가는 곳이 길이 된다.\""
msgstr "\"Meu caminho se torna uma estrada.\""

msgid "\"네 발의 매혹.\""
msgstr "“Como um sedã pré-histórico.”"

msgid "\"누구나 페나코두스부터 시작했다.\""
msgstr "“Todos devem começar com um Phenacodus.”"

msgid "\"눈으로 쫓기 어렵다.\""
msgstr "“Veloz e furioso.”"

msgid "\"눈처럼 새하얗고 뿔을 달았다. 탈것은 이래야 한다.\""
msgstr "“Branco como a neve, enfeitado com um chifre. O transporte dos sonhos.”"

msgid "\"다양한 컬러로 세상을 달리고 싶은 날도 있지.\""
msgstr "“Tem dias que você quer viver o mundo em cores diferentes.”"

msgid "\"달리는 근육 위에 중립은 없을 지어다.\""
msgstr "“Parece que a marcha está em ponto neutro.”"

msgid "\"당분간 대기 오염 문제는 신경 쓰지 않기로 했다.\""
msgstr "“Vamos nos preocupar com a poluição do ar mais tarde.”"

msgid "\"당신을 위한 특별한 선택.\""
msgstr "“Personalize o seu pendurando ornamentos nos chifres!”"

msgid "\"더 다양한 경험을 위한 선택!\" \n캐릭터 슬롯 1개 추가. 모든 캐릭터에 자기계발 패키지 효과 적용."
msgstr "“A trilha mais rápida até o topo da cadeia alimentar!”\nAdiciona 1 espaço de personagem. Aplica o efeito Sobrevivência a todos os personagens. "

msgid "\"도구를 든 인간은 최상위 육식동물이지만, 이 사료는 먹지 않을 것이다.\""
msgstr "“Humanos portadores de ferramentas podem ser carnívoros, mas você nunca os verá comendo isso.”"

msgid "\"돌날이 필요합니다.\""
msgstr "Você precisa de uma lâmina de pedra."

msgid "\"두발 육식동물을 탄다는 건 하이엔드 스포츠카를 타는 거다.\""
msgstr "“É como dirigir um carro esporte.”"

msgid "\"듀랑고에서 육식에 반대하는 책은, 눈물을 흘리는 프로토케라톱스를 표지로 쓸 것이다.\""
msgstr "“A literatura vegetariana aqui, em Durango, terá um Protoceratops chorando na capa do livro.”"

msgid "\"마법 사회의 양극화 문제는 점점 커진다.\""
msgstr "\"Quem já ouviu sobre duas sociedades sobrenaturais em conflito? Ah... Todo mundo.\""

msgid "\"먹고 살려면 뛰어야 한다.\""
msgstr "“Não recomendando para rachas.”"

msgid "\"먹고나면 한동안 금단 현상에 시달릴 수 있으니 섭취시 유의할 것\""
msgstr "“Os efeitos colaterais podem incluir um mês de abstinência.”"

msgid "\"모든 게 새롭다.\""
msgstr "“A vespa de Durango.”"

msgid "\"몸으로 안 될 때는 머리를 써라.\""
msgstr "\"Se seu corpo não dá conta, use a cabeça.\""

msgid "\"미니멀리즘에 심취하는 시절도 있기 마련이지.\""
msgstr "“Às vezes o minimalismo é atraente.”"

msgid "\"방 안의 코끼리는 자신이 처한 문제를 직시한다.\""
msgstr "\"\"O elefante na sala tem seus próprios problemas para lidar.\"\""

msgid "\"보기 드물게 예를 갖췄다.\""
msgstr "“Pelo menos está bem vestido.”"

msgid "\"분홍에 어떤 의미를 부여하건 이 친구를 만나기 전까진 의미없다.\""
msgstr "\"Ninguém fica tão bem de rosa quanto esse camarada aqui.\""

msgid "\"산타클로스 조합이 또 파업에 들어갔다.\""
msgstr "“Se eles achavam que as condições de trabalho com o Papai Noel eram ruins, espere só até ver o que os aguarda por aqui.”"

msgid "\"세상 모두를 짊어져라.\""
msgstr "“Abra caminho na marra.”"

msgid "\"수납공간이 필요하십니까?\""
msgstr "\"Precisa de espaço extra de armazenamento?\""

msgid "\"안장 아래의 힘을 만끽하라.\""
msgstr "“O gato da selva mais gato.”"

msgid "\"안정성은 교환할 수 없다.\""
msgstr "“Veja só esse porta-malas!”"

msgid "\"여기 보이는 모든 게 다 우리 세대가 일군 게 아니냐? 요새 애들은 상상도 못 할 거야. 정말 들판에 천막 하나 없고 공룡만 가득 했는데. 다들 열심히 일했다. 너희들이 그런 걸 아니?\" \"그만 하셔. 애들은 그런 말 해도 몰라. 나이 들어야 알지.\" 어른들은 이런 말도 자주 했어요."
msgstr "“Não foi a nossa geração que construiu tudo isso? As crianças de hoje em dia não sabem como era. Viver ao ar livre. Sem abrigos. Dinossauros para todo lado. Você imagina?” “Não se incomode. As crianças simplesmente não entendem. São jovens demais.” Adultos adoram dizer coisas assim."

msgid "\"여름은 영원하다.\""
msgstr "“Um amigo emplumado fabuloso.”"

msgid "\"연비는 나쁘지 않은데 와이퍼에서 침이 나온다.\""
msgstr "“A quilometragem é ótima. Se ela pelo menos parasse de babar.”"

msgid "\"예전을 생각나게 하는 한 잔\""
msgstr "“Uma bebida para se lembrar dos bons e velhos tempos.”"

msgid "\"온순하되 튼튼하게.\""
msgstr "“Dócil, mas forte.”"

msgid "\"왕에겐 그에 걸맞는 왕좌가 필요하다.\""
msgstr "“Velocidade máxima!”"

msgid "\"외형이 전부는 아니다.\""
msgstr "“Exteriores não são tudo.”"

msgid "\"용암정도면 따뜻하다.\""
msgstr "“Entre, a lava está boa.”"

msgid "\"용암정도면 시원하다.\""
msgstr "“O calor da lava não me incomoda.”"

msgid "\"우는 콤프소그나투스에겐 선물을 안 주신다\""
msgstr "\"Compsognato foi muito danado esse ano para querer ganhar presentes.\" "

msgid "\"우리 페나코는 가장 무도회에 초대 받았으나 주소를 잊어 버렸다.\""
msgstr "“Esse Phenaco foi convidado para um baile de máscaras, mas esqueceu o endereço.”"

msgid "\"우직하게 인내하리.\""
msgstr "“Pode demorar um pouco, mas você vai chegar ao seu destino.”"

msgid "\"육중하고 기능 좋은 탈것을 타고 싶은 날도 있다.\""
msgstr "“Às vezes, eu só quero uma carona resistente e funcional.”"

msgid "\"이 동물을 타는 사람은 열등감을 모른다.\""
msgstr "“Ele vai elevar o seu ego.”"

msgid "\"이 사료를 먹는 동물은 종 차원에서는 양적으로 번영할 것이다.\""
msgstr "“Os animais que comem isso vão engordar muito mais do que seus ancestrais engordavam.”"

msgid "\"이 좋은 친구들의 조상은 캐나다 뉴펀들랜드의 어느 섬에서 태어났다.\""
msgstr "\"Os ancestrais desse carinha são de alguma ilha da Terra-recém-encontrada.\""

msgid "\"이 친구는 언제나 당신을 응원합니다.\""
msgstr "“Um amigo divertido que sempre apoia você.”"

msgid "\"이 콤피는 아빠가 하는 농담을 1분에 하나씩 할 수 있습니다.\""
msgstr "“Esse Compsognato é capaz de contar uma piada boba por minuto.”"

msgid "\"이보다 더 좋은 친구가 있을까?\""
msgstr "“Quem é um bom garoto? Você!”"

msgid "\"자유는 안장 위의 바람이다.\""
msgstr "“A liberdade é o vento batendo no rosto.”"

msgid "\"지도 위에 새로운 선을 긋다.\""
msgstr "“Queima o asfalto.”"

msgid "\"질주의 자유는 침해되지 아니 한다\""
msgstr "“Todo mundo tem um gostinho por velocidade.”"

msgid "\"천천히 걷는 가치를 믿는 사람을 믿습니다.\""
msgstr "“Me pergunto se poderia usar essa cabeça para amplificar o sinal do meu rádio...”"

msgid "\"체급이 늘수록 빨간 코를 얘기하는 친구의 숫자가 줄어들었다.\""
msgstr "\"É melhor convidá-lo para seus jogos Megaloceros ou vai se arrepender.\""

msgid "\"초원에 저무는 노을을 보아라.\""
msgstr "“Nunca saia de casa sem ele.”"

msgid "\"탈것의 뿔이 뭔 기능이 있는지 다른 사람들에게 해명하진 않겠다.\""
msgstr "“Ninguém sabe onde fica a buzina. Use a imaginação.”"

msgid "\"트렁크에 넣을 게 있는 중산층을 위하여.\""
msgstr "“Vem com um sistema de som integrado!”"

msgid "\"티라노사우루스면 충분하다.\""
msgstr "“O rei dos lagartos. Quem poderia pedir mais que isso?”"

msgid "\"펀치 머신도 한 대 맞기 전까진 계획이 있었다.\""
msgstr "“Dê quantos socos você quiser. Essa lata-velha simplesmente não vai sucumbir!”"

msgid "\"페나코는 특별한 존재.\""
msgstr "\"O Phenaco é realmente especial.\""

msgid "\"페나코의 삶에도 때론 마법이 필요하다.\""
msgstr "\"Eu estava de boa com dinossauros, mas... bruxas? Parece até que estou num videogame...\""

msgid "\"회사.\" 왜 회사일까요? 다른 곳들은 부족이라면서. 세련되고 싶었던 걸까요? 모두가 야생으로 돌아가 무법 천지를 빚고 있지만 자신들은 다르단 걸 말하고 싶었는지도 모르죠. 현대적인 단어를 들으면 어딘가 안심이 되는 구석이 있어서 그런 걸지도요. 약탈자들은 야생적인 스타일에 너무 몰입했어요. 그런 스타일로 표를 얻기가 힘들죠."
msgstr "A Companhia. Por que se intitular “A Companhia”? Quero dizer, eles chamavam os outros grupos de clãs. Será que eles se achavam melhores? Mais sofisticados? Talvez seja um jeito de lembrarmos de onde todos viemos, usar uma palavra assim. Talvez queiram diferenciar o grupo deles dos demais clãs menos civilizados. E era uma separação justa. Nossos agressores pareciam selvagens comparados a eles. Como se tivessem perdido completamente a humanidade."

msgid "\"회사입니다. 지금 무사합니까?\" 그들은 스스로를 회사라고 불렀어요. 다들 맥락을 이해하지 못 했어요. 그들은 자신들의 현재 위치와 강가에 도착할 시간, 목적을 밝혔어요. 어쩌면 다른 약탈자일지도 모르겠지만 이번엔 모두들 근처에서 돌이나 가지라도 집어 들었죠. 불도 하나 지폈어요. 보안관이 없는 강가에 알몸으로 서 있는 게 무척 떨렸죠."
msgstr "“Aqui é a Companhia. Vocês estão a salvo?” Eles se intitulavam A Companhia, apesar de nenhum de nós entender o que isso queria dizer. Eles explicaram seu objetivo, localização atual e quando chegariam à margem do rio. Deve ter sido um truque, mas pelo menos tivemos tempo para nos aprontarmos. Pegamos algumas pedras e galhos para usar como armas. Até acendemos uma fogueira que, além de nos aquecer, revelou o quão gelados, nus e apavorados estávamos."

msgid "\"흰털늑대인간의 전설을 들었다.\""
msgstr "“Há algumas lendas sobre um lobo de pelos brancos. Será que...”"

msgid "# 주파수"
msgstr "Frequência #"

msgid "#config_account"
msgstr "Conta"

msgid "#config_leave"
msgstr "Excluir conta"

