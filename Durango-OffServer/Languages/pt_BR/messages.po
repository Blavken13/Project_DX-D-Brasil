msgid "진통효과"
msgstr "Anestesiado"

msgid "진한 {item}"
msgstr "{item} Saudável"

msgid "진한 씨암탉 {item}"
msgstr "{item} Galinha Choca Saudável"

msgid "진행"
msgstr "Progresso"

msgid "진행 가능한 연구가 없습니다."
