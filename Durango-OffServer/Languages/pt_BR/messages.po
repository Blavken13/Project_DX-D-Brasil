msgid "{deportee} 님이 추방되었습니다."
msgstr "{deportee} foi banido."

msgid "{destroyer_entity_name}의 {reason}. {entity_region_name} 섬 {tile} 위치의 레벨{level} {entity_name} 파괴됨. 보관중인 아이템: {inventory_items}"
msgstr "{destroyer_entity_name}'s {reason}. Destruiu a construção de nível {level}, chamada de {entity_name} e localizada em {tile} na ilha {entity_region_name}. Itens armazenados: {inventory_items}."

msgid "{entity_name} 님이 {start_time} ~ {end_time} 까지 채팅금지"
msgstr "{entity_name} bloqueou o bate-papo de {start_time} - {end_time}."

msgid "{entity_name} 님이 동물의 방목 상태를 변경 관리 -> 방목: {grazed} 방목 -> 관리: {leashed}"
msgstr "{entity_name} mudou o status de um animal de administrar -> soltar: {grazed} soltura -> administrar: {leashed}"

msgid "{entity_name} 찾아서 연락"
msgstr "Encontrar e entrar em contato com {entity_name}"

msgid "{entity_region_name} 섬 {tile} {entity_name}에 {farmer_name} 님이 심은 {item_name} 재배 완료({result})"
msgstr "Cultivou {item_name} em {entity_name} na {tile} da ilha {entity_region_name}, que foi plantado por {farmer_name} ({result})."

msgid "{entity_region_name} 섬 {tile} {entity_name}에 건축물 스탯 변화. 안락도: {comfort}, 항균력: {antibacterial}, 복잡도: {complexity}"
msgstr "Os atributos de construção de {entity_name} em {tile} da ilha {entity_region_name} foram alterados. Conforto: {comfort}. Antibiótico: {antibacterial}. Complexidade: {complexity}."

msgid "{entity_region_name} 섬 {tile} {entity_name}에 분위기 효과 {mood_id} 변화. 레벨: {level}"
msgstr "O efeito de ambiente de {entity_name} em {tile} da ilha {entity_region_name} foi alterado para {mood_id}. Nível: {level}."

msgid "{entity_region_name} 섬 {tile} {entity_name}에 세트 효과 {set_id} 변화. 구성: {slots}"
msgstr "O efeito de conjunto de {entity_name} em {tile} da ilha {entity_region_name} foi alterado para {set_id}. Conteúdo: {slots}."

msgid "{entity_region_name} 섬 {tile} 위치에서 {victim_entity_name} 에게 데미지를 줌. 데미지: {damage_value}, 피해자의 이전 체력: {before_hp}, 피해자의 이후 체력: {after_hp}, 가해자: {killer_entity_name}"
msgstr "Danos causados por {victim_entity_name} em {tile} na ilha {entity_region_name}. Danos: {damage_value}. PV da vítima antes: {before_hp}. PV da vítima depois:{after_hp}. Atacante: {killer_entity_name}."

msgid "{entity_region_name} 섬 {tile} 위치의 레벨{level} {entity_name} 노후 되어 섬 정화로 자연 철거됨. 보관중인 아이템: {inventory_items}"
msgstr "O nível {level} de {entity_name} em{tile} da ilha {entity_region_name} deteriorou-se a ponto de ser impossível consertar, então foi naturalmente demolido quando a ilha foi restaurada. Itens armazenados:{inventory_items}."

msgid "{entity_region_name} 섬 {tile} 의 {entity_name} 세션({session_id}) 에서 {phase} 페이즈 시작"
msgstr "Fase {phase} iniciada em {entity_name} sessão ({session_id}) em {tile} da Ilha {entity_region_name}."

msgid "{entity_region_name} 섬 {tile} 의 {entity_name} 세션({session_id}) 에서 {phase} 페이즈 의 - {wave} 웨이브 클리어"
msgstr "Onda {wave} da fase {phase} em {entity_name} sessão ({session_id}) eliminada em {tile} da Ilha {entity_region_name}."

msgid "{entity_region_name} 섬 {tile} 의 {entity_name} 세션({session_id}) 에서 {phase} 페이즈 클리어"
msgstr "Fase {phase} concluída em {entity_name} sessão ({session_id}) em {tile} da Ilha {entity_region_name}."

msgid "{entity_region_name} 섬 {tile} 의 {entity_name} 세션({session_id}) 종료 ({phase} 페이즈 클리어)"
msgstr "{entity_name} sessão ({session_id}) finalizada em {tile} da Ilha {entity_region_name}. (Fase {phase} concluída)"

msgid "{entity_region_name} 섬 {tile}에서 {entity_name} 인벤토리의 {from_section} 섹션 내에 {item_name} 제거. 사유: {item_popped_reason}"
msgstr "Em {tile} na Ilha localizada em {entity_region_name}, {item_name} foi removido da seção {from_section} do inventário de {entity_name}. Motivo: {item_popped_reason}."

msgid "{entity_region_name} 섬 {tile}에서 {entity_name} 인벤토리의 {into_section} 섹션에 {item_name} 추가, 잠금설정: {is_locked}, 사유: {item_added_reason}"
msgstr "Em {tile}, na Ilha localizada em {entity_region_name}, o item {item_name} foi adicionado à seção {into_section} do inventário de {entity_name}. Condição de Bloqueio: {is_locked}, Motivo: {item_added_reason}"

msgid "{entity_region_name} 섬 {tile}에서 {entity_name} 인벤토리의 {item_name} 만료됨"
msgstr "O item {item_name} no inventário de {entity_name} venceu em {tile} na ilha {entity_region_name}."

msgid "{faction:과} {level} 이상이어야 합니다."
msgstr "Deve estar no nível {level} ou superior com a facção {faction}."

msgid "{faction}에 요청한 {name}의 지원 결과를 확인하세요."
msgstr "Verifique com a {faction} para obter suporte quanto ao {name} que você solicitou."

msgid "{faction}에 지원 요청이 가능합니다."
msgstr "Você pode pedir o apoio de {faction}."

msgid "{first_owner_name}의 사과"
msgstr "Maçã de {first_owner_name}"

msgid "{from_region_role}-{from_region_name:이}({from_region_id}) {to_region_role}-{to_region_name:과}({to_region_id}) 연결"
msgstr "{from_region_role}-{from_region_name} ({from_region_id}) vinculado a {to_region_role}-{to_region_name} ({to_region_id})."

msgid "{helper} 님이 {player} 님을 구조했습니다. 건강이 더 많이 회복됩니다."
msgstr "{player} foi resgatado(a) por {helper}. Recuperou Saúde adicional."

msgid "{hour}시간"
msgstr "{hour}h"

msgid "{hour}시간 {min}분"
msgstr "{hour}h {min}min"

msgid "{hour}시간 {min}분 {sec}초"
msgstr "{hour}h {min}min {sec}seg"

