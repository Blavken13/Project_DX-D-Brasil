msgid "내가 하는 일 알잖아요. 외부에서 활동하는 사람들과 연락하고 일 기획해요. 활동은 시위 같은 거고요."
msgstr "Você talvez esteja curioso sobre o que eu faço. É simples - eu me comunico com nossos membros externos e coordeno atividades. Na maioria das vezes, coisas como protestos."

msgid "내가 하는 일이 뭔지 알아? 그 뭐 같은 워프에 휘말려 온 사람들 잡아다가 무법섬에다가 파는 거야. 너나 내가 여기 처음 왔을 때처럼 넋이 빠져서, 전화기만 붙잡고 있는 사람들 말이야. 뭐 그 사람들 애기들 같지. 착한 사람도 있을 거고, 나쁜 사람도 있을 거고. 여러 사람 있을 거야."
msgstr "Sabe o que eu faço na verdade? Não é lidar com uma fazenda. Eu capturo pessoas que foram trazidas aqui pelo Portal e as vendo para exércitos nas Ilhas Selvagens. Sim, eu capturo pessoas como eu: confusas, sozinhas, assustadas como... crianças. Boas ou más, não faz diferença."

msgid "내가 한 행동은 절대로 옹호받을 수도 없고, 용서받을 수도 없는 일이다. 난 회사를 떠나겠다."
msgstr "Minhas ações não podem ser explicadas nem perdoadas... Estou consciente disso. Portanto, meu desligamento da Companhia se efetiva imediatamente."

msgid "내가 확실하게 항의해주마. 그러지 못 하도록 말이야."
msgstr "Vou detê-los. Não vão mais poder agir assim."

msgid "내가 회사 사람들이 어떤 합의 때문에 이렇게 행동하는 건지 다 알 순 없지만 말이야."
msgstr "Eu não sei por que estão agindo assim..."

msgid "내구가 강한 건물"
msgstr "Construção de Alta Durabilidade"

msgid "내구가 강함"
msgstr "Alta Durabilidade"

msgid "내구가 약한 건물"
msgstr "Construção de Baixa Durabilidade"

msgid "내구가 약함"
msgstr "Baixa Durabilidade"

msgid "내구도"
msgstr "Durabilidade"

msgid "내구도 0이 되면 사라집니다."
msgstr "Desaparece quando chega em 0 de Durabilidade."

msgid "내구도 {durability}"
msgstr "Durabilidade {durability}"

msgid "내구도 감소"
msgstr "Penalidade de Durabilidade"

msgid "내구도 감소 완화 정도"
msgstr "Grau de Redução da Durabilidade"

msgid "내구도 수정"
msgstr "Editor de Durabilidade"

msgid "내구도 안내"
msgstr "Guia de Durabilidade"

msgid "내구도 정렬"
msgstr "Ordenar por Durabilidade"

msgid "내구도 증가"
msgstr "Bônus de Durabilidade"

msgid "내구도 테스트 (30초)"
msgstr "Teste de durabilidade (30 segundos)"

msgid "내구도 테스트 (60초)"
msgstr "Teste de durabilidade (60 segundos)"

msgid "내구도가 0이 되어 사용할 수 없습니다. 대부분의 아이템은 수리키트나 워프젬으로 <em>수리</em>하면 다시 사용할 수 있습니다."
msgstr "A durabilidade é 0. Não é possível usar. A maioria dos itens pode ser <em>reparado</em> usando o kit de reparo ou as Pedras do Portal."

msgid "내구도가 0이 된 장비는 수리키트를 사용해서 수리할 수 있습니다.\n단, 수리 시 최대 내구도가 감소됩니다."
msgstr "Um equipamento com a durabilidade totalmente esgotada pode ser reparado usando um kit de reparo.\nMas ao fazer isso, a durabilidade máxima do equipamento é reduzida."

msgid "내구도가 1보다 적게 남은 건축물은 포장할 수 없습니다."
msgstr "Construções com durabilidade abaixo de 1 não podem ser empacotadas."

msgid "내구도가 {0:P0} 미만인 아이템은 등록할 수 없습니다"
msgstr "Não é possível registrar itens com durabilidade menor do que {0:P0}"

msgid "내구도가 {lower_bound:p0} 미만인 아이템은 장터에 등록할 수 없습니다."
msgstr "Itens com uma Durabilidade de {lower_bound:p0} ou inferior não podem ser registrados no mercado."

msgid "내구도가 감소합니다."
msgstr "Diminui a Durabilidade."

msgid "내구도가 높아 작업에 사용하기에 좋은 작업칼. \"양심은 옳고 그름이 아닌 자신을 향한 존중이다.\""
msgstr "Faca de trabalho robusta adequada para confeccionar. “Respeite os mortos colocando-os para trabalhar.”"

msgid "내구도가 높아 흙을 푸는데 좋은 삽. \"굴착기의 원형은 여기서 나왔다.\""
msgstr "Pá robusta. Usada para descompactar o solo. “A escavadora original.”"

msgid "내구도가 높은 도끼. \"나무 입장에선 사람을 베는 게 더 좋을 지도 모른다.\""
msgstr "Machado robusto. “Se dependesse das árvores, nós é que seríamos cortados.”"

msgid "내구도가 다 된 건축물은 까만색으로 표시되며 이용할 수 없습니다.\n수리하거나 새로 지어주세요."
msgstr "Construções de durabilidade zero são marcadas em preto e não podem ser usadas.\nConserte-as ou construa novas."

msgid "내구도가 다 된 아이템은 전송할 수 없습니다."
msgstr "Não é possível transferir itens sem nenhuma Durabilidade."

msgid "내구도가 다 된 아이템입니다."
msgstr "A Durabilidade do item acabou."

msgid "내구도가 더 낮아야 수리할 수 있습니다."
msgstr "A durabilidade do item deve ser menor para que possa ser reparado."

msgid "내구도가 비율로 감소합니다."
msgstr "Diminui a Durabilidade em uma certa porcentagem."

msgid "내구도가 비율로 증가합니다."
msgstr "Aumenta a Durabilidade em uma certa porcentagem."

msgid "내구도가 있는 건축물은 사용/착용 여부와 상관없이 시간이 지나면 내구도가 줄어듭니다."
msgstr "Construções com Durabilidade têm esse atributo reduzido com o passar do tempo, independentemente de serem usados ou não."

msgid "내구도가 있는 아이템은 사용/착용 여부와 상관없이 시간이 지나면 내구도가 줄어듭니다."
msgstr "Os itens duráveis têm a sua Durabilidade reduzida com o passar do tempo, independente de estarem equipados ou não."

msgid "내구도가 있는 아이템은 사용/착용 여부와 상관없이 시간이 지나면 내구도가 줄어듭니다.  캐릭터 착용 레벨에 따라 아이템 능력치가 적용됩니다."
msgstr "Os itens duráveis têm a sua Durabilidade reduzida com o passar do tempo, independente de estarem equipados ou não. Os atributos do item têm como base o nível do equipamento do personagem."

msgid "내구도가 있는 아이템은 사용/착용 여부와 상관없이 시간이 지나면 내구도가 줄어듭니다. 캐릭터 착용 레벨에 따라 아이템 능력치가 적용됩니다."
msgstr "Os itens duráveis têm a sua Durabilidade reduzida com o passar do tempo, independente de estarem equipados ou não. Os atributos do item têm como base o nível do personagem que vestir o item."

msgid "내구도가 증가합니다."
msgstr "Aumenta a Durabilidade."

msgid "내구도와 수리"
msgstr "Durabilidade e Reparo"

msgid "내리기"
msgstr "Desmontar"

msgid "내릴 수 없는 곳입니다."
msgstr "Não é possível desembarcar aqui."

msgid "내부 기록"
msgstr "Registros Internos"

msgid "내부 꾸미기"
msgstr "Decorar Interior"

msgid "내부 분위기가 정말 이상해요. 얼마 전까지 리우 선생을 그렇게 다들 비판하고 그랬는데 지금은 딴판입니다."
msgstr "Esse clima é tão estranho... Estavam todos culpando Liu até a pouco tempo. Agora tudo mudou."

msgid "내부 요원이 아니라면 상당한 희생을 감당해야 할 겁니다. 일용직들은 버티지 못 할 거예요."
msgstr "Claro, o sacrifício seria grande. Nosso povo que está no chão pode não suportar."

msgid "내부 테스트용 상태효과"
msgstr "Efeitos de Condição para Testes Internos"

msgid "내부를 수리했으니 여기 넣어두면 <em>전달</em>이 될거에요."
msgstr "Certo, isso deve dar! O interior está consertado e pronto para fazer <em>entregas</em>!"

msgid "내부에서 건수만 생기면 곧 활성화되겠군. 그 둘이 조직 장악력이 있는 편인가?"
msgstr "Aposto que tentaram algo assim que a oportunidade surgiu. Quanto poder eles detém em suas respectivas organizações?"

msgid "내슈빌"
msgstr "Nashville"

msgid "내심 땅에 고인 항공유에 공룡이 발을 담그는 순간\n타임 패러독스로 워프가 발생할 거라고 기대했지만 아니더군요.\n– 신비주의 성향 워프 추적자"
msgstr "Eu esperava que algum tipo de paradoxo temporal fosse se abrir quando vi um Tiranossauro pisar em uma poça de combustível de avião.\nAcho que não funciona desse jeito.\n– Caçador de Portais Rejeitado"

msgid "내역"
msgstr "Histórico"

msgid "내용"
msgstr "Conteúdo"

msgid "내용 확인"
msgstr "Confirmar Conteúdo"

msgid "내용물"
msgstr "Recheio"

msgid "내용물 가져오기"
msgstr "Trazer Conteúdo"

msgid "내용물 꺼내기"
msgstr "Remover Conteúdos"

msgid "내용물 보기"
msgstr "Ver Conteúdo"

msgid "내용물 확인"
msgstr "Checar Recompensas"

msgid "내용물을 넣은 빵"
msgstr "Pão Recheado"

msgid "내용물을 넣은 빵 제작법으로 10번 제작하세요."
msgstr "Crie usando a receita de um Pão Recheado 10 vezes."

msgid "내용물을 넣은 빵. 재료에 따라 효과가 달라진다."
msgstr "Pão recheado com vários itens. Os efeitos variam dependendo dos ingredientes."

msgid "내용물을 넣은 빵을 만들 수 있습니다. 먹으면 의지가 올라갑니다. 내용물을 넣어 추가 효과를 낼 수 있습니다."
msgstr "Faz pão recheado. Coma-o para aumentar a Vontade. Adicione recheio para efeitos extras."

msgid "내용물이 있는 건축물 입니다."
msgstr "Essa construção está armazenando algo."

msgid "내용은 관심 없어. 돈 받을 데 몇 군데 떼주면, 바로 연결해줄게."
msgstr "Não me importo com o que seja. Contanto que você separe um dinheiro, eu vou fazer."

msgid "내용은 여전히 1865년에 사라진 거랑 별 차이는 없어."
msgstr "Vamos ter outra guerra civil nas mãos se ele continuar fazendo isso."

msgid "내용을 접수하지 못했습니다. 통신 상태를 확인해 주세요."
msgstr "Falha ao receber a denúncia. Verifique sua conexão."

msgid "내장"
msgstr "Vísceras"

msgid "내장을 꺼내오렴"
msgstr "Instinto"

msgid "내장을 채집할 수 있습니다. 내장은 고기로 먹을 수도 있고, 소시지 재료로 쓰거나 육식 동물의 사료로 쓸 수 있습니다."
msgstr "Coleta vísceras. Coma-as como carne ou use-as como material para linguiça e ração de carnívoros."

msgid "내집 마련의 시작 1"
msgstr "A Casa dos Sonhos Durango 1"

msgid "내집 마련의 시작 2"
msgstr "A Casa dos Sonhos Durango 2"

msgid "내집 마련의 시작 3"
msgstr "A Casa dos Sonhos Durango 3"

msgid "내집 마련의 시작 4"
msgstr "A Casa dos Sonhos Durango 4"

msgid "내집 마련의 시작 5"
msgstr "A Casa dos Sonhos Durango 5"

msgid "내출혈"
msgstr "Hemorragia Interna"

msgid "내출혈 예방"
msgstr "Prevenção contra Sangramento Interno"

msgid "내출혈 예방 재료"
msgstr "Remédio Preventivo contra Sangramento Interno"

msgid "내출혈 예방약"
msgstr "Prevenção contra Sangramento Interno"

msgid "내출혈 치료"
msgstr "Tratamento para Sangramento Interno"

msgid "내출혈이 회복되었다."
msgstr "Você se recuperou da hemorragia interna."

msgid "내키진 않지만 그 소위 <em>{item_0}</em>에 맞춰줘야 할 때도 있습니다. 그 섬에 <em>{item_1}</em>가 채집해도 환경에 해가 안 될 거란 게 무영향 운동가들의 생각이고요. 포럼엔 제가 동의하지 않더라도 이뤄지는 일이 있습니다."
msgstr "Nós não queremos isso, mas há vezes em que precisamos ajustar o assim chamado <em>{item_0}</em>. Os ativistas contra o impacto ambiental acreditam que coletar <em>{item_1}</em> da ilha não causará impactos negativos ao meio ambiente. Às vezes, mesmo que o Fórum não esteja de acordo, decisões difíceis têm de ser tomadas."

msgid "냄비"
msgstr "Panela"

msgid "냄비가 필요해요"
msgstr "Panela da Sorte"

msgid "냄새 제거"
msgstr "Retirar o Cheiro"

msgid "냉장고"
msgstr "Refrigerador"

msgid "냉정한 용암 파괴자 I"
msgstr "Destruidor de Lava de Cabeça Fria I"

msgid "냉정한 용암 파괴자 II"
msgstr "Destruidor de Lava de Cabeça Fria II"

msgid "냉정한 용암 파괴자 III"
msgstr "Destruidor de Lava de Cabeça Fria III"

msgid "냉정한 용암 파괴자 IV"
msgstr "Destruidor de Lava de Cabeça Fria IV"

msgid "냉정한 용암 파괴자 V"
msgstr "Destruidor de Lava de Cabeça Fria V"

msgid "냉탕에 몸을 담그면 화산의 열기에 대한 저항이 증가합니다. 해당 효과는 1시간 동안 지속되며, 3시간마다 이용할 수 있습니다."
msgstr "Mergulhe nesta piscina refrescante para aumentar sua resistência térmica a calor vulcânico. O efeito dura 1 hora e pode ser usado a cada 3 horas."

msgid "냉탕의 효과로 화산의 열기를 더 잘 견딜 수 있다."
msgstr "Relaxe em uma piscina de água para aplacar o calor vulcânico."

msgid "냐짱"
msgstr "Nha Trang"

msgid "너 내 동료가 되라."
msgstr "Vamos nos Unir!"

msgid "너 때문에 삶이란 게 더 이상하고 신비로워 보인다."
msgstr "Nós achávamos que era o único jeito de operar aqui: cuidando dos nossos interesses, entende? Mas acho que estávamos errados."

msgid "너 아니더라도 날 미치게 할 인간들 많아. 입 닥치고 있어."
msgstr "Já tem gente demais me deixando doida."

msgid "너 은근히 사람 괴롭히는 걸 즐기는구나. 토끼발도 알고 있었어?"
msgstr "Você tem talento pra irritar as pessoas, hein, K? Pé de Coelho, você tem mais paciência do eu pensava."

msgid "너 이 돌멩이를 사라 (테스트)"
msgstr "Um Seixo pelos seus Pensamentos (Teste)"

msgid "너 자신이 백날 떳떳하다고 생각해도 그 생각을 남에게 효과적으로 전하지 않으면 의미가 없어."
msgstr "Você pode se considerar honrado e virtuoso, mas não adianta nada se os outros não concordarem."

msgid "너나 나나 발 묶여 있잖아. 지금 확인하러 갈 수 있는 사람이……"
msgstr "Estamos de mãos atadas. A única pessoa que pode resolver isso..."

msgid "너는 그저 아무 것도 모르고 기차를 탔다가, 스쿱에 휘말려 이곳에 왔을 뿐이야."
msgstr "Você embarcou em um trem, foi inadvertidamente englobado e chegou aqui."

msgid "너는 말은 없지만, 할 일은 다 하더구나."
msgstr "Você não fala muito, mas faz tudo que precisa fazer."

msgid "너는 부족의 살림을 담당하는 인간인데 어떻게 그럴 수가 있냐? 실망했다. 부족장이 그렇게 말했지. 얼굴 낯짝이 대기권보다 두터웠어. 어떤 인공위성도 나사 조각 하나 안 남길 기세였지. 내가 그 동안 모은 서류를 보여주니까 술만 더 마셨지."
msgstr "“Como você pôde fazer isso? Deveria estar colocando o bem-estar do clã em primeiro lugar! Estou decepcionado.” Foi isso o que o chefe disse sem um pingo de vergonha na cara. Aposto que ele poderia aparecer nu na frente de uma platéia, com uma coleira amarrada no pescoço e nem tentaria se cobrir! Eu mostrei a ele todos os documentos que eu tinha coletado até aquele momento e tudo o que ele podia fazer era sentar e tomar uma bebida."

msgid "너는 사실 아무 것도 아니야. X는 알아."
msgstr "Você não sabe de nada. X sabe de tudo."

msgid "너는 잘 해주었다. K 역시 네가 아니었다면 아무 것도 하지 못 했을 것이니 사실 더 큰 공로는 너에게 있다."
msgstr "Ah, Criança... Você se saiu muito bem. K seria inútil sem você. Na verdade, toda a Durango está endividada com você."

msgid "너는 지구인으로 죽을 거니? 아니면 여기 사람으로 죽을 거니?"
msgstr "Quando você morrer, será como uma pessoa deslocada da Terra? Ou vai se tornar um nativo de verdade?"

msgid "너도 누군가처럼 여러 개의 조국을 갖고 있는 거란다."
msgstr "Tantos mestres para uma pessoa."

msgid "너도 늘 생각하거라. 네가 왜 그 낯선 불안정섬에서 헛고생을 하고 있는지."
msgstr "Você deveria pensar muito, também... No motivo de você estar lutando sem parar em uma Ilha Instável."

msgid "너도 지구에서 왔지. K. 아무튼 말싸움 할 기운은 없다."
msgstr "Você também veio da Terra, K. Você... Argh, deixa pra lá. Não tenho energia para discutir com você."

msgid "너를 보고싶어서 조각 해 보았다."
msgstr "Mini Eu"

msgid "너무 가까워서 발사할 수 없습니다."
msgstr "Perto demais para disparar."

msgid "너무 가까워지지 않도록 대치하면서 정확한 사격을 한다."
msgstr "Atira disparos mortais a curta distância."

msgid "너무 가까이 있다가 소용돌이에 휩쓸려버렸지."
msgstr "Como eu disse, eu me aproximei demais. Quase fui levado pelo redemoinho."

msgid "너무 더워서 걷는 것만으로 지친다. 몸을 씻거나 물을 마시면 좀 나아질 것 같다."
msgstr "Caminhar neste calor sufocante vai desgastar você rapidamente. Mantenha-se hidratado e lave-se para permanecer refrescado."

msgid "너무 많은 메시지를 보내 잠시 입력이 제한됩니다."
msgstr "Seu bate-papo foi limitado devido ao envio de muitas mensagens."

msgid "너무 많이 부탁해서 민망할 정도네요. 다른 개척자들도 당신처럼 기본이 된 사람들이면 좋을 텐데, 그렇지가 않으니 누군가는 이 엉망진창에서 쓸 만한 걸 끌어올려야죠. <em>{item_0}</em>으로 쓸 수 있는 걸 구해주세요. 책에서 보니까 <em>{item_1}</em>이 좋던데 그건 좀 무리겠죠?"
msgstr "Chega a ser vergonhoso como eu estou sempre pedindo sua ajuda. Seria legal se os outros pioneiros fossem tão competentes como você. Colete coisas que possam ser usadas como <em>{item_0}</em>. De acordo com o livro, <em>{item_1}</em> seria ótimo. Não estou pedindo muito, certo?"

msgid "너무 매워서 눈물이 찔끔 난다."
msgstr "Tão picante que me dá água nos olhos."

msgid "너무 매워서 혀가 아프다."
msgstr "Muito picante! Boca... queimando!"

msgid "너무 멀어서 발사할 수 없습니다."
msgstr "Longe demais para disparar."

msgid "너무 문어발식으로 나서는 건 아닌가, 가끔 생각을 정리하고 싶을 때가 있다. 당신아. <em>{item_0}</em> 구해오라니. 당신 같은 고급 두뇌가 할 일은 아니지만, 시대가 워낙에 시대잖아."
msgstr "Algumas vezes eu acho que eles só querem nos manter ocupados, quero dizer, agora eles nos mandaram coletar <em>{item_0}</em>. Alguém tão esperto quanto você deve ter coisas melhores para fazer, mas não temos como contestar essas decisões."

msgid "너무 미안하고 염치가 없네요. 내가 모아둔 회사 물건이라도 주고 싶네요."
msgstr "Se dependesse de mim, eu lhe daria tudo o que a Companhia tem como retribuição. Mas só posso lhe dar meu obrigado."

msgid "너무 시어서 어질어질하다."
msgstr "O azedume é estonteante."

msgid "너무 시어서 이가 시리다."
msgstr "Tão azedo que faz meus dentes doerem."

msgid "너무 써서 먹은 걸 토하고 싶다."
msgstr "Está tão amargo que acho que vou vomitar..."

msgid "너무 어렵게 생각할 건 없수. 21세기 지구 사람이나 듀랑고 사람이나 로마 제국의 시민은 아니여."
msgstr "...Não pense demais nisso. Nem um terráqueo do século XXI ou um Durangoniano moderno viveu no Império Romano, então sabemos tanto quanto eles."

msgid "너무 익숙해진 건 아닐까"
msgstr "O tanto necessário"

msgid "너무 짠 나머지 입안이 얼얼하다."
msgstr "Muito salgado. Minha boca está meio estranha."

msgid "너무 쫄진 말고. 너와 같은 방식으로 살진 않으니까 말이야."
msgstr "Mas não se preocupe. Eu não vou desperdiçar minha vida remoendo um ressentimento besta como você faz."

msgid "너무 추워서 덜덜 떨린다. 불을 쬐거나 따뜻한 옷을 입으면 좀 나아질 것 같다."
msgstr "Você sente o frio em seus ossos. Aqueça-se em frente a uma fogueira ou use roupas quentes."

msgid "너무 흥분한 것 같은데 다음에 다시 얘기하자. 이 채널에서 얘기하면 될까?"
msgstr "Você não deveria estar falando agora. Você precisa descansar. Conversamos mais tarde, ok? Você vai estar nesse canal?"

msgid "너비"
msgstr "Largura"

msgid "너야말로 아직도 카우르를 사령관이라 부르잖아."
msgstr "Mas você ainda chama Kauru de comandante."

msgid "너의 감상은 너의 머리로만 생각하거라. 너희가 <em>파악한 정보</em>부터 보고하거라."
msgstr "Deixe de lado seus sentimentos... em tempos como esses, eles são como urubus esperando pela carniça. Conte-me <em>o que você descobriu</em>."

msgid "너의 충성이 갈림길에 서 있구나. 얘야."
msgstr "Você está em uma encruzilhada, criança. Quem detém sua lealdade?"

msgid "너의 힘을 보여주렴"
msgstr "Teste Seu Poder"

msgid "너클"
msgstr "Soqueira"

msgid "너희 마음에 약간 의구심이 생겼을진 몰라도, 너흰 임무에 집중하고 있어."
msgstr "Tenho certeza de que você tem suas dúvidas, mas se concentre em seu trabalho."

msgid "너희 모두 X에게 할 말이 많다는 걸 안단다. 하지만 감상을 말할 시간은 없으니 X부터 얘기하마."
msgstr "Eu sei que vocês têm muito a falar sobre mim. Mas como não temos tempo disponível, eu falo primeiro."

msgid "너희가 그 사실을 몇 가지 암호와 힌트로, 알아낸 건 참 잘 했단다."
msgstr "Você se saiu muito bem, Criança, decifrar a verdade usando alguns criptogramas abandonados e dicas ao vento."

msgid "너희가 하는 일이 불만을 뿜는 거 말고 뭐가 있어? 오래 전에 결정한 일인데, 아직까지 그 얘기라니 전두엽 절제라도 당했냐?"
msgstr "Você pode fazer outra coisa que não seja reclamar? Isso foi decidido há eras, e você ainda está nisso... Um anquilossauro bateu na sua cabeça ou o quê?"

msgid "너희는 궁금해하겠지. X가 <em>어떤 이유</em>로 너희에게 정보를 넘겼는지 말이야."
msgstr "Você está curiosa, tenho certeza... <em>Por que</em> X iria lhe dar a chave da verdade, depois de todo esse tempo?"

msgid "너희는 일종의 <em>비상구</em>란다. 외부로 정보를 보낼 수 있는 <em>지하통로</em> 같은 거지."
msgstr "...Isso é, a menos que o líder tenha uma <em>saída estratégica</em>. Uma <em>passagem secreta</em> pra conseguir informar o mundo lá fora. Em suma, alguém como você, Criança."

msgid "너희들은 겉에 너무 익숙해서 속이 쏟아지면 정신을 못 차리지. 늘 겉이 다가 아니고, 속에 무엇이 있을지를 생각해야 한단다. <em>{item_0}</em>로 교훈을 얻어보자꾸나. 그 아이의 속에 무엇이 들어있는지 <em>{item_1}</em>을 들추어보자꾸나."
msgstr "A maioria das pessoas está tão acostumada com o que está na superfície, que se espantam com as mentiras que estão abaixo dela. As aparências não são tudo, sabe. Você deve pesquisar bastante para aprender o valor real de uma coisa. Pegue o <em>{item_0}</em>, por exemplo... e me traga seu <em>{item_1}</em>."

msgid "너희들이 무슨 짓을 하건 부인할 수 있어야 한단다. 베드로가 그걸 참 잘 했지."
msgstr "Na nossa linha de trabalho, um talento para enganar é indispensável. Pedro era muito bom nisso."

msgid "너희의 말이 노망난 것처럼 들리게 해야 한단다. 진실을 바라보려면 눈을 감아야 해. 눈은 뇌가 보고 싶은 대로 보려고 하니까 말이야."
msgstr "Para fazer os outros acreditarem no que você diz, parte de você também precisa acreditar. A verdade está sempre sendo reescrita de qualquer forma."

msgid "너희의 요구사항은 잘 얘기했단다."
msgstr "Contei a eles sobre suas exigências."

msgid "너희의 충성심은 잘 안다. 하지만 너희 단계에선 고려할 수 없는 문제가 있다. 일일이 설명할 수 없단 건 알지?"
msgstr "Eu sei o quanto você é leal. No entanto, há problemas que estão simplesmente acima do seu nível de pagamento. Você sabe disso, não sabe?"

msgid "넌 XX 특별한 아이야. 우리 모두에게 말이야. 우리가 한 모든 일이 역할극이라고 해도 말이야."
msgstr "Mas você é muito querida por todos nós. Não estávamos atuando ou interpretando um personagem no que diz respeito à nossa afeição por você."

msgid "넌 금고란다."
msgstr "Você está seguro."

msgid "넌 네 <em>역할</em>을 잘 해왔다. 133. 여러 루트로 <em>정보를 흘려 보내는 일</em>이지."
msgstr "Você desempenhou bem o seu <em>papel</em>, 133. Nenhum dos meus outros agentes <em>espalhou informações</em> por tantos canais como você. Bravo."

msgid "넌 누구지?"
msgstr "Quem é você?"

msgid "넌 보상을 위해, <em>노왁, 리우, K</em> 누구건 접촉했지. 그게 <em>X</em>가 널 <em>메신저</em>로 선택한 이유란다."
msgstr "<em>Novak</em>, <em>Liu</em>...<em>K</em>. Você apoiaria qualquer organização se valesse a pena. E é justamente por isso que <em>X</em> a escolheu para ser sua <em>mensageira</em>."

msgid "넌 사과하고 싶지 않잖아. 타협하고 싶은 거지."
msgstr "Você não quer pedir desculpas. Você quer negociar."

msgid "넌 이 무전에 끼어들면 안 돼. 누가 듣기라도 하면,"
msgstr "Você não pode fazer parte desta transmissão. Se alguém escutar..."

msgid "넌 정말로 정말로 감정적인 문제가 있다. 무전기는 그만 잡고 머리나 식혀라."
msgstr "Acho que suas emoções estão te vencendo. Por que você não guarda o rádio e toma um ar?"

msgid "넌 회사를 배신할 거다."
msgstr "Eu sei que você vai trair a Companhia."

msgid "널 키워준 사람들 앞에서 할 말은 아니지."
msgstr "... Você não devia dizer uma coisa dessas para a pessoa que te criou."

msgid "넓은 {item}"
msgstr "{item} Largo(a)"

msgid "넓은 가죽"
msgstr "Couro Largo"

msgid "넓은 나무 화단"
msgstr "Canteiro Largo de Madeira"

msgid "넓은 바위 화단"
msgstr "Canteiro Largo de Pedra"

msgid "넓은 밭"
msgstr "Campo Grande"

msgid "넓은 밭 건설하기"
msgstr "Construção de Campo Grande"

msgid "넓은 뿔 화단"
msgstr "Canteiro Largo de Chifre"

msgid "넓은 사각 물뿜이"
msgstr "Irrigador Quadrado Largo"

msgid "넓은 사각 물뿜이 도면"
msgstr "Projeto de Irrigador Quadrado Largo"

msgid "넓은 사각 물뿜이를 건설할 수 있는 도면."
msgstr "Projeto para criar um Irrigador Quadrado Largo."

msgid "넓은 세계에 나와 자유의 몸이 되었다."
msgstr "Aventurou-se pelo mundo."

msgid "넓은 천"
msgstr "Tecido Largo"

msgid "넓은 천 모양"
msgstr "Formato de Tecido Largo"

msgid "넓은 털가죽"
msgstr "Pele Larga"

msgid "넓은 톱니 모양의"
msgstr "Forma de Serrilhado Largo"

msgid "넓은 판재"
msgstr "Tábua Larga"

msgid "넓음"
msgstr "Amplitude"

msgid "넓이"
msgstr "Área"

msgid "넓적 상자"
msgstr "Caixa Larga"

msgid "넓적 상자 도면"
msgstr "Projeto de Caixa Larga"

msgid "넓적 상자를 건설하세요."
msgstr "Construa uma caixa larga."

msgid "넓적 상자를 만들 수 있습니다. 넓적 상자엔 큰 상자보다 물건을 더 많이 보관할 수 있습니다."
msgstr "Faz uma Caixa Larga. Armazena mais itens que uma caixa grande."

msgid "넓적 잎상자"
msgstr "Caixa de Folhas Larga"

msgid "넓적잎"
msgstr "Folha Larga"

msgid "넓직한 데다가 터를 잡고 있어. 자네 연구는 잘 되어 가는 겨?"
msgstr "Estava pensando em reivindicar esse terreno. Sua pesquisa vai bem?"

msgid "넓힌 {item}. \"확장성은 미래를 위해 필요하다.\""
msgstr "{item} alargado(a). “Temos que nos adaptar aqui.”"

msgid "넘어졌다던데."
msgstr "Ele caiu."

msgid "넝쿨에 싸인 나무"
msgstr "Árvore Coberta de Hera"

msgid "넝쿨에 싸인 나무 나뭇가지"
msgstr "Galho de Árvore Coberta de Hera"

msgid "넝쿨에 싸인 나무 덩굴"
msgstr "Videiras de Árvore Coberta de Hera"

msgid "넝쿨에 싸인 나무 통나무"
msgstr "Tronco de Árvore Coberta de Hera"

msgid "넣기"
msgstr "Incluir"

msgid "넣을 아이템이 없습니다."
msgstr "Não há itens para colocar dentro."

msgid "네"
msgstr "Sim"

msgid "네 <em>도덕심</em>은 칭찬하겠지만, <em>보통 사람들</em>은 이 일에 도움이 안 돼."
msgstr "Saúdo o seu <em>senso de moralidade</em>, mas <em>pessoas comuns</em> não vão se comover tão fácil."

msgid "네 <em>쓰임새</em>가 멀지 않았구나. <em>모든 기후</em>에서 가속기 실험을 진행해보거라."
msgstr "Porém, o seu <em>verdadeiro propósito</em> ainda será revelado. Portanto, você deve ajudar nos experimentos com os Aceleradores em <em>todos os climas</em>."

msgid "네 그럴게요."
msgstr "Vamos nessa!"

msgid "네 기분은 이해하지만, 시간 낭비야. 회사엔 다른 일이 많아."
msgstr "Não é que eu não entenda seus sentimentos, mas acho uma perda de tempo. A Companhia já está muito espalhada."

msgid "네 발로 힘차게 적에게 돌진한다."
msgstr "Corre para cima do inimigo a toda velocidade."

msgid "네 배짱도 그 정도니, 임무 사령관이 못 된 거야. 에두아르도."
msgstr "Você nunca teve bolas para se tornar comandante de missão, Eduardo."

msgid "네 스스로 누구를 죽일지 기획하고, 실제로 실행하고, 완료한 다음에 그 결과를 평가할 수 있는 경험을 쌓아야 한단다. 경험을 쌓는 게 쉽진 않지만, <em>{item_0}</em>을 대상으로 해보렴. 평가는 <em>{item_1}</em>으로 대체하자꾸나."
msgstr "Você precisa começar a planejar sozinho suas mortes. Há um limite de até onde podemos guiá-lo. Mais cedo ou mais tarde, você vai ter que errar, e é aí que o verdadeiro aprendizado começa. Tente marcar um <em>{item_0}</em> como alvo. Traga-me um pouco de <em>{item_1}</em>, se você conseguir."

msgid "네 양심이 비인도적인 행동에 흔들릴 것 같더라도 당분간은 견디거라."
msgstr "Sua consciência pode parecer tão pesada agora. Mas não se preocupe, criança."

msgid "네 어깨가 생각나. 햇볕에 타서 살이 일었지. 여긴 바람이 차. 배탈이 자주 나고 어떨 땐 설사가 너무 심해서 몸 안에 있는 게 죄다 쏟아질 것 같더라고. 여기 와서 몸무게 재 본 적은 없는데, 물가에 가서 내 꼴을 보면 거식증 걸린 10대 같아. 이제 40킬로그램도 안 될 거야."
msgstr "Eu me lembro dos seus ombros. Sua pele rachada pelos raios solares. O vento é frio aqui. Além de meu estômago estar sempre irritado, eu frequentemente tenho diarréia também; é como se minhas tripas fossem expelidas para fora de mim. Quando eu vejo meu reflexo na água, me lembro de um adolescente anoréxico. Eu acho que estou pesando cerca de 45 quilos."

msgid "네 임무가 그건데 당연히 그래야지. 얘야."
msgstr "Certo. Esse é seu trabalho, afinal."

msgid "네. 근데 나는 예외였고, 그만큼 우린 널 사랑해, 이 얘기하려고?"
msgstr "Ah, entendi o que está acontecendo aqui. Você está tentando me dizer que eu fui uma exceção, porque vocês todos me amam muito. Não é isso?"

msgid "네. 맞습니다. 포럼의 홍보 담당자인 리우졔와 회의의 대외협력 담당자인 우르줄라 노왁에 관한 소문입니다."
msgstr "É sobre Liu Jie, diretor de relações públicas do Fórum, e Ursula Novak, encarregada das relações exteriores."

msgid "네. 아주 잘 듣고 있습니다."
msgstr "Na verdade, estou."

msgid "네? 증언을 했어요? 뭐라고 했는데요?"
msgstr "O quê? O depoimento já foi prestado? O que foi dito?"

msgid "네가 <em>{item_0}</em>를 잡으면 말이야. 징병관은 두 가지 교훈을 얻는단다. 하나는 그 <em>{item_1}</em>으로 활동 자금을 마련하는 게 어려워진다는 것, 둘째는 그걸 잡을 만큼 위험한 인간이 자신들 주변에 있다는 것. 좋은 교훈이지."
msgstr "Pegar um<em>{item_0}</em> irá provar duas coisas aos recrutadores. Uma: Eles não podem contar com o suprimento de<em>{item_1}</em> para financiar suas...atividades. Dois: Há alguém por aí forte o bastante para derrotar uma fera gigante de presas afiadas. Isso os fará dar uma pausa."

msgid "네가 X 앞에 있지 않으니, X의 앞에 커피 두 잔을 뒀단다."
msgstr "Mas já que você ainda não está aqui, existem duas xícaras de café diante de X. Uma pena... pelo menos para você."

msgid "네가 괜히 여행을 가자고 해서 이렇게 됐잖아."
msgstr "Tudo isso porque você queria aquelas malditas férias!"

msgid "네가 너 자신을 어떻게 생각하는지 모르겠지만 말이다."
msgstr "...Apesar de eu não saber que ideia você faz de si mesmo."

msgid "네가 듣는 말은 <em>K</em>에게도 흘러 가지. 하지만 이건 <em>흘러 가라고 하는 말이 아냐</em>."
msgstr "Por favor, não seja tímida. Eu sei que você vazou informações para a <em>K</em> antes. Mas, nesse caso, um vazamento não seria suficiente, <em>precisaria ser uma enxurrada</em>."

msgid "네가 무슨 짓을 하건 네가 한 짓이 아니라 말할 수 있어야 넌 뛰어난 아이야."
msgstr "Se conseguir negar certas atividades e certos eventos, melhor."

msgid "네가 뭘 두려워하는지 알아. 계획이 탄로나는 게 싫은 거잖아."
msgstr "Eu sei de que você tem medo... Do seu plano ser exposto."

msgid "네가 뭘 봤는지 알 것 같아. 그런 말을 믿고 싶을 때도 있겠지."
msgstr "Eu sei o que você pensa que viu. Acreditar nisso deve ajudar você."

msgid "네가 아는 걸 잘 숨겨둬."
msgstr "Mantenha o que você sabe em segredo."

msgid "네가 얘기하는 것 중에 나한테 흥미가 가는 게 없는데."
msgstr "Não temos nada pra conversar."

msgid "네가 우릴 쫓고 죽이더니, 이젠 살렸군. 알로사우루스 죽은 걸 봤다."
msgstr "Você nos caçou, nos matou, e agora está nos salvando? Eu vi aqueles temíveis Alossauros..."

msgid "네가 유황과 숯을 구해오거라. 그러면 알 수 있겠지."
msgstr "Pegue um pouco de enxofre e carvão para que possamos tirar a dúvida."

msgid "네가 윤리를 지껄여? 개척 회의는 끝났어. 정상적인 사고 방식이 통하지 않는 조직이 됐어. 독재자 하나 때문에 말이야!"
msgstr "Você, falando de ética? É o fim da Coalizão da Fronteira. Caíram nas garras de uma verdadeira ditadora."

msgid "네가 행복하건 행복하지 않건 이 사실은 받아 들여야 한다."
msgstr "Sua felicidade não interfere nisso. Essa é a realidade que você precisa aceitar."

msgid "네가 회사에 해를 끼친다면 난 얼마든지 할 거다."
msgstr "Se alguém se torna uma ameaça para a Companhia, eu vou fazer o que tiver que fazer para impedir."

msgid "네게 특별한 자질을 본 것은 아니지만, 기초적인 임무를 마칠 수 있는 건 알았다."
msgstr "Sejamos honestos, eu não escolhi você por causa de nenhuma qualidade especial. Eu apenas sabia que você era capaz de completar missões básicas."

msgid "네덜란드"
msgstr "Países Baixos"

msgid "네메시스"
msgstr "Nêmesis"

msgid "네메아"
msgstr "Nemeia"

msgid "네모 돌 벽"
msgstr "Parede de Pedra Quadrada"

msgid "네모 돌 벽. 조립식 건축물인 벽집을 건축할 때 재료로 사용된다. \"슬픔과 우울함도 기댈 벽이 있으면 조금 나아진다.\""
msgstr "Parede feita de pedras quadradas. Usada como material para casas e abrigos que fizerem parte de construções pré-fabricadas. \"Quando a vida lhe derruba e você precisa de um apoio, tente uma parede.\""

msgid "네바도델루이스"
msgstr "Nevado del Ruiz"

msgid "네발 공룡 잡기 I"
msgstr "Capturando Dinos Quadrúpedes I"

msgid "네발 공룡 잡기 II"
msgstr "Capturando Dinos Quadrúpedes II "

msgid "네발 공룡 잡기I <link>스킬</link> 배우기"
msgstr "Aprenda a <link>habilidade</link> Capturar Dinos Quadrúpedes"

msgid "네브셰히르"
msgstr "Nevsehir"

msgid "네스"
msgstr "Ness"

msgid "네스토르"
msgstr "Nestor"

msgid "네안데르탈인"
msgstr "Neanderthal"

msgid "네움"
