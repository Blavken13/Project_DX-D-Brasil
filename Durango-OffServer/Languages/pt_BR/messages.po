msgstr "O EXP do jogador {player_name} aumentou em {incr_exp} com um bônus de {bonus_exp}, e passou de {before_exp} (Nv. {before_level}, {before_rate}%) para {exp} (Nv. {after_level}, {after_rate}%)."

msgid "{player_name} 님의 상품 보관함에서 상품이 만료. 상품 아이디: {purchase_id}, 상품 종류: {commodity_id}"
msgstr "Um produto vencido no armazém de {player_name}. ID do Produto: {purchase_id}. Tipo de produto: {commodity_id}."

msgid "{player_name} 님의 스킬 포인트가 {prev_usable_point}/{prev_skill_point} 에서 {diff_usable_point}/{diff_skill_point} 만큼 변동되어 {curr_usable_point}/{curr_skill_point} 가 됨, 사유: {reason}"
msgstr "Os pontos de habilidade de {player_name} foram alterados de {prev_usable_point}/{prev_skill_point} para {curr_usable_point}/{curr_skill_point}. Uma diferença de {diff_usable_point}/{diff_skill_point}. Motivo: {reason}."

msgid "{player_name} 님의 안구추적 개인정보를 제거함"
msgstr "As informações sobre a frequência de piscar de olhos de {player_name} foram apagadas."

