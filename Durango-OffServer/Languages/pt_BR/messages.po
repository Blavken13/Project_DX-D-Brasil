msgstr "Coleta peles pequenas. Use-as quando precisar de formatos de couro ou tecido. Roupas e acessórios feitos de pele são ideias para aguentar o frio."

msgid "작은 테이블"
msgstr "Mesa Pequena"

msgid "작은 트리"
msgstr "Árvore Pequena"

msgid "작은 한 걸음"
msgstr "Um Pequeno Passo"

msgid "작은 현무암"
msgstr "Basalto Pequeno"

