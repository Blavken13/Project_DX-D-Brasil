msgstr "Fruit"

msgid "과일 I"
msgstr "Fruit I"

msgid "과일 II"
msgstr "Fruit II"

msgid "과일 구해다주세요"
msgstr "Fruity Favors"

msgid "과일 기름"
msgstr "Fruit Oil"

msgid "과일 볶음면"
msgstr "Fruit Fried Noodles"

msgid "과일 섞기"
msgstr "Fruit Mixing"

