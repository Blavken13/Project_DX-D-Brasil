msgstr "Wave {wave} of phase {phase} in {entity_name} session ({session_id}) cleared on {tile} of {entity_region_name} Island."

msgid "{entity_region_name} 섬 {tile} 의 {entity_name} 세션({session_id}) 에서 {phase} 페이즈 클리어"
msgstr "Phase {phase} cleared in {entity_name} session ({session_id}) on {tile} of {entity_region_name} Island."

msgid "{entity_region_name} 섬 {tile} 의 {entity_name} 세션({session_id}) 종료 ({phase} 페이즈 클리어)"
msgstr "{entity_name} session ({session_id}) ended on {tile} of {entity_region_name} Island. (Phase {phase} cleared)"

msgid "{entity_region_name} 섬 {tile}에서 {entity_name} 인벤토리의 {from_section} 섹션 내에 {item_name} 제거. 사유: {item_popped_reason}"
msgstr "On {tile} of {entity_region_name} Island, {item_name} was removed from the {from_section} section of {entity_name}'s inventory. Reason: {item_popped_reason}."

msgid "{entity_region_name} 섬 {tile}에서 {entity_name} 인벤토리의 {into_section} 섹션에 {item_name} 추가, 잠금설정: {is_locked}, 사유: {item_added_reason}"
msgstr "On {tile} of {entity_region_name} Island, {item_name} was added to the {into_section} section of {entity_name}'s inventory. Lock Status: {is_locked}, Reason: {item_added_reason}."

