msgstr "Lava Kiln"

msgid "용암 가마 건설하기"
msgstr "Lava Kiln Building"

msgid "용암 가마 도면"
msgstr "Lava Kiln Plan"

msgid "용암 가마를 건설하세요."
msgstr "Build a lava kiln."

