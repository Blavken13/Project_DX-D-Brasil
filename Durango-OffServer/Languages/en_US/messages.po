msgid "우편 변경"
msgstr "Mail Changed"

msgid "우편 수령"
msgstr "Mail Receipt"

msgid "우편 제거"
msgstr "Remove Mail"

msgid "우편은 30일이 지나면 자동으로 삭제됩니다."
msgstr "Mail will automatically be deleted after 30 days."

msgid "우편이 없습니다."
msgstr "No mail."

msgid "우편이 회수되었습니다."
msgstr "Mail has been collected."

