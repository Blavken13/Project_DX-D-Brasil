msgstr "(Fee excluded) <em>{0}</em> sold, <em>{1}</em> obtained."

msgid "(수수료 제외) <em>{0}</em> 외 {1}개의 아이템을 팔아 <em>{2}</em>을 받았습니다."
msgstr "(Fee excluded) {1} item sold (incl. <em>{0}</em>), <em>{2}</em> acquired."

msgid "(시스템 건물: 플레이어 건설 불가능)"
msgstr "(System Building: Player cannot build)"

msgid "(시스템) 직접 제작할 일 없음"
msgstr "(System) Can be crafted without work."

msgid "(안씀) 사바나_노란잎나무"
msgstr "(Not Used) Savanna_Yellow Leaf Tree"

msgid "(이번 빌드에 사람이 만들 수 있을까?)"
msgstr "(Can people create it in this build?)"

msgid "(임시) 나무 태그가 붙은 아이템"
msgstr "(Temporary) Items with a tree tag"

msgid "(제작하는게 아님)"
msgstr "(Not for crafting)"

msgid "(짖는다.)"
msgstr "(Pia barks in the background.)"

msgid "(채널을 바꿨다.)"
msgstr "(Radio crackles as the channels are changed.)"

msgid "(총성이 들리고 무전이 끊긴다.)"
msgstr "(Gunshots sound. The walkie-talkie goes dead.)"

msgid "(총성이 들리고 무전이 끊어진다.)"
msgstr "(Another gunshot echoes through the transmission. The walkie-talkie goes dead.)"

msgid "(치트용) 현대인의 향기"
msgstr "(Cheat) Modern Scent"

msgid "(치트용) 휴식"
msgstr "(Cheat) Rest"

msgid "(테스트) 간이 천막의 도면. 부지를 선정한 개척자만 건설이 가능하다."
msgstr "(Test) Diagram for a makeshift tent. Can only be constructed by the pioneer who chose the site."

msgid "(테스트) 무기한 이용권"
msgstr "(Test) Indefinite Voucher"

msgid "(테스트) 이용 불가권"
msgstr "(Test) Unusable Voucher"

msgid "(테스트) 행복 이용권"
msgstr "(Test) Happiness Voucher"

msgid "(테스트용)그로기무기"
msgstr "(For testing) Stun Weapon"

msgid "(테스트용)만능무기"
msgstr "(For testing) All-Purpose Weapon"

msgid "(판매 수수료 제외) 판매 수익"
msgstr "(Registration fee excluded) Sale Profit"

msgid "(현재 시용하지 않음)"
msgstr "(Currently Not Used)"

msgid "* 게임 이용 중 발생한 튕김/끊김 현상에 대해서 제보해 주세요.\n<em>* 제보창구로 접수해주신 내용에는 별도의 답변을 드리지 않습니다.</em>\n* 결제/계정/복구 문의는 [고객센터-결제/기타]를 통해 접수해 주세요."
msgstr "* Please help report crashes/disconnections during the game.\n<em>* Reports submitted as a general inquiry will not be answered.</em>\n* Please submit questions regarding Payment/Account/Restoration to [Customer Service > Payment/Other]."

msgid "* 접수해주신 건의는 게임 서비스 개선을 위해 사용됩니다.\n<em>* 제보창구로 접수해주신 내용에는 별도의 답변을 드리지 않습니다.</em>\n* 결제/계정/복구 문의는 [고객센터-결제/기타]를 통해 접수해 주세요."
msgstr "* Your report will be used to provide a better gaming experience.\n<em>* Reports submitted as a general inquiry will not be answered.</em>\n* Please submit questions regarding Payment/Account/Restoration to [Customer Service > Payment/Other]."

