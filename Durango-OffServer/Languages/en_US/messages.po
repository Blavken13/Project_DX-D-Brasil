msgid "{deportee} 님이 추방되었습니다."
msgstr "{deportee} was banned."

msgid "{destroyer_entity_name}의 {reason}. {entity_region_name} 섬 {tile} 위치의 레벨{level} {entity_name} 파괴됨. 보관중인 아이템: {inventory_items}"
msgstr "{destroyer_entity_name}'s {reason}. Destroyed the level {level} {entity_name} located on {tile} of {entity_region_name} Island. Stored items: {inventory_items}."

msgid "{entity_name} 님이 {start_time} ~ {end_time} 까지 채팅금지"
msgstr "{entity_name} blocked chat from {start_time} - {end_time}."

msgid "{entity_name} 님이 동물의 방목 상태를 변경 관리 -> 방목: {grazed} 방목 -> 관리: {leashed}"
msgstr "{entity_name} has changed an animal's status from manage -> roam: {grazed} roaming -> manage: {leashed}"

msgid "{entity_name} 찾아서 연락"
msgstr "Find and contact {entity_name}"

msgid "{entity_region_name} 섬 {tile} {entity_name}에 {farmer_name} 님이 심은 {item_name} 재배 완료({result})"
msgstr "Cultivated {item_name} at {entity_name} on {tile} of {entity_region_name} Island, which was planted by {farmer_name} ({result})."

msgid "{entity_region_name} 섬 {tile} {entity_name}에 건축물 스탯 변화. 안락도: {comfort}, 항균력: {antibacterial}, 복잡도: {complexity}"
msgstr "{entity_name} on {tile} of {entity_region_name} Island's building stats have changed. Comfort: {comfort}. Antibiotic: {antibacterial}. Complexity: {complexity}."

msgid "{entity_region_name} 섬 {tile} {entity_name}에 분위기 효과 {mood_id} 변화. 레벨: {level}"
msgstr "{entity_name} on {tile} of {entity_region_name} Island's ambiance effect changed to {mood_id}. Level: {level}."

msgid "{entity_region_name} 섬 {tile} {entity_name}에 세트 효과 {set_id} 변화. 구성: {slots}"
msgstr "{entity_name} on {tile} of {entity_region_name} Island's set effect changed to {set_id}. Content: {slots}."

msgid "{entity_region_name} 섬 {tile} 위치에서 {victim_entity_name} 에게 데미지를 줌. 데미지: {damage_value}, 피해자의 이전 체력: {before_hp}, 피해자의 이후 체력: {after_hp}, 가해자: {killer_entity_name}"
msgstr "Damage was dealt to {victim_entity_name} on {tile} of {entity_region_name} Island. Damage: {damage_value}. Victim's HP before: {before_hp}. Victim's HP after: {after_hp}. Attacker: {killer_entity_name}."

msgid "{entity_region_name} 섬 {tile} 위치의 레벨{level} {entity_name} 노후 되어 섬 정화로 자연 철거됨. 보관중인 아이템: {inventory_items}"
msgstr "The level {level} {entity_name} on {tile} of {entity_region_name} Island has deteriorated beyond repair, so it was naturally demolished when the island was restored. Stored items: {inventory_items}."

