msgstr "Lava Tempering I"

msgid "용암 돌피부 A"
msgstr "Lava Stone Skin A"

msgid "용암 돌피부 B"
msgstr "Lava Stone Skin B"

msgid "용암 돌피부 S"
msgstr "Lava Stone Skin S"

msgid "용암 보호 장화"
msgstr "Lava Protection Boots"

msgid "용암 보호 장화 제작법으로 1회 제작하세요."
msgstr "Craft using a Lava Protection Boots Pattern 1 time."

msgid "용암 부엌"
msgstr "Lava Kitchen"

msgid "용암 부엌을 건설하세요."
msgstr "Build a lava kitchen."

msgid "용암 붓기!"
msgstr "Pour Lava"

msgid "용암 용기"
msgstr "Lava Container"

msgid "용암 채집 장비 요청"
msgstr "Lava Gathering Gear Request"

msgid "용암 채집하기 I"
msgstr "Lava Gathering I"

msgid "용암 채집하기 II"
msgstr "Lava Gathering II"

msgid "용암 채집하기 III"
msgstr "Lava Gathering III"

