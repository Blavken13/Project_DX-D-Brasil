msgid "도축을 100회 진행하면, 보상으로 뼈 작업칼을 얻을 수 있습니다."
msgstr "You'll receive a bone work knife as a reward when you butcher 100 times."

msgid "도축을 100회 하세요"
msgstr "Butcher 100 times."

msgid "도축을 100회 하세요."
msgstr "Butcher 100 times."

