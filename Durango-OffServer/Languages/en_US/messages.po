msgstr "<em>Day {0}</em>"

msgid "<em>{1:lv:} {2}</em>섬인 <em>{0}</em>에 도착했습니다."
msgstr "Arrived at the <em>{1:lv:} {2}</em> <em>{0}</em> island."

msgid "<em>{1}</em> 님을 추방했습니다."
msgstr "<em>{1}</em> has been kicked."

msgid "<em>{1}</em> 님을 추방했습니다. (추방자: <em>{0}</em>)"
msgstr "<em>{1}</em> has been banned. (Banned by <em>{0}</em>)"

