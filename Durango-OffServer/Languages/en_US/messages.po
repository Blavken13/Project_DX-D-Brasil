msgid "용암 구덩이_대형_volcano"
msgstr "Lava Pit_Large_volcano"

msgid "용암 구덩이_대형_뿌리기용"
msgstr "Lava Pit_Large_For Throwing"

msgid "용암 구덩이_소형_volcano"
msgstr "Lava Pit_Small_volcano"

msgid "용암 구덩이_소형_뿌리기용"
