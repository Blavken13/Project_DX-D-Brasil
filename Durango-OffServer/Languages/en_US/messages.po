msgstr "Tourist_dinocostume"

msgid "관광객_길리슈트"
msgstr "Tourist_ghilliesuit "

msgid "관광객_벤치옆"
msgstr "Tourist_benchside"

msgid "관광객_불그릇앞"
msgstr "Tourist_firebowlfront"

msgid "관광객_센터남"
