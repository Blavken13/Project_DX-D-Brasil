msgstr "Lava Damage Immunity"

msgid "용암 피해 예방"
msgstr "Lava Damage Prevention"

msgid "용암 피해에 면역이다."
msgstr "Immune to lava damage."

msgid "용암 하드로사우루스"
msgstr "Lava Hadrosaurus"

msgid "용암 하드로사우루스 가죽"
msgstr "Lava Hadrosaurus Leather"

msgid "용암 하드로사우루스 갈비뼈"
msgstr "Lava Hadrosaurus Rib"

msgid "용암 하드로사우루스 고기"
msgstr "Lava Hadrosaurus Meat"

msgid "용암 하드로사우루스 내장"
msgstr "Lava Hadrosaurus Intestine"

msgid "용암 하드로사우루스 머리뼈"
msgstr "Lava Hadrosaurus Skull"

msgid "용암 하드로사우루스 사냥하기"
msgstr "Lava Hadrosaurus Hunting"

msgid "용암 하드로사우루스 큰 다리뼈"
msgstr "Large Lava Hadrosaurus Leg Bone"

msgid "용암 하드로사우루스를 3마리 사냥하세요."
msgstr "Hunt 3 Lava Hadrosaurus."

msgid "용암 하드로사우루스를 잡거라"
msgstr "Catching the Lava Hadrosaurus"

msgid "용암쇠망치"
msgstr "Lava Hammer"

msgid "용암쇠망치머리"
msgstr "Lava Hammer Head"

msgid "용암에 그을린 덤불. \"아직 완전히 타지 않았다.\""
msgstr "Bush scorched by lava. \"There's still so much left to burn.\""

msgid "용암에 닿았다. 생명력이 크게 감소한다. "
msgstr "You made contact with some lava. You are losing a large amount of Health."

msgid "용암에 무기를 담금질해 공격력과 치명도를 올린다."
msgstr "Increase Attack and Lethality by tempering weapons with lava."

msgid "용암에서 금속 양동이로 채집합니다."
msgstr "Gather lava with your metal bucket."

msgid "용암에서 볼 수 있는 <em>검은 철광석</em>을 채광하세요."
msgstr "Mine <em>black iron ore</em> found in lava."

msgid "용암에서만 가능합니다."
msgstr "Only available in lava."

msgid "용암을 10번 채집하세요."
msgstr "Gather lava 10 times."

msgid "용암을 50번 채집하세요."
msgstr "Gather lava 50 times."

msgid "용암을 5번 채집하세요."
msgstr "Gather lava 5 times."

msgid "용암을 건널 수 있는 장화."
msgstr "Boots that allow you to walk through lava."

msgid "용암을 건널 수 있는 장화. \"용암을 걷는 사람 소문을 들어보았습니까?\""
msgstr "Boots for walking across lava. \"Have you ever heard of anyone who could walk on lava?\""

msgid "용암을 사용해 더욱 고온을 낼 수 있는 용암 가마."
msgstr "Kiln that uses lava to generate higher temperatures."

msgid "용암을 사용해 더욱 고온을 낼 수 있는 용암 부엌."
msgstr "Kitchen that generates high temperatures using lava."

msgid "용암을 퍼다가 소사이어티 연구 장치에다 부어 버려."
msgstr "Collect lava and pour it on the Society's research device."

msgid "용암을 퍼오거라"
msgstr "I'd Lava Some"

msgid "용암이 굳은 바위. 망치로 깰 수 있을 것 같다. \"한때의 열정이 식어도, 삶은 다른 방법을 찾아본다.\""
msgstr "Boulder made of hardened lava. Can be broken with a hammer. \"Passionate flames may cool, but life goes on.\""

msgid "용암처리된 {prototype}"
msgstr "Lava-Processed {prototype}"

