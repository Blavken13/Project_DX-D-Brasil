msgid "열대blue_AF03 버섯통나무"
msgstr "Tropical Blue_AF03 Mushroom Log"

msgid "열대blue_FL01 식충식물"
msgstr "Tropical Blue_FL01 Carnivorous Plant"

msgid "열대blue_구즈매니아"
