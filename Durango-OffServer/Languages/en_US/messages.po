msgid "군도6 갈리미무스가드"
msgstr "Archipelago 6 Gallimimus Guard"

msgid "군도6 데이노니쿠스x1"
msgstr "Archipelago 6 Deinonychus x1"

msgid "군도6 데이노니쿠스가드"
msgstr "Archipelago 6 Deinonychus Guard"

msgid "군도6 데이노니쿠스무리"
msgstr "Archipelago 6 Deinonychus Group"

msgid "군도6 메갈로케로스_부녀회"
msgstr "Archipelago 6 Megaloceros_Collection"

msgid "군도6 메갈로케로스_유치원"
msgstr "Archipelago 6 Megaloceros_Group"

msgid "군도6 메갈로케로스_풀스펙"
msgstr "Archipelago 6 Megaloceros_Full Spec"

