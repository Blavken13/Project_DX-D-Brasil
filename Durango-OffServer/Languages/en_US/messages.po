msgstr "Request"

msgid "요청 {0}"
msgstr "Request {0}"

msgid "요청 가능 횟수를 모두 사용하였습니다. {0} 뒤 지원 요청 가능합니다."
msgstr "You cannot request any more support right now. Please wait {0}."

msgid "요청 날짜"
msgstr "Request Date"

msgid "요청 시간"
msgstr "Time of Request"

msgid "요청 취소"
msgstr "Cancel Request"

msgid "요청사유"
msgstr "Reason for Request"

msgid "요청사유를 입력해 주세요."
msgstr "Please explain the reason for your request."

msgid "요청을 처리하지 못했습니다."
msgstr "Failed to process request."

msgid "요청이 등록되었습니다. 상위권자의 승인이 필요합니다."
msgstr "Request has been registered. Awaiting approval from a higher rank."

msgid "요청자"
msgstr "Requester"

msgid "요청할 것 없음"
msgstr "Nothing to Request"

msgid "요코하마"
msgstr "Yokohama"

msgid "요크"
msgstr "York"

msgid "요하네스버그"
msgstr "Johannesburg"

msgid "욕 안 먹고 폭력을 휘두를 방법을 찾는 것뿐이죠. 누구처럼 말이에요."
msgstr "They'll adopt any ideology that will justify violence."

msgid "욕설, 비하 표현 등 타인에게 불쾌감을 주는 표현을\n나타낼 경우 제재를 받을 수 있습니다."
msgstr "Offensive expressions, such as profanity and derogatory phrases,\nmay get you reported."

msgid "욕설, 음란한 내용 등으로 인해 불쾌합니다"
msgstr "Inappropriate or abusive content"

msgid "욕설/음란한 언어 사용 등으로 신고가 누적되어 {duration}시간 동안 게임 내 모든 채팅 이용이 불가능합니다."
msgstr "Cannot use in-game chat for {duration} hour{duration:p:|s} because you have been reported multiple times for inappropriate or abusive language."

msgid "용건만."
msgstr "Keep it short."

msgid "용기"
msgstr "Container"

msgid "용기 정보"
msgstr "Container Info"

msgid "용기가 가득 찼습니다."
msgstr "The container is full."

msgid "용기가 비어 있습니다."
msgstr "The container is empty."

msgid "용기의 내구도가 부족합니다."
msgstr "Insufficient container Durability."

msgid "용량"
msgstr "Capacity"

msgid "용설란"
msgstr "Agave"

msgid "용설란 SW01"
msgstr "Agave SW01"

msgid "용설란 과육"
msgstr "Agave Pulp"

msgid "용설란 군락"
msgstr "Agave Cache"

msgid "용설란 꽃"
msgstr "Agave Flower"

msgid "용설란에서 얻은 과육. \"이런 건 사진으로만 보고 살 줄 알았지.\""
msgstr "Pulp from agave plants. \"Just like the hippest coffee shops.\""

msgid "용설란은 꽃을 피우는 데 오래 걸립니다."
msgstr "Agaves take quite some time to flower."

