msgid "창자루"
msgstr "Pikestaff"

msgid "창저우"
msgstr "Changzhou"

msgid "창춘 룽자"
msgstr "Changchun Longjia"

msgid "창키리"
msgstr "Cankiri"

msgid "찾기"
msgstr "Search"

msgid "찾기 어렵겠지만 부탁해요"
msgstr "Branching Out"

msgid "찾아내서 구조해주십시오. 탈수로 위험합니다."
msgstr "Please find and rescue them. They may be in danger because of dehydration."

msgid "찾아서 없애야 합니다."
msgstr "Find it and get rid of it."

msgid "찾으면, 사례를 해 주지."
msgstr "I'll totally make it worth your while if you find it for me."

msgid "찾은 거야?"
msgstr "You found them?"

msgid "찾을 수 없는 상품입니다."
msgstr "Product cannot be found."

msgid "찾을 수 없습니다."
msgstr "Cannot find."

