msgid "대형 도로표지판"
msgstr "Large Road Sign"

msgid "대형 쓰레기통"
msgstr "Large Trash Bin"

msgid "대형 크리스마스 트리"
msgstr "Large Christmas Tree"

msgid "대형 호박은 1톤까지 자란 사례도 있습니다."
msgstr "Pumpkins can grow to weigh as much as a ton."

msgid "대형 화이트보드"
msgstr "Large Whiteboard"

msgid "대형광고판"
msgstr "Large Billboard"

msgid "대형쓰레기통"
msgstr "Large Trash Bin"

msgid "대화"
msgstr "Chat"

