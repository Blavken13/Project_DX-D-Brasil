msgid "{clan_name} 부족이 {target_clan_name} 부족에게 동맹 파기를 제안. 파기 제안 플레이어: {player_name}"
msgstr "The {clan_name} clan proposed dissolving their ties with the {target_clan_name} clan. Proposed by: {player_name}."

msgid "{clan_name} 부족이 {target_clan_name} 부족의 동맹 제안을 수락. 제안 수락 플레이어: {player_name}"
msgstr "The {clan_name} clan accepted the {target_clan_name} clan's alliance proposal. Accepted by: {player_name}."

msgid "{clan_name}({clan_id}) 부족 레벨 {clan_level} 달성. 멤버: {member_infos}"
msgstr "The {clan_name} clan ({clan_id}) reached level {clan_level}. Members: {member_infos}."

msgid "{clan_name}({clan_id}) 부족에서 {player_name} 님이 등급을 변경. 변경 전: ({before_roles}), 변경 후: ({new_roles})"
msgstr "{player_name} from the {clan_name} clan ({clan_id}) changed in rank. Previous rank: ({before_roles}). New rank: ({new_roles})."

msgid "{clan_name}({clan_id}) 부족에서 {setter_name} 님이 {player_name} 님의 등급을 {prev_role} 에서 {role}으로 변경"
msgstr "{setter_name} from the {clan_name} clan ({clan_id}) changed the rank of {player_name} from {prev_role} to {role}."

msgid "{clan_name}({clan_id}) 부족이 {entity_region_name} 섬 {tile}에 위치한 {entity_name} 점령 시도. 점령 시도자: {player_name}"
msgstr "The {clan_name} clan ({clan_id}) attempted to claim {entity_name} on {tile} of {entity_region_name} Island. Attempt made by: {player_name}."

msgid "{clan_name}({clan_id}) 부족이 {entity_region_name} 섬 {tile}에 위치한 {entity_name} 점령. 방어 부족: {prev_occupied_name}, 방어 기간: {prev_defense_counts} 회차, 점령 시도자: {player_name}"
msgstr "The {clan_name} clan ({clan_id}) claimed {entity_name} on {tile} of {entity_region_name} Island. Defending clan: {prev_occupied_name}. Defense duration: {prev_defense_counts} turn{prev_defense_counts:p:|s}. Attempt made by: {player_name}."

