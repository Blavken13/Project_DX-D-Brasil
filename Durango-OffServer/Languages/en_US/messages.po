msgid "열대전초기지_구부러진갈대(강)"
msgstr "Tropical Outpost_Curved Reed (River)"

msgid "열대전초기지_바나나나무"
msgstr "Tropical Outpost_Banana Tree"

msgid "열대전초기지_부들(강)"
